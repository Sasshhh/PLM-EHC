@model IEnumerable<C8.eServices.Mvc.Models.TenantComplaint>
@using C8.eServices.Mvc.Keys
@{
    ViewBag.Title = "Complaints & Transgressions";
    Layout = "~/Views/Shared/RCS_Layout.cshtml";
    var stats = ViewBag.SLAStats as dynamic;
}

<div class="panel-group">
    <div class="panel panel-default">
        <div class="panel-group" style="margin-bottom: -1px;">
            <div class="panel panel-default">
                <div class="panel-heading" align="center">
                    Complaints & Transgressions
                </div>
            </div>
        </div>

        <div id="accountInfoCollapse" class="panel-collapse collapse in tablecss">
            <br />
            
            <div style="padding-left: 10px; margin-bottom: 15px;">
                <a href="@Url.Action("Create")" class="btn btn-primary">
                    <i class="ion ion-plus-round"></i> Lodge New Complaint
                </a>
            </div>

            @if (User.IsInRole("Client Services Officer"))
            {
                <div class="row" style="margin: 0 10px 15px 10px;">
                    <div class="col-md-3">
                        <div class="panel panel-info">
                            <div class="panel-heading" align="center">Total Cases</div>
                            <div class="panel-body" align="center"><h4>@(Model.Count())</h4></div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="panel panel-warning">
                            <div class="panel-heading" align="center">Open / Pending</div>
                            <div class="panel-body" align="center"><h4>@(Model.Count(c => c.Status != null && (c.Status.Key == ComplaintStatusKeys.Submitted || c.Status.Key == ComplaintStatusKeys.AwaitingAppointment || c.Status.Key == ComplaintStatusKeys.AwaitingInvestigation)))</h4></div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="panel panel-success">
                            <div class="panel-heading" align="center">Resolved</div>
                            <div class="panel-body" align="center"><h4>@(Model.Count(c => c.Status != null && c.Status.Key == ComplaintStatusKeys.Resolved))</h4></div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="panel panel-danger">
                            <div class="panel-heading" align="center">Unresolved</div>
                            <div class="panel-body" align="center"><h4>@(Model.Count(c => c.Status != null && c.Status.Key == ComplaintStatusKeys.Unresolved))</h4></div>
                        </div>
                    </div>
                </div>
            }

            <table id="complaintsTable" class="table table-bordered table-hover table-striped panel panel-default cards">
                <thead>
                    <tr>
                        <th>Case Ref #</th>
                        <th>Date</th>
                        <th>Category</th>
                        <th>Type</th>
                        <th>Respondent</th>
                        @if (User.IsInRole("Client Services Officer"))
                        {
                            <th>Assigned To</th>
                        }
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var statusKey = item.Status != null ? item.Status.Key : "";
                        var statusName = item.Status != null ? item.Status.Name : "Unknown";

                        var categoryName = item.ComplaintCategory != null ? item.ComplaintCategory.Name : "N/A";
                        var typeName = item.ComplaintType != null ? item.ComplaintType.Name : "N/A";
                        var assignedName = item.AssignedTo != null ? (item.AssignedTo.FirstName + " " + item.AssignedTo.LastName) : "Unassigned";

                        var daysOpen = item.DateSubmitted.HasValue ? (DateTime.Now - item.DateSubmitted.Value).Days : 0;
                        var isOverdue = daysOpen > 7 && statusKey != ComplaintStatusKeys.Resolved && statusKey != ComplaintStatusKeys.Referred;

                        <tr>
                            <td>
                                <strong>@item.CaseReferenceNumber</strong>
                                @if (isOverdue)
                                {
                                    <br /><span class="text-danger"><i class="ion ion-alert"></i> @daysOpen days</span>
                                }
                                else if (daysOpen > 5 && statusKey != ComplaintStatusKeys.Resolved)
                                {
                                    <br /><span class="text-warning"><i class="ion ion-ios-time"></i> @daysOpen days</span>
                                }
                            </td>
                            <td>@(item.DateSubmitted.HasValue ? item.DateSubmitted.Value.ToString("dd MMM yyyy") : "N/A")</td>
                            <td>@categoryName</td>
                            <td>@typeName</td>
                            <td>
                                @item.RespondentFirstName @item.RespondentSurname
                                <br />
                                <span class="text-muted" style="font-size: 0.9em;">
                                    @(item.RespondentComplex != null ? item.RespondentComplex.Name : "")
                                    @if (!string.IsNullOrEmpty(item.RespondentBlockNumber))
                                    {
                                        <text> - Blk @item.RespondentBlockNumber</text>
                                    }
                                    @if (!string.IsNullOrEmpty(item.RespondentUnitNumber))
                                    {
                                        <text>, Unit @item.RespondentUnitNumber</text>
                                    }
                                </span>
                            </td>
                            @if (User.IsInRole("Client Services Officer"))
                            {
                                <td>@assignedName</td>
                            }
                            <td>@statusName</td>
                            <td>
                                <a href="@Url.Action("Details", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("id=" + item.Id) })" class="btn btn-primary btn-sm">
                                    <i class="ion ion-ios-search-strong"></i> View
                                </a>
                                @if (!User.IsInRole("Client Services Officer") && item.Investigations != null)
                                {
                                    var activeInvestigation = item.Investigations.FirstOrDefault();
                                    if (activeInvestigation != null && !activeInvestigation.RespondentConfirmed && activeInvestigation.AppointmentDate.HasValue)
                                    {
                                        <a href="@Url.Action("ConfirmAppointment", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("id=" + item.Id) })" class="btn btn-success btn-sm" style="margin-left: 5px;">
                                            <i class="ion ion-checkmark"></i> Confirm Appt
                                        </a>
                                    }
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <br />
        </div>
    </div>
</div>

@section Scripts{
    <script src="@Url.Content("~/scripts/Datatables/jquery.dataTables.min.js")"></script>
    <script src="@Url.Content("~/scripts/Datatables/dataTables.bootstrap.js")"></script>
    <script type="text/javascript">
        $(function () {
            $('#complaintsTable').DataTable({
                "order": [[1, "desc"]],
                "pageLength": 25,
                "language": {
                    "emptyTable": "No complaints found.",
                    "search": "Search:",
                    "lengthMenu": "Show _MENU_ entries"
                }
            });
        });
    </script>
}
