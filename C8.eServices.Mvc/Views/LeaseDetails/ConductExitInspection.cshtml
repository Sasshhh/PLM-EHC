@model C8.eServices.Mvc.ViewModels.DepartmentsApprovalViewModel
@using System.Text;
@using C8.eServices.Mvc.DataAccessLayer;
@using C8.eServices.Mvc.Keys
@{
    ViewBag.Title = "Details";
    Layout = "~/Views/Shared/RCS_Layout.cshtml";
}
<head>
    <style>
        .swal-modal .swal-text {
            text-align: center;
        }
    </style>
</head>
<script src="@Url.Content( "~/Scripts/moment.js" )"></script>
<div id="bankAccountPanel">
    <div class="panel panel-default">
        <div class="panel-heading">Evaluating Application</div>
        <div style="width: 90%;margin: 0 auto;">
            <br />
            <table id="FailureTable" class="table table-bordered table-hover table-striped panel panel-default display ">
                <thead>
                    <tr>
                        <th>
                            Reference Number
                        </th>
                        <th>
                            Applicant Type
                        </th>
                        <th>
                            Status
                        </th>
                        <th>
                            Captured Date
                        </th>
                        <th>
                            Customer Name
                        </th>
                        <th>
                            Action
                        </th>
                    </tr>
                </thead>
                <tbody>

                    <tr>
                        <td>
                            @Model.PropertyLeaseApplications.ApplicationReferenceNumber
                        </td>
                        <td>
                            @if (Model.PropertyLeaseApplications.PurchaserType != null)
                            {
                                @Model.PropertyLeaseApplications.PurchaserType.Name

                            }
                                            </td>
                        <td>
                            @Model.PropertyLeaseApplications.Status.Name
                        </td>
                        <td>
                            @Model.PropertyLeaseApplications.CreatedDateTime
                        </td>
                        <td>
                            @Model.PropertyLeaseApplications.Customer.FullName
                        </td>
                        <td>
                            @Html.ActionLink("View", "Details", "PropertyLeaseApplication", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("refNo=" + Model.PropertyLeaseApplications.Id.ToString()), target = "_blank" }, new { @class = "btn btn-primary", @target = "_blank" })
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
        <br />
        <div class="panel-heading">Evaluating tenant Lease</div>
        <div style="width: 90%;margin: 0 auto;">
            <br />
            <table id="RCSTable" class="table table-bordered table-hover table-striped panel panel-default display ">
                <thead>
                    <tr>
                        <th>
                            Reference Number
                        </th>
                        <th>
                            Applicant Type
                        </th>
                        <th>
                            Status
                        </th>
                        <th>
                            Captured Date
                        </th>
                        <th>
                            Tenant Name
                        </th>
                        <th>
                            Action
                        </th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        @Html.HiddenFor(model => model.LeaseDetails.Id)
                        <td>
                            @Model.LeaseDetails.LeaseReferenceNo
                        </td>
                        <td>
                            @if (Model.PropertyLeaseApplications.PurchaserType!=null)
                            {
                                @Model.PropertyLeaseApplications.PurchaserType.Name
                            }
                        </td>
                        <td>
                            @Model.LeaseDetails.Status.Name
                        </td>
                        <td>
                            @Model.LeaseDetails.CreatedDateTime
                        </td>
                        <td>
                            @Model.LeaseDetails.LastName
                        </td>
                        <td>
                            @Html.ActionLink("View", "ApplincantDetails", "leaseDetails", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("refNo=" + Model.LeaseDetails.Id.ToString()), target = "_blank" }, new { @class = "btn btn-primary", @target = "_blank" })

                        </td>
                    </tr>

                </tbody>
            </table>
        </div>
        <br />
        <div class="panel-heading">Required Termination</div>
        <div style="width: 90%;margin: 0 auto;">
            <br />
            <table id="FailureTable" class="table table-bordered table-hover table-striped panel panel-default display ">
                <thead>
                    <tr>
                        <th>
                            Termination Date
                        </th>
                        <th>
                            Reason For Termination
                        </th>
                        <th>
                            Captured Date
                        </th>
                        <th>
                            Terminateion By
                        </th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>
                            @Model.LeaseTermination.TerminationDate
                        </td>
                        <td>
                            @Model.LeaseTermination.ReasonForTermination
                        </td>
                        <td>
                            @Model.LeaseTermination.CreatedDateTime
                        </td>
                        <td>
                           @Model.Customer.FullName
                        </td>
                    </tr>

                </tbody>
            </table>
        </div>
        <br />
        <div class="panel-heading">Conduct Exit Inspection Template</div>
        <div style="width: 90%;margin: 0 auto;">
            @Html.Partial("_DocumentsPartialDisplayPLMTemplates", Model.DocumentsViewModelTemplate)
        </div>
        <br />

        <div class="panel-heading">Upload Completed Exit Inspection</div>
        @Html.Partial("_DocumentsPartialConductUnitInspection", Model.DocumentsViewModel)
        <br />
        <div style="width: 90%;margin: 0 auto;">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <br />

                if (ViewBag.ApprovalStatus != null)
                {
                    <div class="form-group">
                        @Html.Label("Approval Status", htmlAttributes: new { @class = "control-label col-md-1" })
                        <div class="col-md-2">
                            @Html.DropDownList("ApprovalStatus", null, "-- Select Option --", htmlAttributes: new { @class = "form-control",@Id= "ApprovalStatus", @Name = "ApprovalStatusddl", @required = "required" })
                            @Html.ValidationMessage("ApprovalStatus", "", new { @class = "text-danger" })
                        </div>
                    </div>
                }

                <br />

                <div id="divComment" style="display:block">
                    <div class="form-group">
                        @Html.Label("Comment", htmlAttributes: new { @class = "control-label col-md-1" })
                        <div class="col-md-4">
                            @Html.TextArea("RejectComment", new { @class = "form-control", @Id="Comments" })
                            @Html.ValidationMessage("RejectComment", "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <br />
                    <br />
                    <br />
                </div>
                <br />
                <br />
           
                <div id="divbtn" style="display:block">
                    <input type="button" value="Submit" name="btnApproval" onclick="clickSubmit()" class="button1" />
                    <input type="submit" value="Submit" style="display:none;" hidden name="btnApprovalStatus" class="button1" id="btnApproval" />
                    <br />
                    <br />
                    <br />
                </div>
            }
        </div>
    </div>
</div>
@section Scripts{

    <script src="@Url.Content( "~/scripts/Datatables/jquery.dataTables.min.js" )"></script>
    <script src="@Url.Content( "~/scripts/Datatables/dataTables.bootstrap.js" )"></script>

    <script type="text/javascript">

        function loadAccounts() {
            $('#FailureTable').DataTable({
                "ajax": {
                    "url": "@Url.Action( "LoadDetails", "DepartmentsApprovals" )",
                    "type": "GET",
                    "datatype": "json",
                    "timeout": 60000
                },
                "columns": [

                    {
                        "data": "CreatedDateTime", "autoWidth": true,
                        "render": function (data) {
                            return convertDate(data);
                        }
                    },
                    {
                        "render": function (data) {
                            return "System";
                        }
                    },
                    { "data": "FailureReason", "autoWidth": true },
                    {
                        "data": "CapturedDate", "autoWidth": true,
                        "render": function (data) {
                            return convertDate(data);
                        }
                    },

                     { "data": "AssignedTo", "autoWidth": true }],
                "language": {
                    "emptyTable": "No Data.",
                },
                "Initcomplete": "",
                "destroy": true
            });
        }

        function convertDate(data) {
            try {
                var dtStart = new Date(parseInt(data.substr(6)));
                var dtStartWrapper = moment(dtStart);
                return dtStartWrapper.format("YYYY-MM-DD");
            }
            catch (ex) {
            }
        }

        $(function () {
            $('#RCSTable').DataTable();

        });

    </script>

}

<script>
    function clickSubmit() {
        swal({
            icon: "info",
            title: "Are you sure you want to submit the following document approval?",
            buttons: [
                'No!',
                'Yes, I am sure!'
            ]

        }).then(function (isConfirm) {
            if (isConfirm) {
                debugger;
                var statuskey = document.getElementById('ApprovalStatus').value;
                var comment = document.getElementById('Comments').value;
                if (statuskey == "Rcs_Rejected") {
                    if (comment == null || comment == "") {
                        swal("error", "Please enter reason for rejecting termination", "warning")
                    }
                } else {
                    document.getElementById("btnApproval").click();
                }
            }
        });
    }

</script>
<script>
        $(function () {
            $('#FailureTable').DataTable();

                var display = "@ViewBag.Message";

        if (display != null && display != "") {
            $('#MessageModal4').modal('show');
        }});
</script>


