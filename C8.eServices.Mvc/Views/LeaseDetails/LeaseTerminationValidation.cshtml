@section Scripts{

    <script src="@Url.Content( "~/scripts/Datatables/jquery.dataTables.min.js" )"></script>
    <script src="@Url.Content( "~/scripts/Datatables/dataTables.bootstrap.js" )"></script>

    <script type="text/javascript">


        $(document).ready(function () {
        debugger;
        if ('@ViewBag.TerminationAppRenewalAllowed' !== null && '@ViewBag.TerminationAppRenewalAllowed' !== '') {
            $('#TerminationAppRenewalModal').modal({
                backdrop: 'static',
                keyboard: false,
                show: true
            });
        }

            setDate();
        });
        function loadAccounts() {
            //debugger;
            $('#FailureTable').DataTable({
                "ajax": {
                    "url": "@Url.Action( "LoadDetails", "DepartmentsApprovals" )",
                    "type": "GET",
                    "datatype": "json",
                    "timeout": 60000
                },
                "columns": [

                    {
                        "data": "CreatedDateTime", "autoWidth": true,
                        "render": function (data) {
                            return convertDate(data);
                        }
                    },
                    {
                        "render": function (data) {
                            return "System";
                        }
                    },
                    { "data": "FailureReason", "autoWidth": true },
                    {
                        "data": "CapturedDate", "autoWidth": true,
                        "render": function (data) {
                            return convertDate(data);
                        }
                    },

                     { "data": "AssignedTo", "autoWidth": true }],
                "language": {
                    "emptyTable": "No Data.",
                },
                "Initcomplete": "",
                "destroy": true
            });
        }

        function convertDate(data) {
            try {
                var dtStart = new Date(parseInt(data.substr(6)));
                var dtStartWrapper = moment(dtStart);
                return dtStartWrapper.format("YYYY-MM-DD");
            }
            catch (ex) {
            }
        }

        $(function () {
            $('#RCSTable').DataTable();

        });
        function setDate()
        {
            var Startdate = $("#TerminationDateValue").val()
            var thisDate = new Date(Startdate);
            var day = thisDate.getDate();
            var month = thisDate.getMonth() + 1;
            var year = thisDate.getFullYear();
            var date = year + '-' + month + '-' + day;
            $('#lease_stattdate').val(date)
        }
    </script>

}
<script>
    function ChangeStatus() {
        debugger;
        var statuskey = document.getElementById("ApprovalStatusId").value;
        if (statuskey =="plm_tenant_notice") {

        }



        if (statuskey == "plm_habitable") {
            $('#divComment').css("display", "block");
            $('#divCommentRequired').css("display", "none");
            $("UnitInspectionComment").prop("required", false);
        } else if (statuskey == "plm_habitable_minor_defects" || statuskey == "plm_not_habitable") {
            $('#divCommentRequired').css("display", "block");
            $('#divComment').css("display", "none");
            $("UnitInspectionComment").prop("required", true);
        }
    }


    function ChangeDate() {
        debugger;
        var Startdate = document.getElementById("lease_stattdate").value;
        var thisDate = new Date(Startdate);
        var todaya = new Date();


        var Thisyear = today.getFullYear();

        var month = thisDate.getMonth();
        var year = thisDate.getFullYear();

        var dateSelected = thisDate.getUTCDate();
        var firstDay = 1;
        var last = 31;
        var lastlast = 30;
        var lastFeb = 28;

        var LastDate = new Date(year, month + 1, 0);
        var LastDay = LastDate.getDate();
        var today = new Date();
        var TodayMonth = today.getMonth();
        var date = true;
        if (month <= TodayMonth) {
            swal("Error!", "Please select upcoming month!", "warning");
            $('#lease_stattdate').val('');
            $('#renewal_notice').val('');
            $('#end_date').val('');
            $('#termination_notice').val('');
        }

        if (Thisyear<=year && month == 1)
        {
            if (month > TodayMonth && dateSelected == 29 || dateSelected == 28) {
                var tempday = 15;
                var nextdate = new Date(year, month + 23, tempday);
                var NXmonth = nextdate.getMonth();
                var NXyear = nextdate.getFullYear();
                var terminateday = new Date(NXyear, NXmonth + 1, 0).getDate();
                var exitdate = new Date(NXyear, NXmonth, terminateday).toLocaleDateString('en-ZA');
                var renewalNotice = new Date(NXyear, NXmonth - 2, 1).toLocaleDateString('en-ZA');
                var terminationNotice = new Date(NXyear, NXmonth, 1).toLocaleDateString('en-ZA');

                $('#renewal_notice').val(renewalNotice);
                $('#end_date').val(exitdate);
                $('#termination_notice').val(terminationNotice);

            }


        }

        if (Thisyear <= year && month > TodayMonth && dateSelected == 31 || dateSelected == 30) {
            var tempday = 15;
            var nextdate = new Date(year, month + 23, tempday);
            var NXmonth = nextdate.getMonth();
            var NXyear = nextdate.getFullYear();
            var terminateday = new Date(NXyear, NXmonth + 1, 0).getDate();
            var exitdate = new Date(NXyear, NXmonth, terminateday).toLocaleDateString('en-ZA');
            var renewalNotice = new Date(NXyear, NXmonth - 2, 1).toLocaleDateString('en-ZA');
            var terminationNotice = new Date(NXyear, NXmonth, 1).toLocaleDateString('en-ZA');

            $('#renewal_notice').val(renewalNotice);
            $('#end_date').val(exitdate);
            $('#termination_notice').val(terminationNotice);
        }

        else if (month == 2) {
            if (month > TodayMonth && dateSelected != 29 || dateSelected != 28) {
                swal("Error!", "Please select the last day of the month!", "warning");
                $('#lease_stattdate').val('');
                $('#renewal_notice').val('');
                $('#end_date').val('');
                $('#termination_notice').val('');
            }

        }
       else if (month > TodayMonth && dateSelected != 31 || dateSelected != 30 ) {
            swal("Error!", "Please select the last day of the month!", "warning");
            $('#lease_stattdate').val('');
            $('#renewal_notice').val('');
            $('#end_date').val('');
            $('#termination_notice').val('');
        }

       
    }




</script>
