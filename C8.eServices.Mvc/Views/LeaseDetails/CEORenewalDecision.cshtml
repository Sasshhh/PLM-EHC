@model C8.eServices.Mvc.ViewModels.DepartmentsApprovalViewModel
@using System.Text;
@using C8.eServices.Mvc.DataAccessLayer;
@using C8.eServices.Mvc.Keys
@{
    ViewBag.Title = "CEO Renewal Decision";
    Layout = "~/Views/Shared/RCS_Layout.cshtml";
}
<script src="@Url.Content("~/Scripts/moment.js")"></script>

@Html.Partial("_RenewalEvaluationPanels", Model)

@* -- Supporting Documents Upload -- *@
<div class="eval-section">
    <div class="eval-section-hdr"><i class="ion ion-document-text"></i> Supporting Documents</div>
    <div class="eval-section-body" style="padding:16px;">
        @Html.Partial("_DocumentsPartialDark", Model.DocumentsViewModel)
    </div>
</div>

<div class="outcome-card">
    <h5><i class="ion ion-clipboard"></i> &nbsp;Director Decision</h5>
    @using (Html.BeginForm("CEORenewalDecision", "LeaseDetails", new { q = Request.QueryString["q"] }, FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        <div style="display:flex; flex-wrap:wrap; gap:20px; align-items:flex-start;">
            @if (ViewBag.ApprovalStatus != null)
            {
                <div style="flex:1; min-width:220px;">
                    <label style="font-size:12px; color:#94a3b8; font-weight:600;">OUTCOME <span style="color:#ef4444;">*</span></label>
                    @Html.DropDownList("ApprovalStatus", null, "-- Select Option --", htmlAttributes: new
                    {
                        @class = "form-control", @Name = "ApprovalStatusddl",
                        @required = "required",
                        @Id = "ApprovalStatus",
                        @style = "margin-top:6px; background:#1e293b; color:#fff; border:1px solid #334155;"
                    })
                    @Html.ValidationMessage("ApprovalStatus", "", new { @class = "text-danger" })
                </div>
            }
            <div style="flex:2; min-width:280px;">
                <label style="font-size:12px; color:#94a3b8; font-weight:600;">DIRECTOR COMMENT <span style="color:#ef4444;">*</span></label>
                @Html.TextArea("RejectComment", new { @class = "form-control", @Id = "Comments", @required = "required", @style = "margin-top:6px; background:#1e293b; color:#fff; border:1px solid #334155; resize:vertical;", @rows="3" })
                @Html.ValidationMessage("RejectComment", "", new { @class = "text-danger" })
            </div>
        </div>
        <div style="margin-top:20px; display:flex; flex-wrap:wrap; gap:10px; align-items:center;">
            <button type="button" class="outcome-btn btn-recommend" onclick="clickSubmit()"><i class="ion ion-paper-airplane"></i> Submit Decision</button>
            <a href="@Url.Action("Renewals","LeaseDetails")" class="outcome-btn" style="background:transparent; border:1px solid #475569; color:#94a3b8; text-decoration:none;"><i class="ion ion-arrow-left-c"></i> Back</a>
        </div>
        <input type="submit" style="display:none;" hidden name="btnApprovalStatus" id="btnApproval" />
    }
</div>

@section Scripts{
    <script type="text/javascript">
        function clickSubmit() {
            swal({
                icon: "info",
                title: "Confirm Decision",
                text: "Are you sure you want to submit this decision?",
                buttons: ['Cancel', 'Yes, Submit']
            }).then(function (isConfirm) {
                if (isConfirm) {
                    var statuskey = document.getElementById('ApprovalStatus').value;
                    var comment = document.getElementById('Comments').value;
                    if (statuskey == "Rcs_Rejected" && (!comment || comment.trim() === "")) {
                        swal("Validation Error", "Please enter a reason for rejecting the renewal.", "warning");
                    } else {
                        document.getElementById("btnApproval").click();
                    }
                }
            });
        }
    </script>
}

