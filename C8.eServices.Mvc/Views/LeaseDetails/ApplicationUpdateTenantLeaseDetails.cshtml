    function searchrate(rateNo) {

        var MunicipalAccNo = document.getElementById('rate').value;
        $.getJSON("../Capture/LimsPropertyDetails?MunicipalAccNo="
            + MunicipalAccNo,

            function (result) {

                if (result != "Error" && result != "") {

                    try {

                        if (result.Status != "Success") {

                            if (result.StatusKey == "r_rcs_ccc_doesn't_exist") {
                                swal(result.Title, result.Status, "error");
                                $('#rate').val('');
                                jQuery('#divInformationFields').css("display", "none")

                            }
                            else if (result.StatusKey == "r_rcs_ccc_not_setup") {
                                swal(result.Title, result.Status, "error");
                                $('#rate').val('');
                                jQuery('#divInformationFields').css("display", "none")

                            }
                            else {
