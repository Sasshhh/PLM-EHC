                                row.append($("<td>" + PurchaserInformation_FirstName + " " + PurchaserInformation_LastName + "</td>"));
                                if (PurchaserInformation_IDNo == "") {
                                    row.append($("<td>" + PurchaserInformation_Passport + "</td>"));
                                }
                                else {
                                    row.append($("<td>" + PurchaserInformation_IDNo + "</td>"));
                                }
                                row.append($("<td>" + PurchaserInformation_PurEmail + "</td>"));
                                row.append($("<td>" + PurchaserInformation_PostAddress + "</td>"));
                                row.append($("<td>" + PurchaserInformation_NominatedAddress + "</td>"));
                                clearNaturalPerson();
                                $('#NaturalPersontbl').DataTable();
                            }
                            catch (cat) { }
                        }
                        else {

                            swal("Error!", "Unsuccessfully captured!", "error");
                        }
                    });
            }
        }

