@model C8.eServices.Mvc.ViewModels.DepartmentsApprovalViewModel
@using System.Text;
@using C8.eServices.Mvc.DataAccessLayer;
@using C8.eServices.Mvc.Keys
@{
    ViewBag.Title = "Renewal Revenue Manager Validation";
    Layout = "~/Views/Shared/RCS_Layout.cshtml";
}
<head>
    <style>
        .swal-modal .swal-text {
            text-align: center;
        }
        #signaturePadCanvas {
            border: 2px solid #1e8449;
            border-radius: 4px;
            background: #fff;
            cursor: crosshair;
            touch-action: none;
        }
        .signature-preview {
            border: 1px solid #ccc;
            max-width: 300px;
            max-height: 100px;
        }
    </style>
</head>

<div class="panel panel-default">
    <div class="panel-heading">Evaluating Application</div>
    <div style="width: 90%;margin: 0 auto;">
        <br />
        <table id="FailureTable" class="table table-bordered table-hover table-striped panel panel-default display ">
            <thead>
                <tr>
                    <th>Reference Number</th>
                    <th>Applicant Type</th>
                    <th>Status</th>
                    <th>Captured Date</th>
                    <th>Customer Name</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>@Model.PropertyLeaseApplications.ApplicationReferenceNumber</td>
                    <td>@Model.PropertyLeaseApplications.PurchaserType.Name</td>
                    <td>@Model.PropertyLeaseApplications.Status.Name</td>
                    <td>@Model.PropertyLeaseApplications.CreatedDateTime</td>
                    <td>@Model.PropertyLeaseApplications.Customer.FullName</td>
                    <td>
                        @Html.ActionLink("View", "Details", "PropertyLeaseApplication", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("refNo=" + Model.PropertyLeaseApplications.Id.ToString()), target = "_blank" }, new { @class = "btn btn-primary", @target = "_blank" })
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <br />

    <div class="panel-heading">Generated Renewal Agreement</div>
    <div style="width: 90%;margin: 0 auto;">
        <br />
        <table class="table table-bordered table-hover table-striped panel panel-default display">
            <thead>
                <tr>
                    <th>Document Type</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Renewal Lease Agreement</td>
                    <td>
                        <a href="@Url.Action("pdfGenerateRenewalLeaseAgreement", "LeaseDetails", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("LeaseId=" + ViewBag.LeaseId.ToString()) })" target="_blank" class="btn btn-primary">View Document</a>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="panel-heading">Revenue Manager Signature</div>
    <div style="width: 90%;margin: 0 auto; padding: 20px;">
        <div class="row">
            <div class="col-md-6">
                <div id="rmSignatureStatusContainer">
                    <!-- Status injected via JS -->
                </div>
                <div id="rmSignatureActionContainer" style="margin-top: 10px;">
                    <button type="button" class="btn btn-info" id="btnDrawRMSignature">Draw Signature</button>
                </div>
            </div>
        </div>
    </div>

    <!-- RM Signature Modal -->
    <div class="modal fade" id="rmSignatureModal" tabindex="-1" role="dialog" aria-hidden="true" data-backdrop="static">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title">Revenue Manager Signature Pad</h4>
                </div>
                <div class="modal-body text-center">
                    <canvas id="signaturePadCanvas" width="500" height="200"></canvas>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" id="btnClearRMSignature">Clear</button>
                    <button type="button" class="btn btn-primary" id="btnConfirmRMSignature">Confirm Signature</button>
                </div>
            </div>
        </div>
    </div>

    <div class="panel-heading">Evaluate Details</div>
    <div style="width: 90%;margin: 0 auto;">
        <br />
        @using (Html.BeginForm("RenewalRevenueManagerValidation", "LeaseDetails", FormMethod.Post, new { @id = "EvaluateForm" }))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@ViewBag.LeaseId" />
            <table class="table table-bordered table-hover table-striped panel panel-default display">
                <tbody>
                    <tr>
                        <td>
                            @Html.Label("ApprovalStatus", "Approval Status", new { @class = "control-label" })
                            <span style="color:red"> *</span>
                        </td>
                        <td>
                            @Html.DropDownList("ApprovalStatusddl", new SelectList(new[] {
                                new { Value = RCSActionTypeKeys.Approved, Text = "Approved" },
                                new { Value = RCSActionTypeKeys.Rejected, Text = "Rejected" }
                            }, "Value", "Text"), "-- Select Option --", new { @class = "form-control", @required = true, @id = "ApprovalStatusddl" })
                            @Html.ValidationMessage("ApprovalStatusddl")
                        </td>
                    </tr>
                    <tr id="commentRow" style="display:none;">
                        <td>
                            @Html.Label("Comment", "Comment", new { @class = "control-label" })
                            <span style="color:red" id="commentRequiredStar"> *</span>
                        </td>
                        <td>
                            @Html.TextArea("Comment", null, new { @class = "form-control", @id = "CommentBox" })
                        </td>
                    </tr>
                </tbody>
            </table>
            <br />
            <button type="submit" class="btn btn-primary" id="btnSubmitForm">Submit</button>
            <br /><br />
        }
    </div>
</div>

@section Scripts {
    <script src="@Url.Content("~/scripts/Datatables/jquery.dataTables.min.js")"></script>
    <script src="@Url.Content("~/scripts/Datatables/dataTables.bootstrap.js")"></script>
    <script src="https://cdn.jsdelivr.net/npm/signature_pad@4.0.0/dist/signature_pad.umd.min.js"></script>
    <script>
        $(document).ready(function () {
            var rmPad;
            var leaseId = '@ViewBag.LeaseId';

            var canvas = document.getElementById('signaturePadCanvas');
            if(canvas){ rmPad = new SignaturePad(canvas, { backgroundColor: 'rgba(255, 255, 255, 0)' }); }

            $('#ApprovalStatusddl').change(function () {
                var val = $(this).val();
                if (val === 'Rejected') {
                    $('#commentRow').show();
                    $('#CommentBox').prop('required', true);
                } else {
                    $('#commentRow').hide();
                    $('#CommentBox').prop('required', false);
                }
            });

            $('#btnDrawRMSignature').click(function () {
                rmPad.clear();
                $('#rmSignatureModal').modal('show');
            });

            $('#btnClearRMSignature').click(function () { rmPad.clear(); });

            $('#btnConfirmRMSignature').click(function () {
                if (rmPad.isEmpty()) { swal("Error", "Please draw a signature first.", "error"); return; }
                var dataUrl = rmPad.toDataURL('image/png');
                
                $.ajax({
                    url: '@Url.Action("SaveRenewalRevenueManagerSignatureImage", "LeaseDetails")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ LeaseId: leaseId, SignatureImageData: dataUrl }),
                    success: function (res) {
                        if (res.success) {
                            $('#rmSignatureModal').modal('hide');
                            swal("Success", "Signature captured.", "success");
                            $('#rmSignatureStatusContainer').html('<img src="' + dataUrl + '" class="signature-preview" /><br/><span class="text-success"><i class="fa fa-check"></i> Signed</span>');
                            $('#rmSignatureActionContainer').hide();
                        } else {
                            swal("Error", res.message, "error");
                        }
                    }
                });
            });

            $('#EvaluateForm').submit(function (e) {
                if ($('#ApprovalStatusddl').val() === 'Approved') {
                    if ($('#rmSignatureActionContainer').is(':visible')) {
                        e.preventDefault();
                        swal("Missing Signature", "You must sign the agreement before approving.", "error");
                        return false;
                    }
                }
                return true;
            });
        });
    </script>
}
