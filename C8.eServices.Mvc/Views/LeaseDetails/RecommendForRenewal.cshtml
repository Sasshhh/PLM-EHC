@model C8.eServices.Mvc.ViewModels.DepartmentsApprovalViewModel
@using C8.eServices.Mvc.DataAccessLayer
@using C8.eServices.Mvc.Keys
@using C8.eServices.Mvc.Models
@{
    ViewBag.Title = "Evaluating Application - UC018 Recommend for Renewal";
    Layout = "~/Views/Shared/RCS_Layout.cshtml";

}

@Html.Partial("_RenewalEvaluationPanels", Model)

@* -- Supporting Documents Upload -- *@
<div class="eval-section">
    <div class="eval-section-hdr"><i class="ion ion-document-text"></i> Supporting Documents</div>
    <div class="eval-section-body" style="padding:16px;">
        <p style="color:#94a3b8; font-size:12px; margin-bottom:15px;">Upload any supplementary files required for the renewal recommendation.</p>
        @Html.Partial("_DocumentsPartialDark", Model.DocumentsViewModel)
    </div>
</div>

@* -- 7. Outcome / Decision Form -- *@
@if (ViewBag.MigratedAppRenewalAllowed == null)
{
    <div class="outcome-card">
        <h5><i class="ion ion-clipboard"></i> &nbsp;Step 7 - Select Outcome &amp; Submit Recommendation</h5>
        @using (Html.BeginForm("RecommendForRenewal", "LeaseDetails", new { q = Request.QueryString["q"] }, FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <div style="display:flex; flex-wrap:wrap; gap:20px; align-items:flex-start;">
                <div style="flex:1; min-width:220px;">
                    <label style="font-size:12px; color:#94a3b8; font-weight:600;">RECOMMENDATION OUTCOME <span style="color:#ef4444;">*</span></label>
                    <select name="ApprovalStatusddl" id="ApprovalStatus" required class="form-control" style="margin-top:6px; background:#1e293b; color:#fff; border:1px solid #334155;">
                        <option value="">-- Select Outcome --</option>
                        @if (ViewBag.ApprovalStatus != null)
                        {
                            foreach (var item in ViewBag.ApprovalStatus as IEnumerable<System.Web.Mvc.SelectListItem>)
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        }
                    </select>
                </div>
                <div style="flex:2; min-width:280px;">
                    <label style="font-size:12px; color:#94a3b8; font-weight:600;">COMMENTS / REASON <span style="color:#ef4444;">*</span></label>
                    @Html.TextArea("RejectComment", new { @class = "form-control", @id = "Comments", @rows = "3", @required = "required", @placeholder = "Enter your recommendation reason and supporting notes...", @style = "margin-top:6px; background:#1e293b; color:#fff; border:1px solid #334155; resize:vertical;" })
                </div>
            </div>

            <div style="margin-top:20px; display:flex; flex-wrap:wrap; gap:10px; align-items:center;">
                <button type="button" class="outcome-btn btn-recommend" onclick="submitOutcome()">
                    <i class="ion ion-paper-airplane"></i> Submit Recommendation
                </button>
                <a href="@Url.Action("Renewals","LeaseDetails")" class="outcome-btn" style="background:transparent; border:1px solid #475569; color:#94a3b8; text-decoration:none;">
                    <i class="ion ion-arrow-left-c"></i> Back to Renewals
                </a>
            </div>

            <input type="submit" id="btnApproval" style="display:none;" />
        }
    </div>
}
else
{
    <div class="alert alert-warning" style="border-radius:8px; margin-top:16px;">
        <strong><i class="ion ion-alert-circled"></i> Renewal Blocked:</strong> @ViewBag.MigratedAppRenewalAllowed
        <br /><a href="@Url.Action("Renewals","LeaseDetails")" class="btn btn-default btn-sm" style="margin-top:8px;">- Back to Renewals</a>
    </div>
}



@* -- Migrated warning modal -- *@
<div id="MigratedAppRenewalModal" class="modal fade" role="dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header"><h4 class="modal-title">Warning</h4></div>
            <div class="modal-body"><strong>@Html.Raw(ViewBag.MigratedAppRenewalAllowed)</strong></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" onclick="location.href='@Url.Action("Renewals","LeaseDetails")'">OK</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            if ('@ViewBag.MigratedAppRenewalAllowed' !== '' && '@ViewBag.MigratedAppRenewalAllowed' !== 'null') {
                $('#MigratedAppRenewalModal').modal({ backdrop: 'static', keyboard: false, show: true });
            }
        });

        function submitOutcome() {
            var comment = document.getElementById('Comments').value;
            var status  = document.getElementById('ApprovalStatus').value;
            if (!status) { swal('Validation', 'Please select an outcome before submitting.', 'warning'); return; }
            if (!comment || comment.trim() === '') { swal('Validation', 'Please enter a comment or reason.', 'warning'); return; }

            swal({
                icon: 'info',
                title: 'Confirm Recommendation',
                text: 'Are you sure you want to submit this recommendation? This action will notify the Revenue Manager.',
                buttons: ['Cancel', 'Yes, Submit']
            }).then(function (ok) {
                if (ok) { document.getElementById('btnApproval').click(); }
            });
        }
    </script>
}



