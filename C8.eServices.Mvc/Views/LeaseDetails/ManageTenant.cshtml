@model C8.eServices.Mvc.ViewModels.TenantViewModel



@{
    ViewBag.Title = "Create";
    Layout = "~/Views/Shared/RCS_Layout.cshtml";
}
<head>


</head>

<style>
    /*  h4 {
        font-size: 1.2em;
    }*/
    @@media only screen and (max-width: 1000px) {

        .buttonIcon {
            font-size: 2.5rem !important;
        }

        .chkboxmargin {
            margin-left: 30px;
        }

        .cards tbody tr {
            float: left;
            /*width: 20rem;*/
            width: 90%;
            margin: 0.5rem;
            border: 0.0625rem solid rgba(0,0,0,.125);
            border-radius: .25rem;
            box-shadow: 0.25rem 0.25rem 0.5rem rgba(0,0,0,0.25);
        }

        .cards thead tr {
            float: left;
            /*width: 25rem;*/
            width: 90%;
            margin: 0.5rem;
            border: 0.0625rem solid rgba(0,0,0,.125);
            border-radius: .25rem;
            box-shadow: 0.25rem 0.25rem 0.5rem rgba(0,0,0,0.25);
        }


        .cards tbody td {
            display: block;
            word-wrap: break-word;
        }

        .cards thead th {
            display: none;
        }

        .table tbody label {
            display: block;
        }

        .cards tbody label {
            display: inline;
            position: relative;
            font-size: 85%;
            top: -0.5rem;
            color: #808080;
            min-width: 4rem;
            margin-left: 0;
            margin-right: 1rem;
            text-align: left;
        }

        tr.selected label {
            color: #404040;
        }

        .table .fa {
            font-size: 2.5rem;
            text-align: center;
        }

        .cards .fa {
            font-size: 7.5rem;
        }
    }

    @@media only screen and (max-width: 1000px) {
        .step-app > .step-steps {
            display: inline-block;
            padding: 1px;
            color: white;
            background-color: #848484;
            text-decoration: none;
            border-right: 1px solid #fff;
            word-wrap: break-word;
            width: 100%;
        }
    }

    .button1 {
        font-size: 13px;
    }

    .required:before {
        content: '*';
        color: red;
    }

    input[type='date'] {
        position: relative;
    }

    ::-webkit-datetime-edit, ::-webkit-clear-button, ::-webkit-calendar-picker-indicator {
        position: absolute;
    }

    ::-webkit-clear-button {
        right: 2.5em;
    }

    ::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    ::-webkit-calendar-picker-indicator {
        right: 0;
        padding: .539em .34em;
    }

    input[type="date"]::-webkit-calendar-picker-indicator {
        color: rgba(0, 0, 0, 0);
        opacity: 1;
        display: block;
        background: url('../Content/RcsStyles/calenderIcon.png') no-repeat;
        background-size: 20px 20px;
        width: 20px;
        height: 20px;
        border-width: thin;
        margin-left: 50px;
    }

    body {
        font-family: Arial;
    }

    .number {
        background-color: transparent !important;
        border: 1.5px solid white;
        border-radius: 50px;
        color: white !important;
    }

    .step-app > .step-steps > li > a {
        display: block;
        padding: 10px;
        color: white;
        background-color: #848484;
        text-decoration: none;
        border-right: 1px solid #fff;
    }

    legend {
        display: block;
        width: 100%;
        padding: 0;
        margin-bottom: 20px;
        font-size: 25px;
        line-height: inherit;
        color: #333;
        border: 0;
        background-color: aliceblue;
        border-bottom: 1px solid #00d0ff;
    }

    .error {
        color: tomato;
    }
</style>


<div id="AddOccupantsSessionModal" class="modal fade" role="dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>

                <h4 class="modal-title">Add Occupant</h4>
            </div>
            <div class="modal-body">
                <div class="container">
                    <strong>@Html.Raw(ViewBag.AddOccupantsSession)</strong>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>

<body>
    <br />


    @using (Html.BeginForm("AddOccupant", "LeaseDetails", FormMethod.Post, new { id = "clientInfo-form" }))
    {
        @Html.AntiForgeryToken()

        <div id="demo">

            <div class="step-app">
                <ul class="step-steps">
                    <li><a href="#step2"><span class="number">1</span>Tenant Management <span class="ion ion-person"></span></a></li>

                </ul>
                <div class="step-content">


                    <div class="step-tab-panel" id="step2">
                        <fieldset>
                            <div class="panel-group">
                                <div class="panel panel-default">
                                    <div class="panel-group" style="margin-bottom: -1px;">
                                        <div class="panel panel-default">
                                            <div class="panel-heading">

                                                <h4 class="panel-title" align="center">
                                                    <a data-toggle="collapse" data-parent="#accordion" href="#usersCollapse">
                                                        Add New Occupants
                                                    </a>
                                                </h4>
                                            </div>

                                        </div>
                                    </div>

                                    <div id="accountInfoCollapse" class="panel-collapse collapse in">

                                        <div id="PurchaserDetails" align="left">
                                            <div class="form-horizontal">
                                                <br />
                                                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                                                <div>
                                                    <div id="divOccupants" style="display:block">

                                                        @Html.EditorFor(model => model.WaterSessionList, new { htmlAttributes = new { @id = "WaterMeterList", @style = "display:none;" } })
                                                        @Html.EditorFor(Lease => Lease.Lease.Id, "LeaseId", new { htmlAttributes = new { @class = "form-control", @style = "display:none;", @Id = "Lease.Id" } })

                                                        <div>
                                                            <br />
                                                            <div class="form-group">
                                                                @Html.LabelFor(model => model.PropertyResident.FirstNames, htmlAttributes: new { @class = "control-label col-md-2" })
                                                                <div class="col-md-2">
                                                                    @Html.EditorFor(model => model.PropertyResident.FirstNames, "FirstNames", new { htmlAttributes = new { @class = "form-control", @Id = "PropertyResident.FirstNames", @required = "required" } })
                                                                    @Html.ValidationMessageFor(model => model.PropertyResident.FirstNames, "", new { @class = "text-danger" })
                                                                </div>
                                                                @Html.LabelFor(model => model.PropertyResident.LastName, htmlAttributes: new { @class = "control-label col-md-2" })
                                                                <div class="col-md-2">
                                                                    @Html.EditorFor(model => model.PropertyResident.LastName, "LastName", new { htmlAttributes = new { @class = "form-control", @Id = "PropertyResident.LastName", @required = "required" } })
                                                                    @Html.ValidationMessageFor(model => model.PropertyResident.LastName, "", new { @class = "text-danger" })
                                                                </div>
                                                                @Html.LabelFor(model => model.PropertyResident.IDNo, htmlAttributes: new { @class = "control-label col-md-2" })
                                                                <div class="col-md-2">
