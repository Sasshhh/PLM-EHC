                                                                    @Html.ValidationMessageFor(model => model.PropertyResident.IDNo, "", new { @class = "text-danger" })
                                                                </div>
                                                                <div class="col-md-offset-2 col-md-3">
                                                                    <br />
                                                                    <br />
                                                                    <button type="submit" value="create" class="button1" @*onclick="clearNaturalPerson()"*@>Add Occupant</button>
                                                                    @*<a value="create" id="btnAddWater" class="button1">Add Occupant</a>*@
                                                                    <br />
                                                                    <br />
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            @if ((Model.PropertyResidentList.Count > 0) || (Model.OldResidents.Count > 0))
                            {
