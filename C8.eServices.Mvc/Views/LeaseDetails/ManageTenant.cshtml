    function searchmeters(rateNo) {
        //alert("in search meters");
        Session = [];
        SessionDelete = [];
        SessionCount = 0;
        DeleteCount = 0;

        ElectricitySession = [];
        ElectricitySessionDelete = [];
        ElectricitySessionCount = 0;
        ElectricityDeleteCount = 0;
        //alert("middle search meters");
        document.getElementById("ElectricityMeterList").value = "";
        document.getElementById("WaterMeterList").value = "";
        //alert(" search meters before wtable");
        // $("#Watertbl > tbody").html("");
        //$('#Watertbl').DataTable().clear().draw();
        //$('#Electricitytbl').DataTable().clear().draw();
        var wtable = $('#Watertbl').DataTable();

        wtable.clear().draw();

        var etable = $('#Electricitytbl').DataTable();

        etable.clear().draw();
        //alert(" search meters before json");

        var MunicipalAccNo = document.getElementById('rate').value;
        $.getJSON("../Capture/MeterDetails?MunicipalAccNo="
            + rateNo,

            function (result) {


                if (result != "Error") {
                    try {

                        if (result.length == 0) {

                            swal("Error!", "No Results found!", "error");

                            //$('#rate').val('');
                        }

                        else {
                            var Active = false;
                            if (result.RefuseServiceExist == "Yes") {
                                $('#MunicipalAccountInformation_Refusechk').prop('checked', true);
                                Active = true;

                            }
                            if (result.SewerServiceExist == "Yes") {
                                $('#MunicipalAccountInformation_Sewerchk').prop('checked', true);
                                Active = true;

                            }
                            if (result.RatesServiceExist == "Yes") {
                                $('#MunicipalAccountInformation_RatesandTaxeschk').prop('checked', true);
                                Active = true;

                            }

                            // if (result.MetersList != null) {
                            //     result.MetersList.forEach(function (item) {

                            //         // create an unordered list node
                            //         alert(item);
                            //     )}
                            //}
                            for (var i = 0; i < result.MetersList.length; i++) {
                                //alert("here" + result.MetersList[i].Service);
                                if (result.MetersList[i].Service == "WA") {
                                    Active = true;

                                    if (result.MetersList[i].hasPreviousMeter == true) {
                                        AddSessionApi(result.MetersList[i].MeterNumber, result.MetersList[i].PreviousMeterReading, result.MetersList[i].PreviousMeterReadingDate, "Processed-SOLAR");

                                    }


                                    AddSessionApi(result.MetersList[i].MeterNumber, result.MetersList[i].MeterReading, result.MetersList[i].MeterReadingDate, "Processed-SOLAR");


                                    if (result.MetersList[i].hasUnprocessedMeter == true) {
                                        AddSessionApi(result.MetersList[i].MeterNumber, result.MetersList[i].UnprocessedMeterReading, result.MetersList[i].UnprocessedMeterReadingDate, "Unprocessed-SOLAR");

                                    }


                                    //AddWaterApi(MeterNumber, MeterReading, MeterReadingDate);
                                }
                                if (result.MetersList[i].Service == "EL") {
                                    Active = true;

                                    if (result.MetersList[i].hasPreviousMeter == true) {
                                        ElectricityAddSessionApi(result.MetersList[i].MeterNumber, result.MetersList[i].PreviousMeterReading, result.MetersList[i].PreviousMeterReadingDate, "Processed-SOLAR");

                                    }

                                    ElectricityAddSessionApi(result.MetersList[i].MeterNumber, result.MetersList[i].MeterReading, result.MetersList[i].MeterReadingDate, "Processed-SOLAR");

                                    if (result.MetersList[i].hasUnprocessedMeter == true) {
                                        ElectricityAddSessionApi(result.MetersList[i].MeterNumber, result.MetersList[i].UnprocessedMeterReading, result.MetersList[i].UnprocessedMeterReadingDate, "Unprocessed-SOLAR");

                                    }
                                    //AddWaterApi(MeterNumber, MeterReading, MeterReadingDate);
                                }
                            }
                            if (Active == true) {

                                $('#MunicipalAccountInformation_ServicesOnProperty').trigger('click');

                            }


                        }
                    }
                    catch (cat) { }
                }
                else {
                    //alert("Unsuccessfully captured!");
                    swal("Error!", "Unsuccessfully captured.", "error");
                }
            });
    }
    function ValidateRSAIDNo(id) {
        try {
            if (id.length != 13) {
                $('#PropertyResident.IDNo').val('');
                //alert("Please enter a valid 13 digit ID no.");
                document.getElementById("PropertyResident.IDNo").value = "";
                swal("Error!", "Please enter a valid 13 digit ID no.", "warning");
                return false;
            } else {
                ValidateDuplicates(id);
            }
            var y1o = id.substring(0, 1)
            var y2e = id.substring(1, 2)
            var m1o = id.substring(2, 3)
            var m2e = id.substring(3, 4)
            var d1o = id.substring(4, 5)
            var d2e = id.substring(5, 6)
            var go = id.substring(6, 7)
            var s1e = id.substring(7, 8)
            var s2o = id.substring(8, 9)
            var s3e = id.substring(9, 10)
            var co = id.substring(10, 11)
            var ae = id.substring(11, 12)
            var z = id.substring(12, 13)

            var A = 0;
            A = parseInt(A) + parseInt(y1o) + parseInt(m1o) + parseInt(d1o) + parseInt(go) + parseInt(s2o) + parseInt(co);
            var B1 = y2e + m2e + d2e + s1e + s3e + ae;
            var B2 = B1 * 2;
            var i = 0;
            var B3 = 0;
            var B2string = B2.toString();
            while (B2string.length > i) {
                var x = B2string.substring(i, i + 1);
                B3 = B3 + parseInt(x);
                i = i + 1;
            }

            var C = A + B3;
            var Cstring = C.toString();
            var secNo = Cstring.substring(1, 2);
            var D = 10 - parseInt(secNo);
            while (D >= 10) D = D - 10;
            if (D == z) {
                //test for valid date in 1900
                var valid = true;
                var bd = new Date('19' + y1o + y2e, parseInt(m1o + m2e) - 1, d1o + d2e);
                if ((bd == 'NaN') | (bd == 'Invalid Date')) valid = false;
                else if (bd.getFullYear() != parseInt('19' + y1o + y2e)) valid = false;
                else if (bd.getMonth() + 1 != parseInt(m1o + m2e)) valid = false;
                else if (bd.getDate() != parseInt(d1o + d2e)) valid = false;
                //if invalid test again in 2000
                valid = true;
                bd = new Date('20' + y1o + y2e, parseInt(m1o + m2e) - 1, d1o + d2e);
                if ((bd == 'NaN') | (bd == 'Invalid Date')) valid = false;
                else if (bd.getFullYear() != parseInt('20' + y1o + y2e)) valid = false;
                else if (bd.getMonth() + 1 != parseInt(m1o + m2e)) valid = false;
                else if (bd.getDate() != parseInt(d1o + d2e)) valid = false;


                var tempDate = new Date(id.substring(0, 2), id.substring(2, 4) - 1, id.substring(4, 6));

                var id_date = tempDate.getDate();
                var id_month = tempDate.getMonth();
                var id_year = tempDate.getFullYear();

                var fullDate = (id_month + 1) + "/" + id_date + "/" + id_year;

                $('#DOBAuto').val(fullDate);



                var today_date = new Date();
                var today_year = today_date.getFullYear();
                var today_month = today_date.getMonth();
                var today_day = today_date.getDate();
                var age = today_year - id_year;

                if (today_month < (id_month - 1)) {
                    age--;
                }
                if (((id_month - 1) == today_month) && (today_day < id_date)) {
                    age--;
                }

                $('#AgeAuto').val(age);


                if (!((tempDate.getYear() == id.substring(0, 2)) && (id_month == id.substring(2, 4) - 1) && (id_date == id.substring(4, 6)))) {
                    error.append('<p>ID number does not appear to be authentic - date part not valid</p>');
                    correct = false;
                }


                return valid;
            }
            else {
                $('#PurchaserInformation_IDNo').val('');
                //alert("Please enter a valid 13 digit ID no.");
                $('#PropertyResident.IDNo').val('');
                //alert("Please enter a valid 13 digit ID no.");
                document.getElementById("PropertyResident.IDNo").value = "";
                swal("Error!", "Please enter a valid 13 digit ID no.", "warning");
                return false;
            }
        }
        catch (e) {
            //alert(bd+"Catch");
            return false;
        }
    }

    function isNumber(evt) {
        evt = (evt) ? evt : window.event;
        var charCode = (evt.which) ? evt.which : evt.keyCode;
        if (charCode > 31 && (charCode < 48 || charCode > 57)) {
            return false;
        }
        return true;
    }


