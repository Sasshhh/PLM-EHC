<script>
    function ActivatePerson(val) {
        debugger;
        var i = val;
        $.getJSON("../LeaseDetails/ActivatePerson?id="+val ,
            function (result) {
                 window.location.href = "@Url.Action("Inbox", "PropertyLeaseApplication")";
            });
    }
    function ValidateDuplicates(val) {
        var Id = val;
        if (Id.length == 13) {
            $.getJSON("../LeaseDetails/ValidateDuplicates?Id=" + '@Model.Lease.Id' + "&IDNo=" + Id,
                function (result) {
                    if (result==true) {
                        document.getElementById("PropertyResident.IDNo").value = "";
                        swal("Error", "Occupant has been added with the same ID", "warning");
                    }
                });
        }

    }
    //Masking amount fields
    $(document).ready(function ($) {

        $('#Watertbl').DataTable({ searching: false, paging: false, info: false });

        $('#Electricitytbl').DataTable({ searching: false, paging: false, info: false });
        var form = $("#clientInfo-form");
        form.children("div").steps({

            onFinish: function () {
                var Purchaser = document.getElementById("PurchaserInformation_PurchaseType").value;

                if (Purchaser != '' && Purchaser != null) {

                    $("#clientInfo-form").submit();
                }
                else if ($("#NaturalPersontbl tr").length > 1) {
                    $("#clientInfo-form").submit();

                }
                else {
                    swal("Error!", "Please Select An Applicant Type", "warning");

                }

            },
            onChange: function (event, currentIndex, newIndex) {

                //submit(currentIndex, newIndex)

                if (newIndex < currentIndex) {
                    return true;
                }
                form.validate().settings.ignore = ":disabled,:hidden";
                return form.valid();

            }
        });



        function submit(currentIndex, newIndex) {


            isValid = true;
            var step = "";
            if (currentIndex == 1) {
                step = "DivTransferInformation"
            }

            $('input,select', $("#" + step)).each(
                function () {
                    if ($(this).attr('required') == "required" || $(this).attr('required') == true) {
                        if (document.getElementById($(this).attr('id')).value == "") {
                            document.getElementById($(this).attr('id')).style.border = '1px solid red'
                            if (isValid == true) {
                                isValid = false;
                                //
                            }
                        }

                        else {
                            document.getElementById($(this).attr('id')).style.border = ''
                        }
                    }



                    if (isValid == true) {
                        alert("sbumit");

                        if (btn == "Save") {

                            document.getElementById("btnSave2").click()
                        }
                        else {

                            if (newIndex < currentIndex) {
                                return true;
                            }
                            var form = $("#clientInfo-form");
                            form.validate().settings.ignore = ":disabled,:hidden";
                            return form.valid();

                        }

                    }
                    else {
                        document.getElementById("Erroralert").hidden = false;
                        document.getElementById("error2").innerHTML = "Please fill in all Required Fields marked with an (*)";



                    }

                });
        }

        $('#TransferInformationSellingPrice').mask('#,##0.00', { reverse: true });
        $('#Lease.VATAmount').mask('#,##0.00', { reverse: true });
        $('#Lease.RentalAmount').mask('#,##0.00', { reverse: true });
        $('#Lease.DepositeAmount').mask('#,##0.00', { reverse: true });



        var CurrUrl = window.location.href;

        jQuery('#returnUrl').val("" + CurrUrl);
    });
</script>

<script>

    function servicesCheckedFn() {
        var servicesChecked = document.getElementById("MunicipalAccountInformation_ServicesOnProperty");
        if (servicesChecked.checked) {
            servicesChecked.value = true;
            jQuery('#divServices').css("display", "block")
        }
        else {
            servicesChecked.value = false;
            jQuery('#divServices').css("display", "none")
        }
    }

    function ValidateRatesNumber(rateNo) {

        if (rateNo.length != 10) {
            $('#TransferInformation_RatesNumber').val('');
            //swal("Our First Alert");
            swal("Error!", "Please enter a valid 10 digit Rate Number!", "warning");
            //alert("Please enter a valid 10 digit Rate Number");
            //swal({
            //    title: "Good job!",
            //    text: "Please enter a valid 10 digit Rate Number!",
            //    icon: "success",
            //});
            jQuery('#divInformationFields').css("display", "none")
            return false;
        }
        else {
            searchrate(rateNo);
            //searchmeters(rateNo);
            jQuery('#divInformationFields').css("display", "block")

        }

    }
    function searchrate(rateNo) {

        var MunicipalAccNo = document.getElementById('rate').value;
        $.getJSON("../Capture/LimsPropertyDetails?MunicipalAccNo="
            + MunicipalAccNo,

            function (result) {

                if (result != "Error" && result != "") {

                    try {

                        if (result.Status != "Success") {

                            if (result.StatusKey == "r_rcs_ccc_doesn't_exist") {
                                swal(result.Title, result.Status, "error");
                                $('#rate').val('');
                                jQuery('#divInformationFields').css("display", "none")

                            }
                            else if (result.StatusKey == "r_rcs_ccc_not_setup") {
                                swal(result.Title, result.Status, "error");
                                $('#rate').val('');
                                jQuery('#divInformationFields').css("display", "none")

                            }
                            else {
                                swal("Error!", "No Results found!", "error");
                                $('#rate').val('');
                                jQuery('#divInformationFields').css("display", "none")

                            }



                        }

                        else {
                            $('#SellerInformation_OwnerName').val(result.registeredownernames);
                            $('#TransferInformation_Town').val(result.regionname);
                            $('#TransferInformation_Suburb').val(result.regionname);
                            $('#TransferInformation_PhysicalAddress').val(result.streetaddress);
                            $('#SellerInformation_OwnerIdNumber').val(result.registeredownerids);

                            $('#TransferInformation_ErfDescription').val(result.erfnumber);

                            $('#TransferInformation_ExtentSize').val(result.deedextents);
                            $('#TransferInformation_Extent').val(result.ssourceaccountnumber);

                            $('#TransferInformation_PropertyKey').val(result.ssourceaccountnumber);
                            jQuery('#TransferInformation_Category').val(result.categoryname)
                            //var ownernames = result.Initials + " " + result.Surname
                            //$('#TransferInformation_Extent').val(result.UnitNo);
                            //$('#TransferInformation_PhysicalAddress').val(result.StreetAddr);
                            //$('#TransferInformation_NewSubConfirm').val(result.PostalCode);

                            //$('#SellerInformation_OwnerIdNumber').val(result.IDNo);
                            //$('#SellerInformation_CellNo').val(result.CellNo);
                            //$('#SellerInformation_HomeNo').val(result.HomeTel);
                            //$('#SellerInformation_WorkNo').val(result.WorkTel);
                            //$('#SellerInformation_EmailAddress').val(result.EmailAddr);
                            //$('#TransferInformation_Suburb').val(result.PostalAddress2);
                            //$('#TransferInformation_Town').val(result.PostalAddress3);
                            //alert("Beforre search owner");
                            searchowner(rateNo);
                            //alert("after search owner");
                            searchmeters(rateNo);
                            //alert("after search meters");
                        }
                    }
                    catch (cat) { }
                }
                else {
                    //alert("Unsuccessfully captured!");
                    jQuery('#divInformationFields').css("display", "none")
                    $('#rate').val('');
                    swal("Error", "Service Unavailable ", "error");



                }
            });
    }

    function searchowner(rateNo) {

        var MunicipalAccNo = document.getElementById('rate').value;
        $.getJSON("../Capture/VAInformation?MunicipalAccNo="
            + MunicipalAccNo,

            function (result) {
                if (result != "Error") {
                    try {


                        var ownernames = result.Initials + " " + result.Surname
                        $('#SellerInformation_OwnerName').val(ownernames);

                        $('#TransferInformation_NewSubConfirm').val(result.PostalCode);

                        $('#SellerInformation_OwnerIdNumber').val(result.IDNo);

                        $('#SellerInformation_CellNo').val(result.CellNo);
                        if (result.CellNo == " ") {
                            $('#SellerInformation_CellNo').val('');
                        }

                        $('#SellerInformation_HomeNo').val(result.HomeTel);
                        if (result.HomeTel == " ") {
                            $('#SellerInformation_HomeNo').val('');
                        }
                        $('#SellerInformation_WorkNo').val(result.WorkTel);
                        if (result.WorkTel == " ") {

                            $('#SellerInformation_WorkNo').val('');
                        }
                        $('#SellerInformation_EmailAddress').val(result.EmailAddr);
                        if (result.EmailAddr == " ") {

                            $('#SellerInformation_EmailAddress').val('');
                        }



                    }
                    catch (cat) { }
                }
                else {
                    //alert("Unsuccessfully captured!");
                    swal("Error!", "Unsuccessfully captured.", "error");
                }
            });
    }

    function Cancel() {
        document.getElementById("Cancelbtn").click();
    }

    var ElectricitySession = [];
    var ElectricitySessionDelete = [];
    var ElectricitySessionCount = 0;
    var ElectricityDeleteCount = 0;
    function ElectricityDeleteSession(counter) {
        //alert("Counter" + counter);
        //ElectricitySessionDelete = new [];
        var watert = $('#Electricitytbl').DataTable();
        ElectricitySessionDelete = [];
        watert.clear().draw();



        ElectricityDeleteCount = 0;
        //alert(ElectricitySession.length);
        for (var i = 0; i < ElectricitySession.length; i++) {
            // alert(ElectricitySession[i].SessionNumber);
            if (ElectricitySession[i].Count != counter) {
                ElectricityDeleteCount++;
                //alert(counter + "counter + fees count " + ElectricitySession[i].Count + " ");
