                                                                    <thead>
                                                                        <tr>
                                                                            <th>
                                                                                Tenant Reference No.
                                                                            </th>
                                                                            <th>
                                                                                Occupant Name
                                                                            </th>
                                                                            <th>
                                                                                Occupant Surname
                                                                            </th>
                                                                            <th>
                                                                                Identity No.
                                                                            </th>
                                                                            <th>
                                                                                Status
                                                                            </th>
                                                                            <th>
                                                                                Action
                                                                            </th>
                                                                        </tr>
                                                                    </thead>
                                                                    <tbody>

                                                                        @foreach (var item in Model.PropertyResidentList)
                                                                        {
                                                                            <tr>
                                                                                <td>
                                                                                    @item.OccupantReferenceNo
                                                                                </td>
                                                                                <td>
                                                                                    @item.FirstNames
                                                                                </td>
                                                                                <td>
                                                                                    @item.LastName
                                                                                </td>

                                                                                <td>
                                                                                    @item.IDNo
                                                                                </td>
                                                                                <td>
                                                                                    @item.Status.Name
                                                                                </td>
                                                                                <td>
                                                                                    @Html.ActionLink("Deactivate", "Delete", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("id=" + item.Id.ToString()) }, new { @class = "btn btn-primary" })
                                                                                </td>

                                                                            </tr>
                                                                        }
                                                                    </tbody>
                                                                </table>
                                                            </div>

                                                        }

                                                        @if (Model.OldResidents.Count > 0)
                                                        {
                                                            <div class="panel-body" id="divNaturalPersontbl2">
                                                                <h3 style="text-align:center;">List of Deactive Occupants</h3>
                                                                <hr />
                                                                <table id="NaturalPersontbl" class="table table-bordered table-hover table-striped panel panel-default cards">
                                                                    <thead>
                                                                        <tr>
                                                                            <th>
                                                                                Tenant Reference No.
                                                                            </th>
                                                                            <th>
                                                                                Occupant Name
                                                                            </th>
                                                                            <th>
                                                                                Occupant Surname
                                                                            </th>
                                                                            <th>
                                                                                Identity No.
                                                                            </th>
                                                                            <th>
                                                                                Status
                                                                            </th>
                                                                            <th>
                                                                                Action
                                                                            </th>
                                                                        </tr>
                                                                    </thead>
                                                                    <tbody>

                                                                        @foreach (var item in Model.OldResidents)
                                                                        {
                                                                            <tr>
                                                                                <td>
                                                                                    @item.OccupantReferenceNo
                                                                                </td>
                                                                                <td>
                                                                                    @item.FirstNames
                                                                                </td>
                                                                                <td>
                                                                                    @item.LastName
                                                                                </td>

                                                                                <td>
                                                                                    @item.IDNo
                                                                                </td>
                                                                                <td>
                                                                                    @item.Status.Name
                                                                                </td>
                                                                                <td>
                                                                                    @Html.ActionLink("Activate", "Activate", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("id=" + item.Id.ToString()) }, new { @class = "btn btn-primary" })
                                                                                </td>

                                                                            </tr>
                                                                        }
                                                                    </tbody>
                                                                </table>
                                                            </div>
                                                            <br />
                                                            <br />
                                                        }

                                                        <hr />
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }


                        </fieldset>
                    </div>

                </div>

                <div class="step-footer" align="center">
                    @if (ViewBag.IsManage != null)
                    {
                        <input type="button" id="btnExternal" class="button1" value="Return To Manage" onclick="location.href='@Url.Action("LeaseManageTenants", "LeaseDetails")'" />
                        if ((Model.PropertyResidentList.Count > 0))
                        {
                            <input type="button" id="btnExternal" class="button1" value="Upload Documents" onclick="location.href='@Url.Action("UploadOccupantsDoc", "LeaseDetails", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("Id=" + Model.Lease.PropertyLeaseApplicationId.ToString()+"&IsManage=true") })'" />
                        }

                    }
                    else
                    {
                        <input type="button" id="btnExternal" class="button1" value="Return To Applicant Details" onclick="location.href='@Url.Action("ApplincantDetails", "LeaseDetails", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("refNo=" + Model.Lease.Id.ToString()) })'" />
                        if ((Model.PropertyResidentList.Count > 0))
                        {
                            <input type="button" id="btnExternal" class="button1" value="Upload Documents" onclick="location.href='@Url.Action("UploadOccupantsDoc", "LeaseDetails", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("Id=" + Model.Lease.PropertyLeaseApplicationId.ToString()+"&IsManage="+null) })'" />
                        }
                    }

                </div>
                <div class="step-footer" align="left">
                    @Html.EncodedActionLink("Cancel", "Index", "RCSApplication", new { id = 0 }, new { @class = "btn btn-outline-primary", @style = "display:none", @id = "Cancelbtn" })

                </div>
            </div>
        </div>
    }


</body>


