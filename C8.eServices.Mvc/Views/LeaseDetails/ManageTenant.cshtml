                                            <div class="panel panel-default">

                                                <div id="accountInfoCollapse" class="panel-collapse collapse in">
                                                    <div class="form-horizontal">


                                                        @if (Model.PropertyResidentList.Count > 0)
                                                        {
                                                            <div class="panel-body" id="divNaturalPersontbl">
                                                                <h3 style="text-align:center;">List of Active Occupants</h3>
                                                                <hr />
