
@model IEnumerable<C8.eServices.Mvc.Models.LeaseDetails>
@using C8.eServices.Mvc.Keys;
@{

    Layout = "~/Views/Shared/RCS_Layout.cshtml";

}

<style>
    @@media only screen and (max-width: 1000px) {


        .cards tbody tr {
            float: left;
            /*width: 20rem;*/
            width: 90%;
            margin: 0.5rem;
            border: 0.0625rem solid rgba(0,0,0,.125);
            border-radius: .25rem;
            box-shadow: 0.25rem 0.25rem 0.5rem rgba(0,0,0,0.25);
        }

        .cards thead tr {
            float: left;
            /*width: 25rem;*/
            width: 90%;
            margin: 0.5rem;
            border: 0.0625rem solid rgba(0,0,0,.125);
            border-radius: .25rem;
            box-shadow: 0.25rem 0.25rem 0.5rem rgba(0,0,0,0.25);
        }


        .cards tbody td {
            display: block;
            word-wrap: break-word;
        }

        .cards thead th {
            display: none;
        }

        .table tbody label {
            display: block;
        }

        .cards tbody label {
            display: inline;
            position: relative;
            font-size: 85%;
            top: -0.5rem;
            color: #808080;
            min-width: 4rem;
            margin-left: 0;
            margin-right: 1rem;
            text-align: left;
        }

        tr.selected label {
            color: #404040;
        }

        .table .fa {
            font-size: 2.5rem;
            text-align: center;
        }

        .cards .fa {
            font-size: 7.5rem;
        }
    }
</style>

<div class="panel-group">
    <div class="panel panel-default">




        <div class="panel-group" style="margin-bottom: -1px;">
            <div class="panel panel-default">
                <div class="panel-heading" align="center">
                    Lease Renewal Offer
                </div>

            </div>
        </div>

        <div id="accountInfoCollapse" class="panel-collapse collapse in tablecss">
            <br />

            <table id="RCSTable" class="table table-bordered table-hover table-striped panel panel-default cards">
                <thead>
                    <tr>
                        <th>
                            Lease Referrence No.
                        </th>
                        <th>
                            Tenant Name
                        </th>
                        <th>
                            Application Type
                        </th>
                        <th>
                            Lease Date
                        </th>
                        <th>
                            Status
                        </th>
                        <th> Action</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.LeaseReferenceNo)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.LastName)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.PurchaserType.Name)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.CreatedDateTime.Value)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Status.Name)
                            </td>

                            <td>
                                @if (item.Status != null)
                                {
                                    if (item.Status.Key == StatusKeys.AwaitingTenantAcceptance)
                                    {
                                        @Html.ActionLink("Renewal Available", "LeaseOfferValidation", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("id=" + item.Id.ToString()) }, new { @class = "btn btn-primary" })
                                    }
                                    else if (item.Status.Key == StatusKeys.AwaitingRenewalTenantSignature)
                                    {
                                        @Html.ActionLink("Sign Agreement", "RenewalLeaseAgreementValidation", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("id=" + item.Id.ToString()) }, new { @class = "btn btn-success" })
                                    }
                                    else if (item.Status.Key == StatusKeys.AwaitingRenewalTenantLease)
                                    {
                                        @Html.ActionLink("Renew Lease", "TenantLeaseRenewal", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("id=" + item.PropertyLeaseApplicationId.ToString()) }, new { @class = "btn btn-primary" })
                                    }
                                    else if (item.Status.Key == StatusKeys.LeaseAgreementGenerated)
                                    {
                                        @Html.ActionLink("Upload Document(s)", "AcceptLeaseRenewal", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("Id=" + item.Id.ToString()) }, new { @class = "btn btn-primary" })
                                    }
                                    else if (item.Status.Key == StatusKeys.AwaitingRenewalDocuments)
                                    {
                                        @Html.ActionLink("Upload Document(s)", "AcceptLeaseRenewal", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("Id=" + item.Id.ToString()) }, new { @class = "btn btn-primary" })
                                    }
                                    else if (item.Status.Key == StatusKeys.AwaitingRenewalTenantSignature)
                                    {
                                        @Html.ActionLink("Sign Agreement", "RenewalLeaseAgreementValidation", "LeaseDetails", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("id=" + item.Id.ToString()) }, new { @class = "btn btn-success" })
                                    }
                                    else
                                    {
                                        @Html.ActionLink("View", "ApplincantDetails", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("refNo=" + item.Id.ToString()), target = "_blank" }, new { @class = "btn btn-primary", @target = "_blank" })

                                    }

                                }
                                else
                                {
                                    @Html.ActionLink("View", "ApplincantDetails", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("refNo=" + item.Id.ToString()), target = "_blank" }, new { @class = "btn btn-primary", @target = "_blank" })

                                }
                            </td>

                        </tr>
                    }
                </tbody>
            </table>
            <br />
        </div>


    </div>
</div>
<script>
    $(function () {



        $('#RCSTable').DataTable();
        $('#RCSTable2').DataTable();
        var display = "@ViewBag.Display";

        if (display != null && display != "") {
            $('#MessageModal3').modal('show');
        }
        else {
            $('#MessageModal3').modal('hide');


               var result = "@ViewBag.MessageBody";
        if (result != null && result != "") {
            $('#MessageModal').modal('show');
        }
        else {
            $('#MessageModal').modal('hide');
              var result5 = "@ViewBag.MessageBody5";
            if (result5 != null && result5 != "") {
                $('#MessageModal5').modal('show');
            }
            else {
                $('#MessageModal5').modal('hide');
            }
        }

        }
        //var element = document.getElementById("RCSTable_wrapper");
        //element.classList.add("tablecss");

    });

    function OpenChatModal() {

        $('#MessageModal').modal('show');
    };


</script>