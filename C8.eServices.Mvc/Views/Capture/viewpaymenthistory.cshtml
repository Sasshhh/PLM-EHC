<head>
    <style>
        @@media only screen and (max-width: 1000px) {

            .buttonIcon {
                font-size: 2.5rem !important;
            }

            .chkboxmargin {
                margin-left: 30px;
            }

            .cards tbody tr {
                float: left;
                /*width: 20rem;*/
                width: 90%;
                margin: 0.5rem;
                border: 0.0625rem solid rgba(0,0,0,.125);
                border-radius: .25rem;
                box-shadow: 0.25rem 0.25rem 0.5rem rgba(0,0,0,0.25);
            }

            .cards thead tr {
                float: left;
                /*width: 25rem;*/
                width: 90%;
                margin: 0.5rem;
                border: 0.0625rem solid rgba(0,0,0,.125);
                border-radius: .25rem;
                box-shadow: 0.25rem 0.25rem 0.5rem rgba(0,0,0,0.25);
            }


            .cards tbody td {
                display: block;
                word-wrap: break-word;
            }

            .cards thead th {
                display: none;
            }

            .table tbody label {
                display: block;
            }

            .cards tbody label {
                display: inline;
                position: relative;
                font-size: 85%;
                top: -0.5rem;
                color: #808080;
                min-width: 4rem;
                margin-left: 0;
                margin-right: 1rem;
                text-align: left;
            }

            tr.selected label {
                color: #404040;
            }

            .table .fa {
                font-size: 2.5rem;
                text-align: center;
            }

            .cards .fa {
                font-size: 7.5rem;
            }
        }

        @@media only screen and (max-width: 1000px) {
            .step-app > .step-steps {
                display: inline-block;
                padding: 1px;
                color: white;
                background-color: #848484;
                text-decoration: none;
                border-right: 1px solid #fff;
                word-wrap: break-word;
                width: 100%;
            }
        }
        .swal-modal .swal-text {
            text-align: center;
        }
    </style>
</head>
<script src="@Url.Content( "~/Scripts/moment.js" )"></script>
<div id="bankAccountPanel">
    <div class="panel panel-default">
        <div class="panel-heading">Payment History</div>


        <br />



        <br />
        @if (Model.OnlinePaymentHistory.Count > 0)
        {
            <div class="panel-heading">RCS online Payment History</div>
            <div style="width: 90%;margin: 0 auto;">
                <br />
                <table id="RCSTable" class="table table-bordered table-hover table-striped cards panel panel-default display">
                    <thead>
                        <tr>
                            <th>
                                Account Number
                            </th>

                            <th>
                                Payment Method
                            </th>
                            <th>
                                Date
                            </th>
                            <th>
                                Amount
                            </th>
                            <th>
                                Description
                            </th>
                            <th>
                                Status
                            </th>


                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model.OnlinePaymentHistory)
                        {
                            <tr>

                                <td>
                                    @Model.RCSApplicationStatus.TransferInformation.RatesNumber
                                </td>
                                <td>
                                    @item.PaymentMethod
                                </td>
                                <td>

                                    @item.CreatedDateTime


                                </td>
                                <td>
                                    @item.Amount
                                </td>
                                <td>
                                    @item.Descritpion
                                </td>

                                <td>
                                    @item.Status
                                </td>

                            </tr>
                        }




                    </tbody>


                </table>

                <br />
                <br />


            </div>

        }

        <br />
        @if (Model.Document.Documents.Count > 0)
        {
            <div class="panel-heading">RCS Document Upload Payment History</div>
            <div style="width: 90%;margin: 0 auto;">
                <br />
                <table id="RCSTableUpload" class="table cards table-bordered table-hover table-striped panel panel-default display">
                    <thead>
                        <tr>
                            <th>
                                Document Type
                            </th>

                            <th>
                                Document Name
                            </th>
                            <th>
                                Uploaded Date
                            </th>
                            <th>
                                View
                            </th>



                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model.Document.Documents)
                        {
                            <tr>

                                <td>
                                    @item.DocumentCheckList.DocumentType.Name -
                                    @item.DocumentCheckList.DocumentType.Description

                                </td>
                                <td>
                                    @item.DocumentName
                                </td>
                                <td>

                                    @item.CreatedDateTime


                                </td>
                                <td>
                                    @*@Html.Raw(document != null ? string.Format("<a href='{0}'>{1}</a> {2}</br>", @Url.Action("GetDocument", "File", new { q = document.File.Data }), document.DocumentName, (document.CreatedDateTime == null) ? string.Empty : string.Format("Uploaded On {0:yyyy-MM-dd HH:mm:ss} ", document.File.CreatedDateTime)) : "No Document")*@
                                    @Html.ActionLink("View", "GetDocument", "File", new { q = item.File.Data }, new { @class = "button1" })
                                    @*@Html.ActionLink("View", "GetDocument", new { q = item.File.Data })*@
                                </td>
                             


                            </tr>
                        }




                    </tbody>


                </table>

                <br />
                <br />


            </div>

        }

    </div>
</div>
@section Scripts{

    <script src="@Url.Content( "~/scripts/Datatables/jquery.dataTables.min.js" )"></script>
    <script src="@Url.Content( "~/scripts/Datatables/dataTables.bootstrap.js" )"></script>

    <script type="text/javascript">

        function loadAccounts() {
            //debugger;
            $('#FailureTable').DataTable({
                "ajax": {
                    "url": "@Url.Action( "LoadDetails", "DepartmentsApprovals" )",
                    "type": "GET",
                    "datatype": "json",
                    "timeout": 60000
                },
                "columns": [

                    {
                        "data": "CreatedDateTime", "autoWidth": true,
                        "render": function (data) {
                            return convertDate(data);
                        }
                    },
                    {
                        "render": function (data) {
                            return "System";
                        }
                    },
                    { "data": "FailureReason", "autoWidth": true },
                    {
                        "data": "CapturedDate", "autoWidth": true,
                        "render": function (data) {
                            return convertDate(data);
                        }
                    },

                     { "data": "AssignedTo", "autoWidth": true }],
                "language": {
                    "emptyTable": "No Data.",
                },
                "Initcomplete": "",
                "destroy": true
            });
        }

        function convertDate(data) {
            try {
                var dtStart = new Date(parseInt(data.substr(6)));
                var dtStartWrapper = moment(dtStart);
                return dtStartWrapper.format("YYYY-MM-DD");
            }
            catch (ex) {
            }
        }

        $(function () {
            $('#RCSTable').DataTable();

        });

    </script>

}
