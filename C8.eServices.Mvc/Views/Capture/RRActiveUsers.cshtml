@model IEnumerable<C8.eServices.Mvc.Models.SystemIdentityUser>

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/RCS_Layout.cshtml";
}

@*<h4>Users</h4>*@


<div class="panel-group">
    <div class="panel panel-default">
        <div class="panel-heading">
            <h4 class="panel-title">
                <a data-toggle="collapse" data-parent="#accordion" href="#usersCollapse">
                    Round Robin Users
                </a>
            </h4>
        </div>
        <div id="accountsCollapse" class="panel-collapse collapse in">
            <div class="panel-body">

                <table class="table table-striped" id="table" data-url="/Application/Index">
                    <thead>
                        <tr>
                            <th>
                                @Html.DisplayName("User Name")
                            </th>
                            <th>
                                @Html.DisplayName("Full Name")
                            </th>
                            <th>
                                @Html.DisplayName("Round Robin Is Active")
                            </th>
                            <th>
                                Actions
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                 <td>
                                    @Html.DisplayFor(modelItem => item.SystemUser.UserName)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.SystemUser.FullName)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.RoundRobinIsActive)
                                </td>
                                <td>
                                    @Html.ActionLink("Edit", "EditRRUser", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("id=" + item.Id.ToString()) }, new { @class = "btn btn-primary" })
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>



<script>
    $(function () {
        $('#table').DataTable();
    });
</script>