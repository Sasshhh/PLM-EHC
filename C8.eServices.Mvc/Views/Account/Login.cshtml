                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                <br />
                <h1 id="sign">Sign in</h1>
                <br />
                @*<span>or register your account</span>*@
                @*<input type="text" placeholder="example@gmail.com" title="Please enter you email" required="" value="" name="Email" id="Email">*@
                <input class="input-validation-error form-control" data-val="true" data-val-required="The Username field is required." placeholder="username or e-mail" id="UserName" name="UserName" required="True" type="text" value="">
                <input type="password" title="Please enter your password" placeholder="******" required="" value="" name="Password" id="Password" class="form-control">
                @*<div class="checkbox">
                        <input id="RememberMe" name="RememberMe" type="checkbox" value="true" class="i-checks" checked>
                        Remember login
                        <p class="help-block small">(if this is a private computer)</p>
                    </div>*@
                <a href="@Url.Action("ForgotPassword","Account")">Forgot your password?</a>
                <button style=" position: relative; top: 23px;" type="submit">Sign In</button>

                @*<div class="col-md-4">
                        @Html.TextBoxFor(m => m.UserName, new { @class = "form-control", @required = true })

                    </div>*@
            }
        </div>
    </div>
    <div class="overlay-container">
        <div class="overlay">
            
            <div class="overlay-panel overlay-right" style="background: #1e8449;width: 60%">

                <img src="~/Content/Images/CoE Logo .png" style=" width: 90px; position: relative; left: 31px; height: 120px;" />
                <br />
                <h1>Welcome Back!</h1>

                <p style="font-size: 14px;font-weight: 100;line-height: 20px;letter-spacing: 0.5px;margin: 15px 0 50px;
                    margin-left: 90px;" class="text-center">
                    @*To Login into Property Lease Management System
                    please complete the form with Username and Password*@
                    To keep connected with us please login with your personal information
                </p>
                @*<div class="row">
                    <buttonReg class="ghost" id="signUpHome" onclick="location.href = '@Url.Action("Register","Account")'"> Register >></buttonReg>
                    <br />
                </div>*@
                <div class="row" style="margin-top:-25px;">
                    <p>
                        <button type="button" style="margin-left: 89px; border-radius:20px; padding:9px 35px; " title="Register new account" onclick="location.href='@Url.Action("Register","Account")'"
                                class="gohome">
                            Register >>
                        </button>
                    </p>
                    <p>
                        <button type="button" style="margin-left: 89px; border-radius:20px; padding:9px 35px; " title="Return home" onclick="location.href='../'"
                                class="gohome">
                            Go Home >>
                        </button>
                    </p>
                </div>
                @*<div class="row" style="margin-top:-20px;">
                    <br />

                    <section id="socialLoginForm">
                        @Html.Partial("_ExternalLoginsListPartial", new ExternalLoginListViewModel { ReturnUrl = ViewBag.ReturnUrl })
                    </section>
                </div>*@

            </div>
        </div>
    </div>
</div>



