
@using C8.eServices.Mvc.Keys;
@using C8.eServices.Mvc.Models;
@model C8.eServices.Mvc.ViewModels.CommunicationViewModel


@{
    ViewBag.Title = "MessengerService";
    Layout = null;

}

@{
    int senderid = 0;
    int Depid = 0;
    int validate = 0;
    //var message = ViewBag.LastComment[0] == null ? string.Empty : ViewBag.LastComment[0];
    Comment message = new Comment();
    var message2 = ViewBag.LastComment == null ? string.Empty : ViewBag.LastComment;
    if (message2 != null && message2.Count > 0)
    {
        if (message2.Count > 0)
        {
            message = message2[0];
        }


    }
    else
    {
        //message = string.Empty;
    }
    var test = Model;


    var item = ViewBag.requests;
    var comments = ViewBag.comments;
    var loggedInUser = ViewBag.LoggedInUser;
    var DepartmentCounter = (ViewBag.Departments).Count - 1;
    if (comments.Count > 0)
    {
        validate = 1;
        senderid = comments[0].SenderCustomerId;
    }

}



<html>
<head>
