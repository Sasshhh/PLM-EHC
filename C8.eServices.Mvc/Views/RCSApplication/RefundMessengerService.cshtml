<body>

    <div class="container">
        <div class="messaging">
            <div class="inbox_msg">
                <div class="inbox_people">
                    <div class="headind_srch">
                        <div class="recent_heading">
                            <h4>Recent</h4>
                        </div>

                        <div id="custom-search-input">
                            <div class="input-group col-md-offset-2">
                                <input type="text" class="  search-query form-control" placeholder="Search" />
                                <span class="input-group-btn">
                                    <button class="btn btn-danger" type="button">
                                        <span class=" glyphicon glyphicon-search"></span>
                                    </button>
                                </span>
                            </div>
                        </div>

                    </div>
                    <div class="inbox_chat">
                        @foreach (var department in ViewBag.Departments)
                        {

                            <div class="chat_list">
                                <div class="chat_people">
                                    @*<div class="chat_img"> <img src="~/Content/Images/envelop.png" alt="xet"> </div>*@
                                    <div class="chat_ib">


                                        @{ if (validate == 0)
                                            {
                                                <div onclick="location.href='@Url.Action("RefundCreateMessage", "RCSApplication", new {q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("id=" + Model.RefundApplicationID.ToString() + "&" + "CommunicationType=" + department.Key)  })'">
                                                    <h5><b>@department.Description </b><span class="chat_date">No Date</span></h5>
                                                    <p>
                                                        None
                                                    </p>
                                                </div>
                                            }
                                            else
                                            {
                                                if (message != null && message.Communication.CommunicationTypeId == department.Id)
                                                {
                                                    <div onclick="location.href='@Url.Action("RefundCreateMessage", "RCSApplication", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("id=" + Model.RefundApplicationID.ToString() + "&" + "CommunicationType=" + department.Key)  })'">
                                                        <h5><b>@department.Description </b><span class="chat_date">@message.CreatedDateTime</span></h5>
                                                        <p>
                                                            @message.Comments
                                                        </p>
                                                    </div>

                                                }
                                                else
                                                {
                                                    <div onclick="location.href='@Url.Action("RefundCreateMessage", "RCSApplication", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("id=" + Model.RefundApplicationID.ToString() + "&" + "CommunicationType=" + department.Key)  })'">
                                                        <h5><b>@department.Description </b><span class="chat_date">No Date</span></h5>
                                                        <p>
                                                            None
                                                        </p>

                                                    </div>
                                                }


                                            }
                                        }

                                        @{
                                            if (Depid < DepartmentCounter)
                                            {
                                                Depid = Depid + 1;


                                            }
                                            if (validate == 1)
                                            {
                                                message = ViewBag.LastComment[Depid];
                                            }

                                        }







                                    </div>
                                </div>
                            </div>
                        }
                        @*<div class="chat_list active_chat">
                                <div class="chat_people">
                                    <div class="chat_img"> <img src="https://ptetutorials.com/images/user-profile.png" alt="sunil"> </div>
                                    <div class="chat_ib">
                                        <h5>Sunil Rajput <span class="chat_date">Dec 25</span></h5>
                                        <p>
                                            Test, which is a new approach to have all solutions
                                            astrology under one roof.
                                        </p>
                                    </div>
                                </div>
                            </div>*@

                    </div>
                </div>

                <div class="mesgs">
                    <div class="msg_history">
                        @if (senderid != 0)
                        {
                            for (int i = 0; i < comments.Count; i++)
                            {
                                if (comments[i].SenderCustomerId == loggedInUser)
                                {

                                    <div class="outgoing_msg">
                                        <div class="sent_msg">
                                            <p>
                                                @comments[i].Comments
                                            </p>
                                            <span class="time_date"> @comments[i].CreatedDateTime</span>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="incoming_msg">
                                        @*<div class="incoming_msg_img"> <img src="~/Content/Images/envelop.png" alt="xet"> </div>*@
                                        <div class="received_msg">
                                            <div class="received_withd_msg">
                                                <p>
                                                    @comments[i].Comments
                                                </p>
                                                <span class="time_date">Sent By @comments[i].SenderCustomer.FullName at @comments[i].CreatedDateTime,</span>
                                            </div>
                                        </div>
                                    </div>

                                }
                            }
                        }
                    </div>
                    <div class="type_msg">
                        <div class="input_msg_write">
                            @*<input id="Comments_Comments" type="text" class="write_msg" placeholder="Type a message" />*@
                            @Html.TextAreaFor(model => model.Comments.Comments, new { @cols = "80", @rows = "4", @class = "write_msg", @required = "required", @id = "Comment" })
                            <button class="msg_send_btn" type="submit" id="Submit"><i class="fa fa-paper-plane-o" aria-hidden="true"></i></button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</body>
</html>

@Scripts.Render("~/bundles/jquery")

<script type="text/javascript">

    $('#Submit').click(function ()
            alert("Working");
    Test();
        });

    function Test() {

        var message = $("#Comment").val();

        $.ajax({
            url: "/RCSApplication/RefundCreateMessage",
            method: "POST",
            data: {
                Comments: message
            },
            success: function (data) {
                alert(data);
            },
            error: function () {
                alert("Ajax call failed");
            }
        })
    }

</script>


