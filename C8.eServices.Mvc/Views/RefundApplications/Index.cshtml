@model IEnumerable<C8.eServices.Mvc.Models.RefundApplication>
@using C8.eServices.Mvc.Keys;
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/RCS_Layout.cshtml";
}

<style>
    @@media only screen and (max-width: 1000px) {


        .cards tbody tr {
            float: left;
            /*width: 20rem;*/
            width: 90%;
            margin: 0.5rem;
            border: 0.0625rem solid rgba(0,0,0,.125);
            border-radius: .25rem;
            box-shadow: 0.25rem 0.25rem 0.5rem rgba(0,0,0,0.25);
        }

        .cards thead tr {
            float: left;
            /*width: 25rem;*/
            width: 90%;
            margin: 0.5rem;
            border: 0.0625rem solid rgba(0,0,0,.125);
            border-radius: .25rem;
            box-shadow: 0.25rem 0.25rem 0.5rem rgba(0,0,0,0.25);
        }


        .cards tbody td {
            display: block;
            word-wrap: break-word;
        }

        .cards thead th {
            display: none;
        }

        .table tbody label {
            display: block;
        }

        .cards tbody label {
            display: inline;
            position: relative;
            font-size: 85%;
            top: -0.5rem;
            color: #808080;
            min-width: 4rem;
            margin-left: 0;
            margin-right: 1rem;
            text-align: left;
        }

        tr.selected label {
            color: #404040;
        }

        .table .fa {
            font-size: 2.5rem;
            text-align: center;
        }

        .cards .fa {
            font-size: 7.5rem;
        }
    }

</style>

    <div class="panel-group">
        <div class="panel panel-default">




            <div class="panel-group" style="margin-bottom: -1px;">
                <div class="panel panel-default">
                    <div class="panel-heading" align="center">
                        Submitted Refund Applications

                    </div>

                </div>
            </div>

            <div id="accountInfoCollapse" class="panel-collapse collapse in tablecss">
                <br />
                <table id="RCSTable" class="table table-bordered table-hover table-striped panel panel-default cards">
                    <thead>
                        <tr>
                            <th>
                                First Name
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.ApplicationReferenceNumber)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.CreatedDateTime)
                            </th>
                            <th>
                                Status
                            </th>
                            <th></th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Customer.FirstName)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.ApplicationReferenceNumber)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.CreatedDateTime)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Status.Name)
                                </td>
                                <td>
                                    @*@Html.ActionLink("View", "Details", new { refNo = item.Id }, new { @class = "btn btn-primary" })

        @Html.ActionLink("Message", "CreateMessage", new { id = item.Id, CommunicationType = CommunicationTypeKeys.AttorneyToBo }, new { @class = "btn btn-primary" })*@

                                    @*@if (item.Status.Key == StatusKeys.RefundRequestAvailable)
        {
            @Html.ActionLink("Request Refund", "RefundRequest", new { id = item.Id }, new { @class = "btn btn-primary" })

        }*@
                                    @if (item.Status.Key == StatusKeys.RefundDocumentRejected)
                                    {
                                        @Html.ActionLink("Re-Upload Docs", "UploadRefundDocs", "RCSApplication", new { q = item.Data }, new { @class = "btn btn-primary" })

                                    }
                                    @if (item.Status.Key == StatusKeys.RefundAwaitingUpload)
                                    {
                                        @Html.ActionLink("Re-Upload Docs", "UploadRefundDocs", "RCSApplication", new { q = item.Data }, new { @class = "btn btn-primary" })

                                    }

                                    @Html.ActionLink("Application Details", "Details", "RefundApplications", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("refNo=" + item.Id.ToString()) }, new { @class = "btn btn-primary" })

                                    @Html.ActionLink("Message", "RefundCreateMessage", "RcsApplication", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("id=" + item.Id.ToString() + "&" + "CommunicationType=" + CommunicationTypeKeys.AttorneyToBo) }, new { @class = "btn btn-primary" })

                                    @*@if (item.Status.Key == StatusKeys.RefundDocumentRejected)
        {
            @Html.ActionLink("Re-Upload Docs", "UploadRefundDocs", "RefundApplications", new { id = item.Data }, new { @class = "btn btn-primary" })

        }*@

                                    @*@if (item.Status.Key == StatusKeys.Rejected)
        {
            @Html.ActionLink("Upload", "UploadDocs", new { q = item.Data }, new { @class = "btn btn-primary" })

        }
        @if (item.Status.Key == StatusKeys.UploadPOPApplicationFee)
        {
            @Html.ActionLink("Upload", "UploadApplicationFee", new { q = item.Data }, new { @class = "btn btn-primary" })

        }
        @if (item.Status.Key == StatusKeys.ViewAssessmentFigure)
        {
            @Html.ActionLink("View Assessment Figure", "ViewAssessmentFigure", new { id = item.Id }, new { @class = "btn btn-primary" })

        }
        @if (item.Status.Key == StatusKeys.UploadAssessmentFeePayment)
        {

            @Html.ActionLink("Upload Proof Of Payment", "UploadAssessmentFee", new { q = item.Data }, new { @class = "btn btn-primary" })

        }


        @if (item.Status.Key == StatusKeys.ViewRCCCertificate)
        {
            @Html.ActionLink("View RCC Certificate", "ViewRCCCertificate", new { id = item.Id }, new { @class = "btn btn-primary" })

        }*@

                                </td>

                            </tr>
                        }
                    </tbody>
                </table>

                <br />
            </div>


        </div>
    </div>






    <script>
    $(function () {



        $('#RCSTable').DataTable();
       

        
        //var element = document.getElementById("RCSTable_wrapper");
        //element.classList.add("tablecss");

    });

    function OpenChatModal() {

        $('#MessageModal').modal('show');
    };
    </script>





