                                @Html.DisplayNameFor(model => model.ApplicationAbbreviation)
                            </th>
                            @*<th>
                                    @Html.DisplayNameFor(model => model.IsOnline)
                                </th>*@
                            <th>
                                @Html.DisplayNameFor(model => model.Name)
