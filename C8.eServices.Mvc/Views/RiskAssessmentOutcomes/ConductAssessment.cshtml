<script>
    function Cancel() {
        window.location.href = "@Url.Action("ApplicantRiskAssessment", "PropertyLeaseApplication")";
    }
    function clickSubmit() {
        debugger;
        swal({
            icon: "info",
            title: "Are you sure you want to submit this risk assessment?",
            buttons: [
                'No!',
                'Yes, I am sure!'
            ]

        }).then(function (isConfirm) {
            if (isConfirm) {
                debugger;
                var statusval = document.getElementById("ApprovalStatus").value;
                //var reject = document.getElementById("reject");
                //var accept = document.getElementById("Approve");
                if (statusval == "Rcs_Rejected_unaffordability" || statusval == "Rcs_Rejected_itc" || statusval == "Rcs_Rejected_documents") {
                    //alert('rej');
                    var RejectComment = document.getElementById("RejectComment").value;

                    if ((RejectComment == null || RejectComment == "")) {
                        swal("error", "Please enter the risk assessment outcome comment!", "warning");
                    } else {
                        document.getElementById("btnApproval").click();
                       /* WaitingListBusy();*/
                    }
                    //    document.getElementById("btnApproval").click();
                } else {
                 /*   alert('approval');*/
                    document.getElementById("btnApproval").click();
                  /*  WaitingListBusy();*/
                }
            }
        });
    }
    function checkdocs(id) {
        debugger;
        //alert('inside check docs');


        var statusval = document.getElementById("ApprovalStatus").value;
        if (statusval == "Rcs_Rejected_documents") {
            clickSubmit();
           
        } else if (statusval == "Rcs_Approval" || statusval == "Rcs_Rejected_unaffordability" || statusval == "Rcs_Rejected_itc") {
         
            $.getJSON("../PropertyLeaseApplication/CaptureDocChecker2?id=" + id,
                function (result) {
                    console.log(result);
                    if (result == "true") {
                        try {
                            clickSubmit();
                        }
                        catch (cat) {
                            swal("Error!", "Please upload required documents.", "error");
                        }
                    }
                    else {
                        swal("Error!", "Please upload required documents.", "error");
                    }
                });
           
        } else if (statusval == "r_re_allocate_application") {


            if (isLettingOfficerSelected()) {
                clickSubmit();
            }
            else {
                swal("Error!", "Please select letting officer .", "error");
            }
         
        
          
         
        }




    }
    function isLettingOfficerSelected() {
        var lettingOfficerDropdown = document.getElementById("LettingOfficer");

        // Check if the dropdown exists
        if (lettingOfficerDropdown) {
            // Check if a value is selected and it's not the default value
            return lettingOfficerDropdown.value !== "" && lettingOfficerDropdown.value !== "-- Allocate Officer --";
        }

        // Return false if the dropdown does not exist
        return false;
    }
    function makeFieldsNotRequired() {
        // Array of field names to make not required
        const fieldsToMakeNotRequired = [
            'ApplicationAllocatedProperties.SpaceUnitNumber',
            'ApplicationAllocatedProperties.SpaceUnitSize',
            'ApplicationAllocatedProperties.SolarReference',
            'ApplicationAllocatedProperties.MonthlyRentalAmount',
            'ApplicationAllocatedProperties.NumOfBeds',
            'ApplicationAllocatedProperties.RequiedDepositAmount',
            'ApplicationAllocatedProperties.StreetName',
            'ApplicationAllocatedProperties.Shower',
            'ApplicationAllocatedProperties.Township',
            'ApplicationAllocatedProperties.Postal',
            'ApplicationAllocatedProperties.OfferedComplexId',
            'ApplicationAllocatedProperties.HumanEHCOptionId',
            'ApplicationAllocatedProperties.LettingRequirements'
        ];

        // Loop through each field and set required attribute to false
        fieldsToMakeNotRequired.forEach(fieldName => {
            const field = document.querySelector(`[name='${fieldName}']`);
            if (field) {
                field.required = false;
            }
        });
    }
    function makeFieldsRequiredBasedOnStatus() {
        // Assume 'approved' status makes all fields required again
      
        // Array of field names to make required
        const fieldsToMakeRequired = [
           
            'ApplicationAllocatedProperties.OfferedComplexId',
            'ApplicationAllocatedProperties.HumanEHCOptionId',
         
        ];

        // Loop through each field and set required attribute based on status
        fieldsToMakeRequired.forEach(fieldName => {
            const field = document.querySelector(`[name='${fieldName}']`);
            if (field) {
                field.required = true;
            }
        });
    }
