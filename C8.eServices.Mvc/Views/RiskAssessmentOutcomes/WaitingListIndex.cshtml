@model IEnumerable<C8.eServices.Mvc.Models.PropertyLeaseWaitingList>

@{
    ViewBag.Title = "Housing Waiting List";
    Layout = "~/Views/Shared/RCS_Layout.cshtml";
}

<style>
    /* Queue Badge Styling */
    .queue-badge {
        font-size: 1.2em;
        font-weight: bold;
        padding: 5px 10px;
        border-radius: 50%;
        background-color: #eee;
        color: #333;
        width: 35px;
        height: 35px;
        display: inline-block;
        text-align: center;
        line-height: 25px;
    }

    /* The #1 Person gets a Green Badge */
    .queue-first {
        background-color: #28a745;
        color: white;
        box-shadow: 0 0 5px rgba(0,0,0,0.3);
    }

    .filter-bar {
        background-color: #f8f9fa;
        padding: 15px;
        border: 1px solid #ddd;
        border-radius: 5px;
        margin-bottom: 20px;
    }
</style>

<div class="container-fluid">
    <h2 class="text-center">Property Lease Waiting List</h2>

    <div class="filter-bar">
        <div class="row">
            @using (Html.BeginForm("WaitingListIndex", "RiskAssessmentOutcomes", FormMethod.Get, new { @class = "form-inline", style = "display:inline;" }))
            {
                <div class="col-md-3">
                    <label style="margin-right:10px;">Filter by Complex:</label>
                    @Html.DropDownList("complexId", ViewBag.Complexes as SelectList, "-- All Complexes --", new { @class = "form-control", onchange = "this.form.submit()" })
                </div>

                <div class="col-md-3">
                    <label style="margin-right:10px;">Filter by Typology:</label>
                    @Html.DropDownList("typologyId", ViewBag.Typologies as SelectList, "-- All Unit Types --", new { @class = "form-control", onchange = "this.form.submit()" })
                </div>

                <div class="col-md-2">
                    <a href="@Url.Action("WaitingListIndex", "RiskAssessmentOutcomes")" class="btn btn-default btn-sm" style="margin-top: 20px;">
                        <i class="fa fa-refresh"></i> Reset
                    </a>
                </div>
            } <div class="col-md-4 text-right">
                @using (Html.BeginForm("RunAutoAllocation", "RiskAssessmentOutcomes", FormMethod.Post, new { style = "display:inline;" }))
                {
                    @Html.AntiForgeryToken()

                    <button type="submit" class="btn btn-primary btn-sm" style="margin-top: 20px;"
                            onclick="return confirm('Ready to run Auto-Allocation?');">
                        <i class="fa fa-magic"></i> Run Auto-Allocate
                    </button>
                }
            </div>
        </div>
    </div>

    @* --- 3. LOG DISPLAY (Shows results after button click) --- *@
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            <strong>Success!</strong> @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            <strong>Error:</strong> @TempData["Error"]
        </div>
    }
    @if (TempData["AllocationLog"] != null)
    {
        <div class="panel panel-info">
            <div class="panel-heading">
                <h3 class="panel-title">Processing Log</h3>
            </div>
            <div class="panel-body" style="max-height: 200px; overflow-y: auto; background: #f9f9f9;">
                <pre>@TempData["AllocationLog"]</pre>
            </div>
        </div>
    }

    <div class="panel panel-success">
        <div class="panel-heading">
            <h3 class="panel-title">
                <i class="fa fa-users"></i> Current Queue
                <span class="pull-right badge">@Model.Count() Waiting</span>
            </h3>
        </div>
        <div class="panel-body">
            @if (!Model.Any())
            {
                <div class="alert alert-warning text-center">
                    No applicants found matching these criteria.
                </div>
            }
            else
            {
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th class="text-center"># Pos</th>
                            <th>Date Added</th>
                            <th>Applicant Name</th>
                            <th>Reference No</th>
                            <th>Preferred Complex</th>
                            <th>Typology</th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int position = 1; }
                        @foreach (var item in Model)
                        {
                            <tr class="@(position == 1 ? "success" : "")">
                                <td align="center" style="vertical-align:middle;">
                                    <span class="queue-badge @(position == 1 ? "queue-first" : "")">
                                        @position
                                    </span>
                                </td>

                                <td style="vertical-align:middle;">
                                    @item.DateAdded.ToString("yyyy-MM-dd HH:mm")
                                    <br />
                                    <small class="text-muted">(@((DateTime.Now - item.DateAdded).Days) days waiting)</small>
                                </td>

                                <td style="vertical-align:middle;">
                                    <strong>@item.PropertyLeaseApplication.FullName</strong>
                                </td>

                                <td style="vertical-align:middle;">
                                    @item.PropertyLeaseApplication.ApplicationReferenceNumber
                                </td>

                                <td style="vertical-align:middle;">
                                    @if (item.PreferredComplexArea != null)
                                    {
                                        @item.PreferredComplexArea.Name
                                    }
                                    else
                                    {
                                        <span class="text-muted">ID: @item.PreferredComplexId</span>
                                    }
                                </td>

                                <td style="vertical-align:middle;">
                                    @if (item.HumanEHCOption != null)
                                    {
                                        @item.HumanEHCOption.Name
                                    }
                                    else
                                    {
                                        <span class="text-muted">ID: @item.PreferredTypologyId</span>
                                    }
                                </td>

                                <td align="center" style="vertical-align:middle;">
                                    @if (item.QueueStatus == "Offered")
                                    {
                                        <span class="label label-info" style="font-size: 100%;">Offer Sent</span>
                                    }
                                    else if (position == 1)
                                    {
                                        <a href="@Url.Action("AllocateUnit", "Allocations", new { id = item.Id })" class="btn btn-success btn-sm">
                                            <i class="fa fa-key"></i> Manual Allocate
                                        </a>
                                    }
                                    else
                                    {
                                        <button class="btn btn-default btn-xs" disabled title="Queue order must be respected">Wait</button>
                                    }
                                </td>
                            </tr>
                            position++;
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>