@model C8.eServices.Mvc.ViewModels.CaptureViewModel
@using System.Text;
@using C8.eServices.Mvc.DataAccessLayer;
@using C8.eServices.Mvc.Keys
@{
    //ViewBag.Title = "Details";
    Layout = "~/Views/Shared/RCS_Layout.cshtml";
}
<head>
    <style>
        .swal-modal .swal-text {
            text-align: center;
        }

        .require::after {
            content: "*";
            font-weight: bold;
            color: red;
        }

        input[type="date"]::-webkit-calendar-picker-indicator {
            color: rgba(0, 0, 0, 0);
            opacity: 1;
            display: block;
            background: url('../Content/RcsStyles/calenderIcon.png') no-repeat;
            background-size: 20px 20px;
            width: 20px;
            height: 20px;
            border-width: thin;
            margin-left: 50px;
        }
    </style>
</head>
<script src="@Url.Content( "~/Scripts/moment.js" )"></script>
<div id="bankAccountPanel">
    <div class="panel panel-default">
        <div class="panel-heading">Evaluating Application</div>
        <div style="width: 90%;margin: 0 auto;">
            <br />
            <table id="FailureTable" class="table table-bordered table-hover table-striped panel panel-default display ">
                <thead>
                    <tr>
                        <th>
                            Reference Number
                        </th>
                        <th>
                            Applicant Type
                        </th>
                        <th>
                            Status
                        </th>
                        <th>
                            Captured Date
                        </th>
                        <th>
                            Customer Name
                        </th>
                        <th>
                            Action
                        </th>
                    </tr>
                </thead>
                <tbody>

                    <tr>

                        <td>
                            @Model.PropertyLeaseApplication.ApplicationReferenceNumber
                        </td>
                        <td>
                            @Model.PropertyLeaseApplication.PurchaserType.Name
                        </td>
                        <td>
                            @Model.PropertyLeaseApplication.Status.Name
                        </td>
                        <td>
                            @Model.PropertyLeaseApplication.CreatedDateTime
                        </td>
                        <td>
                            @Model.PropertyLeaseApplication.Customer.FullName
                        </td>
                        <td>
                            @Html.ActionLink("View", "Details", "PropertyLeaseApplication", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("refNo=" + Model.PropertyLeaseApplication.Id.ToString()), target = "_blank" }, new { @class = "btn btn-primary", @target = "_blank" })
                        </td>
                    </tr>

                </tbody>
            </table>



        </div>
        <br />

        <div class="panel-heading">Tenant Lease Details</div>
        <div style="width: 90%;margin: 0 auto;">
            <br />
            <table id="FailureTable2" class="table table-bordered table-hover table-striped panel panel-default display ">
                <thead>
                    <tr>
                        <th>
                            Lease Ref No.
                        </th>
                        <th>
                            Applicant Type
                        </th>
                        <th>
                            Status
                        </th>
                        <th>
                            Captured Date
                        </th>
                        <th>
                            Customer Name
                        </th>
                        <th>
                            Action
                        </th>
                    </tr>
                </thead>
                <tbody>

                    <tr>

                        <td>
                            @Model.LeaseDetails.LeaseReferenceNo
                        </td>
                        <td>
                            @if (Model.LeaseDetails.PurchaserType != null)
                            {
                                @Model.LeaseDetails.PurchaserType.Name
                            }
                        </td>
                        <td>
                            @Model.LeaseDetails.Status.Name
                        </td>
                        <td>
                            @Model.LeaseDetails.CreatedDateTime
                        </td>
                        <td>
                            @Model.LeaseDetails.FirstNames @Model.LeaseDetails.LastName
                        </td>
                        <td>
                            @Html.ActionLink("View", "ApplincantDetails", "leaseDetails", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("refNo=" + Model.LeaseDetails.Id.ToString()), target = "_blank" }, new { @class = "btn btn-primary", @target = "_blank" })
                        </td>
                    </tr>

                </tbody>
            </table>

            <br />

        </div>

        <br />
        <div style="width: 90%;margin: 0 auto;">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <div class="form-horizontal">
                    <div class="step-app">
                        <ul class="step-steps">

                            <li style="text-align:center;"><a href="#step3">Risk Assesment Response<span class=""></span></a></li>
                        </ul>

                    </div>
                    <div class="panel-group" id="instructions">
                        <div class="panel panel-default">

                            <div id="collapseInstructions" class="panel-collapse collapse in">
                                <div class="panel-body">
                                    @Html.HiddenFor(model => model.PropertyLeaseApplication.Id, new { htmlAttributes = new { @class = "form-control", @Style = "display:none;" } })
                                    @Html.HiddenFor(model => model.LeaseDetails.Id, new { htmlAttributes = new { @class = "form-control", @Style = "display:none;" } })
                                    <div class="form-group">


                                        @Html.LabelFor(model => model.RiskAssessmentOutcome.FirstName, "First Name", htmlAttributes: new { @class = "control-label col-md-2" })
                                        <div class="col-md-3">
                                            @Html.EditorFor(model => model.RiskAssessmentOutcome.FirstName, new { htmlAttributes = new { @class = "form-control", @disabled = "disabled" } })
                                            @Html.ValidationMessageFor(model => model.RiskAssessmentOutcome.FirstName, "", new { @class = "text-danger" })
                                        </div>

                                        @Html.LabelFor(model => model.RiskAssessmentOutcome.OfficialNumber, htmlAttributes: new { @class = "control-label col-md-2 require" })
                                        <div class="col-md-3">
                                            @Html.EditorFor(model => model.RiskAssessmentOutcome.OfficialNumber, new { htmlAttributes = new { @class = "form-control", @onkeypress = "return isNumber(event)", @required = "required" } })
                                            @Html.ValidationMessageFor(model => model.RiskAssessmentOutcome.OfficialNumber, "", new { @class = "text-danger" })
                                        </div>
                                    </div>

                                    <div class="form-group">
                                        @Html.LabelFor(model => model.RiskAssessmentOutcome.LastName, "Last Name", htmlAttributes: new { @class = "control-label col-md-2" })
                                        <div class="col-md-3">
                                            @Html.EditorFor(model => model.RiskAssessmentOutcome.LastName, new { htmlAttributes = new { @class = "form-control", @disabled = "disabled" } })
                                            @Html.ValidationMessageFor(model => model.RiskAssessmentOutcome.LastName, "", new { @class = "text-danger" })
                                        </div>
                                        @Html.LabelFor(model => model.RiskAssessmentOutcome.DateStamp, htmlAttributes: new { @class = "control-label col-md-2" })
                                    <div class="col-md-3">
                                        @*"Date"*@
                                        @Html.Editor("DateStamp", null, new { htmlAttributes = new { @class = " form-control", onchange = "ChangeDate()", @Name = "RiskAssessmentOutcome.DateStamp", @Id = "RiskAssessmentOutcome.DateStamp", @disabled = "disabled" } })
                                        @Html.ValidationMessageFor(model => model.RiskAssessmentOutcome.DateStamp, "", new { @class = "text-danger" })
                                    </div>

                                    </div>


                                    <div class="form-group">
                                        <div class="col-md-1"></div>
                                        @*@Html.Label("Outcome", htmlAttributes: new { @class = "control-label col-md-1" })*@
                                        @Html.Label("Outcome", htmlAttributes: new { @class = "control-label col-md-1 require" })
                                        <div class="col-md-2">
                                            @Html.DropDownList("ApprovalStatus", null, "-- Select Option --", htmlAttributes: new { @class = "form-control",@Id= "ApprovalStatus", @Name = "ApprovalStatusddl", @required = "required" })
                                            @Html.ValidationMessage("ApprovalStatus", "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.RiskAssessmentOutcome.Reason, "Comment", htmlAttributes: new { @class = "control-label col-md-2" })
                                        <div class="col-md-8">
                                            @Html.TextAreaFor(model => model.RiskAssessmentOutcome.Reason, new { @class = "form-control", @Id= "Comments" })
                                            @Html.ValidationMessageFor(model => model.RiskAssessmentOutcome.Reason, "", new { @class = "text-danger" })

                                        </div>
                                    </div>

                                    <div class="form-group">

                                        @Html.HiddenFor(model => model.PropertyLeaseApplication.Id)

                                    </div>

                                    <div class="panel-heading">Upload Risk Assessment Supporting Document</div>
                                    @Html.Partial("_DocumentsPartialConductUnitInspection", Model.DocumentsViewModel)

                                </div>

                                <div class="step-footer" align="left">
                                    @Html.EncodedActionLink("Cancel", "Index", "RCSApplication", new { id = 0 }, new { @class = "btn btn-outline-primary", @style = "display:none", @id = "Cancelbtn" })

                                </div>
                            </div>

                        </div>
                        <br />
                        <br />
                        <div class="step-footer" align="center">
                            <input type="button" value="Cancel" onclick="location.href='@Url.Action("ApplicantRiskAssessment", "PropertyLeaseApplication")'" name="btnApprovalStatus" class="button1" />
                            @*<button class="button1" value="Cancel" onclick="Cancel()">Cancel</button>*@
                            <input type="button" value="Submit" name="btnApproval" onclick="clickSubmit()" class="button1" />
                            <input type="submit" value="Submit" style="display:none;" hidden name="btnApprovalStatus" class="button1" id="btnApproval" />
                        </div>
                    </div>

                </div>
            }
        </div>
    </div>
</div>
@section Scripts{

    <script src="@Url.Content( "~/scripts/Datatables/jquery.dataTables.min.js" )"></script>
    <script src="@Url.Content( "~/scripts/Datatables/dataTables.bootstrap.js" )"></script>
    <script>
        function ChangeDate() {
            debugger;

            var Startdate = document.getElementById("RiskAssessmentOutcome.DateStamp").value;

        }
    </script>
    <script type="text/javascript">

        function loadAccounts() {
            //debugger;
            $('#FailureTable2').DataTable({
                "ajax": {
                    "url": "@Url.Action( "LoadDetails", "DepartmentsApprovals" )",
                    "type": "GET",
                    "datatype": "json",
                    "timeout": 60000
                },
                "columns": [

                    {
                        "data": "CreatedDateTime", "autoWidth": true,
                        "render": function (data) {
                            return convertDate(data);
                        }
                    },
                    {
                        "render": function (data) {
                            return "System";
                        }
                    },
                    { "data": "FailureReason", "autoWidth": true },
                    {
                        "data": "CapturedDate", "autoWidth": true,
                        "render": function (data) {
                            return convertDate(data);
                        }
                    },

                     { "data": "AssignedTo", "autoWidth": true }],
                "language": {
                    "emptyTable": "No Data.",
                },
                "Initcomplete": "",
                "destroy": true
            });
            $('#FailureTable').DataTable({
                "ajax": {
                    "url": "@Url.Action( "LoadDetails", "DepartmentsApprovals" )",
                    "type": "GET",
                    "datatype": "json",
                    "timeout": 60000
                },
                "columns": [

                    {
                        "data": "CreatedDateTime", "autoWidth": true,
                        "render": function (data) {
                            return convertDate(data);
                        }
                    },
                    {
                        "render": function (data) {
                            return "System";
                        }
                    },
                    { "data": "FailureReason", "autoWidth": true },
                    {
                        "data": "CapturedDate", "autoWidth": true,
                        "render": function (data) {
                            return convertDate(data);
                        }
                    },

                     { "data": "AssignedTo", "autoWidth": true }],
                "language": {
                    "emptyTable": "No Data.",
                },
                "Initcomplete": "",
                "destroy": true
            });
        }

        function convertDate(data) {
            try {
                var dtStart = new Date(parseInt(data.substr(6)));
                var dtStartWrapper = moment(dtStart);
                return dtStartWrapper.format("YYYY-MM-DD");
            }
            catch (ex) {
            }
        }

        $(function () {
            $('#RCSTable').DataTable();

        });

    </script>

}

