@model IEnumerable<C8.eServices.Mvc.Models.PropertyLeaseApplication>

@{
    ViewBag.Title = "CEO Inbox";
    Layout = "~/Views/Shared/RCS_Layout.cshtml";
}

<div class="panel panel-default">
    <div class="panel-heading">
        <h4 class="panel-title">
            CEO Inbox (Pending Final Approval)
        </h4>
    </div>
    <div class="panel-body">

        @* Display Success Messages (e.g., "Application Approved") *@
        @if (ViewBag.ConductRiskAssessmentSession != null)
        {
            <div class="alert alert-success alert-dismissible">
                <a href="#" class="close" data-dismiss="alert" aria-label="close">&times;</a>
                <strong>Success!</strong> @ViewBag.ConductRiskAssessmentSession
            </div>
        }

        @if (!Model.Any())
        {
            <div class="alert alert-info">
                No applications are currently awaiting CEO approval.
            </div>
        }
        else
        {
            <table class="table table-striped table-bordered table-hover" id="ceoTable">
                @* Using Green header to distinguish CEO level *@
                <thead class="bg-success" style="color:white;">
                    <tr>
                        <th>Reference No</th>
                        <th>Applicant Name</th>
                        <th>Preferred Complex</th>
                        <th>Unit Typology</th>
                        <th>Date Received</th>
                        <th class="text-center">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.ApplicationReferenceNumber)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Customer.FullName)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.PreferredComplexArea.Name)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.HumanEHCOptions.Name)
                            </td>
                            <td>
                                @if (item.CreatedDateTime.HasValue)
                                {
                                    @item.CreatedDateTime.Value.ToString("yyyy-MM-dd")
                                }
                            </td>
                            <td class="text-center">
                                @* SECURE LINK: Uses the 'Data' property we encrypted in the Controller *@
                                <a href="@Url.Action("RiskAssessmentCEO", "RiskAssessmentOutcomes", new { q = item.Data })" class="btn btn-sm btn-primary">
                                    <i class="fa fa-gavel"></i> Finalize
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<script>
    $(document).ready(function () {
        // Enable DataTables if available in your layout
        if ($.fn.DataTable) {
            $('#ceoTable').DataTable();
        }
    });
</script>