@model C8.eServices.Mvc.Models.TenantComplaint
@using C8.eServices.Mvc.Keys
@{
    ViewBag.Title = "Complaint Details";
    Layout = "~/Views/Shared/RCS_Layout.cshtml";
    var statusKey = Model.Status != null ? Model.Status.Key : "";
    var statusName = Model.Status != null ? Model.Status.Name : "Unknown";
    var categoryName = Model.ComplaintCategory != null ? Model.ComplaintCategory.Name : "N/A";
    var typeName = Model.ComplaintType != null ? Model.ComplaintType.Name : "N/A";
    var statusClass = statusKey == ComplaintStatusKeys.Resolved ? "status-resolved" : (statusKey == ComplaintStatusKeys.Referred ? "status-referred" : (statusKey == ComplaintStatusKeys.Unresolved ? "status-unresolved" : "status-awaiting"));
}
<head>
    <style>
        .status-badge { padding: 8px 15px; border-radius: 4px; font-weight: bold; }
        .status-awaiting { background-color: #f0ad4e; color: white; }
        .status-resolved { background-color: #5cb85c; color: white; }
        .status-referred { background-color: #337ab7; color: white; }
        .status-unresolved { background-color: #d9534f; color: white; }
    </style>
</head>
<div class="panel panel-default">
    <div class="panel-heading"><h4>Complaint - @Model.CaseReferenceNumber</h4></div>
    <div class="panel-body">
        <table class="table">
            <tr><td><strong>Status:</strong></td><td><span class="status-badge @statusClass">@statusName</span></td></tr>
            <tr><td><strong>Category:</strong></td><td>@categoryName</td></tr>
            <tr><td><strong>Type:</strong></td><td>@typeName</td></tr>
            <tr><td><strong>Description:</strong></td><td>@Model.DetailedDescription</td></tr>
        </table>
        <a href="@Url.Action("Index")" class="btn btn-default">Back</a>
        @if (User.IsInRole("CSO") && (statusKey == ComplaintStatusKeys.Submitted || statusKey == ComplaintStatusKeys.AwaitingAppointment))
        {
            <a href="@Url.Action("ScheduleAppointment", new { id = Model.Id })" class="btn btn-info">Schedule</a>
        }
        @if (User.IsInRole("CSO") && statusKey == ComplaintStatusKeys.AwaitingInvestigation)
        {
            <a href="@Url.Action("CaptureOutcome", new { id = Model.Id })" class="btn btn-success">Outcome</a>
        }
    </div>
</div>
