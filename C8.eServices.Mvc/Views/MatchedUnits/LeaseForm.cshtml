<script type="text/javascript">
    $("#savencon3").on("click", function () {

        var count = 0;


        if ($("#signature").val() == "" || $("#signature").val() == null) {
            count = count + 1;
        }

        if (count == 0) {

            $('#ticksection3').removeAttr("hidden");
            $('#exclamationmark3').attr("hidden", "hidden");

            return SaveProgress();

        }
        else {
            $('#exclamationmark3').removeAttr("hidden");
            $('#ticksection3').attr("hidden", "hidden");

            Swal.fire({
                icon: 'info',
                title: 'Please Note',
                text: 'Please make sure that all mandatory fields for step 3 is completed!',
                showCancelButton: false,
            });
            var $active = $('.wizard .nav-tabs li.active');
            $active.next().removeClass('disabled');
            nextTab($active);
            //swal("Please make sure that all mandatory fields for step 3 is completed!");

        }
    });

    function SaveProgress(last) {

        appealsSwitchPreloaderStart();
        $.ajax({
        url: '@Url.Action("saveProgress", "AgricultureHoldings")',
        data: $('#agriHoldings').serialize(),
        type: 'POST',
        dataType: 'json',
        success: function (result) {

        document.getElementById("RefNo").value = result.refNum;
        document.getElementById("ApplicationID").value = result.id;
            appealsSwitchPreloaderEnd();

            //swal("Success!", "Progress Saved!");
            if (last) {
                var checkform = ValidateForm();
                if (checkform) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Success...',
                        html: "Form has been submitted!<br/>Please wait for your reference number!",
                        showCancelButton: false,
                    }).then((result) => {
                        if (result.isConfirmed) {
                            appealsSwitchPreloaderStart();
                        }
                    });
                }
                else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error...',
                        html: "Please fill in all mandatory fields!",
                        showCancelButton: false,
                    });
                }
                //swal("Success!", "Please wait for your reference number!");
            }
            else {
                Swal.fire({
                    icon: 'success',
                    title: 'Success...',
                    text: "Progress Saved",
                    showCancelButton: false,
                });
            }

            var $active = $('.wizard .nav-tabs li.active');
            $active.next().removeClass('disabled');
            nextTab($active);

        },
        error: function () {
            appealsSwitchPreloaderEnd();
            Swal.fire({
                icon: 'error',
                title: 'Failed...',
                text: "Progress Not Saved!",
                showCancelButton: false,
            });
        /*swal("Fail!", "Progress Not Saved!");*/
        }
        });


        }

</script>