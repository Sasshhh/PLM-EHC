@model C8.eServices.Mvc.Models.LeaseForm

@{
    ViewBag.Title = "Lease form";
    Layout = "~/Views/Shared/RCS_Layout.cshtml";
}

<style>
    /*  h4 {
        font-size: 1.2em;
    }*/
    @@media only screen and (max-width: 1000px) {

        .buttonIcon {
            font-size: 2.5rem !important;
        }

        .chkboxmargin {
            margin-left: 30px;
        }

        .cards tbody tr {
            float: left;
            /*width: 20rem;*/
            width: 90%;
            margin: 0.5rem;
            border: 0.0625rem solid rgba(0,0,0,.125);
            border-radius: .25rem;
            box-shadow: 0.25rem 0.25rem 0.5rem rgba(0,0,0,0.25);
        }

        .cards thead tr {
            float: left;
            /*width: 25rem;*/
            width: 90%;
            margin: 0.5rem;
            border: 0.0625rem solid rgba(0,0,0,.125);
            border-radius: .25rem;
            box-shadow: 0.25rem 0.25rem 0.5rem rgba(0,0,0,0.25);
        }


        .cards tbody td {
            display: block;
            word-wrap: break-word;
        }

        .cards thead th {
            display: none;
        }

        .table tbody label {
            display: block;
        }

        .cards tbody label {
            display: inline;
            position: relative;
            font-size: 85%;
            top: -0.5rem;
            color: #808080;
            min-width: 4rem;
            margin-left: 0;
            margin-right: 1rem;
            text-align: left;
        }

        tr.selected label {
            color: #404040;
        }

        .table .fa {
            font-size: 2.5rem;
            text-align: center;
        }

        .cards .fa {
            font-size: 7.5rem;
        }
    }

    @@media only screen and (max-width: 1000px) {
        .step-app > .step-steps {
            display: inline-block;
            padding: 1px;
            color: white;
            background-color: #848484;
            text-decoration: none;
            border-right: 1px solid #fff;
            word-wrap: break-word;
            width: 100%;
        }
    }

    .button1 {
        font-size: 13px;
    }

    .required:before {
        content: '*';
        color: red;
    }

    input[type='date'] {
        position: relative;
    }

    ::-webkit-datetime-edit, ::-webkit-clear-button, ::-webkit-calendar-picker-indicator {
        position: absolute;
    }

    ::-webkit-clear-button {
        right: 2.5em;
    }

    ::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    ::-webkit-calendar-picker-indicator {
        right: 0;
        padding: .539em .34em;
    }

    input[type="date"]::-webkit-calendar-picker-indicator {
        color: rgba(0, 0, 0, 0);
        opacity: 1;
        display: block;
        background: url('../Content/RcsStyles/calenderIcon.png') no-repeat;
        background-size: 20px 20px;
        width: 20px;
        height: 20px;
        border-width: thin;
        margin-left: 50px;
    }

    body {
        font-family: Arial;
    }

    .number {
        background-color: transparent !important;
        border: 1.5px solid white;
        border-radius: 50px;
        color: white !important;
    }

    .step-app > .step-steps > li > a {
        display: block;
        padding: 10px;
        color: white;
        background-color: #848484;
        text-decoration: none;
        border-right: 1px solid #fff;
    }

    legend {
        display: block;
        width: 100%;
        padding: 0;
        margin-bottom: 20px;
        font-size: 25px;
        line-height: inherit;
        color: #333;
        border: 0;
        background-color: aliceblue;
        border-bottom: 1px solid #00d0ff;
    }

    .error {
        color: tomato;
    }
</style>
<div class="panel-group" id="instructions">
    <div class="panel panel-default">
        <div class="panel-heading">
            <h4 class="panel-title">
                <a data-toggle="collapse" data-parent="#accordion" href="#collapseInstructions">
                    <span>Instructions</span>
                </a>
            </h4>
        </div>
        <div id="collapseInstructions" class="panel-collapse collapse in">
            <div class="panel-body">
                <p>
                    @Html.Raw(ViewBag.CaptureInstructions)
                </p>
            </div>
        </div>
    </div>
</div>
