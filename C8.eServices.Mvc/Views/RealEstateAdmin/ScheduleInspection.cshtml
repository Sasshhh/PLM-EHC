@model C8.eServices.Mvc.Models.RE_Application
@{
    ViewBag.Title = "Schedule Property Inspection";
    Layout = "~/Views/Shared/RCS_Layout.cshtml";
    var types = (IEnumerable<SelectListItem>)ViewBag.TypeList;
}

<style>
    :root {
        --re-gold: #c59b27;
        --re-gold-hover: #a37f1c;
        --re-border-color: #e7e5e4;
        --re-slate-dark: #2e2a27;
        --re-slate-black: #1c1917;
    }

    .admin-container {
        padding: 30px 15px;
        font-family: 'Inter', sans-serif;
    }

    .admin-header-card {
        background: linear-gradient(135deg, var(--re-slate-dark) 0%, var(--re-slate-black) 100%);
        color: #ffffff;
        border-radius: 12px;
        padding: 25px 30px;
        margin-bottom: 25px;
        border-left: 5px solid var(--re-gold);
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .info-card {
        background: #ffffff;
        border: 1px solid var(--re-border-color);
        border-radius: 12px;
        padding: 20px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    }

    .info-card h4 {
        margin-top: 0;
        margin-bottom: 15px;
        font-weight: 700;
        color: var(--re-slate-black);
        border-bottom: 2px solid var(--re-gold);
        padding-bottom: 6px;
        font-size: 15px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .info-item {
        display: flex;
        justify-content: space-between;
        padding: 8px 0;
        border-bottom: 1px dashed #f1f5f9;
        font-size: 13px;
    }

    .info-item:last-child {
        border-bottom: none;
    }

    .info-label {
        font-weight: 600;
        color: #64748b;
    }

    .info-value {
        color: #1e293b;
        font-weight: 500;
        text-align: right;
    }

    .form-card {
        background: #ffffff;
        border: 1px solid var(--re-border-color);
        border-radius: 12px;
        padding: 24px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    }

    .btn-re-gold {
        background-color: var(--re-gold);
        color: #ffffff;
        border: 1px solid var(--re-gold);
        padding: 10px 24px;
        border-radius: 6px;
        font-weight: 600;
        cursor: pointer;
        font-size: 14px;
    }

    .btn-re-gold:hover {
        background-color: var(--re-gold-hover);
        border-color: var(--re-gold-hover);
    }

    .btn-cancel {
        background-color: transparent;
        border: 1px solid #cbd5e1;
        color: #475569;
        text-decoration: none;
        padding: 10px 24px;
        border-radius: 6px;
        font-weight: 600;
        font-size: 14px;
        display: inline-block;
    }

    .btn-cancel:hover {
        background-color: #f1f5f9;
        color: #1e293b;
    }
</style>

<div class="admin-container">
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger" style="border-radius: 8px; border-left: 4px solid #dc2626;">
            <i class="fa fa-exclamation-circle"></i> @TempData["ErrorMessage"]
        </div>
    }

    <div class="admin-header-card">
        <h1 style="margin:0 0 5px 0; font-size:24px; font-weight:700;">Schedule Property Inspection</h1>
        <p style="margin:0; font-size:14px; color:#cbd5e1;">Select an inspection slot for reference @Model.ApplicationReferenceNumber.</p>
    </div>

    <div class="info-grid">
        <div class="info-card">
            <h4>Application Details</h4>
            <div class="info-item">
                <span class="info-label">Reference Number:</span>
                <span class="info-value" style="font-weight:700;">@Model.ApplicationReferenceNumber</span>
            </div>
            <div class="info-item">
                <span class="info-label">Applicant Name:</span>
                <span class="info-value">@(Model.Customer != null ? Model.Customer.FullName : "N/A")</span>
            </div>
            <div class="info-item">
                <span class="info-label">Selected Premises:</span>
                <span class="info-value">@(Model.SelectedFacility != null ? Model.SelectedFacility.Name : "N/A")</span>
            </div>
        </div>

        <div class="info-card">
            <h4>Premises Requested</h4>
            <div class="info-item">
                <span class="info-label">Property Address:</span>
                <span class="info-value">@Model.PropertyAddress</span>
            </div>
            <div class="info-item">
                <span class="info-label">Purpose of Lease:</span>
                <span class="info-value">@Model.PurposeOfLease</span>
            </div>
            <div class="info-item">
                <span class="info-label">Unit Code:</span>
                <span class="info-value">@(Model.SelectedFacilityUnit != null ? Model.SelectedFacilityUnit.UnitType : "N/A")</span>
            </div>
        </div>
    </div>

    <div class="form-card">
        <h4 style="margin-top:0; margin-bottom: 20px; font-weight: 700; font-size:16px; border-bottom: 2px solid var(--re-gold); padding-bottom: 8px;">Inspection Slot Details</h4>

        @using (Html.BeginForm("ScheduleInspection", "RealEstateAdmin", new { id = Model.Id }, FormMethod.Post, new { id = "scheduleForm" }))
        {
            @Html.AntiForgeryToken()

            <div class="row">
                <div class="col-md-4 form-group">
                    <label style="font-weight:600; color:#475569;">Inspection Type *</label>
                    @Html.DropDownList("type", types, "-- Select Type --", new { @class = "form-control", required = "required", id = "ddlType" })
                </div>

                <div class="col-md-4 form-group">
                    <label style="font-weight:600; color:#475569;">Scheduled Date *</label>
                    <input type="date" name="date" class="form-control" required="required" id="txtDate" value="@(Model.InspectionDate.HasValue ? Model.InspectionDate.Value.ToString("yyyy-MM-dd") : "")" />
                </div>

                <div class="col-md-4 form-group">
                    <label style="font-weight:600; color:#475569;">Scheduled Time *</label>
                    <input type="text" name="time" class="form-control" required="required" placeholder="e.g. 10:00 - 11:30" id="txtTime" value="@Model.InspectionTime" />
                </div>
            </div>

            <div style="margin-top: 25px; display:flex; gap:12px;">
                <button type="button" class="btn-re-gold" id="btn-submit-schedule" onclick="validateAndSubmit()">
                    <i class="fa fa-calendar-check-o"></i> Save Inspection Schedule
                </button>
                <a href="@Url.Action("InspectionSchedules", "RealEstateAdmin")" class="btn-cancel">
                    Cancel / Back
                </a>
            </div>
        }
    </div>
</div>

<!-- Custom Confirmation Modal -->
<div class="modal fade" id="confirmModal" tabindex="-1" role="dialog" aria-labelledby="confirmModalLabel" aria-hidden="true" style="margin-top: 10%;">
    <div class="modal-dialog" role="document">
        <div class="modal-content" style="border-radius: 12px; border: 2px solid var(--re-gold);">
            <div class="modal-header" style="background: linear-gradient(135deg, var(--re-slate-dark) 0%, var(--re-slate-black) 100%); color:#ffffff; border-bottom: 2px solid var(--re-gold);">
                <button type="button" class="close" data-dismiss="modal" style="color:white; opacity:0.8;">&times;</button>
                <h4 class="modal-title" id="confirmModalLabel" style="font-weight: 700;">Confirm Inspection Slot</h4>
            </div>
            <div class="modal-body" style="padding: 20px; font-size:15px; font-weight:500;">
                <p>Are you sure you want to schedule this inspection slot for the applicant?</p>
            </div>
            <div class="modal-footer" style="padding:15px 20px; display:flex; justify-content:flex-end; gap:10px;">
                <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="submitConfirmed()" style="background-color: var(--re-gold); border-color: var(--re-gold); font-weight:600;">Yes, Schedule</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function validateAndSubmit() {
            let type = $('#ddlType').val();
            let date = $('#txtDate').val();
            let time = $('#txtTime').val();

            if (!type || type === '') {
                alert('Inspection type is required.');
                return;
            }

            if (!date || date === '') {
                alert('Scheduled date is required.');
                return;
            }

            if (!time || time.trim() === '') {
                alert('Scheduled time slot is required.');
                return;
            }

            $('#confirmModal').modal('show');
        }

        function submitConfirmed() {
            $('#confirmModal').modal('hide');
            $('#scheduleForm').submit();
        }
    </script>
}
