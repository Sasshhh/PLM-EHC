@model C8.eServices.Mvc.Models.RE_Application
@{
    ViewBag.Title = "Capture Departmental Comments";
    Layout = "~/Views/Shared/RCS_Layout.cshtml";
    var departments = (IEnumerable<SelectListItem>)ViewBag.DepartmentList;
    var outcomes = (IEnumerable<SelectListItem>)ViewBag.OutcomeList;
}

<style>
    :root {
        --re-gold: #c59b27;
        --re-gold-hover: #a37f1c;
        --re-border-color: #e7e5e4;
        --re-slate-dark: #2e2a27;
        --re-slate-black: #1c1917;
    }

    .admin-container {
        padding: 30px 15px;
        font-family: 'Inter', sans-serif;
    }

    .admin-header-card {
        background: linear-gradient(135deg, var(--re-slate-dark) 0%, var(--re-slate-black) 100%);
        color: #ffffff;
        border-radius: 12px;
        padding: 25px 30px;
        margin-bottom: 25px;
        border-left: 5px solid var(--re-gold);
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .info-card {
        background: #ffffff;
        border: 1px solid var(--re-border-color);
        border-radius: 12px;
        padding: 20px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    }

    .info-card h4 {
        margin-top: 0;
        margin-bottom: 15px;
        font-weight: 700;
        color: var(--re-slate-black);
        border-bottom: 2px solid var(--re-gold);
        padding-bottom: 6px;
        font-size: 15px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .info-item {
        display: flex;
        justify-content: space-between;
        padding: 8px 0;
        border-bottom: 1px dashed #f1f5f9;
        font-size: 13px;
    }

    .info-item:last-child {
        border-bottom: none;
    }

    .info-label {
        font-weight: 600;
        color: #64748b;
    }

    .info-value {
        color: #1e293b;
        font-weight: 500;
        text-align: right;
    }

    .form-card {
        background: #ffffff;
        border: 1px solid var(--re-border-color);
        border-radius: 12px;
        padding: 24px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    }

    .btn-re-gold {
        background-color: var(--re-gold);
        color: #ffffff;
        border: 1px solid var(--re-gold);
        padding: 10px 24px;
        border-radius: 6px;
        font-weight: 600;
        cursor: pointer;
        font-size: 14px;
    }

    .btn-re-gold:hover {
        background-color: var(--re-gold-hover);
        border-color: var(--re-gold-hover);
    }

    .btn-cancel {
        background-color: transparent;
        border: 1px solid #cbd5e1;
        color: #475569;
        text-decoration: none;
        padding: 10px 24px;
        border-radius: 6px;
        font-weight: 600;
        font-size: 14px;
        display: inline-block;
    }

    .btn-cancel:hover {
        background-color: #f1f5f9;
        color: #1e293b;
    }
</style>

<div class="admin-container">
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger" style="border-radius: 8px; border-left: 4px solid #dc2626;">
            <i class="fa fa-exclamation-circle"></i> @TempData["ErrorMessage"]
        </div>
    }

    <div class="admin-header-card" style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:15px;">
        <div>
            <h1 style="margin:0 0 5px 0; font-size:24px; font-weight:700;">Capture Departmental Review Comments</h1>
            <p style="margin:0 0 5px 0; font-size:14px; color:#cbd5e1;">Review details and capture official departmental comments for reference @Model.ApplicationReferenceNumber.</p>
            <span class="badge" style="background-color: var(--re-gold); color: #ffffff; font-weight: 600; padding: 5px 10px; border-radius: 4px; font-size: 12px; display: inline-block;">
                <i class="fa fa-user"></i> Assigned Representative: @ViewBag.AssignedRepresentative
            </span>
        </div>
        <button type="button" class="btn btn-primary" data-toggle="modal" data-target="#capturedDetailsModal" style="background-color:var(--re-gold); border-color:var(--re-gold); font-weight:600;">
            <i class="fa fa-list-alt"></i> View Full Application Details
        </button>
    </div>

    <div class="info-grid">
        <div class="info-card">
            <h4>Application Details</h4>
            <div class="info-item">
                <span class="info-label">Reference Number:</span>
                <span class="info-value" style="font-weight:700;">@Model.ApplicationReferenceNumber</span>
            </div>
            <div class="info-item">
                <span class="info-label">Applicant Name:</span>
                <span class="info-value">@(Model.Customer != null ? Model.Customer.FullName : "N/A")</span>
            </div>
            <div class="info-item">
                <span class="info-label">Applicant Type:</span>
                <span class="info-value">@Model.ApplicantType</span>
            </div>
        </div>

        <div class="info-card">
            <h4>Premises Requested</h4>
            <div class="info-item">
                <span class="info-label">Property Address:</span>
                <span class="info-value">@Model.PropertyAddress</span>
            </div>
            <div class="info-item">
                <span class="info-label">Purpose of Lease:</span>
                <span class="info-value">@Model.PurposeOfLease</span>
            </div>
            <div class="info-item">
                <span class="info-label">Calculated Rental:</span>
                <span class="info-value" style="color:var(--re-gold); font-weight:700;">R @string.Format("{0:N2}", Model.CalculatedMonthlyRental) / month</span>
            </div>
        </div>
    </div>

    <div class="info-grid" style="margin-bottom: 25px;">
        <!-- Credit Review Details -->
        <div class="info-card">
            <h4>Risk Assessment & Credit Review</h4>
            <div class="info-item">
                <span class="info-label">Credit Bureau Result:</span>
                <span class="info-value" style="font-weight:600;">@Model.CreditBureauResult</span>
            </div>
            <div class="info-item">
                <span class="info-label">Deeds Registry Search:</span>
                <span class="info-value">@Model.DeedsResult</span>
            </div>
            <div class="info-item">
                <span class="info-label">Home Affairs status:</span>
                <span class="info-value">@Model.HomeAffairsResult</span>
            </div>
            <div class="info-item">
                <span class="info-label">SARS / CIPC verification:</span>
                <span class="info-value">@Model.CipcResult</span>
            </div>
            <div class="info-item">
                <span class="info-label">SASSA status:</span>
                <span class="info-value">@Model.SassaResult</span>
            </div>
            <div class="info-item">
                <span class="info-label">Risk Recommendation:</span>
                <span class="info-value" style="font-weight:700; color:@(Model.RiskAssessmentRecommendation == "Recommended" ? "#16a34a" : "#dc2626");">@Model.RiskAssessmentRecommendation</span>
            </div>
            <div class="info-item" style="flex-direction:column; align-items:flex-start;">
                <span class="info-label" style="margin-bottom:4px;">Risk Assessment Notes:</span>
                <span class="info-value" style="text-align:left; color:#475569; font-size:12px; font-style:italic;">@Model.RiskAssessmentReason</span>
            </div>
        </div>

        <!-- Uploaded Documents Details -->
        <div class="info-card">
            <h4>Applicant Uploaded Documents</h4>
            @{
                var docs = (IEnumerable<C8.eServices.Mvc.Models.Document>)ViewBag.Documents;
            }
            @if (docs == null || !docs.Any())
            {
                <p style="color:#64748b; font-style:italic; font-size:13px; margin: 15px 0;">No documents uploaded for this application.</p>
            }
            else
            {
                <div style="max-height: 250px; overflow-y: auto; padding-right:5px;">
                    @foreach (var d in docs)
                    {
                        <div class="info-item" style="align-items:center; padding: 10px 0;">
                            <span class="info-label" style="text-align:left; font-size:12px; max-width:60%;">
                                <i class="fa fa-file-pdf-o" style="color:#ef4444; margin-right:6px;"></i> @d.DocumentName
                            </span>
                            <span class="info-value">
                                <a href="@Url.Action("GetDocument", "File", new { fileId = d.FileId })" target="_blank" class="btn btn-xs btn-default" style="font-weight:600; font-size:11px;">
                                    <i class="fa fa-download"></i> View File
                                </a>
                            </span>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <!-- Application Process Audit Trail & History Log -->
    <div class="info-card" style="margin-bottom: 25px;">
        <h4 style="border-bottom: 2px solid var(--re-gold); padding-bottom: 6px; margin-bottom: 15px;">Application History Log & Audit Trail</h4>
        @{
            var logs = (IEnumerable<C8.eServices.Mvc.Models.PLMApplicationHistortyLog>)ViewBag.HistoryLogs;
        }
        @if (logs == null || !logs.Any())
        {
            <p style="color:#64748b; font-style:italic; font-size:13px; margin: 15px 0;">No history logs recorded for this application.</p>
        }
        else
        {
            <div style="max-height: 250px; overflow-y: auto; padding-right:5px;">
                <table class="table table-striped table-hover" style="font-size: 12px; margin-bottom: 0;">
                    <thead>
                        <tr style="background-color: #f8fafc;">
                            <th style="width: 25%; font-weight:700; color:var(--re-slate-black); text-align:left;">Date / Time</th>
                            <th style="width: 75%; font-weight:700; color:var(--re-slate-black); text-align:left;">Action Description & Audit Trail Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in logs)
                        {
                            <tr>
                                <td style="color:#64748b; font-weight: 500; text-align:left;">@(log.CreatedDateTime.HasValue ? log.CreatedDateTime.Value.ToString("yyyy-MM-dd HH:mm:ss") : "")</td>
                                <td style="color:#334155; font-weight: 600; text-align:left;">@log.AuditAction</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <div class="form-card">
        <h4 style="margin-top:0; margin-bottom: 20px; font-weight: 700; font-size:16px; border-bottom: 2px solid var(--re-gold); padding-bottom: 8px;">Comment Details</h4>

        @using (Html.BeginForm("CaptureDepartmentalComment", "RealEstateAdmin", new { id = Model.Id }, FormMethod.Post, new { enctype = "multipart/form-data", id = "commentForm" }))
        {
            @Html.AntiForgeryToken()

            <div class="row">
                @if (ViewBag.AssignedDepartment != null)
                {
                    <div class="col-md-6 form-group">
                        <label style="font-weight:600; color:#475569;">Reviewing Department *</label>
                        <input type="text" class="form-control" value="@ViewBag.AssignedDepartment.DepartmentName" disabled="disabled" style="background-color: #f1f5f9; cursor: not-allowed;" />
                        <input type="hidden" name="departmentName" value="@ViewBag.AssignedDepartment.DepartmentName" />
                    </div>

                    <div class="col-md-6 form-group">
                        <label style="font-weight:600; color:#475569;">Representative/Official Name *</label>
                        <input type="text" class="form-control" value="@ViewBag.RepresentativeName" disabled="disabled" style="background-color: #f1f5f9; cursor: not-allowed;" />
                        <input type="hidden" name="representativeName" value="@ViewBag.RepresentativeName" />
                    </div>
                }
                else
                {
                    <div class="col-md-6 form-group">
                        <label style="font-weight:600; color:#475569;">Reviewing Department *</label>
                        @Html.DropDownList("departmentName", departments, "-- Select Department --", new { @class = "form-control", required = "required" })
                    </div>

                    <div class="col-md-6 form-group">
                        <label style="font-weight:600; color:#475569;">Representative/Official Name *</label>
                        @Html.TextBox("representativeName", "", new { @class = "form-control", required = "required", placeholder = "Enter your full name" })
                    </div>
                }
            </div>

            <div class="form-group" style="margin-top: 15px;">
                <label style="font-weight:600; color:#475569;">Review Outcome *</label>
                @Html.DropDownList("outcome", outcomes, "-- Select Outcome --", new { @class = "form-control", required = "required", id = "ddlOutcome" })
            </div>

            <div class="form-group" style="margin-top: 15px;">
                <label style="font-weight:600; color:#475569;">Comments / Feedback Details</label>
                @Html.TextArea("comments", "", new { @class = "form-control", rows = "5", placeholder = "Capture details of comments, and outline specific conditions if outcome is Supported with Conditions...", id = "txtComments" })
                <small class="text-muted" id="commentHelp" style="display:none; color:#dc2626; font-weight:600; margin-top:4px;">* Comments are mandatory for outcomes other than Supported.</small>
            </div>

            <div class="form-group" style="margin-top: 15px; background-color:#fafaf9; border: 1px dashed var(--re-border-color); border-radius:8px; padding:15px;">
                <label style="font-weight:600; color:#475569;">Upload Supporting Document (Optional)</label>
                <input type="file" name="supportingFile" class="form-control-file" />
                <span class="text-muted" style="font-size:11px;">Max size 5MB. PDF, JPG, PNG formats.</span>
            </div>

            <div style="margin-top: 25px; display:flex; gap:12px;">
                <button type="button" class="btn-re-gold" id="btn-submit-comment" onclick="validateAndSubmit()">
                    <i class="fa fa-save"></i> Submit Comment
                </button>
                <a href="@Url.Action("DepartmentalQueue", "RealEstateAdmin")" class="btn-cancel">
                    Cancel / Back
                </a>
            </div>
        }
    </div>
</div>

<!-- Custom Confirmation Modal -->
<div class="modal fade" id="confirmModal" tabindex="-1" role="dialog" aria-labelledby="confirmModalLabel" aria-hidden="true" style="margin-top: 10%;">
    <div class="modal-dialog" role="document">
        <div class="modal-content" style="border-radius: 12px; border: 2px solid var(--re-gold);">
            <div class="modal-header" style="background: linear-gradient(135deg, var(--re-slate-dark) 0%, var(--re-slate-black) 100%); color:#ffffff; border-bottom: 2px solid var(--re-gold);">
                <button type="button" class="close" data-dismiss="modal" style="color:white; opacity:0.8;">&times;</button>
                <h4 class="modal-title" id="confirmModalLabel" style="font-weight: 700;">Confirm Comment Submission</h4>
            </div>
            <div class="modal-body" style="padding: 20px; font-size:15px; font-weight:500;">
                <p>Are you sure you want to submit the following departmental review?</p>
            </div>
            <div class="modal-footer" style="padding:15px 20px; display:flex; justify-content:flex-end; gap:10px;">
                <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="submitConfirmed()" style="background-color: var(--re-gold); border-color: var(--re-gold); font-weight:600;">Yes, I am sure</button>
            </div>
        </div>
    </div>
</div>

<!-- Full Application Details Modal -->
<div class="modal fade" id="capturedDetailsModal" tabindex="-1" role="dialog" aria-labelledby="capturedDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content" style="border-radius: 12px; border: 2px solid var(--re-gold);">
            <div class="modal-header" style="background: linear-gradient(135deg, var(--re-slate-dark) 0%, var(--re-slate-black) 100%); color:#ffffff; border-bottom: 2px solid var(--re-gold); border-top-left-radius: 10px; border-top-right-radius: 10px;">
                <button type="button" class="close" data-dismiss="modal" style="color:white; opacity:0.8;">&times;</button>
                <h4 class="modal-title" id="capturedDetailsModalLabel" style="font-weight: 700;">Captured Application Details: @Model.ApplicationReferenceNumber</h4>
            </div>
            <div class="modal-body" style="padding: 25px; max-height:70vh; overflow-y:auto; font-family:'Inter', sans-serif;">
                
                <!-- Section 1: Entity Details -->
                <div style="margin-bottom:20px; border-bottom:1px solid #e2e8f0; padding-bottom:10px;">
                    <h5 style="color:var(--re-gold); font-weight:700; text-transform:uppercase; margin-bottom:15px; font-size:14px;"><i class="fa fa-user"></i> Applicant & Entity Profile</h5>
                    <div class="row" style="font-size:13px; line-height:2.0;">
                        <div class="col-md-6">
                            <strong>Applicant Type:</strong> @Model.ApplicantType<br />
                            <strong>Entity/Business Name:</strong> @(string.IsNullOrEmpty(Model.EntityName) ? "N/A" : Model.EntityName)<br />
                            <strong>Company Registration Number:</strong> @(string.IsNullOrEmpty(Model.CompanyRegistrationNumber) ? "N/A" : Model.CompanyRegistrationNumber)<br />
                            <strong>VAT Registration Number:</strong> @(string.IsNullOrEmpty(Model.VatRegistrationNumber) ? "N/A" : Model.VatRegistrationNumber)<br />
                            <strong>SARS Tax Reference Number:</strong> @(string.IsNullOrEmpty(Model.TaxReferenceNumber) ? "N/A" : Model.TaxReferenceNumber)
                        </div>
                        <div class="col-md-6">
                            <strong>Authorized Representative:</strong> @(string.IsNullOrEmpty(Model.AuthorizedRepresentativeName) ? "N/A" : Model.AuthorizedRepresentativeName) (@(string.IsNullOrEmpty(Model.AuthorizedRepresentativeCapacity) ? "N/A" : Model.AuthorizedRepresentativeCapacity))<br />
                            <strong>Registered Address:</strong> @(string.IsNullOrEmpty(Model.EntityRegisteredAddress) ? "N/A" : Model.EntityRegisteredAddress)<br />
                            <strong>Postal Code:</strong> @(string.IsNullOrEmpty(Model.EntityRegisteredPostalCode) ? "N/A" : Model.EntityRegisteredPostalCode)<br />
                            <strong>Email Address:</strong> @(string.IsNullOrEmpty(Model.EntityEmail) ? "N/A" : Model.EntityEmail)<br />
                            <strong>Mobile Number:</strong> @(string.IsNullOrEmpty(Model.EntityMobile) ? "N/A" : Model.EntityMobile)
                        </div>
                    </div>
                </div>

                <!-- Section 2: Premises Details -->
                <div style="margin-bottom:20px; border-bottom:1px solid #e2e8f0; padding-bottom:10px;">
                    <h5 style="color:var(--re-gold); font-weight:700; text-transform:uppercase; margin-bottom:15px; font-size:14px;"><i class="fa fa-building"></i> Premises & Space Specifications</h5>
                    <div class="row" style="font-size:13px; line-height:2.0;">
                        <div class="col-md-6">
                            <strong>Purpose of Lease:</strong> @Model.PurposeOfLease<br />
                            <strong>Customer Care Centre (CCC):</strong> @(Model.CCC != null ? Model.CCC.CCCName : "N/A")<br />
                            <strong>Erf / Farm Number:</strong> @(string.IsNullOrEmpty(Model.ErfFarmNumber) ? "N/A" : Model.ErfFarmNumber)<br />
                            <strong>Property Address:</strong> @(string.IsNullOrEmpty(Model.PropertyAddress) ? "N/A" : Model.PropertyAddress)<br />
                            <strong>Township / Suburb / Farm Name:</strong> @(string.IsNullOrEmpty(Model.TownshipSuburbFarmName) ? "N/A" : Model.TownshipSuburbFarmName)
                        </div>
                        <div class="col-md-6">
                            <strong>Property Postal Code:</strong> @(string.IsNullOrEmpty(Model.PropertyPostalCode) ? "N/A" : Model.PropertyPostalCode)<br />
                            <strong>Letting Facility / Site:</strong> @(Model.SelectedFacility != null ? Model.SelectedFacility.Name : "N/A")<br />
                            <strong>Unit Type & Spec:</strong> @(Model.SelectedFacilityUnit != null ? Model.SelectedFacilityUnit.UnitType : "N/A")<br />
                            <strong>Number of Units:</strong> @Model.SelectedUnitCount<br />
                            <strong>Calculated Monthly Rental:</strong> <span style="color:var(--re-gold); font-weight:700;">R @string.Format("{0:N2}", Model.CalculatedMonthlyRental) / month</span>
                        </div>
                    </div>
                </div>

                <!-- Section 3: Banking Details -->
                <div>
                    <h5 style="color:var(--re-gold); font-weight:700; text-transform:uppercase; margin-bottom:15px; font-size:14px;"><i class="fa fa-credit-card"></i> Banking Details</h5>
                    <div class="row" style="font-size:13px; line-height:2.0;">
                        <div class="col-md-6">
                            <strong>Bank Name:</strong> @(string.IsNullOrEmpty(Model.BankName) ? "N/A" : Model.BankName)<br />
                            <strong>Branch Code:</strong> @(string.IsNullOrEmpty(Model.BankBranchCode) ? "N/A" : Model.BankBranchCode)
                        </div>
                        <div class="col-md-6">
                            <strong>Account Type:</strong> @(string.IsNullOrEmpty(Model.BankAccountType) ? "N/A" : Model.BankAccountType)<br />
                            <strong>Account Number:</strong> @(string.IsNullOrEmpty(Model.BankAccountNumber) ? "N/A" : Model.BankAccountNumber)
                        </div>
                    </div>
                </div>

            </div>
            <div class="modal-footer" style="padding:15px 20px; display:flex; justify-content:flex-end; border-top:1px solid #e2e8f0;">
                <button type="button" class="btn btn-default" data-dismiss="modal" style="border-radius: 6px; font-weight:600;">Close</button>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        function validateAndSubmit() {
            let outcome = $('#ddlOutcome').val();
            let comments = $('#txtComments').val();

            if (!outcome || outcome === '') {
                alert('Outcome is required.');
                return;
            }

            if ((outcome === 'Supported with Conditions' || outcome === 'Not Supported' || outcome === 'Request Additional Information') && (!comments || comments.trim() === '')) {
                alert('Comments are mandatory for outcome: ' + outcome);
                return;
            }

            $('#confirmModal').modal('show');
        }

        function submitConfirmed() {
            $('#confirmModal').modal('hide');
            $('#commentForm').submit();
        }

        $(document).ready(function() {
            $('#ddlOutcome').change(function() {
                let outcome = $(this).val();
                if (outcome && outcome !== 'Supported') {
                    $('#commentHelp').show();
                } else {
                    $('#commentHelp').hide();
                }
            });
        });
    </script>
}
