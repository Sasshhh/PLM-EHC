@model C8.eServices.Mvc.Models.RE_Application
@{
    ViewBag.Title = "Record Inspection Results";
    Layout = "~/Views/Shared/RCS_Layout.cshtml";
    var conditions = (IEnumerable<SelectListItem>)ViewBag.ConditionList;
}

<style>
    :root {
        --re-gold: #c59b27;
        --re-gold-hover: #a37f1c;
        --re-border-color: #e7e5e4;
        --re-slate-dark: #2e2a27;
        --re-slate-black: #1c1917;
    }

    .admin-container {
        padding: 30px 15px;
        font-family: 'Inter', sans-serif;
    }

    .admin-header-card {
        background: linear-gradient(135deg, var(--re-slate-dark) 0%, var(--re-slate-black) 100%);
        color: #ffffff;
        border-radius: 12px;
        padding: 25px 30px;
        margin-bottom: 25px;
        border-left: 5px solid var(--re-gold);
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .info-card {
        background: #ffffff;
        border: 1px solid var(--re-border-color);
        border-radius: 12px;
        padding: 20px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    }

    .info-card h4 {
        margin-top: 0;
        margin-bottom: 15px;
        font-weight: 700;
        color: var(--re-slate-black);
        border-bottom: 2px solid var(--re-gold);
        padding-bottom: 6px;
        font-size: 15px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .info-item {
        display: flex;
        justify-content: space-between;
        padding: 8px 0;
        border-bottom: 1px dashed #f1f5f9;
        font-size: 13px;
    }

    .info-item:last-child {
        border-bottom: none;
    }

    .info-label {
        font-weight: 600;
        color: #64748b;
    }

    .info-value {
        color: #1e293b;
        font-weight: 500;
        text-align: right;
    }

    .form-card {
        background: #ffffff;
        border: 1px solid var(--re-border-color);
        border-radius: 12px;
        padding: 24px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        margin-bottom: 25px;
    }

    .btn-re-gold {
        background-color: var(--re-gold);
        color: #ffffff;
        border: 1px solid var(--re-gold);
        padding: 10px 24px;
        border-radius: 6px;
        font-weight: 600;
        cursor: pointer;
        font-size: 14px;
    }

    .btn-re-gold:hover {
        background-color: var(--re-gold-hover);
        border-color: var(--re-gold-hover);
    }

    .btn-cancel {
        background-color: transparent;
        border: 1px solid #cbd5e1;
        color: #475569;
        text-decoration: none;
        padding: 10px 24px;
        border-radius: 6px;
        font-weight: 600;
        font-size: 14px;
        display: inline-block;
    }

    .btn-cancel:hover {
        background-color: #f1f5f9;
        color: #1e293b;
    }

    .section-title {
        margin-top:0;
        margin-bottom: 20px;
        font-weight: 700;
        font-size:16px;
        border-bottom: 2px solid var(--re-gold);
        padding-bottom: 8px;
        color: var(--re-slate-black);
    }

    .works-order-section {
        display: none;
        background-color: #fafaf9;
        border: 1px solid var(--re-border-color);
        border-radius: 8px;
        padding: 20px;
        margin-top: 20px;
    }
</style>

<div class="admin-container">
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger" style="border-radius: 8px; border-left: 4px solid #dc2626;">
            <i class="fa fa-exclamation-circle"></i> @TempData["ErrorMessage"]
        </div>
    }

    <div class="admin-header-card">
        <h1 style="margin:0 0 5px 0; font-size:24px; font-weight:700;">Record Inspection Results</h1>
        <p style="margin:0; font-size:14px; color:#cbd5e1;">Complete property checklist and sign-off for reference @Model.ApplicationReferenceNumber.</p>
    </div>

    <div class="info-grid">
        <div class="info-card">
            <h4>Application Details</h4>
            <div class="info-item">
                <span class="info-label">Reference Number:</span>
                <span class="info-value" style="font-weight:700;">@Model.ApplicationReferenceNumber</span>
            </div>
            <div class="info-item">
                <span class="info-label">Applicant Name:</span>
                <span class="info-value">@(Model.Customer != null ? Model.Customer.FullName : "N/A")</span>
            </div>
            <div class="info-item">
                <span class="info-label">Inspection Slot:</span>
                <span class="info-value">@(Model.InspectionDate.HasValue ? Model.InspectionDate.Value.ToString("yyyy-MM-dd") : "") at @Model.InspectionTime</span>
            </div>
        </div>

        <div class="info-card">
            <h4>Premises Inspected</h4>
            <div class="info-item">
                <span class="info-label">Property Address:</span>
                <span class="info-value">@Model.PropertyAddress</span>
            </div>
            <div class="info-item">
                <span class="info-label">Facility Name:</span>
                <span class="info-value">@(Model.SelectedFacility != null ? Model.SelectedFacility.Name : "N/A")</span>
            </div>
            <div class="info-item">
                <span class="info-label">Unit Type / Code:</span>
                <span class="info-value">@(Model.SelectedFacilityUnit != null ? Model.SelectedFacilityUnit.UnitType : "N/A")</span>
            </div>
        </div>
    </div>

    @using (Html.BeginForm("ConductInspection", "RealEstateAdmin", new { id = Model.Id }, FormMethod.Post, new { enctype = "multipart/form-data", id = "inspectionForm" }))
    {
        @Html.AntiForgeryToken()

        <div class="form-card">
            <h4 class="section-title">Unit Condition Assessment</h4>

            <div class="row">
                <div class="col-md-4 form-group">
                    <label style="font-weight:600; color:#475569;">Plumbing System *</label>
                    @Html.DropDownList("plumbing", conditions, new { @class = "form-control assessment-dropdown", required = "required", id = "ddlPlumbing" })
                </div>
                <div class="col-md-4 form-group">
                    <label style="font-weight:600; color:#475569;">Electrical & Wiring *</label>
                    @Html.DropDownList("electrical", conditions, new { @class = "form-control assessment-dropdown", required = "required", id = "ddlElectrical" })
                </div>
                <div class="col-md-4 form-group">
                    <label style="font-weight:600; color:#475569;">Structural & Fixtures *</label>
                    @Html.DropDownList("fixtures", conditions, new { @class = "form-control assessment-dropdown", required = "required", id = "ddlFixtures" })
                </div>
            </div>

            <div class="row" style="margin-top:15px;">
                <div class="col-md-4 form-group">
                    <label style="font-weight:600; color:#475569;">Water & Sanitation *</label>
                    @Html.DropDownList("sanitation", conditions, new { @class = "form-control assessment-dropdown", required = "required", id = "ddlSanitation" })
                </div>
                <div class="col-md-4 form-group">
                    <label style="font-weight:600; color:#475569;">Fire/Health Hazards *</label>
                    @Html.DropDownList("hazards", conditions, new { @class = "form-control assessment-dropdown", required = "required", id = "ddlHazards" })
                </div>
                <div class="col-md-4 form-group">
                    <label style="font-weight:600; color:#475569;">General Wear & Tear *</label>
                    @Html.DropDownList("wearTear", conditions, new { @class = "form-control assessment-dropdown", required = "required", id = "ddlWearTear" })
                </div>
            </div>

            <div class="form-group" style="margin-top:15px;">
                <label style="font-weight:600; color:#475569;">Inspector Observations & Comments</label>
                @Html.TextArea("comments", "", new { @class = "form-control", rows = "3", placeholder = "Describe any defect, necessary repairs, or specific conditions..." })
            </div>

            <div class="form-group" style="margin-top: 15px; background-color:#fafaf9; border: 1px dashed var(--re-border-color); border-radius:8px; padding:15px;">
                <label style="font-weight:600; color:#475569;">Upload Completed Inspection Checklist (Signed PDF) *</label>
                <input type="file" name="inspectionFormFile" class="form-control-file" required="required" id="fileInspectionChecklist" />
                <span class="text-muted" style="font-size:11px;">Max size 5MB. PDF, JPG, PNG formats. Signed checklist is mandatory.</span>
            </div>
        </div>

        <div class="form-card">
            <h4 class="section-title">Works Order / Maintenance Referral</h4>
            
            <div class="form-group" style="margin-bottom:0;">
                <div class="checkbox" style="margin:0;">
                    <label style="font-weight:700; color:var(--re-slate-black); font-size:14px; cursor:pointer;">
                        <input type="checkbox" name="logWorkOrder" value="true" id="chkLogWorkOrder" />
                        Log an Ad-Hoc Maintenance Work Order for repairs.
                    </label>
                </div>
                <p style="margin:5px 0 0 20px; font-size:12px; color:#64748b;">Check this if any checklist item above is rated 'Poor' and requires immediate correction.</p>
            </div>

            <div class="works-order-section" id="worksOrderSection">
                <h5 style="margin-top:0; margin-bottom:15px; font-weight:700; color:var(--re-slate-black); text-transform:uppercase; font-size:13px; letter-spacing:0.5px;">Work Order Request details</h5>
                
                <div class="form-group">
                    <label style="font-weight:600; color:#475569;">Defects & Issues Description *</label>
                    @Html.TextArea("woIssue", "", new { @class = "form-control", rows = "3", placeholder = "Detail specific defects and items to repair...", id = "txtWoIssue" })
                </div>

                <div class="form-group" style="margin-top:15px;">
                    <label style="font-weight:600; color:#475569;">Tasks to Execute</label>
                    @Html.TextArea("woTasks", "", new { @class = "form-control", rows = "3", placeholder = "Describe necessary works tasks (e.g. replace geyser valve)..." })
                </div>

                <div class="row" style="margin-top:15px;">
                    <div class="col-md-6 form-group">
                        <label style="font-weight:600; color:#475569;">Priority Level *</label>
                        @Html.DropDownList("woPriority", new List<SelectListItem>
                        {
                            new SelectListItem { Value = "Low", Text = "Low" },
                            new SelectListItem { Value = "Medium", Text = "Medium", Selected = true },
                            new SelectListItem { Value = "High", Text = "High" },
                            new SelectListItem { Value = "Urgent", Text = "Urgent" }
                        }, new { @class = "form-control", id = "ddlWoPriority" })
                    </div>
                    <div class="col-md-6 form-group">
                        <label style="font-weight:600; color:#475569;">Due Date *</label>
                        <input type="date" name="woDueDate" class="form-control" id="txtWoDueDate" value="@(DateTime.Today.AddDays(7).ToString("yyyy-MM-dd"))" />
                    </div>
                </div>

                <div class="row" style="margin-top:15px;">
                    <div class="col-md-6 form-group">
                        <label style="font-weight:600; color:#475569;">Required Materials / Spares</label>
                        @Html.TextArea("woMaterials", "", new { @class = "form-control", rows = "2", placeholder = "E.g. copper pipes, washers..." })
                    </div>
                    <div class="col-md-6 form-group">
                        <label style="font-weight:600; color:#475569;">Safety & Special Instructions</label>
                        @Html.TextArea("woSafety", "", new { @class = "form-control", rows = "2", placeholder = "E.g. isolate mains before working..." })
                    </div>
                </div>
            </div>
        </div>

        <div style="margin-top: 25px; display:flex; gap:12px; margin-bottom:40px;">
            <button type="button" class="btn-re-gold" id="btn-submit-inspection" onclick="validateAndSubmit()">
                <i class="fa fa-save"></i> Save Inspection & Continue
            </button>
            <a href="@Url.Action("ConductInspections", "RealEstateAdmin")" class="btn-cancel">
                Cancel / Back
            </a>
        </div>
    }
</div>

<!-- Custom Confirmation Modal -->
<div class="modal fade" id="confirmModal" tabindex="-1" role="dialog" aria-labelledby="confirmModalLabel" aria-hidden="true" style="margin-top: 10%;">
    <div class="modal-dialog" role="document">
        <div class="modal-content" style="border-radius: 12px; border: 2px solid var(--re-gold);">
            <div class="modal-header" style="background: linear-gradient(135deg, var(--re-slate-dark) 0%, var(--re-slate-black) 100%); color:#ffffff; border-bottom: 2px solid var(--re-gold);">
                <button type="button" class="close" data-dismiss="modal" style="color:white; opacity:0.8;">&times;</button>
                <h4 class="modal-title" id="confirmModalLabel" style="font-weight: 700;">Confirm Inspection Checklist</h4>
            </div>
            <div class="modal-body" style="padding: 20px; font-size:15px; font-weight:500;">
                <p>Are you sure you want to finalize this pre-occupation unit inspection report?</p>
            </div>
            <div class="modal-footer" style="padding:15px 20px; display:flex; justify-content:flex-end; gap:10px;">
                <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="submitConfirmed()" style="background-color: var(--re-gold); border-color: var(--re-gold); font-weight:600;">Yes, Finalize</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Check for Poor ratings and auto-prompt or auto-check the log work order box
            $('.assessment-dropdown').change(function() {
                var hasPoor = false;
                $('.assessment-dropdown').each(function() {
                    if ($(this).val() === 'Poor') {
                        hasPoor = true;
                    }
                });

                if (hasPoor) {
                    $('#chkLogWorkOrder').prop('checked', true).trigger('change');
                }
            });

            $('#chkLogWorkOrder').change(function() {
                if ($(this).is(':checked')) {
                    $('#worksOrderSection').slideDown();
                } else {
                    $('#worksOrderSection').slideUp();
                }
            });
        });

        function validateAndSubmit() {
            let file = $('#fileInspectionChecklist').val();

            if (!file || file === '') {
                alert('Please upload the signed Inspection Checklist PDF.');
                return;
            }

            if ($('#chkLogWorkOrder').is(':checked')) {
                let issue = $('#txtWoIssue').val();
                let dueDate = $('#txtWoDueDate').val();

                if (!issue || issue.trim() === '') {
                    alert('Please specify the defect/issues description for the Work Order.');
                    return;
                }

                if (!dueDate || dueDate === '') {
                    alert('Please specify the due date for the Work Order.');
                    return;
                }
            }

            $('#confirmModal').modal('show');
        }

        function submitConfirmed() {
            $('#confirmModal').modal('hide');
            $('#inspectionForm').submit();
        }
    </script>
}
