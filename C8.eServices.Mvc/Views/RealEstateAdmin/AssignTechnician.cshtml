@model C8.eServices.Mvc.Models.RE_Application
@{
    ViewBag.Title = "Assign Maintenance Technician";
    Layout = "~/Views/Shared/RCS_Layout.cshtml";
    var technicians = (IEnumerable<SelectListItem>)ViewBag.Technicians;
}

<style>
    :root {
        --re-gold: #c59b27;
        --re-gold-hover: #a37f1c;
        --re-border-color: #e7e5e4;
        --re-slate-dark: #2e2a27;
        --re-slate-black: #1c1917;
    }

    .admin-container {
        padding: 30px 15px;
        font-family: 'Inter', sans-serif;
    }

    .admin-header-card {
        background: linear-gradient(135deg, var(--re-slate-dark) 0%, var(--re-slate-black) 100%);
        color: #ffffff;
        border-radius: 12px;
        padding: 25px 30px;
        margin-bottom: 25px;
        border-left: 5px solid var(--re-gold);
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .info-card {
        background: #ffffff;
        border: 1px solid var(--re-border-color);
        border-radius: 12px;
        padding: 20px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    }

    .info-card h4 {
        margin-top: 0;
        margin-bottom: 15px;
        font-weight: 700;
        color: var(--re-slate-black);
        border-bottom: 2px solid var(--re-gold);
        padding-bottom: 6px;
        font-size: 15px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .info-item {
        display: flex;
        justify-content: space-between;
        padding: 8px 0;
        border-bottom: 1px dashed #f1f5f9;
        font-size: 13px;
    }

    .info-item:last-child {
        border-bottom: none;
    }

    .info-label {
        font-weight: 600;
        color: #64748b;
    }

    .info-value {
        color: #1e293b;
        font-weight: 500;
        text-align: right;
    }

    .form-card {
        background: #ffffff;
        border: 1px solid var(--re-border-color);
        border-radius: 12px;
        padding: 24px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    }

    .btn-re-gold {
        background-color: var(--re-gold);
        color: #ffffff;
        border: 1px solid var(--re-gold);
        padding: 10px 24px;
        border-radius: 6px;
        font-weight: 600;
        cursor: pointer;
        font-size: 14px;
    }

    .btn-re-gold:hover {
        background-color: var(--re-gold-hover);
        border-color: var(--re-gold-hover);
    }

    .btn-cancel {
        background-color: transparent;
        border: 1px solid #cbd5e1;
        color: #475569;
        text-decoration: none;
        padding: 10px 24px;
        border-radius: 6px;
        font-weight: 600;
        font-size: 14px;
        display: inline-block;
    }

    .btn-cancel:hover {
        background-color: #f1f5f9;
        color: #1e293b;
    }
</style>

<div class="admin-container">
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger" style="border-radius: 8px; border-left: 4px solid #dc2626;">
            <i class="fa fa-exclamation-circle"></i> @TempData["ErrorMessage"]
        </div>
    }

    <div class="admin-header-card">
        <h1 style="margin:0 0 5px 0; font-size:24px; font-weight:700;">Assign Works Order</h1>
        <p style="margin:0; font-size:14px; color:#cbd5e1;">Assign a technician to perform repairs for WO @Model.WorkOrderNumber.</p>
    </div>

    <div class="info-grid">
        <div class="info-card">
            <h4>Work Order Details</h4>
            <div class="info-item">
                <span class="info-label">WO Number:</span>
                <span class="info-value" style="font-weight:700; color:var(--re-gold);">@Model.WorkOrderNumber</span>
            </div>
            <div class="info-item">
                <span class="info-label">Priority:</span>
                <span class="info-value" style="font-weight:600;">@Model.WorkOrderPriority</span>
            </div>
            <div class="info-item">
                <span class="info-label">Assignment Route:</span>
                <span class="info-value">@Model.WorkOrderAssignmentType</span>
            </div>
        </div>

        <div class="info-card">
            <h4>Defect Tasks</h4>
            <div class="info-item">
                <span class="info-label">Description of Issues:</span>
                <span class="info-value" style="text-align:left; max-width:200px;">@Model.WorkOrderIssueDescription</span>
            </div>
            <div class="info-item">
                <span class="info-label">Tasks to Perform:</span>
                <span class="info-value" style="text-align:left; max-width:200px;">@Model.WorkOrderTasks</span>
            </div>
        </div>
    </div>

    <div class="form-card">
        <h4 style="margin-top:0; margin-bottom: 20px; font-weight: 700; font-size:16px; border-bottom: 2px solid var(--re-gold); padding-bottom: 8px;">Technician Assignment</h4>

        @using (Html.BeginForm("AssignTechnician", "RealEstateAdmin", new { id = Model.Id }, FormMethod.Post, new { id = "assignForm" }))
        {
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label style="font-weight:600; color:#475569;">Select Technician *</label>
                @Html.DropDownList("technicianName", technicians, "-- Select Technician --", new { @class = "form-control", required = "required", id = "ddlTechnician" })
            </div>

            <div style="margin-top: 25px; display:flex; gap:12px;">
                <button type="button" class="btn-re-gold" id="btn-submit-assign" onclick="validateAndSubmit()">
                    <i class="fa fa-user-plus"></i> Assign Technician
                </button>
                <a href="@Url.Action("WorkOrders", "RealEstateAdmin")" class="btn-cancel">
                    Cancel / Back
                </a>
            </div>
        }
    </div>
</div>

<!-- Custom Confirmation Modal -->
<div class="modal fade" id="confirmModal" tabindex="-1" role="dialog" aria-labelledby="confirmModalLabel" aria-hidden="true" style="margin-top: 10%;">
    <div class="modal-dialog" role="document">
        <div class="modal-content" style="border-radius: 12px; border: 2px solid var(--re-gold);">
            <div class="modal-header" style="background: linear-gradient(135deg, var(--re-slate-dark) 0%, var(--re-slate-black) 100%); color:#ffffff; border-bottom: 2px solid var(--re-gold);">
                <button type="button" class="close" data-dismiss="modal" style="color:white; opacity:0.8;">&times;</button>
                <h4 class="modal-title" id="confirmModalLabel" style="font-weight: 700;">Confirm Assignment</h4>
            </div>
            <div class="modal-body" style="padding: 20px; font-size:15px; font-weight:500;">
                <p>Are you sure you want to assign the selected technician to this work order?</p>
            </div>
            <div class="modal-footer" style="padding:15px 20px; display:flex; justify-content:flex-end; gap:10px;">
                <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="submitConfirmed()" style="background-color: var(--re-gold); border-color: var(--re-gold); font-weight:600;">Yes, Assign</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function validateAndSubmit() {
            let tech = $('#ddlTechnician').val();

            if (!tech || tech === '') {
                alert('Please select a technician.');
                return;
            }

            $('#confirmModal').modal('show');
        }

        function submitConfirmed() {
            $('#confirmModal').modal('hide');
            $('#assignForm').submit();
        }
    </script>
}
