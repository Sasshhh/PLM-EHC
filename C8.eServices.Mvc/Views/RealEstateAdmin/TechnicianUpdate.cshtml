@model C8.eServices.Mvc.Models.RE_Application
@{
    ViewBag.Title = "Update Work Order Status";
    Layout = "~/Views/Shared/RCS_Layout.cshtml";
}

<style>
    :root {
        --re-gold: #c59b27;
        --re-gold-hover: #a37f1c;
        --re-border-color: #e7e5e4;
        --re-slate-dark: #2e2a27;
        --re-slate-black: #1c1917;
    }

    .admin-container {
        padding: 30px 15px;
        font-family: 'Inter', sans-serif;
    }

    .admin-header-card {
        background: linear-gradient(135deg, var(--re-slate-dark) 0%, var(--re-slate-black) 100%);
        color: #ffffff;
        border-radius: 12px;
        padding: 25px 30px;
        margin-bottom: 25px;
        border-left: 5px solid var(--re-gold);
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .info-card {
        background: #ffffff;
        border: 1px solid var(--re-border-color);
        border-radius: 12px;
        padding: 20px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    }

    .info-card h4 {
        margin-top: 0;
        margin-bottom: 15px;
        font-weight: 700;
        color: var(--re-slate-black);
        border-bottom: 2px solid var(--re-gold);
        padding-bottom: 6px;
        font-size: 15px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .info-item {
        display: flex;
        justify-content: space-between;
        padding: 8px 0;
        border-bottom: 1px dashed #f1f5f9;
        font-size: 13px;
    }

    .info-item:last-child {
        border-bottom: none;
    }

    .info-label {
        font-weight: 600;
        color: #64748b;
    }

    .info-value {
        color: #1e293b;
        font-weight: 500;
        text-align: right;
    }

    .form-card {
        background: #ffffff;
        border: 1px solid var(--re-border-color);
        border-radius: 12px;
        padding: 24px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        margin-bottom: 25px;
    }

    .btn-re-gold {
        background-color: var(--re-gold);
        color: #ffffff;
        border: 1px solid var(--re-gold);
        padding: 10px 24px;
        border-radius: 6px;
        font-weight: 600;
        cursor: pointer;
        font-size: 14px;
    }

    .btn-re-gold:hover {
        background-color: var(--re-gold-hover);
        border-color: var(--re-gold-hover);
    }

    .btn-re-danger {
        background-color: #dc2626;
        color: #ffffff;
        border: 1px solid #dc2626;
        padding: 10px 24px;
        border-radius: 6px;
        font-weight: 600;
        cursor: pointer;
        font-size: 14px;
    }

    .btn-re-danger:hover {
        background-color: #b91c1c;
        border-color: #b91c1c;
    }

    .btn-cancel {
        background-color: transparent;
        border: 1px solid #cbd5e1;
        color: #475569;
        text-decoration: none;
        padding: 10px 24px;
        border-radius: 6px;
        font-weight: 600;
        font-size: 14px;
        display: inline-block;
    }

    .btn-cancel:hover {
        background-color: #f1f5f9;
        color: #1e293b;
    }
</style>

<div class="admin-container">
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger" style="border-radius: 8px; border-left: 4px solid #dc2626;">
            <i class="fa fa-exclamation-circle"></i> @TempData["ErrorMessage"]
        </div>
    }

    <div class="admin-header-card">
        <h1 style="margin:0 0 5px 0; font-size:24px; font-weight:700;">Update Work Order Progress</h1>
        <p style="margin:0; font-size:14px; color:#cbd5e1;">Submit job sheets and completion updates for WO @Model.WorkOrderNumber.</p>
    </div>

    <div class="info-grid">
        <div class="info-card">
            <h4>Work Order Details</h4>
            <div class="info-item">
                <span class="info-label">WO Number:</span>
                <span class="info-value" style="font-weight:700; color:var(--re-gold);">@Model.WorkOrderNumber</span>
            </div>
            <div class="info-item">
                <span class="info-label">Priority:</span>
                <span class="info-value">@Model.WorkOrderPriority</span>
            </div>
            <div class="info-item">
                <span class="info-label">Due Date:</span>
                <span class="info-value">@(Model.WorkOrderDueDate.HasValue ? Model.WorkOrderDueDate.Value.ToString("yyyy-MM-dd") : "")</span>
            </div>
        </div>

        <div class="info-card">
            <h4>Task Details</h4>
            <div class="info-item">
                <span class="info-label">Defects Description:</span>
                <span class="info-value" style="text-align:left; max-width:200px;">@Model.WorkOrderIssueDescription</span>
            </div>
            <div class="info-item">
                <span class="info-label">Tasks to Perform:</span>
                <span class="info-value" style="text-align:left; max-width:200px;">@Model.WorkOrderTasks</span>
            </div>
        </div>
    </div>

    @using (Html.BeginForm("TechnicianUpdate", "RealEstateAdmin", new { id = Model.Id }, FormMethod.Post, new { enctype = "multipart/form-data", id = "techUpdateForm" }))
    {
        @Html.AntiForgeryToken()
        <input type="hidden" name="holdReason" id="holdReasonInput" />

        <div class="form-card">
            <h4 style="margin-top:0; margin-bottom: 20px; font-weight: 700; font-size:16px; border-bottom: 2px solid var(--re-gold); padding-bottom: 8px;">Complete Maintenance Task</h4>

            <div class="form-group">
                <label style="font-weight:600; color:#475569;">Work Execution Comments / Details *</label>
                @Html.TextArea("comments", "", new { @class = "form-control", rows = "4", placeholder = "Detail specific works done, parts replaced, or general status updates...", id = "txtComments" })
            </div>

            <div class="form-group" style="margin-top: 15px; background-color:#fafaf9; border: 1px dashed var(--re-border-color); border-radius:8px; padding:15px;">
                <label style="font-weight:600; color:#475569;">Upload Completed Job Sheet (Signed PDF) *</label>
                <input type="file" name="jobSheetFile" class="form-control-file" id="fileJobSheet" />
                <span class="text-muted" style="font-size:11px;">Max size 5MB. PDF, JPG, PNG formats. Completed Job Sheet is required for completion.</span>
            </div>
        </div>

        <div style="margin-top: 25px; display:flex; gap:12px; margin-bottom:40px;">
            <button type="button" class="btn-re-gold" id="btn-complete-job" onclick="completeJob()">
                <i class="fa fa-check-circle"></i> Mark Job Completed
            </button>
            <button type="button" class="btn-re-danger" id="btn-hold-job" onclick="holdJob()">
                <i class="fa fa-pause-circle"></i> Place On Hold
            </button>
            <a href="@Url.Action("TechnicianAllocation", "RealEstateAdmin")" class="btn-cancel">
                Cancel / Back
            </a>
        </div>
    }
</div>

<!-- On Hold Modal -->
<div class="modal fade" id="holdModal" tabindex="-1" role="dialog" aria-labelledby="holdModalLabel" aria-hidden="true" style="margin-top: 10%;">
    <div class="modal-dialog" role="document">
        <div class="modal-content" style="border-radius: 12px; border: 2px solid #dc2626;">
            <div class="modal-header" style="background: linear-gradient(135deg, #2e2a27 0%, #1c1917 100%); color:#ffffff; border-bottom: 2px solid var(--re-gold);">
                <button type="button" class="close" data-dismiss="modal" style="color:white; opacity:0.8;">&times;</button>
                <h4 class="modal-title" id="holdModalLabel" style="font-weight: 700;">Place Work Order On Hold</h4>
            </div>
            <div class="modal-body" style="padding: 20px;">
                <div class="form-group">
                    <label style="font-weight:600; color:#475569;">Please specify the reason for placing this job On Hold *</label>
                    <textarea id="txtHoldReason" class="form-control" rows="4" placeholder="E.g. Awaiting specialized replacement parts..."></textarea>
                </div>
            </div>
            <div class="modal-footer" style="padding:15px 20px; display:flex; justify-content:flex-end; gap:10px; border-top: 1px solid var(--re-border-color);">
                <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" onclick="submitHold()" style="font-weight:600;">Yes, Place On Hold</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function completeJob() {
            let comments = $('#txtComments').val();
            let file = $('#fileJobSheet').val();

            if (!comments || comments.trim() === '') {
                alert('Execution comments are required to complete the task.');
                return;
            }

            if (!file || file === '') {
                alert('Please upload the signed Job Sheet PDF to complete the task.');
                return;
            }

            $('#holdReasonInput').val(''); // Clear hold reason
            $('#techUpdateForm').submit();
        }

        function holdJob() {
            $('#holdModal').modal('show');
        }

        function submitHold() {
            let reason = $('#txtHoldReason').val();
            if (!reason || reason.trim() === '') {
                alert('Please specify the hold reason.');
                return;
            }

            $('#holdReasonInput').val(reason);
            $('#holdModal').modal('hide');
            $('#techUpdateForm').submit();
        }
    </script>
}
