<style>
    :root { --re-gold: #c59b27; --re-gold-hover: #a37f1c; --re-border-color: #e7e5e4; --re-slate-dark: #2e2a27; --re-slate-black: #1c1917; }
    .admin-container { padding: 30px 15px; font-family: 'Inter', sans-serif; }
    .admin-header-card { background: linear-gradient(135deg, var(--re-slate-dark) 0%, var(--re-slate-black) 100%); color: #fff; border-radius: 12px; padding: 24px 30px; margin-bottom: 25px; border-left: 5px solid var(--re-gold); }
    .admin-header-card h1 { margin: 0 0 5px 0; font-size: 24px; font-weight: 700; }
    .admin-header-card p { margin: 0; font-size: 14px; color: #cbd5e1; }
    .admin-card { background: #fff; border: 1px solid var(--re-border-color); border-radius: 12px; box-shadow: 0 4px 6px -1px rgba(0,0,0,.05); padding: 24px; margin-bottom: 20px; }
    .admin-card h3 { margin-top: 0; margin-bottom: 18px; font-weight: 700; font-size: 18px; border-bottom: 2px solid var(--re-gold); padding-bottom: 8px; display: inline-block; }
    .admin-table { width: 100%; border-collapse: separate; border-spacing: 0; }
    .admin-table th { background: #f8fafc; color: #475569; font-weight: 600; text-transform: uppercase; font-size: 12px; padding: 12px 14px; border-bottom: 2px solid var(--re-border-color); }
    .admin-table td { padding: 12px 14px; border-bottom: 1px solid var(--re-border-color); font-size: 14px; color: #334155; vertical-align: middle; }
    .admin-table td.num, .admin-table th.num { text-align: right; }
    .admin-table tr.total td { font-weight: 700; background: #f8fafc; }
    .btn-re-gold { background: var(--re-gold); color: #fff; font-weight: 600; border: 1px solid var(--re-gold); padding: 8px 16px; border-radius: 6px; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; }
    .btn-re-gold:hover, .btn-re-gold:focus { background: var(--re-gold-hover); color: #fff; text-decoration: none; }
    .btn-re-outline { background: #fff; color: #334155; font-weight: 600; border: 1px solid #cbd5e1; padding: 8px 16px; border-radius: 6px; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; }
    .btn-re-outline:hover { background: #f1f5f9; text-decoration: none; }
    .kpi { border: 1px solid var(--re-border-color); border-radius: 10px; padding: 16px; background: #fff; text-align: center; display: block; color: inherit; }
    .kpi:hover { text-decoration: none; border-color: var(--re-gold); }
    .kpi .v { font-size: 28px; font-weight: 700; color: #1c1917; }
    .kpi .l { font-size: 12px; text-transform: uppercase; color: #64748b; letter-spacing: .04em; }
    .re-status { display: inline-block; padding: 2px 10px; border-radius: 999px; font-size: 12px; font-weight: 600; }
    .re-status-Active { background: #dcfce7; color: #166534; }
    .re-status-Expired { background: #fee2e2; color: #991b1b; }
    .re-status-Indefinite { background: #e0e7ff; color: #3730a3; }
    .re-status-NoLease { background: #fef3c7; color: #92400e; }
    .re-status-MOA { background: #f3e8ff; color: #6b21a8; }
    .re-status-Inactive { background: #e5e7eb; color: #374151; }
    .re-section-title { font-size: 15px; font-weight: 700; color: #1c1917; margin: 8px 0 14px; padding-bottom: 6px; border-bottom: 1px solid var(--re-border-color); }
    .re-form label { font-size: 13px; font-weight: 600; color: #334155; }
    .re-form .req:after { content: " *"; color: #b91c1c; }
    .re-dl dt { color: #64748b; font-weight: 600; font-size: 12px; text-transform: uppercase; }
    .re-dl dd { margin-bottom: 12px; font-size: 14px; color: #1c1917; word-break: break-word; }
    @@media (max-width: 767px) { .admin-table { display: block; overflow-x: auto; } }
</style>
