@model IEnumerable<C8.eServices.Mvc.Models.RE_FacilityUnit>
@{
    ViewBag.Title = "Preventive Maintenance Scheduling";
    Layout = "~/Views/Shared/RCS_Layout.cshtml";
}

<style>
    :root {
        --re-gold: #c59b27;
        --re-gold-hover: #a37f1c;
        --re-border-color: #e7e5e4;
        --re-slate-dark: #2e2a27;
        --re-slate-black: #1c1917;
    }

    .admin-container {
        padding: 30px 15px;
        font-family: 'Inter', sans-serif;
    }

    .admin-header-card {
        background: linear-gradient(135deg, var(--re-slate-dark) 0%, var(--re-slate-black) 100%);
        color: #ffffff;
        border-radius: 12px;
        padding: 25px 30px;
        margin-bottom: 25px;
        border-left: 5px solid var(--re-gold);
    }

    .admin-card {
        background: #ffffff;
        border: 1px solid var(--re-border-color);
        border-radius: 12px;
        padding: 24px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    }

    .admin-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
    }

    .admin-table th {
        background-color: #f8fafc;
        color: #475569;
        font-weight: 600;
        text-transform: uppercase;
        font-size: 11px;
        padding: 12px 16px;
        border-bottom: 2px solid var(--re-border-color);
    }

    .admin-table td {
        padding: 14px 16px;
        border-bottom: 1px solid var(--re-border-color);
        font-size: 13px;
    }

    .btn-re-gold {
        background-color: var(--re-gold);
        color: #ffffff;
        border: 1px solid var(--re-gold);
        padding: 6px 12px;
        border-radius: 6px;
        font-weight: 600;
        text-decoration: none;
        font-size: 12px;
        display: inline-block;
        cursor: pointer;
    }

    .btn-re-gold:hover {
        background-color: var(--re-gold-hover);
        color: #ffffff;
    }
</style>

<div class="admin-container">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible" role="alert">
            <button type="button" class="close" data-dismiss="alert">&times;</button>
            <i class="fa fa-check-circle"></i> @TempData["SuccessMessage"]
        </div>
    }

    <div class="admin-header-card">
        <h1 style="margin:0 0 5px 0; font-size:24px; font-weight:700;">Preventive Maintenance Scheduling</h1>
        <p style="margin:0; font-size:14px; color:#cbd5e1;">Review lease property units and plan preventive maintenance schedules (UC 16).</p>
    </div>

    <div class="admin-card">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Facility</th>
                    <th>Unit Code</th>
                    <th>Category</th>
                    <th>Max Units / Occupancy</th>
                    <th style="text-align:right;">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="5" style="text-align:center; color:#64748b; font-style:italic; padding:30px;">
                            No real estate units configured.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var unit in Model)
                    {
                        <tr>
                            <td style="font-weight:700;">@(unit.Facility != null ? unit.Facility.Name : "N/A")</td>
                            <td>@unit.UnitType</td>
                            <td>@(unit.FacilityCategory != null ? unit.FacilityCategory.Name : "N/A")</td>
                            <td>@unit.MaxUnits</td>
                            <td style="text-align:right;">
                                <button class="btn-re-gold" onclick="openScheduleModal(@unit.Id, '@(unit.Facility != null ? unit.Facility.Name : "N/A") - @unit.UnitType')" id="btn-schedule-main-@unit.Id">
                                    <i class="fa fa-calendar-plus-o"></i> Plan Maintenance
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Maintenance Schedule Modal -->
<div class="modal fade" id="scheduleModal" tabindex="-1" role="dialog" aria-labelledby="scheduleModalLabel" aria-hidden="true" style="margin-top: 5%;">
    <div class="modal-dialog" role="document">
        <div class="modal-content" style="border-radius: 12px; border: 2px solid var(--re-gold);">
            <div class="modal-header" style="background: linear-gradient(135deg, var(--re-slate-dark) 0%, var(--re-slate-black) 100%); color:#ffffff; border-bottom: 2px solid var(--re-gold);">
                <button type="button" class="close" data-dismiss="modal" style="color:white; opacity:0.8;">&times;</button>
                <h4 class="modal-title" id="scheduleModalLabel" style="font-weight: 700;">Plan Maintenance Schedule</h4>
            </div>
            @using (Html.BeginForm("MaintenancePlanning", "RealEstateAdmin", FormMethod.Post, new { id = "planningForm" }))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="unitIdInput" />

                <div class="modal-body" style="padding: 20px;">
                    <p style="font-weight:600; font-size:14px; margin-bottom:15px; color:var(--re-slate-black);">
                        Property Unit: <span id="unitNameLabel" style="color:var(--re-gold);"></span>
                    </p>

                    <div class="form-group">
                        <label style="font-weight:600; color:#475569;">Maintenance Activity Description *</label>
                        <input type="text" name="activity" class="form-control" required="required" placeholder="E.g. HVAC service, Fire extinguisher check" id="txtActivity" />
                    </div>

                    <div class="form-group" style="margin-top:15px;">
                        <label style="font-weight:600; color:#475569;">Maintenance Frequency *</label>
                        <select name="frequency" class="form-control" required="required" id="ddlFrequency">
                            <option value="Weekly">Weekly</option>
                            <option value="Monthly" selected>Monthly</option>
                            <option value="Quarterly">Quarterly</option>
                            <option value="Bi-Annually">Bi-Annually</option>
                            <option value="Annually">Annually</option>
                        </select>
                    </div>

                    <div class="row" style="margin-top:15px;">
                        <div class="col-md-6 form-group">
                            <label style="font-weight:600; color:#475569;">First Scheduled Due Date *</label>
                            <input type="date" name="dueDate" class="form-control" required="required" id="txtDueDate" value="@(DateTime.Today.AddMonths(1).ToString("yyyy-MM-dd"))" />
                        </div>
                        <div class="col-md-6 form-group">
                            <label style="font-weight:600; color:#475569;">Est. Duration (hours) *</label>
                            <input type="number" name="duration" class="form-control" required="required" min="1" value="2" id="txtDuration" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer" style="padding:15px 20px; display:flex; justify-content:flex-end; gap:10px; border-top: 1px solid var(--re-border-color);">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary" style="background-color: var(--re-gold); border-color: var(--re-gold); font-weight:600;">Save Schedule</button>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openScheduleModal(unitId, unitName) {
            $('#unitIdInput').val(unitId);
            $('#unitNameLabel').text(unitName);
            $('#txtActivity').val('');
            $('#scheduleModal').modal('show');
        }
    </script>
}
