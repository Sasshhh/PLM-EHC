@model C8.eServices.Mvc.Models.RE_Application
@{
    ViewBag.Title = "Review PTO Request";
    Layout = "~/Views/Shared/RCS_Layout.cshtml";
    var docs = (IEnumerable<C8.eServices.Mvc.Models.Document>)ViewBag.Documents;
}

<style>
    :root {
        --re-gold: #c59b27;
        --re-gold-hover: #a37f1c;
        --re-border-color: #e7e5e4;
        --re-slate-dark: #2e2a27;
        --re-slate-black: #1c1917;
    }

    .admin-container {
        padding: 30px 15px;
        font-family: 'Inter', sans-serif;
    }

    .admin-header-card {
        background: linear-gradient(135deg, var(--re-slate-dark) 0%, var(--re-slate-black) 100%);
        color: #ffffff;
        border-radius: 12px;
        padding: 25px 30px;
        margin-bottom: 25px;
        border-left: 5px solid var(--re-gold);
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .info-card {
        background: #ffffff;
        border: 1px solid var(--re-border-color);
        border-radius: 12px;
        padding: 20px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    }

    .info-card h4 {
        margin-top: 0;
        margin-bottom: 15px;
        font-weight: 700;
        color: var(--re-slate-black);
        border-bottom: 2px solid var(--re-gold);
        padding-bottom: 6px;
        font-size: 15px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .info-item {
        display: flex;
        justify-content: space-between;
        padding: 8px 0;
        border-bottom: 1px dashed #f1f5f9;
        font-size: 13px;
    }

    .info-item:last-child {
        border-bottom: none;
    }

    .info-label {
        font-weight: 600;
        color: #64748b;
    }

    .info-value {
        color: #1e293b;
        font-weight: 500;
        text-align: right;
    }

    .form-card {
        background: #ffffff;
        border: 1px solid var(--re-border-color);
        border-radius: 12px;
        padding: 24px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        margin-bottom: 25px;
    }

    .btn-re-gold {
        background-color: var(--re-gold);
        color: #ffffff;
        border: 1px solid var(--re-gold);
        padding: 10px 24px;
        border-radius: 6px;
        font-weight: 600;
        cursor: pointer;
        font-size: 14px;
    }

    .btn-re-gold:hover {
        background-color: var(--re-gold-hover);
        border-color: var(--re-gold-hover);
    }

    .btn-cancel {
        background-color: transparent;
        border: 1px solid #cbd5e1;
        color: #475569;
        text-decoration: none;
        padding: 10px 24px;
        border-radius: 6px;
        font-weight: 600;
        font-size: 14px;
        display: inline-block;
    }

    .btn-cancel:hover {
        background-color: #f1f5f9;
        color: #1e293b;
    }

    .doc-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 10px;
    }

    .doc-table th {
        text-align: left;
        padding: 10px;
        background-color: #f8fafc;
        border-bottom: 2px solid var(--re-border-color);
        font-size: 11px;
        text-transform: uppercase;
        color: #475569;
    }

    .doc-table td {
        padding: 10px;
        border-bottom: 1px solid var(--re-border-color);
        font-size: 13px;
    }
</style>

<div class="admin-container">
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger" style="border-radius: 8px; border-left: 4px solid #dc2626;">
            <i class="fa fa-exclamation-circle"></i> @TempData["ErrorMessage"]
        </div>
    }

    <div class="admin-header-card">
        <h1 style="margin:0 0 5px 0; font-size:24px; font-weight:700;">Review PTO Request</h1>
        <p style="margin:0; font-size:14px; color:#cbd5e1;">Review insurance, fit-out documents, and record recommendation for PTO Ref @Model.PtoReferenceNumber.</p>
    </div>

    <div class="info-grid">
        <div class="info-card">
            <h4>PTO Request Details</h4>
            <div class="info-item">
                <span class="info-label">PTO Ref Number:</span>
                <span class="info-value" style="font-weight:700; color:var(--re-gold);">@Model.PtoReferenceNumber</span>
            </div>
            <div class="info-item">
                <span class="info-label">Applicant Name:</span>
                <span class="info-value">@(Model.Customer != null ? Model.Customer.FullName : "N/A")</span>
            </div>
            <div class="info-item">
                <span class="info-label">Period of Occupation:</span>
                <span class="info-value">
                    @(Model.PtoStartDate.HasValue ? Model.PtoStartDate.Value.ToString("yyyy-MM-dd") : "") to
                    @(Model.PtoEndDate.HasValue ? Model.PtoEndDate.Value.ToString("yyyy-MM-dd") : "")
                </span>
            </div>
        </div>

        <div class="info-card">
            <h4>Premises & Purpose</h4>
            <div class="info-item">
                <span class="info-label">Property Address:</span>
                <span class="info-value">@Model.PropertyAddress</span>
            </div>
            <div class="info-item">
                <span class="info-label">Purpose of Occupation:</span>
                <span class="info-value" style="text-align:left; max-width:200px;">@Model.PtoPurposeOfOccupation</span>
            </div>
            <div class="info-item">
                <span class="info-label">Indemnity Accepted:</span>
                <span class="info-value text-success">@((Model.PtoAcceptedIndemnity == true) ? "Yes / Confirmed" : "No")</span>
            </div>
        </div>
    </div>

    <div class="form-card">
        <h4 style="margin-top:0; margin-bottom: 20px; font-weight: 700; font-size:16px; border-bottom: 2px solid var(--re-gold); padding-bottom: 8px;">Compliance Documents</h4>
        
        <table class="doc-table">
            <thead>
                <tr>
                    <th>Document Name</th>
                    <th>Required Type</th>
                    <th>Upload Date</th>
                    <th>Download Link</th>
                </tr>
            </thead>
            <tbody>
                @if (docs == null || !docs.Any())
                {
                    <tr>
                        <td colspan="4" style="text-align:center; color:#64748b; font-style:italic; padding:20px;">
                            No compliance documents uploaded for this PTO request.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var doc in docs)
                    {
                        <tr>
                            <td style="font-weight:600;">@doc.DocumentCheckList.DocumentType.Name</td>
                            <td>@doc.DocumentCheckList.DocumentType.Description</td>
                            <td>@(doc.CreatedDateTime.HasValue ? doc.CreatedDateTime.Value.ToString("yyyy-MM-dd HH:mm") : "")</td>
                            <td>
                                @if (doc.FileId != null)
                                {
                                    <a href="@Url.Action("DownloadFile", "Document", new { q = doc.File.Data })" target="_blank" class="btn btn-xs btn-default">
                                        <i class="fa fa-download"></i> Download File
                                    </a>
                                }
                                else
                                {
                                    <span class="text-danger">File Missing</span>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="form-card">
        <h4 style="margin-top:0; margin-bottom: 20px; font-weight: 700; font-size:16px; border-bottom: 2px solid var(--re-gold); padding-bottom: 8px;">Officer Recommendation</h4>

        @using (Html.BeginForm("ReviewPto", "RealEstateAdmin", new { id = Model.Id }, FormMethod.Post, new { id = "reviewPtoForm" }))
        {
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label style="font-weight:600; color:#475569;">Recommendation Outcome *</label>
                @Html.DropDownList("recommendation", new List<SelectListItem>
                {
                    new SelectListItem { Value = "Recommended", Text = "Recommend for Approval" },
                    new SelectListItem { Value = "Request Additional Information", Text = "Request Additional Information" }
                }, "-- Select Recommendation --", new { @class = "form-control", required = "required", id = "ddlRec" })
            </div>

            <div class="form-group" style="margin-top: 15px;">
                <label style="font-weight:600; color:#475569;">Comments / Reasons / Deferral Details *</label>
                @Html.TextArea("reason", "", new { @class = "form-control", rows = "4", required = "required", placeholder = "Detail reason for recommendation, or specify outstanding items if info is required...", id = "txtReason" })
            </div>

            <div style="margin-top: 25px; display:flex; gap:12px;">
                <button type="button" class="btn-re-gold" id="btn-submit-rec" onclick="validateAndSubmit()">
                    <i class="fa fa-save"></i> Submit Recommendation
                </button>
                <a href="@Url.Action("PtoReviews", "RealEstateAdmin")" class="btn-cancel">
                    Cancel / Back
                </a>
            </div>
        }
    </div>
</div>

<!-- Custom Confirmation Modal -->
<div class="modal fade" id="confirmModal" tabindex="-1" role="dialog" aria-labelledby="confirmModalLabel" aria-hidden="true" style="margin-top: 10%;">
    <div class="modal-dialog" role="document">
        <div class="modal-content" style="border-radius: 12px; border: 2px solid var(--re-gold);">
            <div class="modal-header" style="background: linear-gradient(135deg, var(--re-slate-dark) 0%, var(--re-slate-black) 100%); color:#ffffff; border-bottom: 2px solid var(--re-gold);">
                <button type="button" class="close" data-dismiss="modal" style="color:white; opacity:0.8;">&times;</button>
                <h4 class="modal-title" id="confirmModalLabel" style="font-weight: 700;">Confirm PTO Recommendation</h4>
            </div>
            <div class="modal-body" style="padding: 20px; font-size:15px; font-weight:500;">
                <p>Are you sure you want to submit this recommendation for HoD approval?</p>
            </div>
            <div class="modal-footer" style="padding:15px 20px; display:flex; justify-content:flex-end; gap:10px;">
                <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="submitConfirmed()" style="background-color: var(--re-gold); border-color: var(--re-gold); font-weight:600;">Yes, Submit</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function validateAndSubmit() {
            let rec = $('#ddlRec').val();
            let reason = $('#txtReason').val();

            if (!rec || rec === '') {
                alert('Recommendation outcome is required.');
                return;
            }

            if (!reason || reason.trim() === '') {
                alert('Comments / reasons details are required.');
                return;
            }

            $('#confirmModal').modal('show');
        }

        function submitConfirmed() {
            $('#confirmModal').modal('hide');
            $('#reviewPtoForm').submit();
        }
    </script>
}
