@model C8.eServices.Mvc.Models.RE_Application
@{
    ViewBag.Title = "Verify Application Payment";
    Layout = "~/Views/Shared/RCS_Layout.cshtml";
    var documents = (IEnumerable<C8.eServices.Mvc.Models.Document>)ViewBag.Documents;
}

<style>
    :root {
        --re-gold: #c59b27;
        --re-gold-hover: #a37f1c;
        --re-gold-light: #fafaf9;
        --re-text-dark: #1c1917;
        --re-border-color: #e7e5e4;
        --re-slate-dark: #2e2a27;
        --re-slate-black: #1c1917;
    }

    .admin-container {
        padding: 30px 15px;
        font-family: 'Inter', 'Outfit', sans-serif;
        color: var(--re-text-dark);
    }

    .admin-header-card {
        background: linear-gradient(135deg, var(--re-slate-dark) 0%, var(--re-slate-black) 100%);
        color: #ffffff;
        border-radius: 12px;
        padding: 25px 30px;
        margin-bottom: 25px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
        border-left: 5px solid var(--re-gold);
    }

    .admin-title {
        font-size: 24px;
        font-weight: 700;
        margin: 0 0 5px 0;
        letter-spacing: -0.5px;
    }

    .admin-subtitle {
        font-size: 14px;
        color: #94a3b8;
        margin: 0;
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .info-card {
        background: #ffffff;
        border: 1px solid var(--re-border-color);
        border-radius: 12px;
        padding: 20px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    }

    .info-card h4 {
        margin-top: 0;
        margin-bottom: 15px;
        font-weight: 700;
        color: var(--re-slate-black);
        border-bottom: 2px solid var(--re-gold);
        padding-bottom: 6px;
        font-size: 15px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .info-item {
        display: flex;
        justify-content: space-between;
        padding: 8px 0;
        border-bottom: 1px dashed #f1f5f9;
        font-size: 13px;
    }

    .info-item:last-child {
        border-bottom: none;
    }

    .info-label {
        font-weight: 600;
        color: #64748b;
    }

    .info-value {
        color: #1e293b;
        font-weight: 500;
        text-align: right;
    }

    .doc-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 16px;
        border: 1px solid var(--re-border-color);
        border-radius: 8px;
        margin-bottom: 10px;
        background-color: #ffffff;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .doc-row:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 8px rgba(0,0,0,0.05);
    }

    .doc-row-highlight {
        border: 1.5px solid var(--re-gold);
        background-color: var(--re-gold-light);
    }

    .doc-name {
        font-weight: 600;
        font-size: 14px;
        color: #334155;
    }

    .doc-meta {
        font-size: 11px;
        color: #64748b;
        margin-top: 2px;
    }

    .badge-pop {
        background-color: #fef3c7;
        color: #b45309;
        border: 1px solid #fde68a;
        padding: 2px 8px;
        border-radius: 4px;
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        margin-left: 8px;
        display: inline-block;
    }

    .btn-download {
        background-color: #ffffff;
        border: 1px solid #cbd5e1;
        color: #475569;
        padding: 6px 12px;
        border-radius: 6px;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .btn-download:hover {
        background-color: #f8fafc;
        border-color: #94a3b8;
        color: #1e293b;
    }

    .btn-download-highlight {
        background-color: var(--re-gold);
        border-color: var(--re-gold);
        color: #ffffff;
    }

    .btn-download-highlight:hover {
        background-color: var(--re-gold-hover);
        border-color: var(--re-gold-hover);
        color: #ffffff;
    }

    .action-panel {
        background: #ffffff;
        border: 1px solid var(--re-border-color);
        border-radius: 12px;
        padding: 24px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        margin-top: 30px;
    }

    .btn-action {
        padding: 10px 24px;
        font-weight: 600;
        border-radius: 6px;
        transition: all 0.2s ease;
        font-size: 14px;
        cursor: pointer;
    }

    .btn-approve {
        background-color: var(--re-gold);
        border: 1px solid var(--re-gold);
        color: #ffffff;
    }

    .btn-approve:hover {
        background-color: var(--re-gold-hover);
        border-color: var(--re-gold-hover);
    }

    .btn-reject {
        background-color: #dc2626;
        border: 1px solid #dc2626;
        color: #ffffff;
    }

    .btn-reject:hover {
        background-color: #b91c1c;
        border-color: #b91c1c;
    }

    .btn-cancel {
        background-color: transparent;
        border: 1px solid #cbd5e1;
        color: #475569;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .btn-cancel:hover {
        background-color: #f1f5f9;
        color: #1e293b;
    }

    /* Modal Gold Theme Override */
    .modal-content-gold {
        border-radius: 12px;
        border: 2px solid var(--re-gold);
        background: #ffffff;
    }

    .modal-header-gold {
        background: linear-gradient(135deg, var(--re-slate-dark) 0%, var(--re-slate-black) 100%);
        color: #ffffff;
        border-top-left-radius: 10px;
        border-top-right-radius: 10px;
        border-bottom: 2px solid var(--re-gold);
    }
</style>

<div class="admin-container">
    <div class="admin-header-card">
        <h1 class="admin-title">Verify Application Fee Payment</h1>
        <p class="admin-subtitle">Verify details and Proof of Payment uploaded for application @Model.ApplicationReferenceNumber.</p>
    </div>

    <!-- Info Grid -->
    <div class="info-grid">
        <div class="info-card">
            <h4>Application Details</h4>
            <div class="info-item">
                <span class="info-label">Reference Number:</span>
                <span class="info-value" style="font-weight: 700;">@Model.ApplicationReferenceNumber</span>
            </div>
            <div class="info-item">
                <span class="info-label">Applicant Name:</span>
                <span class="info-value">@(Model.Customer != null ? Model.Customer.FullName : "N/A")</span>
            </div>
            <div class="info-item">
                <span class="info-label">Applicant Type:</span>
                <span class="info-value">@Model.ApplicantType</span>
            </div>
            <div class="info-item">
                <span class="info-label">Date Submitted:</span>
                <span class="info-value">@(Model.CreatedDateTime.HasValue ? Model.CreatedDateTime.Value.ToString("yyyy-MM-dd HH:mm") : "N/A")</span>
            </div>
        </div>

        <div class="info-card">
            <h4>Lease Premises Selected</h4>
            <div class="info-item">
                <span class="info-label">Facility / Property:</span>
                <span class="info-value">@(Model.SelectedFacility != null ? Model.SelectedFacility.Name : "N/A")</span>
            </div>
            <div class="info-item">
                <span class="info-label">Unit Type:</span>
                <span class="info-value">@(Model.SelectedFacilityUnit != null ? Model.SelectedFacilityUnit.UnitType : "N/A")</span>
            </div>
            <div class="info-item">
                <span class="info-label">Number of Units:</span>
                <span class="info-value">@Model.SelectedUnitCount</span>
            </div>
            <div class="info-item">
                <span class="info-label">Calculated Rental:</span>
                <span class="info-value" style="color: var(--re-gold); font-weight: 700;">R @string.Format("{0:N2}", Model.CalculatedMonthlyRental) / month</span>
            </div>
        </div>
    </div>

    <!-- Documents Card -->
    <div class="info-card" style="margin-bottom: 30px;">
        <h4>Attached Documents</h4>
        @if (documents == null || !documents.Any())
        {
            <p style="color: #64748b; font-style: italic;">No documents uploaded for this application.</p>
        }
        else
        {
            foreach (var doc in documents)
            {
                bool isPOP = doc.DocumentName.Contains("Proof of Application Fee Payment") || doc.DocumentName.Contains("Proof of Payment");
                <div class="doc-row @(isPOP ? "doc-row-highlight" : "")">
                    <div>
                        <span class="doc-name">
                            @doc.DocumentName
                            @if (isPOP)
                            {
                                <span class="badge-pop">Proof of Payment</span>
                            }
                        </span>
                        <div class="doc-meta">Uploaded on @(doc.CreatedDateTime.HasValue ? doc.CreatedDateTime.Value.ToString("yyyy-MM-dd HH:mm") : "N/A")</div>
                    </div>
                    <div>
                        @if (doc.FileId != null)
                        {
                            <a href="@Url.Action("GetDocument", "File", new { q = doc.File.Data })" class="btn-download @(isPOP ? "btn-download-highlight" : "")" target="_blank" id="btn-download-@doc.Id">
                                <i class="fa fa-download"></i> Download / View
                            </a>
                        }
                        else
                        {
                            <span class="text-muted" style="font-size: 12px; font-style: italic;">No file data</span>
                        }
                    </div>
                </div>
            }
        }
    </div>

    <!-- Action Section -->
    <div class="action-panel">
        <h4 style="margin-top:0; margin-bottom: 15px; font-weight: 700; font-size: 15px; text-transform: uppercase;">Payment Validation Decision</h4>
        
        @using (Html.BeginForm("VerifyPayment", "RealEstateAdmin", new { id = Model.Id }, FormMethod.Post, new { id = "verifyForm" }))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="decision" id="hidDecision" value="" />

            <div class="form-group" style="margin-bottom: 20px;">
                <label for="txtComment" style="font-weight: 600; color: #475569; margin-bottom: 8px;">Validation Comments / Feedback Reason:</label>
                @Html.TextArea("comment", Model.PaymentValidationComment, new { id = "txtComment", @class = "form-control", rows = "4", placeholder = "Provide details on the validated amount, or reasons for rejection if the proof is incorrect or missing...", style = "border-radius: 6px; border-color: var(--re-border-color); font-size: 14px;" })
                @Html.ValidationMessage("comment", "", new { @class = "text-danger", style = "font-size: 12px; font-weight: 600; margin-top: 4px; display: block;" })
            </div>

            <div style="display:flex; gap:12px; justify-content: flex-start; align-items: center; margin-top: 20px;">
                <button type="button" class="btn-action btn-approve" id="btn-approve-submit" onclick="showConfirmModal('Approve')">
                    <i class="fa fa-check"></i> Approve Payment
                </button>
                <button type="button" class="btn-action btn-reject" id="btn-reject-submit" onclick="showConfirmModal('Reject')">
                    <i class="fa fa-times"></i> Reject Payment
                </button>
                <a href="@Url.Action("ApplicationFeePayments", "RealEstateAdmin")" class="btn-action btn-cancel">
                    Cancel / Back
                </a>
            </div>
        }
    </div>
</div>

<!-- Custom Confirmation Modal -->
<div class="modal fade" id="confirmModal" tabindex="-1" role="dialog" aria-labelledby="confirmModalLabel" aria-hidden="true" style="margin-top: 10%;">
    <div class="modal-dialog" role="document">
        <div class="modal-content modal-content-gold">
            <div class="modal-header modal-header-gold">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close" style="color: white; opacity: 0.8;"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="confirmModalLabel" style="font-weight: 700; display:flex; align-items:center; gap:8px;">
                    <i class="fa fa-exclamation-triangle" style="color: var(--re-gold);"></i> Confirm Action
                </h4>
            </div>
            <div class="modal-body" style="padding: 24px; font-size: 15px; color: var(--re-text-dark); font-weight: 500;">
                <p id="modal-message"></p>
            </div>
            <div class="modal-footer" style="border-top: 1px solid var(--re-border-color); padding: 15px 24px; display:flex; justify-content:flex-end; gap:10px;">
                <button type="button" class="btn btn-default" data-dismiss="modal" style="border-radius: 6px; font-weight:600; padding:8px 16px;">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="submitConfirmed()" style="background-color: var(--re-gold); border-color: var(--re-gold); font-weight:600; border-radius: 6px; padding:8px 20px;">Yes, I am sure</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let selectedDecision = '';

        function showConfirmModal(decision) {
            selectedDecision = decision;
            if (decision === 'Approve') {
                $('#modal-message').text('Are you sure you want to submit the following document for approval?');
            } else {
                let comment = $('#txtComment').val();
                if (!comment || comment.trim() === '') {
                    alert('A rejection comments/reason is mandatory when rejecting proof of payment.');
                    return;
                }
                $('#modal-message').text('Are you sure you want to reject this payment?');
            }
            $('#confirmModal').modal('show');
        }

        function submitConfirmed() {
            $('#confirmModal').modal('hide');
            $('#hidDecision').val(selectedDecision);
            $('#verifyForm').submit();
        }
    </script>
}
