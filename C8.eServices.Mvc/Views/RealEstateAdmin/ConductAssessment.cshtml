@model C8.eServices.Mvc.Models.RE_Application
@{
    ViewBag.Title = "Conduct Risk Assessment";
    Layout = "~/Views/Shared/RCS_Layout.cshtml";
    var recommendationList = (IEnumerable<SelectListItem>)ViewBag.RecommendationList;
}

<style>
    :root {
        --re-gold: #c59b27;
        --re-gold-hover: #a37f1c;
        --re-gold-light: #fafaf9;
        --re-text-dark: #1c1917;
        --re-border-color: #e7e5e4;
        --re-slate-dark: #2e2a27;
        --re-slate-black: #1c1917;
    }

    .admin-container {
        padding: 30px 15px;
        font-family: 'Inter', 'Outfit', sans-serif;
        color: var(--re-text-dark);
    }

    .admin-header-card {
        background: linear-gradient(135deg, var(--re-slate-dark) 0%, var(--re-slate-black) 100%);
        color: #ffffff;
        border-radius: 12px;
        padding: 25px 30px;
        margin-bottom: 25px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
        border-left: 5px solid var(--re-gold);
    }

    .admin-title {
        font-size: 24px;
        font-weight: 700;
        margin: 0 0 5px 0;
        letter-spacing: -0.5px;
    }

    .admin-subtitle {
        font-size: 14px;
        color: #94a3b8;
        margin: 0;
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .info-card {
        background: #ffffff;
        border: 1px solid var(--re-border-color);
        border-radius: 12px;
        padding: 20px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    }

    .info-card h4 {
        margin-top: 0;
        margin-bottom: 15px;
        font-weight: 700;
        color: var(--re-slate-black);
        border-bottom: 2px solid var(--re-gold);
        padding-bottom: 6px;
        font-size: 15px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .info-item {
        display: flex;
        justify-content: space-between;
        padding: 8px 0;
        border-bottom: 1px dashed #f1f5f9;
        font-size: 13px;
    }

    .info-item:last-child {
        border-bottom: none;
    }

    .info-label {
        font-weight: 600;
        color: #64748b;
    }

    .info-value {
        color: #1e293b;
        font-weight: 500;
        text-align: right;
    }

    .form-section-title {
        font-size: 14px;
        font-weight: 700;
        text-transform: uppercase;
        color: #475569;
        letter-spacing: 0.5px;
        margin-top: 20px;
        margin-bottom: 15px;
        padding-bottom: 6px;
        border-bottom: 1px solid var(--re-border-color);
    }

    .vetting-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 15px;
        margin-bottom: 20px;
    }

    .btn-action {
        padding: 10px 24px;
        font-weight: 600;
        border-radius: 6px;
        transition: all 0.2s ease;
        font-size: 14px;
        cursor: pointer;
    }

    .btn-submit {
        background-color: var(--re-gold);
        border: 1px solid var(--re-gold);
        color: #ffffff;
    }

    .btn-submit:hover {
        background-color: var(--re-gold-hover);
        border-color: var(--re-gold-hover);
    }

    .btn-cancel {
        background-color: transparent;
        border: 1px solid #cbd5e1;
        color: #475569;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .btn-cancel:hover {
        background-color: #f1f5f9;
        color: #1e293b;
    }

    .modal-content-gold {
        border-radius: 12px;
        border: 2px solid var(--re-gold);
        background: #ffffff;
    }

    .modal-header-gold {
        background: linear-gradient(135deg, var(--re-slate-dark) 0%, var(--re-slate-black) 100%);
        color: #ffffff;
        border-top-left-radius: 10px;
        border-top-right-radius: 10px;
        border-bottom: 2px solid var(--re-gold);
    }
</style>

<div class="admin-container">
    <div class="admin-header-card">
        <h1 class="admin-title">Conduct Risk Assessment</h1>
        <p class="admin-subtitle">Capture risk metrics and recommend application @Model.ApplicationReferenceNumber.</p>
    </div>

    <!-- Info Grid -->
    <div class="info-grid">
        <div class="info-card">
            <h4>Application Details</h4>
            <div class="info-item">
                <span class="info-label">Reference Number:</span>
                <span class="info-value" style="font-weight: 700;">@Model.ApplicationReferenceNumber</span>
            </div>
            <div class="info-item">
                <span class="info-label">Applicant Name:</span>
                <span class="info-value">@(Model.Customer != null ? Model.Customer.FullName : "N/A")</span>
            </div>
            <div class="info-item">
                <span class="info-label">Applicant Type:</span>
                <span class="info-value">@Model.ApplicantType</span>
            </div>
            <div class="info-item">
                <span class="info-label">Payment Comments:</span>
                <span class="info-value" style="font-style: italic;">@(string.IsNullOrEmpty(Model.PaymentValidationComment) ? "None" : Model.PaymentValidationComment)</span>
            </div>
        </div>

        <div class="info-card">
            <h4>Premises Requested</h4>
            <div class="info-item">
                <span class="info-label">Facility Selected:</span>
                <span class="info-value">@(Model.SelectedFacility != null ? Model.SelectedFacility.Name : "N/A")</span>
            </div>
            <div class="info-item">
                <span class="info-label">Unit Type:</span>
                <span class="info-value">@(Model.SelectedFacilityUnit != null ? Model.SelectedFacilityUnit.UnitType : "N/A")</span>
            </div>
            <div class="info-item">
                <span class="info-label">Number of Units:</span>
                <span class="info-value">@Model.SelectedUnitCount</span>
            </div>
            <div class="info-item">
                <span class="info-label">Monthly Rental:</span>
                <span class="info-value" style="color: var(--re-gold); font-weight: 700;">R @string.Format("{0:N2}", Model.CalculatedMonthlyRental)</span>
            </div>
        </div>
    </div>

    <!-- Assessment Form Card -->
    <div class="info-card">
        <h4>Risk Assessment Outcome Details</h4>
        
        @using (Html.BeginForm("ConductAssessment", "RealEstateAdmin", new { id = Model.Id }, FormMethod.Post, new { id = "assessForm", enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()

            <div class="form-section-title">Vetting Agency Results</div>
            
            <div class="vetting-grid">
                <div class="form-group">
                    <label for="txtCredit" style="font-size: 13px; font-weight: 600; color: #475569;">Credit Bureau Result:</label>
                    @Html.TextBox("creditResult", Model.CreditBureauResult, new { id = "txtCredit", @class = "form-control", placeholder = "e.g. Cleared / Flags Found / Score: 680", style = "border-radius: 6px; border-color: var(--re-border-color); font-size: 13px;" })
                </div>
                <div class="form-group">
                    <label for="txtHomeAffairs" style="font-size: 13px; font-weight: 600; color: #475569;">Home Affairs Result:</label>
                    @Html.TextBox("homeAffairsResult", Model.HomeAffairsResult, new { id = "txtHomeAffairs", @class = "form-control", placeholder = "e.g. Verified / Active ID", style = "border-radius: 6px; border-color: var(--re-border-color); font-size: 13px;" })
                </div>
                <div class="form-group">
                    <label for="txtDeeds" style="font-size: 13px; font-weight: 600; color: #475569;">Deeds Result:</label>
                    @Html.TextBox("deedsResult", Model.DeedsResult, new { id = "txtDeeds", @class = "form-control", placeholder = "e.g. No Properties Owned", style = "border-radius: 6px; border-color: var(--re-border-color); font-size: 13px;" })
                </div>
                <div class="form-group">
                    <label for="txtSassa" style="font-size: 13px; font-weight: 600; color: #475569;">SASSA Result:</label>
                    @Html.TextBox("sassaResult", Model.SassaResult, new { id = "txtSassa", @class = "form-control", placeholder = "e.g. Non-Recipient", style = "border-radius: 6px; border-color: var(--re-border-color); font-size: 13px;" })
                </div>
                <div class="form-group">
                    <label for="txtCipc" style="font-size: 13px; font-weight: 600; color: #475569;">CIPC Result:</label>
                    @Html.TextBox("cipcResult", Model.CipcResult, new { id = "txtCipc", @class = "form-control", placeholder = "e.g. In Business / Active", style = "border-radius: 6px; border-color: var(--re-border-color); font-size: 13px;" })
                </div>
            </div>

            <div class="form-section-title">Risk Assessment Evaluation & Decision</div>

            <div class="row">
                <div class="col-md-6 form-group">
                    <label for="ddlRecommendation" style="font-weight: 600; color: #475569;">Risk Assessment Outcome Selection:</label>
                    @Html.DropDownList("recommendation", recommendationList, "-- Select Outcome --", new { id = "ddlRecommendation", @class = "form-control", style = "border-radius: 6px; border-color: var(--re-border-color); font-size: 14px;", onchange = "toggleReasonMandatory()" })
                    @Html.ValidationMessage("recommendation", "", new { @class = "text-danger", style = "font-size: 12px; font-weight: 600; margin-top: 4px; display: block;" })
                </div>
                <div class="col-md-6 form-group">
                    <label for="evidenceFile" style="font-weight: 600; color: #475569;">Upload Supporting Evidence (PDF/Photos):</label>
                    <input type="file" id="evidenceFile" name="evidenceFile" class="form-control" style="border-radius: 6px; border-color: var(--re-border-color); font-size: 13px; height: auto; padding: 6px 12px;" />
                </div>
            </div>

            <div class="form-group" style="margin-top: 15px;">
                <label for="txtReason" style="font-weight: 600; color: #475569; margin-bottom: 8px;">Reason / Recommendation Comments:</label>
                @Html.TextArea("reason", Model.RiskAssessmentReason, new { id = "txtReason", @class = "form-control", rows = "4", placeholder = "Provide rationale for this decision. If Not Recommended, this reason will be sent to the applicant as feedback...", style = "border-radius: 6px; border-color: var(--re-border-color); font-size: 14px;" })
                @Html.ValidationMessage("reason", "", new { @class = "text-danger", style = "font-size: 12px; font-weight: 600; margin-top: 4px; display: block;" })
            </div>

            <div style="display:flex; gap:12px; justify-content: flex-start; align-items: center; margin-top: 25px;">
                <button type="button" class="btn-action btn-submit" id="btn-submit-assessment" onclick="showConfirmModal()">
                    <i class="fa fa-paper-plane"></i> Submit Assessment
                </button>
                <a href="@Url.Action("RiskAssessments", "RealEstateAdmin")" class="btn-action btn-cancel">
                    Cancel
                </a>
            </div>
        }
    </div>
</div>

<!-- Custom Confirmation Modal -->
<div class="modal fade" id="confirmModal" tabindex="-1" role="dialog" aria-labelledby="confirmModalLabel" aria-hidden="true" style="margin-top: 10%;">
    <div class="modal-dialog" role="document">
        <div class="modal-content modal-content-gold">
            <div class="modal-header modal-header-gold">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close" style="color: white; opacity: 0.8;"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="confirmModalLabel" style="font-weight: 700; display:flex; align-items:center; gap:8px;">
                    <i class="fa fa-exclamation-triangle" style="color: var(--re-gold);"></i> Confirm Risk Assessment Submission
                </h4>
            </div>
            <div class="modal-body" style="padding: 24px; font-size: 15px; color: var(--re-text-dark); font-weight: 500;">
                <p>Are you sure you want to submit the following recommendation?</p>
            </div>
            <div class="modal-footer" style="border-top: 1px solid var(--re-border-color); padding: 15px 24px; display:flex; justify-content:flex-end; gap:10px;">
                <button type="button" class="btn btn-default" data-dismiss="modal" style="border-radius: 6px; font-weight:600; padding:8px 16px;">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="submitConfirmed()" style="background-color: var(--re-gold); border-color: var(--re-gold); font-weight:600; border-radius: 6px; padding:8px 20px;">Yes, I am sure</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function toggleReasonMandatory() {
            let recommendation = $('#ddlRecommendation').val();
            if (recommendation === 'Not Recommended') {
                $('#txtReason').prop('required', true).attr('placeholder', 'A detailed reason is mandatory for Not Recommended outcomes. This will be emailed to the applicant...');
            } else {
                $('#txtReason').prop('required', false).attr('placeholder', 'Provide recommendation comments or conditions of approval...');
            }
        }

        function showConfirmModal() {
            let recommendation = $('#ddlRecommendation').val();
            if (!recommendation) {
                alert('Please select a Risk Assessment Outcome.');
                return;
            }

            let reason = $('#txtReason').val();
            if (recommendation === 'Not Recommended' && (!reason || reason.trim() === '')) {
                alert('A reason is mandatory when selecting Not Recommended.');
                return;
            }

            $('#confirmModal').modal('show');
        }

        function submitConfirmed() {
            $('#confirmModal').modal('hide');
            $('#assessForm').submit();
        }

        $(document).ready(function() {
            toggleReasonMandatory();
        });
    </script>
}
