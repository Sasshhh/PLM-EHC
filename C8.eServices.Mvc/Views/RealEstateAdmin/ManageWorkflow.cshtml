@model dynamic
@{
    ViewBag.Title = "Workflow & Representative Management";
    Layout = "~/Views/Shared/RCS_Layout.cshtml";

    var departments = (IEnumerable<C8.eServices.Mvc.Models.DepartmentsCoE>)ViewBag.Departments;
    var representativeUsers = (IEnumerable<C8.eServices.Mvc.Models.SystemUser>)ViewBag.RepresentativeUsers;
    var committeeMembers = (IEnumerable<C8.eServices.Mvc.Models.SystemUser>)ViewBag.CommitteeMembers;
    var userSelectList = (IEnumerable<SelectListItem>)ViewBag.UserSelectList;
}

<style>
    :root {
        --re-gold: #c59b27;
        --re-gold-hover: #a37f1c;
        --re-gold-light: #fafaf9;
        --re-text-dark: #1c1917;
        --re-border-color: #e7e5e4;
        --re-slate-dark: #2e2a27;
        --re-slate-black: #1c1917;
        --re-light-bg: #f8fafc;
    }

    .admin-container {
        padding: 30px 15px;
        font-family: 'Inter', 'Outfit', sans-serif;
        color: var(--re-text-dark);
    }

    .admin-header-card {
        background: linear-gradient(135deg, var(--re-slate-dark) 0%, var(--re-slate-black) 100%);
        color: #ffffff;
        border-radius: 12px;
        padding: 25px 30px;
        margin-bottom: 25px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
        border-left: 5px solid var(--re-gold);
    }

    .admin-title {
        font-size: 24px;
        font-weight: 700;
        margin: 0 0 5px 0;
        letter-spacing: -0.5px;
    }

    .admin-subtitle {
        font-size: 14px;
        color: #94a3b8;
        margin: 0;
    }

    .nav-tabs-re {
        border-bottom: 2px solid var(--re-border-color);
        margin-bottom: 25px;
        display: flex;
        gap: 5px;
        padding: 0;
        list-style: none;
    }

    .nav-tabs-re li a {
        padding: 12px 20px;
        font-weight: 700;
        color: #64748b;
        text-decoration: none;
        border-bottom: 3px solid transparent;
        display: block;
        font-size: 14px;
        transition: all 0.2s ease;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .nav-tabs-re li.active a {
        color: var(--re-gold);
        border-bottom-color: var(--re-gold);
    }

    .nav-tabs-re li a:hover {
        color: var(--re-gold-hover);
        background-color: var(--re-light-bg);
        border-radius: 6px 6px 0 0;
    }

    .card-re {
        background: #ffffff;
        border: 1px solid var(--re-border-color);
        border-radius: 12px;
        padding: 25px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        margin-bottom: 25px;
    }

    .table-re {
        width: 100%;
        margin-bottom: 0;
        font-size: 13px;
        border-collapse: collapse;
    }

    .table-re th {
        background-color: var(--re-slate-dark);
        color: #ffffff;
        font-weight: 700;
        padding: 12px 15px;
        border: 1px solid var(--re-slate-dark);
        text-transform: uppercase;
        font-size: 11px;
        letter-spacing: 0.5px;
    }

    .table-re td {
        padding: 12px 15px;
        border-bottom: 1px solid var(--re-border-color);
        vertical-align: middle;
        color: #334155;
    }

    .table-re tr:hover {
        background-color: var(--re-light-bg);
    }

    .badge-status {
        padding: 3px 8px;
        border-radius: 4px;
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        display: inline-block;
    }

    .badge-active {
        background-color: #dcfce7;
        color: #15803d;
        border: 1px solid #bbf7d0;
    }

    .badge-inactive {
        background-color: #fee2e2;
        color: #b91c1c;
        border: 1px solid #fecaca;
    }

    .btn-re {
        padding: 8px 16px;
        font-weight: 600;
        border-radius: 6px;
        font-size: 13px;
        cursor: pointer;
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border: 1px solid transparent;
    }

    .btn-re-primary {
        background-color: var(--re-gold);
        color: #ffffff;
        border-color: var(--re-gold);
    }

    .btn-re-primary:hover {
        background-color: var(--re-gold-hover);
        border-color: var(--re-gold-hover);
        color: #ffffff;
    }

    .btn-re-secondary {
        background-color: transparent;
        border-color: #cbd5e1;
        color: #475569;
    }

    .btn-re-secondary:hover {
        background-color: #f1f5f9;
        color: #1e293b;
    }

    .modal-content-gold {
        border-radius: 12px;
        border: 2px solid var(--re-gold);
        background: #ffffff;
    }

    .modal-header-gold {
        background: linear-gradient(135deg, var(--re-slate-dark) 0%, var(--re-slate-black) 100%);
        color: #ffffff;
        border-top-left-radius: 10px;
        border-top-right-radius: 10px;
        border-bottom: 2px solid var(--re-gold);
    }
</style>

<div class="admin-container">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible" role="alert" style="border-radius: 8px; border-left: 4px solid #16a34a;">
            <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            <i class="fa fa-check-circle" style="margin-right: 8px; color: #16a34a;"></i> @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible" role="alert" style="border-radius: 8px; border-left: 4px solid #dc2626;">
            <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            <i class="fa fa-exclamation-circle" style="margin-right: 8px; color: #dc2626;"></i> @TempData["ErrorMessage"]
        </div>
    }

    <div class="admin-header-card">
        <h1 class="admin-title">Workflow & Representative Management</h1>
        <p class="admin-subtitle">Configure reviewing departments, map official representatives, and create evaluation committee member logins.</p>
    </div>

    <!-- Navigation Tabs -->
    <ul class="nav-tabs-re" id="workflowTabs" role="tablist">
        <li class="active"><a href="#tab-departments" data-toggle="tab"><i class="fa fa-sitemap"></i> Departments Mapping</a></li>
        <li><a href="#tab-representatives" data-toggle="tab"><i class="fa fa-users"></i> Representative Users</a></li>
        <li><a href="#tab-committee" data-toggle="tab"><i class="fa fa-gavel"></i> Committee Members</a></li>
    </ul>

    <!-- Tab Content -->
    <div class="tab-content">
        <!-- Tab 1: Departments -->
        <div class="tab-pane active fade in" id="tab-departments">
            <div class="card-re">
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 20px;">
                    <h3 style="margin:0; font-weight:700; font-size:16px;">Vetting & Reviewing Departments</h3>
                </div>

                <div class="table-responsive">
                    <table class="table-re">
                        <thead>
                            <tr>
                                <th style="width: 30%;">Department Name</th>
                                <th style="width: 40%;">Official Representative</th>
                                <th style="width: 15%;">Status</th>
                                <th style="width: 15%; text-align: center;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var dept in departments)
                            {
                                <tr>
                                    <td style="font-weight:700; color:var(--re-slate-black);">@dept.DepartmentName</td>
                                    <td>
                                        @if (dept.RepresentativeSystemUser != null)
                                        {
                                            <span><i class="fa fa-user" style="color:var(--re-gold); margin-right:6px;"></i> @dept.RepresentativeSystemUser.FullName (@dept.RepresentativeSystemUser.UserName)</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted" style="font-style:italic;"><i class="fa fa-warning"></i> Not Mapped</span>
                                        }
                                    </td>
                                    <td>
                                        @if (dept.IsActive)
                                        {
                                            <span class="badge-status badge-active">Enabled</span>
                                        }
                                        else
                                        {
                                            <span class="badge-status badge-inactive">Disabled</span>
                                        }
                                    </td>
                                    <td style="text-align: center;">
                                        <button class="btn-re btn-re-secondary" onclick="openEditDeptModal(@dept.Id, '@dept.DepartmentName', '@(dept.RepresentativeSystemUserId ?? 0)', '@dept.IsActive.ToString().ToLower()')">
                                            <i class="fa fa-edit"></i> Edit Mapping
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Tab 2: Representatives -->
        <div class="tab-pane fade" id="tab-representatives">
            <div class="card-re">
                <h3 style="margin:0 0 20px 0; font-weight:700; font-size:16px;">Internal Staff & Representatives</h3>
                <div class="table-responsive">
                    <table class="table-re">
                        <thead>
                            <tr>
                                <th>Full Name</th>
                                <th>Username</th>
                                <th>Email Address</th>
                                <th>Mobile Number</th>
                                <th>Designation</th>
                                <th>Mapped Department</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in representativeUsers)
                            {
                                // Find if this user maps to a department
                                var mappedDept = departments.FirstOrDefault(d => d.RepresentativeSystemUserId == user.Id);
                                <tr>
                                    <td style="font-weight:700; color:var(--re-slate-black);">@user.FullName</td>
                                    <td><code>@user.UserName</code></td>
                                    <td>@user.EmailAddress</td>
                                    <td>@(string.IsNullOrEmpty(user.MobileNumber) ? "N/A" : user.MobileNumber)</td>
                                    <td>@(string.IsNullOrEmpty(user.Designation) ? "N/A" : user.Designation)</td>
                                    <td>
                                        @if (mappedDept != null)
                                        {
                                            <span class="badge-status badge-active">@mappedDept.DepartmentName</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted" style="font-style:italic;">None</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Tab 3: Committee -->
        <div class="tab-pane fade" id="tab-committee">
            <div class="card-re">
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 20px;">
                    <h3 style="margin:0; font-weight:700; font-size:16px;">Evaluation Committee Members</h3>
                    <button class="btn-re btn-re-primary" data-toggle="modal" data-target="#createCommitteeModal">
                        <i class="fa fa-user-plus"></i> Create Committee Member
                    </button>
                </div>

                <div class="table-responsive">
                    <table class="table-re">
                        <thead>
                            <tr>
                                <th>Full Name</th>
                                <th>Username</th>
                                <th>Email Address</th>
                                <th>Mobile Number</th>
                                <th>Role</th>
                                <th>Account Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in committeeMembers)
                            {
                                <tr>
                                    <td style="font-weight:700; color:var(--re-slate-black);">@user.FullName</td>
                                    <td><code>@user.UserName</code></td>
                                    <td>@user.EmailAddress</td>
                                    <td>@(string.IsNullOrEmpty(user.MobileNumber) ? "N/A" : user.MobileNumber)</td>
                                    <td><span class="badge-status badge-active" style="background-color:#eff6ff; color:#1e40af; border:1px solid #bfdbfe;">Committee Member</span></td>
                                    <td>
                                        @if (user.IsActive)
                                        {
                                            <span class="badge-status badge-active">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge-status badge-inactive">Inactive</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal 1: Edit Department Mapping -->
<div class="modal fade" id="editDeptModal" tabindex="-1" role="dialog" aria-labelledby="editDeptModalLabel" aria-hidden="true" style="margin-top: 10%;">
    <div class="modal-dialog" role="document">
        <div class="modal-content modal-content-gold">
            <div class="modal-header modal-header-gold">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close" style="color: white; opacity: 0.8;"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="editDeptModalLabel" style="font-weight: 700;"><i class="fa fa-edit" style="color:var(--re-gold);"></i> Edit Department Mapping</h4>
            </div>
            @using (Html.BeginForm("SaveDepartmentMapping", "RealEstateAdmin", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="departmentId" id="editDeptId" />

                <div class="modal-body" style="padding: 24px;">
                    <div class="form-group">
                        <label style="font-weight:600; color:#475569; margin-bottom:6px;">Department Name</label>
                        <input type="text" class="form-control" id="editDeptName" disabled="disabled" style="background-color:#f1f5f9;" />
                    </div>

                    <div class="form-group" style="margin-top:15px;">
                        <label style="font-weight:600; color:#475569; margin-bottom:6px;">Official Representative</label>
                        @Html.DropDownList("representativeSystemUserId", userSelectList, "-- Select Representative --", new { @class = "form-control", id = "editDeptRep" })
                        <small class="text-muted">This representative user will be assigned review tasks for this department.</small>
                    </div>

                    <div class="form-group" style="margin-top:20px;">
                        <label style="font-weight:600; color:#475569; display:block; margin-bottom:8px;">Status</label>
                        <label class="radio-inline" style="font-weight:500;">
                            <input type="radio" name="isActive" id="editDeptActiveTrue" value="true" /> Enabled
                        </label>
                        <label class="radio-inline" style="font-weight:500; margin-left:15px;">
                            <input type="radio" name="isActive" id="editDeptActiveFalse" value="false" /> Disabled
                        </label>
                    </div>
                </div>

                <div class="modal-footer" style="border-top:1px solid var(--re-border-color); padding: 15px 24px; display:flex; justify-content:flex-end; gap:10px;">
                    <button type="button" class="btn btn-default" data-dismiss="modal" style="border-radius:6px; font-weight:600;">Cancel</button>
                    <button type="submit" class="btn btn-primary" style="background-color:var(--re-gold); border-color:var(--re-gold); font-weight:600; border-radius:6px; padding:8px 20px;">Save Changes</button>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal 2: Create Committee Member -->
<div class="modal fade" id="createCommitteeModal" tabindex="-1" role="dialog" aria-labelledby="createCommitteeModalLabel" aria-hidden="true" style="margin-top: 5%;">
    <div class="modal-dialog" role="document">
        <div class="modal-content modal-content-gold">
            <div class="modal-header modal-header-gold">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close" style="color: white; opacity: 0.8;"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="createCommitteeModalLabel" style="font-weight: 700;"><i class="fa fa-user-plus" style="color:var(--re-gold);"></i> Create Committee Member Account</h4>
            </div>
            @using (Html.BeginForm("CreateCommitteeMember", "RealEstateAdmin", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <div class="modal-body" style="padding: 24px; max-height:450px; overflow-y:auto;">
                    <div class="row">
                        <div class="col-md-6 form-group">
                            <label style="font-weight:600; color:#475569; margin-bottom:4px;">First Name *</label>
                            <input type="text" name="firstName" class="form-control" required="required" placeholder="Enter first name" />
                        </div>
                        <div class="col-md-6 form-group">
                            <label style="font-weight:600; color:#475569; margin-bottom:4px;">Last Name *</label>
                            <input type="text" name="lastName" class="form-control" required="required" placeholder="Enter last name" />
                        </div>
                    </div>

                    <div class="form-group" style="margin-top:15px;">
                        <label style="font-weight:600; color:#475569; margin-bottom:4px;">Username *</label>
                        <input type="text" name="userName" class="form-control" required="required" placeholder="Choose a unique username" />
                    </div>

                    <div class="form-group" style="margin-top:15px;">
                        <label style="font-weight:600; color:#475569; margin-bottom:4px;">Email Address *</label>
                        <input type="email" name="emailAddress" class="form-control" required="required" placeholder="Enter email address" />
                    </div>

                    <div class="row" style="margin-top:15px;">
                        <div class="col-md-6 form-group">
                            <label style="font-weight:600; color:#475569; margin-bottom:4px;">Mobile Number</label>
                            <input type="text" name="mobileNumber" class="form-control" placeholder="Enter mobile number" />
                        </div>
                        <div class="col-md-6 form-group">
                            <label style="font-weight:600; color:#475569; margin-bottom:4px;">ID / Passport No</label>
                            <input type="text" name="identificationNumber" class="form-control" placeholder="Enter identity number" />
                        </div>
                    </div>

                    <div class="form-group" style="margin-top:15px;">
                        <label style="font-weight:600; color:#475569; margin-bottom:4px;">Employee/Service Number</label>
                        <input type="text" name="employeeNumber" class="form-control" placeholder="Enter employee number" />
                    </div>
                </div>

                <div class="modal-footer" style="border-top:1px solid var(--re-border-color); padding: 15px 24px; display:flex; justify-content:flex-end; gap:10px;">
                    <button type="button" class="btn btn-default" data-dismiss="modal" style="border-radius:6px; font-weight:600;">Cancel</button>
                    <button type="submit" class="btn btn-primary" style="background-color:var(--re-gold); border-color:var(--re-gold); font-weight:600; border-radius:6px; padding:8px 20px;">Create Member</button>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openEditDeptModal(id, name, repUserId, isActive) {
            $('#editDeptId').val(id);
            $('#editDeptName').val(name);
            
            if (repUserId && repUserId !== '0') {
                $('#editDeptRep').val(repUserId);
            } else {
                $('#editDeptRep').val('');
            }

            if (isActive === true || isActive === 'true') {
                $('#editDeptActiveTrue').prop('checked', true);
            } else {
                $('#editDeptActiveFalse').prop('checked', true);
            }

            $('#editDeptModal').modal('show');
        }
    </script>
}
