@model C8.eServices.Mvc.Models.RE_Application
@{
    ViewBag.Title = "Authorise PTO Request";
    Layout = "~/Views/Shared/RCS_Layout.cshtml";
}

<style>
    :root {
        --re-gold: #c59b27;
        --re-gold-hover: #a37f1c;
        --re-border-color: #e7e5e4;
        --re-slate-dark: #2e2a27;
        --re-slate-black: #1c1917;
    }

    .admin-container {
        padding: 30px 15px;
        font-family: 'Inter', sans-serif;
    }

    .admin-header-card {
        background: linear-gradient(135deg, var(--re-slate-dark) 0%, var(--re-slate-black) 100%);
        color: #ffffff;
        border-radius: 12px;
        padding: 25px 30px;
        margin-bottom: 25px;
        border-left: 5px solid var(--re-gold);
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .info-card {
        background: #ffffff;
        border: 1px solid var(--re-border-color);
        border-radius: 12px;
        padding: 20px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    }

    .info-card h4 {
        margin-top: 0;
        margin-bottom: 15px;
        font-weight: 700;
        color: var(--re-slate-black);
        border-bottom: 2px solid var(--re-gold);
        padding-bottom: 6px;
        font-size: 15px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .info-item {
        display: flex;
        justify-content: space-between;
        padding: 8px 0;
        border-bottom: 1px dashed #f1f5f9;
        font-size: 13px;
    }

    .info-item:last-child {
        border-bottom: none;
    }

    .info-label {
        font-weight: 600;
        color: #64748b;
    }

    .info-value {
        color: #1e293b;
        font-weight: 500;
        text-align: right;
    }

    .form-card {
        background: #ffffff;
        border: 1px solid var(--re-border-color);
        border-radius: 12px;
        padding: 24px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    }

    .btn-re-gold {
        background-color: var(--re-gold);
        color: #ffffff;
        border: 1px solid var(--re-gold);
        padding: 10px 24px;
        border-radius: 6px;
        font-weight: 600;
        cursor: pointer;
        font-size: 14px;
    }

    .btn-re-gold:hover {
        background-color: var(--re-gold-hover);
        border-color: var(--re-gold-hover);
    }

    .btn-cancel {
        background-color: transparent;
        border: 1px solid #cbd5e1;
        color: #475569;
        text-decoration: none;
        padding: 10px 24px;
        border-radius: 6px;
        font-weight: 600;
        font-size: 14px;
        display: inline-block;
    }

    .btn-cancel:hover {
        background-color: #f1f5f9;
        color: #1e293b;
    }

    .signature-area {
        background-color: #fafaf9;
        border: 2px dashed var(--re-gold);
        border-radius: 8px;
        padding: 15px;
        text-align: center;
        margin-top: 15px;
    }

    .signature-canvas-container {
        display: inline-block;
        background-color: #ffffff;
        border: 1px solid var(--re-border-color);
        border-radius: 4px;
    }

    #signatureCanvas {
        cursor: crosshair;
    }
</style>

<div class="admin-container">
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger" style="border-radius: 8px; border-left: 4px solid #dc2626;">
            <i class="fa fa-exclamation-circle"></i> @TempData["ErrorMessage"]
        </div>
    }

    <div class="admin-header-card">
        <h1 style="margin:0 0 5px 0; font-size:24px; font-weight:700;">HoD PTO Authorisation</h1>
        <p style="margin:0; font-size:14px; color:#cbd5e1;">Finalize Permission to Occupy decision and sign off for PTO Ref @Model.PtoReferenceNumber.</p>
    </div>

    <div class="info-grid">
        <div class="info-card">
            <h4>PTO Details</h4>
            <div class="info-item">
                <span class="info-label">PTO Ref Number:</span>
                <span class="info-value" style="font-weight:700; color:var(--re-gold);">@Model.PtoReferenceNumber</span>
            </div>
            <div class="info-item">
                <span class="info-label">Applicant Name:</span>
                <span class="info-value">@(Model.Customer != null ? Model.Customer.FullName : "N/A")</span>
            </div>
            <div class="info-item">
                <span class="info-label">Officer Recommendation:</span>
                <span class="info-value" style="font-weight:600;">@Model.PtoReviewRecommendation</span>
            </div>
        </div>

        <div class="info-card">
            <h4>Recommendation Detail</h4>
            <div class="info-item">
                <span class="info-label">Officer Comments:</span>
                <span class="info-value" style="text-align:left; max-width:200px;">@Model.PtoReviewReason</span>
            </div>
            <div class="info-item">
                <span class="info-label">Occupation Period:</span>
                <span class="info-value">
                    @(Model.PtoStartDate.HasValue ? Model.PtoStartDate.Value.ToString("yyyy-MM-dd") : "") to
                    @(Model.PtoEndDate.HasValue ? Model.PtoEndDate.Value.ToString("yyyy-MM-dd") : "")
                </span>
            </div>
        </div>
    </div>

    <div class="form-card">
        <h4 style="margin-top:0; margin-bottom: 20px; font-weight: 700; font-size:16px; border-bottom: 2px solid var(--re-gold); padding-bottom: 8px;">Final Decision</h4>

        @using (Html.BeginForm("AuthorisePto", "RealEstateAdmin", new { id = Model.Id }, FormMethod.Post, new { id = "ptoAuthoriseForm" }))
        {
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label style="font-weight:600; color:#475569;">HoD Final Outcome *</label>
                @Html.DropDownList("decision", new List<SelectListItem>
                {
                    new SelectListItem { Value = "Approve", Text = "Approve PTO Request" },
                    new SelectListItem { Value = "Approve with Conditions", Text = "Approve PTO with Conditions" },
                    new SelectListItem { Value = "Reject", Text = "Reject / Decline PTO" }
                }, "-- Select Decision --", new { @class = "form-control", required = "required", id = "ddlDecision" })
            </div>

            <div class="form-group" style="margin-top: 15px;">
                <label style="font-weight:600; color:#475569;">HoD Comments / Conditions</label>
                @Html.TextArea("comments", "", new { @class = "form-control", rows = "4", placeholder = "Detail specific comments or conditions..." })
            </div>

            <div class="signature-area">
                <label style="font-weight:600; color:#475569; display:block; margin-bottom:10px;">Draw Signature below *</label>
                <div class="signature-canvas-container">
                    <canvas id="signatureCanvas" width="400" height="150"></canvas>
                </div>
                <div style="margin-top: 8px;">
                    <button type="button" class="btn btn-sm btn-default" onclick="clearSignatureCanvas()">
                        <i class="fa fa-eraser"></i> Clear Signature
                    </button>
                </div>
                <input type="hidden" name="signature" id="signatureInput" />
            </div>

            <div style="margin-top: 25px; display:flex; gap:12px;">
                <button type="button" class="btn-re-gold" id="btn-submit-pto-auth" onclick="validateAndSubmit()">
                    <i class="fa fa-pencil-square-o"></i> Submit Authorization
                </button>
                <a href="@Url.Action("PtoAuthorisations", "RealEstateAdmin")" class="btn-cancel">
                    Cancel / Back
                </a>
            </div>
        }
    </div>
</div>

<!-- Custom Confirmation Modal -->
<div class="modal fade" id="confirmModal" tabindex="-1" role="dialog" aria-labelledby="confirmModalLabel" aria-hidden="true" style="margin-top: 10%;">
    <div class="modal-dialog" role="document">
        <div class="modal-content" style="border-radius: 12px; border: 2px solid var(--re-gold);">
            <div class="modal-header" style="background: linear-gradient(135deg, var(--re-slate-dark) 0%, var(--re-slate-black) 100%); color:#ffffff; border-bottom: 2px solid var(--re-gold);">
                <button type="button" class="close" data-dismiss="modal" style="color:white; opacity:0.8;">&times;</button>
                <h4 class="modal-title" id="confirmModalLabel" style="font-weight: 700;">Confirm PTO Decision</h4>
            </div>
            <div class="modal-body" style="padding: 20px; font-size:15px; font-weight:500;">
                <p>Are you sure you want to log the final authorization for this Permission to Occupy?</p>
            </div>
            <div class="modal-footer" style="padding:15px 20px; display:flex; justify-content:flex-end; gap:10px;">
                <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="submitConfirmed()" style="background-color: var(--re-gold); border-color: var(--re-gold); font-weight:600;">Yes, Finalise</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var canvas;
        var ctx;
        var drawing = false;
        var hasDrawn = false;

        function getX(e) {
            return e.clientX - canvas.getBoundingClientRect().left;
        }

        function getY(e) {
            return e.clientY - canvas.getBoundingClientRect().top;
        }

        function clearSignatureCanvas() {
            if (ctx) {
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                hasDrawn = false;
                $('#signatureInput').val('');
            }
        }

        $(document).ready(function() {
            canvas = document.getElementById('signatureCanvas');
            if (canvas) {
                ctx = canvas.getContext('2d');

                // Setup drawing events for desktop
                canvas.addEventListener('mousedown', function(e) {
                    drawing = true;
                    ctx.beginPath();
                    ctx.moveTo(getX(e), getY(e));
                });

                canvas.addEventListener('mousemove', function(e) {
                    if (drawing) {
                        ctx.lineTo(getX(e), getY(e));
                        ctx.stroke();
                        hasDrawn = true;
                    }
                });

                canvas.addEventListener('mouseup', function() {
                    drawing = false;
                });

                // Setup drawing events for mobile
                canvas.addEventListener('touchstart', function(e) {
                    drawing = true;
                    var touch = e.touches[0];
                    ctx.beginPath();
                    ctx.moveTo(touch.clientX - canvas.getBoundingClientRect().left, touch.clientY - canvas.getBoundingClientRect().top);
                    e.preventDefault();
                });

                canvas.addEventListener('touchmove', function(e) {
                    if (drawing) {
                        var touch = e.touches[0];
                        ctx.lineTo(touch.clientX - canvas.getBoundingClientRect().left, touch.clientY - canvas.getBoundingClientRect().top);
                        ctx.stroke();
                        hasDrawn = true;
                    }
                    e.preventDefault();
                });

                canvas.addEventListener('touchend', function() {
                    drawing = false;
                });
            }
        });

        function validateAndSubmit() {
            let decision = $('#ddlDecision').val();

            if (!decision || decision === '') {
                alert('HoD decision outcome is required.');
                return;
            }

            if (!hasDrawn) {
                alert('Please sign on the signature pad canvas.');
                return;
            }

            var dataUrl = canvas.toDataURL();
            $('#signatureInput').val(dataUrl);

            $('#confirmModal').modal('show');
        }

        function submitConfirmed() {
            $('#confirmModal').modal('hide');
            $('#ptoAuthoriseForm').submit();
        }
    </script>
}
