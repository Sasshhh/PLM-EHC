@model C8.eServices.Mvc.Models.RE_Application
@{
    ViewBag.Title = "Sign PTO Certificate";
    Layout = "~/Views/Shared/RCS_Layout.cshtml";
}

<style>
    :root {
        --re-gold: #c59b27;
        --re-gold-hover: #a37f1c;
        --re-border-color: #e7e5e4;
        --re-slate-dark: #2e2a27;
        --re-slate-black: #1c1917;
    }

    .admin-container {
        padding: 30px 15px;
        font-family: 'Inter', sans-serif;
    }

    .admin-header-card {
        background: linear-gradient(135deg, var(--re-slate-dark) 0%, var(--re-slate-black) 100%);
        color: #ffffff;
        border-radius: 12px;
        padding: 25px 30px;
        margin-bottom: 25px;
        border-left: 5px solid var(--re-gold);
    }

    .info-card {
        background: #ffffff;
        border: 1px solid var(--re-border-color);
        border-radius: 12px;
        padding: 20px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        margin-bottom: 20px;
    }

    .info-card h4 {
        margin-top: 0;
        margin-bottom: 15px;
        font-weight: 700;
        color: var(--re-slate-black);
        border-bottom: 2px solid var(--re-gold);
        padding-bottom: 6px;
        font-size: 15px;
        text-transform: uppercase;
    }

    .info-item {
        display: flex;
        justify-content: space-between;
        padding: 8px 0;
        border-bottom: 1px dashed #f1f5f9;
        font-size: 13px;
    }

    .info-label {
        font-weight: 600;
        color: #64748b;
    }

    .info-value {
        color: #1e293b;
        font-weight: 500;
    }

    .form-card {
        background: #ffffff;
        border: 1px solid var(--re-border-color);
        border-radius: 12px;
        padding: 24px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    }

    .btn-re-gold {
        background-color: var(--re-gold);
        color: #ffffff;
        border: 1px solid var(--re-gold);
        padding: 10px 24px;
        border-radius: 6px;
        font-weight: 600;
        cursor: pointer;
        font-size: 14px;
    }

    .btn-re-gold:hover {
        background-color: var(--re-gold-hover);
        border-color: var(--re-gold-hover);
    }

    .signature-area {
        background-color: #fafaf9;
        border: 2px dashed var(--re-gold);
        border-radius: 8px;
        padding: 15px;
        text-align: center;
        margin-top: 15px;
    }

    .signature-canvas-container {
        display: inline-block;
        background-color: #ffffff;
        border: 1px solid var(--re-border-color);
        border-radius: 4px;
    }

    #signatureCanvas {
        cursor: crosshair;
    }
</style>

<div class="admin-container">
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            <i class="fa fa-exclamation-circle"></i> @TempData["ErrorMessage"]
        </div>
    }

    <div class="admin-header-card">
        <h1 style="margin:0 0 5px 0; font-size:24px;">HoD PTO Signature</h1>
        <p style="margin:0; font-size:14px; color:#cbd5e1;">Review the drafted Permission to Occupy certificate and apply your signature.</p>
    </div>

    <div class="info-card">
        <h4>PTO Letter Specifications</h4>
        <div class="info-item">
            <span class="info-label">Reference:</span>
            <span class="info-value" style="font-weight:700; color:var(--re-gold);">@Model.PtoReferenceNumber</span>
        </div>
        <div class="info-item">
            <span class="info-label">Applicant/Tenant Name:</span>
            <span class="info-value">@Model.EntityName</span>
        </div>
        <div class="info-item">
            <span class="info-label">Purpose:</span>
            <span class="info-value">@Model.PtoPurposeOfOccupation</span>
        </div>
        <div class="info-item">
            <span class="info-label">Duration:</span>
            <span class="info-value">@(Model.PtoStartDate.HasValue ? Model.PtoStartDate.Value.ToString("yyyy-MM-dd") : "") to @(Model.PtoEndDate.HasValue ? Model.PtoEndDate.Value.ToString("yyyy-MM-dd") : "") (Max 12 Months)</span>
        </div>
    </div>

    <div class="form-card">
        <h4 style="margin-top:0; margin-bottom: 20px; font-weight:700;">Final Decision & Signature</h4>

        @using (Html.BeginForm("SignPtoCertificate", "RealEstateAdmin", new { id = Model.Id }, FormMethod.Post, new { id = "ptoSignForm" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.Id)

            <div class="form-group">
                <label style="font-weight:600; color:#475569;">Decision *</label>
                @Html.DropDownList("decision", new List<SelectListItem>
                {
                    new SelectListItem { Value = "Approve", Text = "Approve & Sign Certificate" },
                    new SelectListItem { Value = "Reject", Text = "Reject Draft Certificate" }
                }, "-- Select Option --", new { @class = "form-control", required = "required", id = "ddlDecision" })
            </div>

            <div class="form-group" style="margin-top: 15px;">
                <label style="font-weight:600; color:#475569;">Comments / Rationale</label>
                @Html.TextArea("comments", "", new { @class = "form-control", rows = "4", placeholder = "Enter approval comments or rejection reason..." })
            </div>

            <div class="signature-area">
                <label style="font-weight:600; color:#475569; display:block; margin-bottom:10px;">Draw Signature below *</label>
                <div class="signature-canvas-container">
                    <canvas id="signatureCanvas" width="400" height="150"></canvas>
                </div>
                <div style="margin-top: 8px;">
                    <button type="button" class="btn btn-sm btn-default" onclick="clearSignatureCanvas()">
                        <i class="fa fa-eraser"></i> Clear Pad
                    </button>
                </div>
                <input type="hidden" name="signature" id="signatureInput" />
            </div>

            <div style="margin-top: 25px; display:flex; gap:12px;">
                <button type="button" class="btn-re-gold" id="btn-submit-pto-sign" onclick="validateAndSubmit()">
                    <i class="fa fa-check"></i> Submit
                </button>
                <a href="@Url.Action("PtoSignatureQueue")" class="btn btn-default" style="padding:10px 24px;">Cancel</a>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        var canvas;
        var ctx;
        var drawing = false;
        var hasDrawn = false;

        function getX(e) {
            return e.clientX - canvas.getBoundingClientRect().left;
        }

        function getY(e) {
            return e.clientY - canvas.getBoundingClientRect().top;
        }

        function clearSignatureCanvas() {
            if (ctx) {
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                hasDrawn = false;
                $('#signatureInput').val('');
            }
        }

        $(document).ready(function() {
            canvas = document.getElementById('signatureCanvas');
            if (canvas) {
                ctx = canvas.getContext('2d');
                canvas.addEventListener('mousedown', function(e) {
                    drawing = true;
                    ctx.beginPath();
                    ctx.moveTo(getX(e), getY(e));
                });
                canvas.addEventListener('mousemove', function(e) {
                    if (drawing) {
                        ctx.lineTo(getX(e), getY(e));
                        ctx.stroke();
                        hasDrawn = true;
                    }
                });
                canvas.addEventListener('mouseup', function() {
                    drawing = false;
                });
            }
        });

        function validateAndSubmit() {
            let decision = $('#ddlDecision').val();
            if (!decision || decision === '') {
                alert('Decision is required.');
                return;
            }
            if (!hasDrawn) {
                alert('Signature is required.');
                return;
            }
            var dataUrl = canvas.toDataURL();
            $('#signatureInput').val(dataUrl);
            $('#ptoSignForm').submit();
        }
    </script>
}
