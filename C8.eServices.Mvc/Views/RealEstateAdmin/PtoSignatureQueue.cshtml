@model IEnumerable<C8.eServices.Mvc.Models.RE_Application>
@{
    ViewBag.Title = "PTO Signature Queue";
    Layout = "~/Views/Shared/RCS_Layout.cshtml";
}

<style>
    :root {
        --re-gold: #c59b27;
        --re-gold-hover: #a37f1c;
        --re-gold-light: #fafaf9;
        --re-text-dark: #1c1917;
        --re-border-color: #e7e5e4;
        --re-slate-dark: #2e2a27;
        --re-slate-black: #1c1917;
    }

    .admin-container {
        padding: 30px 15px;
        font-family: 'Inter', sans-serif;
        color: var(--re-text-dark);
    }

    .admin-header-card {
        background: linear-gradient(135deg, var(--re-slate-dark) 0%, var(--re-slate-black) 100%);
        color: #ffffff;
        border-radius: 12px;
        padding: 30px;
        margin-bottom: 25px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
        border-left: 5px solid var(--re-gold);
    }

    .admin-title {
        font-size: 28px;
        font-weight: 700;
        margin: 0 0 10px 0;
    }

    .admin-card {
        background: #ffffff;
        border: 1px solid var(--re-border-color);
        border-radius: 12px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        padding: 24px;
        margin-bottom: 30px;
    }

    .admin-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
    }

    .admin-table th {
        background-color: #f8fafc;
        color: #475569;
        font-weight: 600;
        text-transform: uppercase;
        font-size: 12px;
        padding: 14px 16px;
        border-bottom: 2px solid var(--re-border-color);
    }

    .admin-table td {
        padding: 16px;
        border-bottom: 1px solid var(--re-border-color);
        font-size: 14px;
        color: #334155;
        vertical-align: middle;
    }

    .btn-re-gold {
        background-color: var(--re-gold);
        color: #ffffff;
        font-weight: 600;
        border: 1px solid var(--re-gold);
        padding: 8px 16px;
        border-radius: 6px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .btn-re-gold:hover {
        background-color: var(--re-gold-hover);
        color: #ffffff;
    }
</style>

<div class="admin-container">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            <i class="fa fa-check-circle"></i> @TempData["SuccessMessage"]
        </div>
    }

    <div class="admin-header-card">
        <h1 class="admin-title">PTO Authorization & Signature Queue</h1>
        <p style="margin:0; color: #94a3b8;">Review and digitally sign drafted Permission to Occupy letters (UC 21).</p>
    </div>

    <div class="admin-card">
        <h3 style="margin-top:0; margin-bottom:20px; font-weight:700; border-bottom: 2px solid var(--re-gold); padding-bottom: 8px; display:inline-block;">Awaiting Signature</h3>

        @if (Model == null || !Model.Any())
        {
            <div style="text-align: center; padding: 40px; color: #64748b;">
                <i class="fa fa-folder-open-o" style="font-size: 48px; color: #cbd5e1; margin-bottom: 15px;"></i>
                <p>No certificates awaiting signature.</p>
            </div>
        }
        else
        {
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Reference</th>
                        <th>Applicant</th>
                        <th>Purpose</th>
                        <th>PTO Period</th>
                        <th>Status</th>
                        <th style="text-align: right;">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var app in Model)
                    {
                        <tr>
                            <td style="font-weight: 700;">@app.ApplicationReferenceNumber</td>
                            <td>@app.EntityName</td>
                            <td>@app.PtoPurposeOfOccupation</td>
                            <td>@(app.PtoStartDate.HasValue ? app.PtoStartDate.Value.ToString("yyyy-MM-dd") : "N/A") to @(app.PtoEndDate.HasValue ? app.PtoEndDate.Value.ToString("yyyy-MM-dd") : "N/A")</td>
                            <td>@app.Status.Name</td>
                            <td style="text-align: right;">
                                <a href="@Url.Action("SignPtoCertificate", "RealEstateAdmin", new { id = app.Id })" class="btn-re-gold" id="btn-sign-pto-@app.Id">
                                    <i class="fa fa-pencil"></i> Authorize & Sign
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
