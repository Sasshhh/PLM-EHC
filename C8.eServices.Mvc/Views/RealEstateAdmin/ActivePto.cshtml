@model IEnumerable<C8.eServices.Mvc.Models.RE_Application>
@{
    ViewBag.Title = "Active PTO List";
    Layout = "~/Views/Shared/RCS_Layout.cshtml";
}

<style>
    :root {
        --re-gold: #c59b27;
        --re-gold-hover: #a37f1c;
        --re-border-color: #e7e5e4;
        --re-slate-dark: #2e2a27;
        --re-slate-black: #1c1917;
    }

    .admin-container {
        padding: 30px 15px;
        font-family: 'Inter', sans-serif;
    }

    .admin-header-card {
        background: linear-gradient(135deg, var(--re-slate-dark) 0%, var(--re-slate-black) 100%);
        color: #ffffff;
        border-radius: 12px;
        padding: 30px;
        margin-bottom: 25px;
        border-left: 5px solid var(--re-gold);
    }

    .admin-card {
        background: #ffffff;
        border: 1px solid var(--re-border-color);
        border-radius: 12px;
        padding: 24px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    }

    .admin-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
    }

    .admin-table th {
        background-color: #f8fafc;
        color: #475569;
        font-weight: 600;
        text-transform: uppercase;
        font-size: 12px;
        padding: 14px 16px;
        border-bottom: 2px solid var(--re-border-color);
    }

    .admin-table td {
        padding: 16px;
        border-bottom: 1px solid var(--re-border-color);
        font-size: 14px;
        color: #334155;
        vertical-align: middle;
    }

    .btn-revoke {
        background-color: #dc2626;
        color: white;
        border: 1px solid #dc2626;
        border-radius: 6px;
        padding: 8px 16px;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .btn-revoke:hover {
        background-color: #b91c1c;
        color: white;
    }
</style>

<div class="admin-container">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            <i class="fa fa-check-circle"></i> @TempData["SuccessMessage"]
        </div>
    }

    <div class="admin-header-card">
        <h1 class="admin-title" style="margin:0 0 5px 0; font-size:24px; font-weight:700;">Active Permission to Occupy Records</h1>
        <p style="margin:0; font-size:14px; color:#cbd5e1;">Monitor and manage active commercial Permission to Occupy certificates (UC 22).</p>
    </div>

    <div class="admin-card">
        <h3 style="margin-top:0; margin-bottom:20px; font-weight:700; border-bottom:2px solid var(--re-gold); padding-bottom:8px; display:inline-block;">Active PTOs</h3>

        @if (Model == null || !Model.Any())
        {
            <div style="text-align: center; padding: 40px; color: #64748b;">
                <i class="fa fa-folder-open-o" style="font-size: 48px; color: #cbd5e1; margin-bottom: 15px;"></i>
                <p>No active Permission to Occupy records found.</p>
            </div>
        }
        else
        {
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>PTO Reference</th>
                        <th>Applicant</th>
                        <th>Address</th>
                        <th>Start Date</th>
                        <th>End Date</th>
                        <th style="text-align: right;">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var app in Model)
                    {
                        <tr>
                            <td style="font-weight: 700; color: var(--re-gold);">@app.PtoReferenceNumber</td>
                            <td>@app.EntityName</td>
                            <td>@app.PropertyAddress</td>
                            <td>@(app.PtoStartDate.HasValue ? app.PtoStartDate.Value.ToString("yyyy-MM-dd") : "N/A")</td>
                            <td>@(app.PtoEndDate.HasValue ? app.PtoEndDate.Value.ToString("yyyy-MM-dd") : "N/A")</td>
                            <td style="text-align: right;">
                                <a href="@Url.Action("RevokePto", "RealEstateAdmin", new { id = app.Id })" class="btn-revoke" id="btn-revoke-pto-@app.Id">
                                    <i class="fa fa-ban"></i> Initiate Revocation
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
