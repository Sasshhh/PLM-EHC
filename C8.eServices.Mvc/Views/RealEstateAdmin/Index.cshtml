@section Scripts {
    <script type="text/javascript">
        $(document).ready(function () {
            // Interactive Tab Toggles
            $(".admin-tab-item").click(function () {
                var target = $(this).attr("data-target");

                $(".admin-tab-item").removeClass("active");
                $(this).addClass("active");

                $(".admin-tab-content").removeClass("active");
                $(target).addClass("active");
            });

            // Edit Category Trigger
            $(".edit-category-btn").click(function () {
                var id = $(this).data("id");
                var name = $(this).data("name");
                var tariff = $(this).data("tariff");

                $("#editCategoryModal [name='id']").val(id);
                $("#editCategoryModal [name='name']").val(name);
                $("#editCategoryModal [name='tariffPerSqm']").val(tariff);

                $("#editCategoryModal").modal("show");
            });

            // Edit Facility Trigger
            $(".edit-facility-btn").click(function () {
                var id = $(this).data("id");
                var name = $(this).data("name");
                var cccid = $(this).data("cccid");
                var address = $(this).data("address");

                $("#editFacilityModal [name='id']").val(id);
                $("#editFacilityModal [name='name']").val(name);
                $("#editFacilityModal [name='cccId']").val(cccid);
                $("#editFacilityModal [name='address']").val(address);

                $("#editFacilityModal").modal("show");
            });

            // Edit Unit Trigger
            $(".edit-unit-btn").click(function () {
                var id = $(this).data("id");
                var facility = $(this).data("facility");
                var categoryid = $(this).data("categoryid");
                var unittype = $(this).data("unittype");
                var unitsize = $(this).data("unitsize");
                var maxunits = $(this).data("maxunits");

                $("#editUnitModal [name='Id']").val(id);
                $("#editUnitModal #editUnitFacilityName").text(facility);
                $("#editUnitModal [name='FacilityCategoryId']").val(categoryid);
                $("#editUnitModal [name='UnitType']").val(unittype);
                $("#editUnitModal [name='UnitSize']").val(unitsize);
                $("#editUnitModal [name='MaxUnits']").val(maxunits);

                $("#editUnitModal").modal("show");
            });
        });
    </script>
}
