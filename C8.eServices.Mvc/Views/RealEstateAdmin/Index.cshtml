                </div>
                <div class="modal-footer" style="border-top: 1px solid var(--re-border-color); padding: 18px 24px;">
                    <button type="button" class="btn btn-default" data-dismiss="modal" style="border-radius: 8px; font-weight: 600; padding: 8px 18px;">Cancel</button>
                    <button type="submit" class="btn btn-add-gold" style="padding: 8px 22px;">Save Changes</button>
                </div>
            }
        </div>
    </div>
</div>

