            <div class="col-sm-3 form-group">
                <label for="LeaseContactTelephone1">Telephone Number 1</label>
                @Html.TextBoxFor(m => m.LeaseContactTelephone1, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.LeaseContactTelephone1, "", new { @class = "text-danger" })
            </div>
            <div class="col-sm-3 form-group">
                <label for="LeaseContactTelephone2">Telephone Number 2</label>
                @Html.TextBoxFor(m => m.LeaseContactTelephone2, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.LeaseContactTelephone2, "", new { @class = "text-danger" })
            </div>
            <div class="col-sm-6 form-group">
                <label for="LeaseContactEmail1">E-mail Address 1</label>
                @Html.TextBoxFor(m => m.LeaseContactEmail1, new { @class = "form-control", type = "email" })
                @Html.ValidationMessageFor(m => m.LeaseContactEmail1, "", new { @class = "text-danger" })
            </div>
            <div class="col-sm-6 form-group">
                <label for="LeaseContactEmail2">E-mail Address 2</label>
                @Html.TextBoxFor(m => m.LeaseContactEmail2, new { @class = "form-control", type = "email" })
                @Html.ValidationMessageFor(m => m.LeaseContactEmail2, "", new { @class = "text-danger" })
            </div>
        </div>
    </div>

        <div class="admin-card" style="display:flex; justify-content:flex-end; gap:10px; flex-wrap:wrap;">
            <a class="btn-re-outline" href="@(isEdit ? Url.Action("LeaseDetails", new { id = Model.Id }) : Url.Action("LeaseDashboard"))">Close</a>
            <button type="button" class="btn-re-gold" id="btnSubmitLease"><i class="fa fa-check"></i> Submit</button>
        </div>

        <!-- UCXX Step 8: confirmation -->
        <div class="modal fade" id="confirmLeaseModal" tabindex="-1" role="dialog" aria-labelledby="confirmLeaseLabel">
            <div class="modal-dialog" role="document">
                <div class="modal-content" style="border-radius:12px; overflow:hidden;">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                        <h4 class="modal-title" id="confirmLeaseLabel">Confirm lease record</h4>
                    </div>
                    <div class="modal-body">Are you sure you want to confirm this lease record?</div>
                    <div class="modal-footer">
                        <button type="button" class="btn-re-outline" data-dismiss="modal">No</button>
                        <button type="submit" class="btn-re-gold" id="btnConfirmLease">Yes, I am sure</button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<script>
    (function () {
        function req(id, msg) {
            var el = document.getElementById(id);
            if (el && !el.value.trim()) { return msg; }
            return null;
        }
        document.getElementById('btnSubmitLease').addEventListener('click', function () {
            var errors = [
                @(isEdit ? Html.Raw("req('LeaseReferenceNumber', 'Lease Reference Number is required.'),") : Html.Raw(""))
                req('TenantName', 'Tenant Name is required.'),
                req('LeaseClassification', 'Select a Lease Classification.')
            ].filter(function (e) { return e; });
            var s = document.getElementById('LeaseStartDate').value, e = document.getElementById('LeaseEndDate').value;
            if (s && e && e < s) { errors.push('Lease End Date cannot be before the Lease Start Date.'); }
            if (errors.length) {
                var box = document.getElementById('leaseClientErrors');
                if (!box) {
                    box = document.createElement('div');
                    box.id = 'leaseClientErrors';
                    box.className = 'alert alert-danger';
                    var form = document.getElementById('leaseForm');
                    form.insertBefore(box, form.firstChild);
                }
                box.innerHTML = errors.join('<br />');
                box.scrollIntoView({ behavior: 'smooth', block: 'center' });
                return;
            }
            $('#confirmLeaseModal').modal('show');
        });
        document.getElementById('btnConfirmLease').addEventListener('click', function () {
            this.disabled = true;
            this.innerHTML = 'Saving...';
            document.getElementById('leaseForm').submit();
        });

        // GIS Viewer link (IR014) deferred until after UC01-05/UCXX (DPRE-Q04/Q22, 26 Nov 2026); it will come through a GIS integration.

        // Show "Other, please specify" and Authorised Representative only when relevant
        function toggle(selectId, value, targetId) {
            var sel = document.getElementById(selectId), target = document.getElementById(targetId).closest('.form-group');
            function apply() { target.style.display = sel.value === value ? '' : 'none'; }
            sel.addEventListener('change', apply); apply();
        }
        toggle('ApplicantType', 'Other', 'ApplicantTypeOther');
        toggle('ContactType', 'Authorised Representative', 'AuthorisedRepresentative');
    })();
</script>
