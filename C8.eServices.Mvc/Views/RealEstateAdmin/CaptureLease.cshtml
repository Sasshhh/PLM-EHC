@model C8.eServices.Mvc.Models.RE_Lease
@{
    bool isEdit = Model != null && Model.Id > 0;
    ViewBag.Title = isEdit ? "Edit Lease Details" : "Capture Lease Details";
    Layout = "~/Views/Shared/RCS_Layout.cshtml";
}
@Html.Partial("_RE_LeaseStyles")

<div class="admin-container re-form">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success"><i class="fa fa-check-circle"></i> @TempData["SuccessMessage"] You can capture another lease below, or close.</div>
    }

    <div class="admin-header-card">
        <h1>@(isEdit ? "Edit Lease " + Model.LeaseReferenceNumber : "Capture Lease Details")</h1>
        <p>Record the lease information and assign the lease category for management, billing and reporting.</p>
    </div>

    @using (Html.BeginForm("CaptureLease", "RealEstateAdmin", FormMethod.Post, new { id = "leaseForm", novalidate = "novalidate" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.Id)
        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })
        if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">Please correct the highlighted fields.</div>
        }

    <div class="admin-card">
        <div class="re-section-title">Lease and Property</div>
        <div class="row">
            <div class="col-sm-3 form-group">
                <label for="ContractReferenceNumber">Contract Reference Number</label>
                @Html.TextBoxFor(m => m.ContractReferenceNumber, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.ContractReferenceNumber, "", new { @class = "text-danger" })
            </div>
            <div class="col-sm-3 form-group">
                <label for="LeaseReferenceNumber" class="@(isEdit ? "req" : "")">Lease Reference Number (Unique)</label>
                @Html.TextBoxFor(m => m.LeaseReferenceNumber, new { @class = "form-control", placeholder = isEdit ? "" : "Leave blank to auto-number" })
                @Html.ValidationMessageFor(m => m.LeaseReferenceNumber, "", new { @class = "text-danger" })
            </div>
            <div class="col-sm-3 form-group">
                <label for="SolarAccountNumber">SOLAR Account Number</label>
                @Html.TextBoxFor(m => m.SolarAccountNumber, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.SolarAccountNumber, "", new { @class = "text-danger" })
            </div>
            <div class="col-sm-3 form-group">
                <label for="PropertyCode">Property Code</label>
                @Html.TextBoxFor(m => m.PropertyCode, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.PropertyCode, "", new { @class = "text-danger" })
            </div>
            <div class="col-sm-3 form-group">
