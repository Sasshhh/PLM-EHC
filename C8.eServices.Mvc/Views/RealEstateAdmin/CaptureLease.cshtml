                @Html.ValidationMessageFor(m => m.HigherLevelPropertyCode, "", new { @class = "text-danger" })
            </div>
            <div class="col-sm-5 form-group">
                <label for="PhysicalBuildingNumberAndName">Building Number and Name (Physical Address)</label>
                @Html.TextBoxFor(m => m.PhysicalBuildingNumberAndName, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.PhysicalBuildingNumberAndName, "", new { @class = "text-danger" })
            </div>
            <div class="col-sm-4 form-group">
