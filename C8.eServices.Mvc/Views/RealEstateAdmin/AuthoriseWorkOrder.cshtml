@model C8.eServices.Mvc.Models.RE_Application
@{
    ViewBag.Title = "Authorise Works Order";
    Layout = "~/Views/Shared/RCS_Layout.cshtml";
    var assignments = (IEnumerable<SelectListItem>)ViewBag.AssignList;
}

<style>
    :root {
        --re-gold: #c59b27;
        --re-gold-hover: #a37f1c;
        --re-border-color: #e7e5e4;
        --re-slate-dark: #2e2a27;
        --re-slate-black: #1c1917;
    }

    .admin-container {
        padding: 30px 15px;
        font-family: 'Inter', sans-serif;
    }

    .admin-header-card {
        background: linear-gradient(135deg, var(--re-slate-dark) 0%, var(--re-slate-black) 100%);
        color: #ffffff;
        border-radius: 12px;
        padding: 25px 30px;
        margin-bottom: 25px;
        border-left: 5px solid var(--re-gold);
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .info-card {
        background: #ffffff;
        border: 1px solid var(--re-border-color);
        border-radius: 12px;
        padding: 20px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    }

    .info-card h4 {
        margin-top: 0;
        margin-bottom: 15px;
        font-weight: 700;
        color: var(--re-slate-black);
        border-bottom: 2px solid var(--re-gold);
        padding-bottom: 6px;
        font-size: 15px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .info-item {
        display: flex;
        justify-content: space-between;
        padding: 8px 0;
        border-bottom: 1px dashed #f1f5f9;
        font-size: 13px;
    }

    .info-item:last-child {
        border-bottom: none;
    }

    .info-label {
        font-weight: 600;
        color: #64748b;
    }

    .info-value {
        color: #1e293b;
        font-weight: 500;
        text-align: right;
    }

    .form-card {
        background: #ffffff;
        border: 1px solid var(--re-border-color);
        border-radius: 12px;
        padding: 24px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    }

    .btn-re-gold {
        background-color: var(--re-gold);
        color: #ffffff;
        border: 1px solid var(--re-gold);
        padding: 10px 24px;
        border-radius: 6px;
        font-weight: 600;
        cursor: pointer;
        font-size: 14px;
    }

    .btn-re-gold:hover {
        background-color: var(--re-gold-hover);
        border-color: var(--re-gold-hover);
    }

    .btn-cancel {
        background-color: transparent;
        border: 1px solid #cbd5e1;
        color: #475569;
        text-decoration: none;
        padding: 10px 24px;
        border-radius: 6px;
        font-weight: 600;
        font-size: 14px;
        display: inline-block;
    }

    .btn-cancel:hover {
        background-color: #f1f5f9;
        color: #1e293b;
    }

    .signature-area {
        background-color: #fafaf9;
        border: 2px dashed var(--re-gold);
        border-radius: 8px;
        padding: 15px;
        text-align: center;
        margin-top: 15px;
    }

    .signature-canvas-container {
        display: inline-block;
        background-color: #ffffff;
        border: 1px solid var(--re-border-color);
        border-radius: 4px;
    }

    #signatureCanvas {
        cursor: crosshair;
    }
</style>

<div class="admin-container">
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger" style="border-radius: 8px; border-left: 4px solid #dc2626;">
            <i class="fa fa-exclamation-circle"></i> @TempData["ErrorMessage"]
        </div>
    }

    <div class="admin-header-card">
        <h1 style="margin:0 0 5px 0; font-size:24px; font-weight:700;">Authorise Maintenance Works Order</h1>
        <p style="margin:0; font-size:14px; color:#cbd5e1;">Review logged works order details and authorize task assignment for WO @Model.WorkOrderNumber.</p>
    </div>

    <div class="info-grid">
        <div class="info-card">
            <h4>Work Order Details</h4>
            <div class="info-item">
                <span class="info-label">WO Number:</span>
                <span class="info-value" style="font-weight:700; color:var(--re-gold);">@Model.WorkOrderNumber</span>
            </div>
            <div class="info-item">
                <span class="info-label">Application Ref:</span>
                <span class="info-value">@Model.ApplicationReferenceNumber</span>
            </div>
            <div class="info-item">
                <span class="info-label">Priority:</span>
                <span class="info-value" style="font-weight:600;">@Model.WorkOrderPriority</span>
            </div>
            <div class="info-item">
                <span class="info-label">Due Date:</span>
                <span class="info-value">@(Model.WorkOrderDueDate.HasValue ? Model.WorkOrderDueDate.Value.ToString("yyyy-MM-dd") : "")</span>
            </div>
        </div>

        <div class="info-card">
            <h4>Requested Works Tasks</h4>
            <div class="info-item">
                <span class="info-label">Defects Description:</span>
                <span class="info-value" style="text-align:left; max-width:200px;">@Model.WorkOrderIssueDescription</span>
            </div>
            <div class="info-item">
                <span class="info-label">Tasks to Perform:</span>
                <span class="info-value" style="text-align:left; max-width:200px;">@Model.WorkOrderTasks</span>
            </div>
            <div class="info-item">
                <span class="info-label">Suggested Materials:</span>
                <span class="info-value">@Model.WorkOrderMaterials</span>
            </div>
        </div>
    </div>

    <div class="form-card">
        <h4 style="margin-top:0; margin-bottom: 20px; font-weight: 700; font-size:16px; border-bottom: 2px solid var(--re-gold); padding-bottom: 8px;">Review Decision</h4>

        @using (Html.BeginForm("AuthoriseWorkOrder", "RealEstateAdmin", new { id = Model.Id }, FormMethod.Post, new { id = "woAuthoriseForm" }))
        {
            @Html.AntiForgeryToken()

            <div class="row">
                <div class="col-md-6 form-group">
                    <label style="font-weight:600; color:#475569;">Manager Decision *</label>
                    @Html.DropDownList("decision", new List<SelectListItem>
                    {
                        new SelectListItem { Value = "Approve", Text = "Approve / Assign" },
                        new SelectListItem { Value = "Reject", Text = "Reject / Defect Cancel" }
                    }, "-- Select Outcome --", new { @class = "form-control", required = "required", id = "ddlDecision" })
                </div>

                <div class="col-md-6 form-group" id="assignmentTypeGroup">
                    <label style="font-weight:600; color:#475569;">Assignment Route *</label>
                    @Html.DropDownList("assignmentType", assignments, new { @class = "form-control", id = "ddlAssignmentType" })
                </div>
            </div>

            <div class="form-group" style="margin-top: 15px;">
                <label style="font-weight:600; color:#475569;">Authorisation Comments / Reasons *</label>
                @Html.TextArea("reason", "", new { @class = "form-control", rows = "4", required = "required", placeholder = "Detail specific instructions for the technician, SCM vendor, or rejection reasons...", id = "txtReason" })
            </div>

            <div class="signature-area">
                <label style="font-weight:600; color:#475569; display:block; margin-bottom:10px;">Draw Signature below *</label>
                <div class="signature-canvas-container">
                    <canvas id="signatureCanvas" width="400" height="150"></canvas>
                </div>
                <div style="margin-top: 8px;">
                    <button type="button" class="btn btn-sm btn-default" onclick="clearSignatureCanvas()">
                        <i class="fa fa-eraser"></i> Clear Signature
                    </button>
                </div>
                <input type="hidden" name="signature" id="signatureInput" />
            </div>

            <div style="margin-top: 25px; display:flex; gap:12px;">
                <button type="button" class="btn-re-gold" id="btn-submit-wo-auth" onclick="validateAndSubmit()">
                    <i class="fa fa-save"></i> Submit Resolution
                </button>
                <a href="@Url.Action("WorkOrders", "RealEstateAdmin")" class="btn-cancel">
                    Cancel / Back
                </a>
            </div>
        }
    </div>
</div>

<!-- Custom Confirmation Modal -->
<div class="modal fade" id="confirmModal" tabindex="-1" role="dialog" aria-labelledby="confirmModalLabel" aria-hidden="true" style="margin-top: 10%;">
    <div class="modal-dialog" role="document">
        <div class="modal-content" style="border-radius: 12px; border: 2px solid var(--re-gold);">
            <div class="modal-header" style="background: linear-gradient(135deg, var(--re-slate-dark) 0%, var(--re-slate-black) 100%); color:#ffffff; border-bottom: 2px solid var(--re-gold);">
                <button type="button" class="close" data-dismiss="modal" style="color:white; opacity:0.8;">&times;</button>
                <h4 class="modal-title" id="confirmModalLabel" style="font-weight: 700;">Confirm Works Order Outcome</h4>
            </div>
            <div class="modal-body" style="padding: 20px; font-size:15px; font-weight:500;">
                <p>Are you sure you want to log this authorization outcome for the maintenance works order?</p>
            </div>
            <div class="modal-footer" style="padding:15px 20px; display:flex; justify-content:flex-end; gap:10px;">
                <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="submitConfirmed()" style="background-color: var(--re-gold); border-color: var(--re-gold); font-weight:600;">Yes, Finalise</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var canvas;
        var ctx;
        var drawing = false;
        var hasDrawn = false;

        function getX(e) {
            return e.clientX - canvas.getBoundingClientRect().left;
        }

        function getY(e) {
            return e.clientY - canvas.getBoundingClientRect().top;
        }

        function clearSignatureCanvas() {
            if (ctx) {
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                hasDrawn = false;
                $('#signatureInput').val('');
            }
        }

        $(document).ready(function() {
            canvas = document.getElementById('signatureCanvas');
            if (canvas) {
                ctx = canvas.getContext('2d');

                // Setup drawing events for desktop
                canvas.addEventListener('mousedown', function(e) {
                    drawing = true;
                    ctx.beginPath();
                    ctx.moveTo(getX(e), getY(e));
                });

                canvas.addEventListener('mousemove', function(e) {
                    if (drawing) {
                        ctx.lineTo(getX(e), getY(e));
                        ctx.stroke();
                        hasDrawn = true;
                    }
                });

                canvas.addEventListener('mouseup', function() {
                    drawing = false;
                });

                // Setup drawing events for mobile
                canvas.addEventListener('touchstart', function(e) {
                    drawing = true;
                    var touch = e.touches[0];
                    ctx.beginPath();
                    ctx.moveTo(touch.clientX - canvas.getBoundingClientRect().left, touch.clientY - canvas.getBoundingClientRect().top);
                    e.preventDefault();
                });

                canvas.addEventListener('touchmove', function(e) {
                    if (drawing) {
                        var touch = e.touches[0];
                        ctx.lineTo(touch.clientX - canvas.getBoundingClientRect().left, touch.clientY - canvas.getBoundingClientRect().top);
                        ctx.stroke();
                        hasDrawn = true;
                    }
                    e.preventDefault();
                });

                canvas.addEventListener('touchend', function() {
                    drawing = false;
                });
            }

            $('#ddlDecision').change(function() {
                if ($(this).val() === 'Reject') {
                    $('#assignmentTypeGroup').hide();
                } else {
                    $('#assignmentTypeGroup').show();
                }
            });
        });

        function validateAndSubmit() {
            let decision = $('#ddlDecision').val();
            let reason = $('#txtReason').val();

            if (!decision || decision === '') {
                alert('Manager decision is required.');
                return;
            }

            if (!reason || reason.trim() === '') {
                alert('Decision comments / reasons are required.');
                return;
            }

            if (!hasDrawn) {
                alert('Please sign on the signature pad canvas.');
                return;
            }

            var dataUrl = canvas.toDataURL();
            $('#signatureInput').val(dataUrl);

            $('#confirmModal').modal('show');
        }

        function submitConfirmed() {
            $('#confirmModal').modal('hide');
            $('#woAuthoriseForm').submit();
        }
    </script>
}
