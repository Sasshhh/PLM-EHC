@model IEnumerable<C8.eServices.Mvc.Models.RE_Application>
@{
    ViewBag.Title = "Maintenance Work Orders";
    Layout = "~/Views/Shared/RCS_Layout.cshtml";
}

<style>
    :root {
        --re-gold: #c59b27;
        --re-gold-hover: #a37f1c;
        --re-border-color: #e7e5e4;
        --re-slate-dark: #2e2a27;
        --re-slate-black: #1c1917;
    }

    .admin-container {
        padding: 30px 15px;
        font-family: 'Inter', sans-serif;
    }

    .admin-header-card {
        background: linear-gradient(135deg, var(--re-slate-dark) 0%, var(--re-slate-black) 100%);
        color: #ffffff;
        border-radius: 12px;
        padding: 25px 30px;
        margin-bottom: 25px;
        border-left: 5px solid var(--re-gold);
    }

    .admin-card {
        background: #ffffff;
        border: 1px solid var(--re-border-color);
        border-radius: 12px;
        padding: 24px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    }

    .admin-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
    }

    .admin-table th {
        background-color: #f8fafc;
        color: #475569;
        font-weight: 600;
        text-transform: uppercase;
        font-size: 11px;
        padding: 12px 16px;
        border-bottom: 2px solid var(--re-border-color);
    }

    .admin-table td {
        padding: 14px 16px;
        border-bottom: 1px solid var(--re-border-color);
        font-size: 13px;
    }

    .btn-re-gold {
        background-color: var(--re-gold);
        color: #ffffff;
        border: 1px solid var(--re-gold);
        padding: 6px 12px;
        border-radius: 6px;
        font-weight: 600;
        text-decoration: none;
        font-size: 12px;
        display: inline-block;
    }

    .btn-re-gold:hover {
        background-color: var(--re-gold-hover);
        color: #ffffff;
    }

    .badge-status {
        padding: 4px 8px;
        border-radius: 9999px;
        font-size: 11px;
        font-weight: 600;
    }

    .status-logged { background-color: #dbeafe; color: #1e40af; border: 1px solid #bfdbfe; }
    .status-assigned { background-color: #e0f2fe; color: #0369a1; border: 1px solid #bae6fd; }
    .status-inprogress { background-color: #fef3c7; color: #92400e; border: 1px solid #fde68a; }
    .status-completed { background-color: #dcfce7; color: #166534; border: 1px solid #bbf7d0; }
    .status-closed { background-color: #f3f4f6; color: #374151; border: 1px solid #e5e7eb; }
    .status-hold { background-color: #fee2e2; color: #991b1b; border: 1px solid #fecaca; }

    .priority-high { color: #dc2626; font-weight: 700; }
    .priority-medium { color: #d97706; font-weight: 600; }
    .priority-low { color: #059669; font-weight: 500; }
</style>

<div class="admin-container">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible" role="alert">
            <button type="button" class="close" data-dismiss="alert">&times;</button>
            <i class="fa fa-check-circle"></i> @TempData["SuccessMessage"]
        </div>
    }

    <div class="admin-header-card">
        <h1 style="margin:0 0 5px 0; font-size:24px; font-weight:700;">Maintenance Work Orders</h1>
        <p style="margin:0; font-size:14px; color:#cbd5e1;">Review logged, assigned, and completed maintenance tasks (UC 15 - UC 17).</p>
    </div>

    <div class="admin-card">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>WO Number</th>
                    <th>Application Ref</th>
                    <th>Defect Description</th>
                    <th>Priority</th>
                    <th>Technician</th>
                    <th>WO Status</th>
                    <th style="text-align:right;">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="7" style="text-align:center; color:#64748b; font-style:italic; padding:30px;">
                            No maintenance work orders logged in the system.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var app in Model)
                    {
                        <tr>
                            <td style="font-weight:700; color:var(--re-slate-black);">@app.WorkOrderNumber</td>
                            <td>@app.ApplicationReferenceNumber</td>
                            <td style="max-width:250px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">@app.WorkOrderIssueDescription</td>
                            <td>
                                @if (app.WorkOrderPriority == "High" || app.WorkOrderPriority == "Urgent")
                                {
                                    <span class="priority-high">@app.WorkOrderPriority</span>
                                }
                                else if (app.WorkOrderPriority == "Medium")
                                {
                                    <span class="priority-medium">@app.WorkOrderPriority</span>
                                }
                                else
                                {
                                    <span class="priority-low">@app.WorkOrderPriority</span>
                                }
                            </td>
                            <td>@(string.IsNullOrEmpty(app.WorkOrderTechnicianName) ? "Unassigned" : app.WorkOrderTechnicianName)</td>
                            <td>
                                @if (app.WorkOrderStatus == "Logged")
                                {
                                    <span class="badge-status status-logged">Logged</span>
                                }
                                else if (app.WorkOrderStatus == "Assigned")
                                {
                                    <span class="badge-status status-assigned">Assigned</span>
                                }
                                else if (app.WorkOrderStatus == "In Progress" || app.WorkOrderStatus == "In Progress, Pending Resolution")
                                {
                                    <span class="badge-status status-inprogress">In Progress</span>
                                }
                                else if (app.WorkOrderStatus == "Completed")
                                {
                                    <span class="badge-status status-completed">Completed</span>
                                }
                                else if (app.WorkOrderStatus == "On Hold")
                                {
                                    <span class="badge-status status-hold">On Hold</span>
                                }
                                else
                                {
                                    <span class="badge-status status-closed">Closed</span>
                                }
                            </td>
                            <td style="text-align:right;">
                                @if (app.WorkOrderStatus == "Logged")
                                {
                                    <a href="@Url.Action("AuthoriseWorkOrder", "RealEstateAdmin", new { id = app.Id })" class="btn-re-gold" id="btn-auth-wo-@app.Id">
                                        <i class="fa fa-gavel"></i> Authorise WO
                                    </a>
                                }
                                else if (app.WorkOrderStatus == "Assigned" || app.WorkOrderStatus == "On Hold")
                                {
                                    <a href="@Url.Action("AssignTechnician", "RealEstateAdmin", new { id = app.Id })" class="btn-re-gold" id="btn-assign-wo-@app.Id">
                                        <i class="fa fa-user"></i> Assign Tech
                                    </a>
                                }
                                else if (app.WorkOrderStatus == "Completed")
                                {
                                    <a href="@Url.Action("CloseWorkOrder", "RealEstateAdmin", new { id = app.Id })" class="btn-re-gold" id="btn-close-wo-@app.Id">
                                        <i class="fa fa-check"></i> Verify & Close
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted" style="font-size:12px; font-style:italic;">No Pending Actions</span>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
