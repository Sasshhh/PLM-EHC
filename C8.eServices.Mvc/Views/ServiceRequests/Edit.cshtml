@model C8.eServices.Mvc.Models.ServiceRequest
@using C8.eServices.Mvc.Keys
@{
    ViewBag.Title = "Edit Service Request";
    Layout = "~/Views/Shared/RCS_Layout.cshtml";
}

<style>
    .section-header { background-color: #f5f5f5; padding: 10px 15px; margin-bottom: 15px; border-left: 4px solid #f0ad4e; font-weight: bold; }
    .form-section { margin-bottom: 30px; padding: 20px; background: #fff; border: 1px solid #ddd; border-radius: 4px; }
    .required-field::after { content: " *"; color: red; }
</style>

<div class="panel panel-default">
    <div class="panel-heading" align="center">
        <i class="ion ion-edit"></i> Edit Service Request: @Model.RequestReferenceNumber
    </div>
    <div class="panel-body">
        @using (Html.BeginForm("Edit", "ServiceRequests", new { q = C8.eServices.Mvc.Helpers.SecureActionLinkExtension.EncryptToString(new { id = Model.Id }) }, FormMethod.Post, new { @class = "form-horizontal" }))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <!-- Request Details -->
            <div class="form-section">
                <div class="section-header"><i class="ion ion-information-circled"></i> Editable Details</div>
                
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="control-label col-md-4 required-field">Category</label>
                            <div class="col-md-8">
                                @Html.DropDownListFor(m => m.ServiceRequestCategoryId, ViewBag.Categories as SelectList, "-- Select Category --", new { @class = "form-control", required = "required" })
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="control-label col-md-4 required-field">Priority</label>
                            <div class="col-md-8">
                                @Html.DropDownListFor(m => m.ServiceRequestPriorityId, ViewBag.Priorities as SelectList, "-- Select Priority --", new { @class = "form-control", required = "required" })
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-12">
                        <div class="form-group">
                            <label class="control-label col-md-2 required-field">Description</label>
                            <div class="col-md-10">
                                @Html.TextAreaFor(m => m.DetailedDescription, new { @class = "form-control", rows = "5", required = "required", placeholder = "Describe the issue in detail..." })
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <div class="col-md-offset-2 col-md-10" style="display: flex; gap: 12px; align-items: center;">
                    <button type="submit" class="btn btn-warning"><i class="ion ion-checkmark"></i> Save Changes</button>
                    @Html.ActionLink("Cancel", "Details", new { q = C8.eServices.Mvc.Helpers.SecureActionLinkExtension.EncryptToString(new { id = Model.Id }) }, new { @class = "btn btn-default" })
                </div>
            </div>
        }
    </div>
</div>
