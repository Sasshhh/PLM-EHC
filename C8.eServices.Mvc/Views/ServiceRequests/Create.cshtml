@model C8.eServices.Mvc.Models.ServiceRequest
@using C8.eServices.Mvc.Keys
@{
    ViewBag.Title = "Capture New Service Request";
    Layout = "~/Views/Shared/RCS_Layout.cshtml";
}

<style>
    .section-header { background-color: #f5f5f5; padding: 10px 15px; margin-bottom: 15px; border-left: 4px solid #5cb85c; font-weight: bold; }
    .form-section { margin-bottom: 30px; padding: 20px; background: #fff; border: 1px solid #ddd; border-radius: 4px; }
    .required-field::after { content: " *"; color: red; }
</style>

<div class="panel panel-default">
    <div class="panel-heading" align="center">
        <i class="ion ion-ios-gear-outline"></i> Capture New Service Request
    </div>
    <div class="panel-body">
        @using (Html.BeginForm("Create", "ServiceRequests", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal" }))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <!-- Reporter Information -->
            <div class="form-section">
                <div class="section-header"><i class="ion ion-person"></i> Reporter Information</div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="control-label col-md-4 required-field">First Name</label>
                            <div class="col-md-8">
                                @Html.TextBoxFor(m => m.ReportedByName, new { @class = "form-control", required = "required", value = ViewBag.ReportedByName })
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="control-label col-md-4 required-field">Surname</label>
                            <div class="col-md-8">
                                @Html.TextBoxFor(m => m.ReportedBySurname, new { @class = "form-control", required = "required", value = ViewBag.ReportedBySurname })
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="control-label col-md-4 required-field">Email</label>
                            <div class="col-md-8">
                                @Html.TextBoxFor(m => m.EmailAddress, new { @class = "form-control", type = "email", required = "required", value = ViewBag.EmailAddress })
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="control-label col-md-4 required-field">Contact Number</label>
                            <div class="col-md-8">
                                @Html.TextBoxFor(m => m.ContactNumber, new { @class = "form-control", required = "required", value = ViewBag.ContactNumber })
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Request Details -->
            <div class="form-section">
                <div class="section-header"><i class="ion ion-information-circled"></i> Request Details</div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="control-label col-md-4 required-field">Complex/Area</label>
                            <div class="col-md-8">
                                @Html.DropDownListFor(m => m.ComplexId, ViewBag.Complexes as SelectList, "-- Select Complex --", new { @class = "form-control", required = "required" })
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label class="control-label col-md-4">Block</label>
                            <div class="col-md-8">
                                @Html.TextBoxFor(m => m.BlockNumber, new { @class = "form-control" })
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label class="control-label col-md-4">Unit</label>
                            <div class="col-md-8">
                                @Html.TextBoxFor(m => m.UnitNumber, new { @class = "form-control" })
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="control-label col-md-4 required-field">Category</label>
                            <div class="col-md-8">
                                @Html.DropDownListFor(m => m.ServiceRequestCategoryId, ViewBag.Categories as SelectList, "-- Select Category --", new { @class = "form-control", required = "required" })
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="control-label col-md-4 required-field">Priority</label>
                            <div class="col-md-8">
                                @Html.DropDownListFor(m => m.ServiceRequestPriorityId, ViewBag.Priorities as SelectList, "-- Select Priority --", new { @class = "form-control", required = "required" })
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-12">
                        <div class="form-group">
                            <label class="control-label col-md-2 required-field">Description</label>
                            <div class="col-md-10">
                                @Html.TextAreaFor(m => m.DetailedDescription, new { @class = "form-control", rows = "5", required = "required", placeholder = "Describe the issue in detail..." })
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Attachments -->
            <div class="form-section">
                <div class="section-header"><i class="ion ion-paperclip"></i> Attachments (Optional)</div>
                <div class="row">
                    <div class="col-md-12">
                        <input type="file" name="documents" id="documents" multiple class="form-control" accept=".jpg,.jpeg,.png,.pdf,.doc,.docx" />
                        <small class="text-muted">Max 10MB per file. Formats: JPG, PNG, PDF, Word.</small>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <div class="col-md-offset-2 col-md-10">
                    <button type="submit" class="btn btn-success"><i class="ion ion-checkmark"></i> Submit Request</button>
                    @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-default" })
                </div>
            </div>
        }
    </div>
</div>
