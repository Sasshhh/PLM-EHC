@model C8.eServices.Mvc.Models.ServiceRequest
@using C8.eServices.Mvc.Keys
@{
    ViewBag.Title = "Service Request Details";
    Layout = "~/Views/Shared/RCS_Layout.cshtml";
}

<style>
    .detail-label { font-weight: bold; color: #555; }
    .status-section { border-bottom: 2px solid #eee; margin-bottom: 20px; padding-bottom: 10px; }
    .history-item { padding: 10px; border-left: 3px solid #ddd; margin-bottom: 10px; background: #f9f9f9; }
</style>

<div class="panel panel-default">
    <div class="panel-heading">
        <div class="row">
            <div class="col-md-6">
                Service Request: @Model.RequestReferenceNumber
            </div>
            <div class="col-md-6 text-right" style="display: flex; gap: 8px; justify-content: flex-end;">
                @if (ViewBag.CanEditOrDelete == true)
                {
                    <a href="@Url.Action("Edit", new { q = C8.eServices.Mvc.Helpers.SecureActionLinkExtension.EncryptToString(new { id = Model.Id }) })" class="btn btn-warning btn-sm">Edit</a>
                    <button type="button" class="btn btn-danger btn-sm" data-toggle="modal" data-target="#deleteModal">Delete</button>
                }
                <a href="@Url.Action("Index")" class="btn btn-default btn-sm">Back to List</a>
            </div>
        </div>
    </div>
    <div class="panel-body">
        <div class="row status-section">
            <div class="col-md-4">
                <span class="detail-label">Status:</span> @(Model.Status != null ? Model.Status.Name : "N/A")
            </div>
            <div class="col-md-4">
                <span class="detail-label">Priority:</span> @(Model.Priority != null ? Model.Priority.Name : "N/A")
            </div>
            <div class="col-md-4">
                <span class="detail-label">SLA Status:</span> @ViewBag.SlaStatus
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <span class="detail-label">Reported By:</span> @Model.ReportedByName @Model.ReportedBySurname
                </div>
                <div class="form-group">
                    <span class="detail-label">Email:</span> @Model.EmailAddress
                </div>
                <div class="form-group">
                    <span class="detail-label">Contact:</span> @Model.ContactNumber
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <span class="detail-label">Complex:</span> @(Model.Complex != null ? Model.Complex.Name : "N/A")
                </div>
                <div class="form-group">
                    <span class="detail-label">Block/Unit:</span> @Model.BlockNumber / @Model.UnitNumber
                </div>
                <div class="form-group">
                    <span class="detail-label">Date Submitted:</span> @Model.DateSubmitted.ToString("F")
                </div>
            </div>
        </div>

        <hr />
        <div class="row">
            <div class="col-md-12">
                <span class="detail-label">Detailed Description:</span>
                <p class="well">@Model.DetailedDescription</p>
            </div>
        </div>

        <hr />
        <div class="row">
            <div class="col-md-12">
                <span class="detail-label"><i class="ion ion-paperclip"></i> Attached Documents:</span>
                @if (Model.Documents != null && Model.Documents.Any(d => !d.IsDeleted))
                {
                    <ul class="list-group" style="margin-top: 10px; max-width: 600px;">
                        @foreach (var doc in Model.Documents.Where(d => !d.IsDeleted))
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <a href="@Url.Content("~/Uploads/ServiceRequests/Documents/" + System.IO.Path.GetFileName(doc.FilePath))" target="_blank">
                                    <i class="ion ion-document-text" style="margin-right: 5px;"></i> @doc.FileName
                                </a>
                                <span class="badge badge-primary badge-pill">@(doc.FileSize / 1024) KB</span>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted" style="margin-top: 10px;"><em>No documents attached.</em></p>
                }
            </div>
        </div>

        @if (User.IsInRole("Client Services Officer") && (Model.Status == null || (Model.Status.Key != ServiceRequestStatusKeys.Resolved && Model.Status.Key != ServiceRequestStatusKeys.Closed)))
        {
            <hr />
            <div class="row">
                <div class="col-md-12">
                    <h4>CSO Actions</h4>
                    @using (Html.BeginForm("UpdateStatus", "ServiceRequests", new { id = Model.Id }, FormMethod.Post, new { @class = "form-inline" }))
                    {
                        @Html.AntiForgeryToken()
                        <div class="form-group">
                            <select name="newStatusKey" class="form-control">
                                <option value="">-- Change Status --</option>
                                <option value="@ServiceRequestStatusKeys.InProgress">In Progress</option>
                                <option value="@ServiceRequestStatusKeys.Resolved">Resolved</option>
                                <option value="@ServiceRequestStatusKeys.Closed">Closed</option>
                            </select>
                        </div>
                        <button type="submit" class="btn btn-primary">Update Status</button>
                    }
                </div>
            </div>
        }
    </div>
</div>

@if (ViewBag.CanEditOrDelete == true)
{
    <!-- Delete Modal -->
    <div class="modal fade" id="deleteModal" tabindex="-1" role="dialog" aria-labelledby="deleteModalLabel">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                @using (Html.BeginForm("Delete", "ServiceRequests", new { q = C8.eServices.Mvc.Helpers.SecureActionLinkExtension.EncryptToString(new { id = Model.Id }) }, FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                        <h4 class="modal-title" id="deleteModalLabel">Delete Service Request</h4>
                    </div>
                    <div class="modal-body">
                        <p>Are you sure you want to delete this service request?</p>
                        <div class="form-group">
                            <label for="deletionReason" class="control-label required-field">Reason for Deletion:</label>
                            <textarea name="deletionReason" id="deletionReason" class="form-control" required="required" rows="3"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger">Yes, I am sure</button>
                    </div>
                }
            </div>
        </div>
    </div>
}
