<script src="~/Scripts/JqueryUi.js"></script>
<script src="~/Scripts/TimePickerAddOn.js"></script>
<script>

    $("#EffectiveDateFrom").datepicker({
        dateFormat: "dd/mm/yy",
        minDate: 0,

        onSelect: function (date) {
            var dt2 = $('#EffectiveDateTo');
            var dt1 = $('#EffectiveDateFrom');
            var startDate = $(this).datepicker('getDate');
            var minDate = $(this).datepicker('getDate');
            /*dt2.datepicker('setDate', minDate);*/
            startDate.setDate(startDate.getDate() + 365);
            //sets dt2 maxDate to the last day of 30 days window
            dt2.datepicker('option', 'maxDate', startDate);
            dt2.datepicker('option', 'minDate', minDate);
            dt1.datepicker('option', 'maxDate', minDate)
            //$(this).datepicker('option', 'minDate', minDate);
        }
    });
    $('#EffectiveDateTo').datepicker({
        dateFormat: "dd/mm/yy"
    });
    $('#ValuationPlacedDate').datepicker({
        dateFormat: "dd/mm/yy"
    });
    //$('#PublishedDate').datepicker({
    //    dateFormat: "dd/mm/yy"
    //});
    //$('#GenerationDate').datepicker({
    //    dateFormat: "dd/mm/yy"
    //});
    $('#ImplementionDate').datepicker({
        dateFormat: "dd/mm/yy"
    });

    //    $('.datepicker').datepicker();


    function checkTime(i) {
        if (i < 10) {
            i = "0" + i;
        }
        return i;
    }

    function startTime() {
        var today = new Date();
        var h = today.getHours();
        var m = today.getMinutes();
        var s = today.getSeconds();
        var day = today.getDay().toString();
        var month = today.getMonth().toString();

        var year = today.getFullYear();
        // add a zero in front of numbers<10 m=checkTime(m);
        s = checkTime(s);
        var mo = month.length < 2 ? '0' + month : month;
        var d = day.length < 2 ? '0' + day : day;


        document.getElementById('date').value = d + "/" + mo + "/" + year;
        t = setTimeout(function () {
            startTime()
        }, 500);
        //document.getElementById('AgentDate2').value = d + "/" + mo + "/" + year + " " + h + ":" + m + ":" + s;
        //t = setTimeout(function () {
        //    startTime()
        //}, 500);
    }
   // startTime();
</script>

