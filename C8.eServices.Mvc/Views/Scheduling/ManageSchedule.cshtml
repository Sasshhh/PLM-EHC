@model C8.eServices.Mvc.ViewModels.GenericSchedulingViewModel

@{
    ViewBag.Title = Model.HeaderTitle ?? "Manage Schedule";
    Layout = "~/Views/Shared/RCS_Layout.cshtml";
}

<style>
    @@media only screen and (max-width: 1000px) {
        .cards tbody tr { float: left; width: 90%; margin: 0.5rem; border: 0.0625rem solid rgba(0,0,0,.125); border-radius: .25rem; box-shadow: 0.25rem 0.25rem 0.5rem rgba(0,0,0,0.25); }
        .cards thead tr { float: left; width: 90%; margin: 0.5rem; border: 0.0625rem solid rgba(0,0,0,.125); border-radius: .25rem; box-shadow: 0.25rem 0.25rem 0.5rem rgba(0,0,0,0.25); }
        .cards tbody td { display: block; word-wrap: break-word; }
        .cards thead th { display: none; }
        .cards tbody label { display: inline; position: relative; font-size: 85%; top: -0.5rem; color: #808080; min-width: 4rem; margin-left: 0; margin-right: 1rem; text-align: left; }
    }
    .button1 { font-size: 13px; }
    .required:before { content: '*'; color: red; }
    input[type='date'] { position: relative; }
</style>

<div id="TenantTimeslotSelectedModal" class="modal fade" role="dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Schedule Update</h4>
            </div>
            <div class="modal-body">
                <div class="container">
                    <strong>Timeslot has been updated successfully.</strong>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>

<div class="panel-group">
    <div class="panel panel-default">
        <div class="panel-heading" align="center">
            @Model.HeaderTitle
        </div>
        <div class="panel-body">
            <div class="alert alert-info">
                <strong>Reference No:</strong> @Model.ReferenceNumber <br/>
                <strong>Participant:</strong> @Model.TargetName
            </div>
            
            @using (Html.BeginForm("ManageSchedule", "Scheduling", FormMethod.Post, new { id = "clientInfo-form" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.ReferenceId)
                @Html.HiddenFor(m => m.ReferenceType)
                @Html.HiddenFor(m => m.ReferenceNumber)

                <div class="row">
                    <div class="col-sm-6">
                        <div class="form-group">
                            <label class="col-md-4 control-label">Day Available <span class="required"></span></label>
                            <div class="col-md-8">
                                <input type="date" name="DateToSchedule" id="DateToSchedule" class="form-control" required="required" onchange="ChangeDate()" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                            </div>
                        </div>
                        <br/><br/>
                        <div class="form-group">
                            <label class="col-md-4 control-label">Hours Available <span class="required"></span></label>
                            <div class="col-md-8">
                                @foreach (var item in Model.AvailableTimeSlots)
                                {
                                    <div class="checkbox">
                                        <label>
                                            <input type="checkbox" name="SelectedRoles" value="@item.Value" />
                                            @item.Text
                                        </label>
                                    </div>
                                }
                            </div>
                        </div>
                        <br/>
                        <div class="form-group">
                            <div class="col-md-offset-4 col-md-8">
                                <button type="submit" class="btn btn-primary">Schedule Slots</button>
                            </div>
                        </div>
                    </div>
                    
                    <div class="col-sm-6">
                        @if (Model.ExistingSchedules != null && Model.ExistingSchedules.Count > 0)
                        {
                            <table class="table table-bordered table-striped">
                                <thead>
                                    <tr>
                                        <th>Date</th>
                                        <th>Time Slot</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.ExistingSchedules)
                                    {
                                        <tr>
                                            <td>@(item.DateToSchedule != null ? item.DateToSchedule.ShecduleDate.Value.ToString("yyyy-MM-dd") : "")</td>
                                            <td>@(item.TimeSlot != null ? item.TimeSlot.Name : "")</td>
                                            <td>
                                                <button type="button" class="btn btn-xs btn-success" onclick="ApproveTimeSlot('@item.Id', '@item.DateToSchedule.ShecduleDate', '@item.TimeSlot.Name')">Approve</button>
                                                <button type="button" class="btn btn-xs btn-danger" onclick="DeleteSchedule('@item.Id')">Remove</button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        else
                        {
                            <p class="text-muted">No timeslots have been scheduled yet.</p>
                        }
                    </div>
                </div>
            }

            @if (Model.ExistingSchedules != null && Model.ExistingSchedules.Count > 0 && Model.ReferenceType == "Complaint")
            {
                <div class="row">
                    <div class="col-sm-12 text-right">
                        <br />
                        <form method="post" action="@Url.Action("FinalizeComplaintSchedule", "Scheduling")">
                            <input type="hidden" name="referenceId" value="@Model.ReferenceId" />
                            <button type="submit" class="btn btn-success">Finalize & Send Notification</button>
                        </form>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section scripts {
    <script>
        function ChangeDate() {
            var startdate = document.getElementById("DateToSchedule").value;
            var thisDate = new Date(startdate);
            var today = new Date();
            today.setHours(0,0,0,0);
            if (thisDate < today) {
                swal("Error!", "Please select an upcoming date!", "warning");
                $('#DateToSchedule').val('');
            }
        }

        function ApproveTimeSlot(id, date, time) {
            swal({
                icon: "info",
                title: "Are you sure you want to approve " + time + " on " + date.substring(0,10) + "?",
                buttons: ['No', 'Yes, I am sure!']
            }).then(function (isConfirm) {
                if (isConfirm) {
                    $.getJSON("@Url.Action("ApproveTimeSlot", "Scheduling")?Id=" + id, function (result) {
                        window.location.reload();
                    });
                }
            });
        }

        function DeleteSchedule(id) {
            swal({
                icon: "warning",
                title: "Are you sure you want to remove this slot?",
                buttons: ['No', 'Yes, remove it!']
            }).then(function (isConfirm) {
                if (isConfirm) {
                    $.getJSON("@Url.Action("DeleteSchedule", "Scheduling")?Id=" + id, function (result) {
                        window.location.reload();
                    });
                }
            });
        }
    </script>
}
