@{
    ViewBag.Title = "Admin Activities / Transactions";
    Layout = "~/Views/Shared/RCS_Layout.cshtml";
    var activities = ViewBag.Activities as List<C8.eServices.Mvc.Models.AuditTrail.AuditTrailActivity> ?? new List<C8.eServices.Mvc.Models.AuditTrail.AuditTrailActivity>();
}

<div class="row">
    <div class="col-md-12">
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title">
                    <i class="ion ion-ios-locked"></i> Admin Activities / Transactions
                    <span class="label label-info pull-right">@(ViewBag.DepartmentName)</span>
                </h3>
            </div>
            <div class="panel-body">
                @if (ViewBag.ErrorMessage != null)
                {
                    <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
                }

                <!-- Filters -->
                <form method="get" class="form-inline" style="margin-bottom: 20px;">
                    <div class="form-group" style="margin-right: 10px;">
                        <input type="text" name="search" class="form-control" placeholder="Search..." value="@ViewBag.Search" style="min-width: 200px;" />
                    </div>
                    <div class="form-group" style="margin-right: 10px;">
                        <label style="margin-right: 5px;">From:</label>
                        <input type="date" name="dateFrom" class="form-control" value="@ViewBag.DateFrom" />
                    </div>
                    <div class="form-group" style="margin-right: 10px;">
                        <label style="margin-right: 5px;">To:</label>
                        <input type="date" name="dateTo" class="form-control" value="@ViewBag.DateTo" />
                    </div>
                    <button type="submit" class="btn btn-primary"><i class="ion ion-ios-search"></i> Filter</button>
                    <a href="@Url.Action("AdminActivityLog")" class="btn btn-default" style="margin-left: 5px;">Clear</a>
                    <a href="@Url.Action("ExportActivityLog", new { search = ViewBag.Search, dateFrom = ViewBag.DateFrom, dateTo = ViewBag.DateTo, adminOnly = true })" class="btn btn-success pull-right"><i class="ion ion-ios-download"></i> Export CSV</a>
                </form>

                <div class="table-responsive">
                    <table id="auditAdminActivityTable" class="table table-striped table-bordered table-hover">
                        <thead>
                            <tr style="background-color: #8e44ad; color: white;">
                                <th>Username</th>
                                <th>Name</th>
                                <th>Surname</th>
                                <th>Date</th>
                                <th>Activity / Transaction</th>
                                <th>Controller</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var a in activities)
                            {
                                <tr>
                                    <td>@(a.SystemUser != null ? a.SystemUser.UserName : "System")</td>
                                    <td>@(a.SystemUser != null ? a.SystemUser.FirstName : "")</td>
                                    <td>@(a.SystemUser != null ? a.SystemUser.LastName : "")</td>
                                    <td>@a.ActivityDateTime.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                    <td>@a.Description</td>
                                    <td><code>@a.Controller</code></td>
                                    <td><code>@a.Action</code></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <p class="text-muted">Showing @activities.Count admin record(s). Maximum 1,000 records per page.</p>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            try {
                if ($.fn.DataTable) {
                    $('#auditAdminActivityTable').DataTable({
                        "order": [[3, "desc"]],
                        "pageLength": 25,
                        "language": { "search": "Filter:" }
                    });
                }
            } catch (e) { }
        });
    </script>
}
