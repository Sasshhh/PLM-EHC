@{
    ViewBag.Title = "Active Users & Login History";
    Layout = "~/Views/Shared/RCS_Layout.cshtml";
    var users = ViewBag.Users as List<C8.eServices.Mvc.Models.SystemUser> ?? new List<C8.eServices.Mvc.Models.SystemUser>();
    var lastLogins = ViewBag.LastLogins as Dictionary<int, DateTime> ?? new Dictionary<int, DateTime>();
    var roleData = ViewBag.RoleData as Dictionary<int, string> ?? new Dictionary<int, string>();
}

<div class="row">
    <div class="col-md-12">
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title">
                    <i class="ion ion-ios-people"></i> Active Users & Login History
                    <span class="label label-info pull-right">@(ViewBag.DepartmentName)</span>
                </h3>
            </div>
            <div class="panel-body">
                @if (ViewBag.ErrorMessage != null)
                {
                    <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
                }

                <!-- Filters -->
                <form method="get" class="form-inline" style="margin-bottom: 20px;">
                    <div class="form-group" style="margin-right: 10px;">
                        <input type="text" name="search" class="form-control" placeholder="Search by username or name..." value="@ViewBag.Search" style="min-width: 300px;" />
                    </div>
                    <button type="submit" class="btn btn-primary"><i class="ion ion-ios-search"></i> Search</button>
                    <a href="@Url.Action("ActiveUsers")" class="btn btn-default" style="margin-left: 5px;">Clear</a>
                    <a href="@Url.Action("ExportActiveUsers")" class="btn btn-success pull-right"><i class="ion ion-ios-download"></i> Export CSV</a>
                </form>

                <div class="table-responsive">
                    <table id="auditActiveUsersTable" class="table table-striped table-bordered table-hover">
                        <thead>
                            <tr style="background-color: #2c3e50; color: white;">
                                <th>Username</th>
                                <th>Name</th>
                                <th>Surname</th>
                                <th>Role Name</th>
                                <th>Creation Date</th>
                                <th>Last Logon Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in users)
                            {
                                <tr>
                                    <td>@user.UserName</td>
                                    <td>@user.FirstName</td>
                                    <td>@user.LastName</td>
                                    <td>@(roleData.ContainsKey(user.Id) ? roleData[user.Id] : "N/A")</td>
                                    <td>@(user.CreatedDateTime.HasValue ? user.CreatedDateTime.Value.ToString("yyyy-MM-dd HH:mm") : "N/A")</td>
                                    <td>
                                        @if (lastLogins.ContainsKey(user.Id))
                                        {
                                            @lastLogins[user.Id].ToString("yyyy-MM-dd HH:mm")
                                        }
                                        else
                                        {
                                            <span class="text-muted">Never</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <p class="text-muted">Showing @users.Count active user(s).</p>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            try {
                if ($.fn.DataTable) {
                    $('#auditActiveUsersTable').DataTable({
                        "order": [[4, "desc"]],
                        "pageLength": 25,
                        "language": { "search": "Filter:" }
                    });
                }
            } catch (e) { }
        });
    </script>
}
