@{
    ViewBag.Title = "User Role Modifications";
    Layout = "~/Views/Shared/RCS_Layout.cshtml";
    var modifications = ViewBag.Modifications as List<C8.eServices.Mvc.Models.AuditTrail.AuditTrailRoleModification> ?? new List<C8.eServices.Mvc.Models.AuditTrail.AuditTrailRoleModification>();
    var currentRoles = ViewBag.CurrentRoles as Dictionary<int, string> ?? new Dictionary<int, string>();
}

<div class="row">
    <div class="col-md-12">
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title">
                    <i class="ion ion-ios-people"></i> User Role Modifications
                    <span class="label label-info pull-right">@(ViewBag.DepartmentName)</span>
                </h3>
            </div>
            <div class="panel-body">
                @if (ViewBag.ErrorMessage != null)
                {
                    <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
                }

                <!-- Filters -->
                <form method="get" class="form-inline" style="margin-bottom: 20px;">
                    <div class="form-group" style="margin-right: 10px;">
                        <input type="text" name="search" class="form-control" placeholder="Search by username or role..." value="@ViewBag.Search" style="min-width: 250px;" />
                    </div>
                    <div class="form-group" style="margin-right: 10px;">
                        <label style="margin-right: 5px;">From:</label>
                        <input type="date" name="dateFrom" class="form-control" value="@ViewBag.DateFrom" />
                    </div>
                    <div class="form-group" style="margin-right: 10px;">
                        <label style="margin-right: 5px;">To:</label>
                        <input type="date" name="dateTo" class="form-control" value="@ViewBag.DateTo" />
                    </div>
                    <button type="submit" class="btn btn-primary"><i class="ion ion-ios-search"></i> Filter</button>
                    <a href="@Url.Action("RoleModifications")" class="btn btn-default" style="margin-left: 5px;">Clear</a>
                    <a href="@Url.Action("ExportRoleModifications", new { search = ViewBag.Search, dateFrom = ViewBag.DateFrom, dateTo = ViewBag.DateTo })" class="btn btn-success pull-right"><i class="ion ion-ios-download"></i> Export CSV</a>
                </form>

                <div class="table-responsive">
                    <table id="auditRoleModTable" class="table table-striped table-bordered table-hover">
                        <thead>
                            <tr style="background-color: #27ae60; color: white;">
                                <th>Username</th>
                                <th>Name</th>
                                <th>Surname</th>
                                <th>Current Role Name</th>
                                <th>Administrator Username</th>
                                <th>Role Modification Date</th>
                                <th>New Role Name</th>
                                <th>Type</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var m in modifications)
                            {
                                <tr>
                                    <td>@(m.TargetSystemUser != null ? m.TargetSystemUser.UserName : "Unknown")</td>
                                    <td>@(m.TargetSystemUser != null ? m.TargetSystemUser.FirstName : "")</td>
                                    <td>@(m.TargetSystemUser != null ? m.TargetSystemUser.LastName : "")</td>
                                    <td>@(currentRoles.ContainsKey(m.TargetSystemUserId) ? currentRoles[m.TargetSystemUserId] : "N/A")</td>
                                    <td><strong>@(m.ModifiedBySystemUser != null ? m.ModifiedBySystemUser.UserName : "System")</strong></td>
                                    <td>@m.ModificationDateTime.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                    <td><span class="label label-success">@m.NewRoleName</span></td>
                                    <td>
                                        @switch (m.ModificationType)
                                        {
                                            case "RoleAdded":
                                                <span class="label label-success">Added</span>
                                                break;
                                            case "RoleRemoved":
                                                <span class="label label-danger">Removed</span>
                                                break;
                                            case "RoleChanged":
                                                <span class="label label-warning">Changed</span>
                                                break;
                                            default:
                                                <span class="label label-default">@m.ModificationType</span>
                                                break;
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (modifications.Count == 0)
                {
                    <div class="alert alert-info">No role modifications found for the selected filters.</div>
                }

                <p class="text-muted">Showing @modifications.Count record(s).</p>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            try {
                if ($.fn.DataTable) {
                    $('#auditRoleModTable').DataTable({
                        "order": [[5, "desc"]],
                        "pageLength": 25,
                        "language": { "search": "Filter:" }
                    });
                }
            } catch (e) { }
        });
    </script>
}
