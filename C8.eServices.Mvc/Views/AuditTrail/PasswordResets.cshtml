@{
    ViewBag.Title = "Password Reset Activity Trail";
    Layout = "~/Views/Shared/RCS_Layout.cshtml";
    var resets = ViewBag.Resets as List<C8.eServices.Mvc.Models.AuditTrail.AuditTrailPasswordReset> ?? new List<C8.eServices.Mvc.Models.AuditTrail.AuditTrailPasswordReset>();
    var roleData = ViewBag.RoleData as Dictionary<int, string> ?? new Dictionary<int, string>();
}

<div class="row">
    <div class="col-md-12">
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title">
                    <i class="ion ion-ios-unlocked"></i> Password Reset Activity Trail
                    <span class="label label-info pull-right">@(ViewBag.DepartmentName)</span>
                </h3>
            </div>
            <div class="panel-body">
                @if (ViewBag.ErrorMessage != null)
                {
                    <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
                }

                <!-- Filters -->
                <form method="get" class="form-inline" style="margin-bottom: 20px;">
                    <div class="form-group" style="margin-right: 10px;">
                        <input type="text" name="search" class="form-control" placeholder="Search by username..." value="@ViewBag.Search" style="min-width: 200px;" />
                    </div>
                    <div class="form-group" style="margin-right: 10px;">
                        <label style="margin-right: 5px;">From:</label>
                        <input type="date" name="dateFrom" class="form-control" value="@ViewBag.DateFrom" />
                    </div>
                    <div class="form-group" style="margin-right: 10px;">
                        <label style="margin-right: 5px;">To:</label>
                        <input type="date" name="dateTo" class="form-control" value="@ViewBag.DateTo" />
                    </div>
                    <button type="submit" class="btn btn-primary"><i class="ion ion-ios-search"></i> Filter</button>
                    <a href="@Url.Action("PasswordResets")" class="btn btn-default" style="margin-left: 5px;">Clear</a>
                    <a href="@Url.Action("ExportPasswordResets", new { search = ViewBag.Search, dateFrom = ViewBag.DateFrom, dateTo = ViewBag.DateTo })" class="btn btn-success pull-right"><i class="ion ion-ios-download"></i> Export CSV</a>
                </form>

                <div class="table-responsive">
                    <table id="auditPasswordResetsTable" class="table table-striped table-bordered table-hover">
                        <thead>
                            <tr style="background-color: #e74c3c; color: white;">
                                <th>Username</th>
                                <th>Name</th>
                                <th>Surname</th>
                                <th>Role Name</th>
                                <th>Administrator Username</th>
                                <th>Password Modification Date</th>
                                <th>Reset Type</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in resets)
                            {
                                <tr>
                                    <td>@(r.TargetSystemUser != null ? r.TargetSystemUser.UserName : "Unknown")</td>
                                    <td>@(r.TargetSystemUser != null ? r.TargetSystemUser.FirstName : "")</td>
                                    <td>@(r.TargetSystemUser != null ? r.TargetSystemUser.LastName : "")</td>
                                    <td>@(roleData.ContainsKey(r.TargetSystemUserId) ? roleData[r.TargetSystemUserId] : "N/A")</td>
                                    <td><strong>@(r.ResetBySystemUser != null ? r.ResetBySystemUser.UserName : "System")</strong></td>
                                    <td>@r.ResetDateTime.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                    <td><span class="label label-@(r.ResetType == "AdminReset" ? "danger" : "info")">@r.ResetType</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (resets.Count == 0)
                {
                    <div class="alert alert-info">No password reset activity found for the selected filters.</div>
                }

                <p class="text-muted">Showing @resets.Count record(s).</p>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            try {
                if ($.fn.DataTable) {
                    $('#auditPasswordResetsTable').DataTable({
                        "order": [[5, "desc"]],
                        "pageLength": 25,
                        "language": { "search": "Filter:" }
                    });
                }
            } catch (e) { }
        });
    </script>
}
