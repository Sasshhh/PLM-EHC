        var currYear=@DateTime.Now.Year;
            url = '@Url.Action("GenerateDetailedReport", "RCSReport")?reportId=' + reportId + '&docTypeId=' + docTypeId + '&RegionType=' + RegionType + '&StatusType=' + StatusType;
            Item = '<tr><td> Licensing And Permits ' + reportName + '-' + docTypeName+'</td><td><a href=\"' + url + '\" class=\"download\" target=\"_blank\"></a></td></tr>';
            new_tBody.innerHTML += Item;
            old_tbody.parentNode.replaceChild(new_tBody, old_tbody);

        });

