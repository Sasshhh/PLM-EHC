<div class="panel-group" id="newConsumption">
    <div class="panel panel-default">

        <div id="collapseNewLinkedAccount" class="panel-collapse collapse in">
            <div class="panel-body">
                <div class="alert alert-warning" id="associatedAlert" style="display:none">
                    @ViewBag.AccountsMessage
                    <p id="ErrCon"></p>
                </div>
                <div class="form-horizontal">
                    @*<div class="col-md-12">*@
                    <form class="">
                        <div class="row" id="DocTypeCtrl">
                            <div class="form-group">
                                @Html.Label("Document Type", new { @class = "control-label col-md-2" })
                                <div class="col-md-5">
                                    @Html.DropDownList("DocTypeDdl", (SelectList)ViewBag.DocTypes, "Select type ...", htmlAttributes: new { @class = "form-control", id = "DocTypeDdl", @required = true })
                                </div>
                            </div>
                        </div>
                        <div id="ReportTypeCtrl" style="display:none">
                            <div class="row">
                                <div class="form-group">
                                    @Html.Label("Report Type", new { @class = "control-label col-md-2" })
                                    <div class="col-md-5">
                                        @Html.DropDownList("ReportDdl", (SelectList)ViewBag.Reports, "Select type ...", htmlAttributes: new { @class = "form-control", id = "ReportDdl", @required = true })
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div id="NormDetailedReportCtrl" style="display:none">
                            <div class="row">
                                <div class="col-xs-2">


                                </div>

                            </div>
                            <div class="row">
                                <div class="col-xs-2" style="padding-top:0px">
                                    <button id="submitStatReport" type="button" class="btn btn-primary">Generate Download Link</button>
                                </div>

                            </div>
                        </div>
                        <div id="DateRangeCtrl" style="display:none">
                            <div class="row">

                                <div class="col-xs-3">
                                    <label class="control-label">Start Date </label>

                                </div>
                                <div class="col-xs-3">
                                    <label class="control-label">End Date </label>

                                </div>


                            </div>


                            <div class="row">

                                <div class="col-xs-3">

                                    @Html.TextBox("startDate", "Select Date", new { @class = "form-control", @id = "startDate" })
                                </div>
                                <div class="col-xs-3">

                                    @Html.TextBox("endDate", "Select Date", new { @class = "form-control", id = "endDate" })
                                </div>


                            </div>

                            <div class="row">

                                <div class="col-xs-3" id="divRegionlbl" style="display:none">
                                    <label class="control-label">Region </label>
                                </div>
                                <div class="col-xs-3" style="display:none" id="divLicenseStatuslbl">
                                    <label class="control-label">Status </label>
                                </div>

                            </div>


                            <div class="row">


                                <div class="col-xs-3" id="divRegion" style="display:none">

                                    @Html.DropDownList("RegionType", null, "Select Region", new { @class = "form-control" })
                                </div>

                                <div class="col-xs-3" style="display:none" id="divLicenseStatus">

                                    @Html.DropDownList("StatusType", null, "Select Status", new { @class = "form-control" })
                                </div>

                                <div class="col-xs-3" style="display:none" id="divRejected">

                                    @Html.DropDownList("Rejected", null, "Select Status", new { @class = "form-control" })
                                </div>
                            </div>

                            <br />

                            <div class="col-xs-8" style="padding-top:0px">
                                <button id="submitDownloadDRReport" type="button" class="btn btn-primary">Generate Download Link</button>
                                <button id="btnReset" type="button" class="btn btn-primary">Reset</button>
                            </div>
                            <br />
                            <br />
                        </div>
                    </form>
                    @*</div>*@
                    <br />
                    <br />

                    <div class="row">
                        <table class="table table-bordered table-hover table-striped panel panel-default" id="MultiplePDFLinks">
                            <thead>
                                <tr>
                                    <th data-field="IdentificationNumber">
                                        Report Name
                                    </th>

                                    <th data-field="EmailAddress">
                                        Download Link
                                    </th>

                                </tr>
                            </thead>
                            <tbody id="MultipleLinksTBL"></tbody>

                        </table>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

