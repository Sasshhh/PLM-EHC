                });
            }
            });

            $("#MultipleLinksTBL tr").remove();

            document.getElementById("ReportDdl").value = '';
            document.getElementById("DocTypeDdl").value = '';
            document.getElementById("StatusType").value = '';
            document.getElementById("RegionType").value = '';
            document.getElementById("Rejected").value = '';

            var ur = "";
            var Item = "";

        });

