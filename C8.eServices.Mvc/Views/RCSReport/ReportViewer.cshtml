<div id="chartContainer" style="height: 300px; width: 100%;"></div>
<script src="~/Scripts/jquery.datetimepicker.js"></script>
<script src="~/Content/RcsStyles/jquery.canvasjs.min.js"></script>
<link href="~/Content/RcsStyles/fontReports.css" rel="stylesheet" />

<script type="text/javascript">

        $(function () {

            $('#startDate').datetimepicker({
            format: 'Y/m/d',
            timepicker: false,
            onSelectDate: function (dt, i) {
                $('#endDate').datetimepicker({
                    format: 'Y/m/d',
                    minDate: dt,
                    maxDate:0,
                    timepicker: false
                });
            }
        });
        $('#DocTypeDdl').on('change', function () {

            $('#ReportTypeCtrl').show();

        });
        $('#ReportDdl').on('change', function () {
            var savedIndex = $('#ReportDdl').val();
            var subKey = savedIndex.substring(0, 3);
            if (subKey == "drr") {
                $('#DateRangeCtrl').show();
                $('#NormDetailedReportCtrl').hide();
                $('#divLicenseStatus').hide();
                $('#divLicenseStatuslbl').hide();
                $('#divRegionlbl').hide();
                $('#divRegion').hide();
                $('#divRejected').hide();
                
            }
            else if (subKey == "rdr") {
                $('#DateRangeCtrl').show();
                $('#NormDetailedReportCtrl').hide();
                $('#divLicenseStatus').hide();
                $('#divLicenseStatuslbl').show();
                $('#divRegionlbl').hide();
                $('#divRegion').hide();
                $('#divRejected').show();

            }
            else if (subKey == "sdr") {
                $('#DateRangeCtrl').show();
                $('#NormDetailedReportCtrl').hide();
                $('#divLicenseStatus').show();
                $('#divLicenseStatuslbl').show();
                $('#divRegionlbl').hide();
                $('#divRegion').hide();
                $('#divRejected').hide();

            }
            else if (subKey=="ndr") {
                $('#NormDetailedReportCtrl').show();
                $('#DateRangeCtrl').hide();
                $('#divLicenseStatus').hide();
                $('#divLicenseStatuslbl').hide();
                $('#divRegionlbl').hide();
                $('#divRegion').hide();

            }
            //   1.Start date & End date 2.Region 3. License Status
            else if (subKey=="drs") {
                $('#DateRangeCtrl').show();
                $('#NormDetailedReportCtrl').hide();
                $('#divLicenseStatus').show();
                $('#divLicenseStatuslbl').show();
                $('#divRegionlbl').show();
                $('#divRegion').show();
            }

            //  1. Start date & End date 2.Region
            else if (subKey == "ddr") {

                $('#DateRangeCtrl').show();
                $('#divLicenseStatus').hide();
                $('#divLicenseStatuslbl').hide();
                $('#divRegionlbl').show();
                $('#divRegion').show();

                $('#NormDetailedReportCtrl').hide();
            }
            else {
                $('#DateRangeCtrl').hide();
                $('#NormDetailedReportCtrl').hide();
                $('#divLicenseStatus').hide();
                $('#divLicenseStatuslbl').hide();
                $('#divRegionlbl').hide();
                $('#divRegion').hide();
            }
        });
        function convertToDate(data) {
            @*// The 6th+ positions contain the number of milliseconds in Universal Coordinated Time between the specified date and midnight January 1, 1970.*@
            var dtStart = new Date(parseInt(data.substr(6)));
            @*// Format using moment.js.*@
            var dtStartWrapper = moment(dtStart);
            return dtStartWrapper.format("YYYY/MM/DD");
        }

        function formatDate(data) {
            @*// Format using moment.js.*@
            var dtStartWrapper = moment(data);
            return dtStartWrapper.format("YYYY/MM/DD");
        }

    });



</script>
<script type="text/javascript">

        $('#submitDownloadDRReport').on('click', function () {
            var startDate = $('#startDate').val();
            var endDate = $('#endDate').val();
            var reportId = $('#ReportDdl').val();
            var reportName = $("#ReportDdl option:selected").text();
            var docTypeId = $('#DocTypeDdl').val();
            var docTypeName = $("#DocTypeDdl option:selected").text();

            var RegionType = $('#RegionType').val();
            var StatusType = $('#StatusType').val();
            var Rejected = $('#Rejected').val();

            var ur = "";
        var Item = "";

        var old_tbody = document.getElementById('MultipleLinksTBL');
        var new_tBody = document.createElement('tbody');
        new_tBody.setAttribute("id", "MultipleLinksTBL");
        var currMonth =@DateTime.Now.Month;
            var currYear =@DateTime.Now.Year;
            url = '@Url.Action("GenerateDateRangeReport", "RCSReport")?startDate=' + startDate + '&endDate=' + endDate + '&reportId=' + reportId + '&docTypeId=' + docTypeId + '&RegionType=' + RegionType + '&StatusType=' + StatusType + '&Rejected=' + Rejected;
            Item = '<tr><td> RCS  ' + reportName + '-' + docTypeName + '</td><td><a href=\"' + url + '\" class=\"download\" target=\"_blank\"></a></td></tr>';
            new_tBody.innerHTML += Item;
            old_tbody.parentNode.replaceChild(new_tBody, old_tbody);
        });

        $('#btnReset').on('click', function () {
            document.getElementById("startDate").value = '';
            document.getElementById("endDate").value = '';

             $('#startDate').datetimepicker({
