}

</html>
<div id="waitinglist_busy" class="modal fade" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content" style="width:550px;">
            <div class="modal-header">
                <h4 class="modal-title" id="modalTitleText"></h4>
            </div>
            <div class="modal-body">
                <div class="container">
                    <div class="alert alert-success col-md-5" id="AMYAlert" style="display:block;">
                        <p><strong>Please wait 20 seconds, then action.</strong></p>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-dismiss="modal">Okay</button>
            </div>
        </div>
    </div>
</div>


<script src="~/Scripts/jquery-2.2.0.min.js"></script>
<script>
    //Model.MatchedUnitId
    function AcceptPropertyListing() {

        jQuery.noConflict();
        $.getJSON("../HumanSettlementApplication/ValidateWaitingListSorting",
            function (result) {
                debugger;
                if (result == true) {
                    $("#waitinglist_busy").modal('show');
                    $('#waitinglist_busy').modal({
                        backdrop: 'static',
                        keyboard: false,
                        show: true
                    });
                } else {
                    $.getJSON("../HumanSettlementApplication/AcceptMatchedUnit?id=" +@Model.MatchedUnitId,
                        function (result) {
                            window.location.href = "@Url.Action("Inbox", "HumanSettlementApplication")";
                        });
                }
            });
    }

    function RejectPropertyListing() {

        $.getJSON("../HumanSettlementApplication/ValidateWaitingListSorting",
            function (result) {
                debugger;
                if (result == true) {
                    jQuery.noConflict();
                    $("#waitinglist_busy").modal('show');
                    $('#waitinglist_busy').modal({
                        backdrop: 'static',
                        keyboard: false,
                        show: true
                    });
                } else {
                    $.getJSON("../HumanSettlementApplication/RejectMatchedUnit?id=" +@Model.MatchedUnitId ,
                        function (result) {

                            window.location.href = "@Url.Action("Inbox", "HumanSettlementApplication")";
                        });
                }
            });
    }

    function redirect() {
        window.close();
    }
</script>



