                                                            </div>
                                                            <div class="item">
                                                                <img class="slide-image" src="~/Content/Images/image_ehc2.jpg" />
                                                                @*<img class="slide-image" src="https://cache-graphicslib.viator.com/graphicslib/destination/rhine-river-133772.jpg" alt="">*@
                                                            </div>
                                                            <!--<div class="item">
                                                                <img class="slide-image" src="~/Content/Images/house3.jpg" />-->
                                                            @*<img class="slide-image" src="https://cache-graphicslib.viator.com/graphicslib/destination/rhine-river-133772.jpg" alt="">*@
                                                            <!--</div>-->
                                                        </div>

                                                        <a class="left carousel-control" href="#carousel-example-generic" data-slide="prev">
                                                            <span class="glyphicon glyphicon-chevron-left" style="color:white;"><</span>
                                                        </a>
                                                        <a class="right carousel-control" href="#carousel-example-generic" data-slide="next">
                                                            <span class="glyphicon glyphicon-chevron-right" style="color:white;">></span>
                                                        </a>
                                                    </div>
