                                        <div class="btn-group btn-group-justified" style="width:1097px;">
                                            @*<a href="#" class="btn btn-default" onclick="AcceptPropertyListing()"><i class="fa fa-check" aria-hidden="true" style="color:forestgreen;"></i> Accept</a>*@
                                            @*<a href="#" class="btn btn-default" onclick="redirect()"><i class="fa fa-close" aria-hidden="true" style="color:red;"></i> Close</a>*@

                                            <a href="#" class="btn btn-default" onclick="AcceptPropertyListing()"><i class="fa fa-check" aria-hidden="true" style="color:forestgreen;"></i> Accept</a>
                                            <a href="#" class="btn btn-default" onclick="RejectPropertyListing()"><i class="fa fa-close" aria-hidden="true" style="color:red;"></i> Reject</a>
