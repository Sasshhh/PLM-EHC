
@model IEnumerable<C8.eServices.Mvc.ViewModels.TenantViewModel>
@using C8.eServices.Mvc.Keys;
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/RCS_Layout.cshtml";
}

<style>
    @@media only screen and (max-width: 1000px) {


        .cards tbody tr {
            float: left;
            width: 90%;
            margin: 0.5rem;
            border: 0.0625rem solid rgba(0,0,0,.125);
            border-radius: .25rem;
            box-shadow: 0.25rem 0.25rem 0.5rem rgba(0,0,0,0.25);
        }

        .cards thead tr {
            float: left;
            width: 90%;
            margin: 0.5rem;
            border: 0.0625rem solid rgba(0,0,0,.125);
            border-radius: .25rem;
            box-shadow: 0.25rem 0.25rem 0.5rem rgba(0,0,0,0.25);
        }


        .cards tbody td {
            display: block;
            word-wrap: break-word;
        }

        .cards thead th {
            display: none;
        }

        .table tbody label {
            display: block;
        }

        .cards tbody label {
            display: inline;
            position: relative;
            font-size: 85%;
            top: -0.5rem;
            color: #808080;
            min-width: 4rem;
            margin-left: 0;
            margin-right: 1rem;
            text-align: left;
        }

        tr.selected label {
            color: #404040;
        }

        .table .fa {
            font-size: 2.5rem;
            text-align: center;
        }

        .cards .fa {
            font-size: 7.5rem;
        }
    }
</style>

<div class="panel-group">
    <div class="panel panel-default">
        <div class="panel-group" style="margin-bottom: -1px;">
            <div class="panel panel-default">
                <div class="panel-heading" align="center">
                    @ViewBag.Tittle
                </div>
            </div>
        </div>
        <div id="accountInfoCollapse" class="panel-collapse collapse in tablecss">
            <br />
            <table id="RCSTable" class="table table-bordered table-hover table-striped panel panel-default cards">
                <thead>
                    <tr>
                        <th>Applicant Name</th>
                        <th>Application Type</th>
                        <th>Application Reference Number</th>
                        <th>Agreement Created Date</th>
                        <th>Status</th>
                        <th> Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@Html.DisplayFor(modelItem => item.HumanSettlementApplication.ApplicantFullName)</td>
                            <td>@Html.DisplayFor(modelItem => item.HumanSettlementApplication.PurchaserType.Name)</td>
                            <td>@Html.DisplayFor(modelItem => item.HumanSettlementApplication.ApplicationReferenceNumber)</td>
                            @if (item.HumanSettlementApplication.IsMaster)
                            {
                                <td>@Html.DisplayFor(modelItem => item.HumanSettlementLeaseMaster.CreatedDateTime.Value)</td>
                                <td>@Html.DisplayFor(modelItem => item.HumanSettlementLeaseMaster.Status.Name)</td>
                                <td>

                                    @if (item.HumanSettlementLeaseMaster.Status.Key == StatusKeys.AgreementOfLeaseReview || item.HumanSettlementLeaseMaster.Status.Key == StatusKeys.AwaitingRecommendationReview || item.HumanSettlementLeaseMaster.Status.Key == StatusKeys.AwaitingRecommendationApproval || item.HumanSettlementLeaseMaster.Status.Key == StatusKeys.AwaitingTenantAcceptance)
                                    {
                                        @Html.ActionLink("Review", "HumanAgreementRenewal", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("ApplicationId=" + item.HumanSettlementApplication.Id.ToString() + "&Data=" + item.HumanSettlementLeaseMaster.Data) }, new { @class = "btn btn-primary" })
                                    }
                                    @if (item.HumanSettlementLeaseMaster.Status.Key == StatusKeys.AgreementRenewal)
                                    {
                                        @Html.ActionLink("Renewal Documents", "HumanAgreementRenewal", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("ApplicationId=" + item.HumanSettlementApplication.Id.ToString() + "&Data=" + item.HumanSettlementLeaseMaster.Data) }, new { @class = "btn btn-primary" })
                                    }
                                </td>
                            }
                            else
                            {
                                <td>@Html.DisplayFor(modelItem => item.HumanSettlementLeaseDetails.CreatedDateTime.Value)</td>
                                <td>@Html.DisplayFor(modelItem => item.HumanSettlementLeaseDetails.Status.Name)</td>
                                <td>
                                    @if (item.HumanSettlementLeaseDetails.Status.Key == StatusKeys.AwaitingLeaseAgreementReview)
                                    {
                                        @Html.ActionLink("Agreement Review", "HumanAgreementOfLease", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("ApplicationId=" + item.Id.ToString() + "&Data=" + item.Data) }, new { @class = "btn btn-primary" })
                                    }
                            </td>
                            }

                        </tr>
                    }
                </tbody>
            </table>
            <br />
        </div>
    </div>
</div>

<script>
    $(function () {
        $('#RCSTable').DataTable();
        var display = "@ViewBag.Display";

        if (display != null && display != "") {
            $('#MessageModal3').modal('show');
        }
        else {
            $('#MessageModal3').modal('hide');
            var result = "@ViewBag.MessageBody";
            if (result != null && result != "") {
                $('#MessageModal').modal('show');
            }
            else {
                $('#MessageModal').modal('hide');
                var result5 = "@ViewBag.MessageBody5";
                if (result5 != null && result5 != "") {
                    $('#MessageModal5').modal('show');
                }
                else {
                    $('#MessageModal5').modal('hide');
                }
            }
        }


          $.ajax({
            url: "@Url.Action("ClearViewBags", "home")",
            type: "GET",
            dataType: "json",
            success: function (data) {

            }
        });
    });

    function OpenChatModal() {

        $('#MessageModal').modal('show');
    };

</script>