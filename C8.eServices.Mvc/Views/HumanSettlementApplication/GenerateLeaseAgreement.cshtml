                                <div class="col-md-6">
                                    @Html.DropDownList("DebitApproval", null, "-- Select Option --", htmlAttributes: new { @class = "form-control", onchange = "ApproveDebitOder()", @Name = "DebitApproval", @required = "required", @Id = "DebitApproval" })
                                    @Html.ValidationMessage("DebitApproval", "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </td>*@
                    </tr>

                </tbody>
            </table>
        </div>

        <br />
        <div id="divbtn" style="display:block" class="col-md-offset-1">
            <input type="button" value="Finish" name="btnApproval" onclick="location.href='@Url.Action("HumanSettlementAgreements", "HumanSettlementApplication", new { q = Model.HumanSettlementApplication.Data })'" class="button1" />
            <br />
            <br />
            <br />
        </div>

    </div>
</div>
<div id="otp_success" class="modal fade" role="dialog">
    <div class="modal-dialog">
        <div class="modal-content" style="width:550px;">
            <div class="modal-header">
                <h4 class="modal-title" id="modalTitleText"></h4>
            </div>
            <div class="modal-body">
                <div class="container">
                    <div class="alert alert-success col-md-5" id="AMYAlert" style="display:block;">
                        <p id="_successId"><strong>Agreement of Lease Successfully Generated!</strong></p>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-primary" data-dismiss="modal" @*onclick="location.href='@Url.Action("HumanAgreementRenewwals", "HumanSettlementApplication", new { q = Model._Data })'"*@>OK</button>
            </div>
        </div>
    </div>
</div>
@section Scripts{

    <script src="@Url.Content( "~/scripts/Datatables/jquery.dataTables.min.js" )"></script>
    <script src="@Url.Content( "~/scripts/Datatables/dataTables.bootstrap.js" )"></script>

    <script type="text/javascript">

        function loadAccounts() {
            //debugger;
            $('#FailureTable').DataTable({
                "ajax": {
                    "url": "@Url.Action( "LoadDetails", "DepartmentsApprovals" )",
                    "type": "GET",
                    "datatype": "json",
                    "timeout": 60000
                },
                "columns": [

                    {
                        "data": "CreatedDateTime", "autoWidth": true,
                        "render": function (data) {
                            return convertDate(data);
                        }
                    },
                    {
                        "render": function (data) {
                            return "System";
                        }
                    },
                    { "data": "FailureReason", "autoWidth": true },
                    {
                        "data": "CapturedDate", "autoWidth": true,
                        "render": function (data) {
                            return convertDate(data);
                        }
                    },

                     { "data": "AssignedTo", "autoWidth": true }],
                "language": {
                    "emptyTable": "No Data.",
                },
                "Initcomplete": "",
                "destroy": true
            });
        }

        function convertDate(data) {
            try {
                var dtStart = new Date(parseInt(data.substr(6)));
                var dtStartWrapper = moment(dtStart);
                return dtStartWrapper.format("YYYY-MM-DD");
            }
            catch (ex) {
            }
        }

        $(function () {
            $('#RCSTable').DataTable();

        });

    </script>

}

