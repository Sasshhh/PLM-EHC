@model C8.eServices.Mvc.ViewModels.DepartmentsApprovalViewModel
@using C8.eServices.Mvc.Keys;
@using System.Text;
@using C8.eServices.Mvc.DataAccessLayer;
@using C8.eServices.Mvc.Keys
@{
    ViewBag.Title = "Details";
    Layout = "~/Views/Shared/RCS_Layout.cshtml";
    bool DocumentSigned = false;
}
<head>
    <style>
        .swal-modal .swal-text {
            text-align: center;
        }
    </style>
</head>
<script src="@Url.Content( "~/Scripts/moment.js" )"></script>
<div id="bankAccountPanel">
    <div class="panel panel-default">
        <div class="panel-heading">Evaluating Application</div>
        <div style="width: 90%;margin: 0 auto;">
            <br />
            <table id="FailureTable" class="table table-bordered table-hover table-striped panel panel-default display ">
                <thead>
                    <tr>
                        <th>Reference Number</th>
                        <th>Applicant Type</th>
                        <th>Status</th>
                        <th>Captured Date</th>
                        <th>Customer Name</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>@Model.HumanSettlementApplication.ApplicationReferenceNumber</td>
                        <td>@Model.HumanSettlementApplication.PurchaserType.Name</td>
                        <td>@Model.HumanSettlementApplication.Status.Name</td>
                        <td>@Model.HumanSettlementApplication.CreatedDateTime</td>
                        <td>
                            @if (Model.HumanSettlementApplication.IsMaster)
                            {
                                @Model.HumanSettlementApplication.ApplicantFullName
                            }
                            else
                            {
                                @Model.HumanSettlementApplication.Customer.FullName
                            }
                        </td>
                        <td>@Html.ActionLink("View", "Details", "HumanSettlementApplication", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("ApplicationId=" + Model.HumanSettlementApplication.Id.ToString()), target = "_blank" }, new { @class = "btn btn-primary", @target = "_blank" })</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <br />
        <div class="panel-heading">Generated Agreement Of Lease</div>
        <div style="width: 90%;margin: 0 auto;">
            <br />
            <table id="FailureTable" class="table table-bordered table-hover table-striped panel panel-default display ">
                <thead>
                    <tr>
                        <th>Document Type</th>
                        <th>Document</th>
                        @if (Model.HumanSettlementApplication.Status.Key == StatusKeys.AwaitingApplicantssignature || Model.HumanSettlementApplication.Status.Key == StatusKeys.AwaitingLeaseAgreementApproval)
                        {
                            <th>Action</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>@Model.DocName</td>
                        <td><input type="button" id="btnExternal" class="button1" value="View" onclick="location.href='@Url.Action("pdfDenerateAgreementOfLease", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("ApplicationId=" + Model.HumanSettlementApplication.Id.ToString()) })'" /></td>
                        @if (Model.HumanSettlementApplication.Status.Key == StatusKeys.AwaitingApplicantssignature || Model.HumanSettlementApplication.Status.Key == StatusKeys.AwaitingLeaseAgreementApproval)
                        {
                            <td>
                                <div class="form-group">
                                    <span>@Html.Label("Signature", htmlAttributes: new { @class = "control-label col-md-3" })<b style="color:red; font-size:x-large;">*</b></span>
                                    <div class="col-md-6">
                                        @Html.DropDownList("AgreementSignature", null, "-- Select Option --", htmlAttributes: new { @class = "form-control", onchange = "SignAgreementOfLease(this.value)", @Name = "AgreementSignature", @required = "required", @Id = "AgreementSignatureId" })
                                        @Html.ValidationMessage("DebitApproval", "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </td>
                        }

                    </tr>
                </tbody>
            </table>
        </div>
        @if (Model.HumanSettlementApplication.Status.Key == StatusKeys.AwaitingFinalAgreementOfLease)
        {
            <br />
            <br />
            <div class="panel-heading">Final Agreement Of Lease</div>
            @Html.Partial("_DocumentsPartialAgreementOfLease", Model.DocumentsViewModel)
        }
        <div style="width: 90%;margin: 0 auto;">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                <br />
                @Html.HiddenFor(model => model.HumanSettlementApplication.Id, htmlAttributes: new { @class = "form-control", @Name = "HumanSettlementApplicationId", @Style = "display:none;" })
                @Html.HiddenFor(model => model.HumanSettlementApplication.Data, htmlAttributes: new { @class = "form-control", @Name = "Data", @Style = "display:none;" })
                @Html.HiddenFor(model => model.HumanSettlementApplication.Initial, htmlAttributes: new { @class = "form-control", @Name = "DocsSigned", @Id = "DocsSigned", @Style = "display:none;" })
                <div class="form-horizontal">
                    <div class="form-group">
                        <span>@Html.Label("Approval Action", htmlAttributes: new { @class = "control-label col-md-1" })<b style="color:red; font-size:x-large;">*</b></span>
                        @*@Html.Label("Approval Action", htmlAttributes: new { @class = "control-label col-md-1" })*@
                        <div class="col-md-2">
                            @Html.DropDownList("ApprovalAction", null, "-- Select Option --", htmlAttributes: new { @class = "form-control", @onchange = "ChangeStatus()", @Name = "ApprovalAction", @Id = "ApprovalAction", @required = "required" })
                            @Html.ValidationMessage("ApprovalStatus", "", new { @class = "text-danger" })
                        </div>
                    </div>
                    @if (Model.HumanSettlementApplication.Status.Key == StatusKeys.AwaitingApplicantssignature)
                    {
                        <div class="form-group" id="sub-div">
                            <span>@Html.Label("One Time Pin", htmlAttributes: new { @class = "control-label col-md-1" })<b style="color:red; font-size:x-large;">*</b></span>
                            <div class="col-md-2">
                                @Html.Editor("OneTimePin", new { htmlAttributes = new { @class = "form-control", @Name = "OneTimePin", @Id = "OneTimePinId", @maxlength = "4", @minlength = "4", @onkeypress = "return isNumber(event)" } })
                                @Html.ValidationMessage("OneTimePin", "", new { @class = "text-danger" })
                            </div>
                        </div>
                    }
                </div>


                <div id="divComment" style="display:none">
                    <div class="form-group">
                        <span>@Html.Label("Rejecting Comment", htmlAttributes: new { @class = "control-label col-md-1" })<b style="color:red; font-size:x-large;">*</b></span>
                        <div class="col-md-4">
                            @Html.TextArea("Comment", new { @class = "form-control", @Name = "ReasonForReject", @Id = "CommentId" })
                            @Html.ValidationMessage("Comment", "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <br />
                    <br />
                    <br />
                </div>
                @*<br />
                    <br />*@

                <div id="divbtn" style="display:block" class="col-md-offset-1">
                    @if (Model.HumanSettlementApplication.Status.Key == StatusKeys.AwaitingApplicantssignature)
                    {
                        <input type="button" class="button1" value="Verify" onclick="clickSubmit()" />
                    }
                    else
                    {
                        <input type="button" class="button1" value="Submit" onclick="clickSubmit()" />
                    }

                    <input type="submit" value="Submit" style="display:none;" hidden name="btnApprovalStatus" class="button1" id="btnApproval" />
                    <br />
                    <br />
                    <br />
                </div>
            }
        </div>
    </div>
</div>
<div id="otp_failure" class="modal fade" role="dialog">
    <div class="modal-dialog">
        <div class="modal-content" style="width:550px;">
            <div class="modal-header">
                <h4 class="modal-title" id="modalTitleText"></h4>
            </div>
            <div class="modal-body">
                <div class="container">
                    <div class="alert alert-danger col-md-5" id="AMYAlert" style="display:block;">
                        <p><strong>Invalid One Time Pin Entered!</strong></p>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-primary" data-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>
<div id="Doc_Not_Uploaded" class="modal fade" role="dialog">
    <div class="modal-dialog">
        <div class="modal-content" style="width:550px;">
            <div class="modal-header">
                <h4 class="modal-title" id="modalTitleText"></h4>
            </div>
            <div class="modal-body">
                <div class="container">
                    <div class="alert alert-danger col-md-5" id="AMYAlert" style="display:block;">
                        <p><strong>Please upload the finalized agreement!</strong></p>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-primary" data-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>
<div id="sign_agreement_failure" class="modal fade" role="dialog">
    <div class="modal-dialog">
        <div class="modal-content" style="width:550px;">
            <div class="modal-header">
                <h4 class="modal-title" id="modalTitleText">Error</h4>
            </div>
            <div class="modal-body">
                <div class="container">
                    <div class="alert alert-danger col-md-5" id="AMYAlert" style="display:block;">
                        <p><strong>Please sign the agreement of lease to submit!</strong></p>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-primary" data-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>
@section Scripts{

    <script src="@Url.Content( "~/scripts/Datatables/jquery.dataTables.min.js" )"></script>
    <script src="@Url.Content( "~/scripts/Datatables/dataTables.bootstrap.js" )"></script>

    <script type="text/javascript">


        function SignAgreementOfLease(selectedddl) {
            debugger;
            if (selectedddl != null || selectedddl != undefined) {
                $.getJSON("../HumanSettlementApplication/AgreementOfLeaseSignature?Id=" +@Model.HumanSettlementApplication.Id ,
                    function (result) {
                        debugger;
                        document.getElementById("DocsSigned").value = "true";
                        window.location.href = "@Url.Action("pdfDenerateAgreementOfLease", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("ApplicationId=" + Model.HumanSettlementApplication.Id.ToString()) })";
                    });
            }
        }

        function loadAccounts() {
            //debugger;
            $('#FailureTable').DataTable({
                "ajax": {
                    "url": "@Url.Action( "LoadDetails", "DepartmentsApprovals" )",
                    "type": "GET",
                    "datatype": "json",
                    "timeout": 60000
                },
                "columns": [

                    {
                        "data": "CreatedDateTime", "autoWidth": true,
                        "render": function (data) {
                            return convertDate(data);
                        }
                    },
                    {
                        "render": function (data) {
                            return "System";
                        }
                    },
                    { "data": "FailureReason", "autoWidth": true },
                    {
                        "data": "CapturedDate", "autoWidth": true,
                        "render": function (data) {
                            return convertDate(data);
                        }
                    },

                     { "data": "AssignedTo", "autoWidth": true }],
                "language": {
                    "emptyTable": "No Data.",
                },
                "Initcomplete": "",
                "destroy": true
            });
        }

        function convertDate(data) {
            try {
                var dtStart = new Date(parseInt(data.substr(6)));
                var dtStartWrapper = moment(dtStart);
                return dtStartWrapper.format("YYYY-MM-DD");
            }
            catch (ex) {
            }
        }

        $(function () {
            $('#RCSTable').DataTable();

        });

    </script>

}

<script>
    function isNumber(evt) {
        evt = (evt) ? evt : window.event;
        var charCode = (evt.which) ? evt.which : evt.keyCode;
        if (charCode > 31 && (charCode < 48 || charCode > 57)) {
            return false;
        }
        return true;
    }
    function ChangeStatus() {
        debugger;
        var statuskey = document.getElementById("ApprovalAction").value;
        if (statuskey == "Rcs_Rejected") {
            $('#divComment').css("display", "block");
           /* $("ApprovalAction").prop("required", true);*/
            document.querySelector('#CommentId').required = true;
        } else if (statuskey == "Rcs_Approval") {
            $('#divComment').css("display", "none");
            document.querySelector('#CommentId').required = false;
           /* $("ApprovalAction").prop("required", false);*/
        }
    }

    function clickSubmit() {
        debugger;
        var Key = '@Model.HumanSettlementApplication.Status.Key';
        if (Key == "s_awaiting_applicants_signature") {
            if (document.getElementById("DocsSigned").value == "false") {
                $('#sign_agreement_failure').modal({
                    backdrop: 'static',
                    keyboard: false,
                    show: true
                });
                return false;
            }
        }
        swal({
            icon: "info",
            title: "Are you sure you want to submit the following agreement?",
            buttons: [
                'No!',
                'Yes, I am sure!'
            ]

        }).then(function (isConfirm) {
            if (isConfirm) {
                debugger;
                var statusKey = '@Model.HumanSettlementApplication.Status.Key';
                var approvalaction = document.getElementById("ApprovalAction").value;
                if (statusKey == '@StatusKeys.AwaitingFinalAgreementOfLease') {
                    $.ajax({
                        url: "@Url.Action("DocFinalAgreementValid", "HumanSettlementApplication")?HumanSettlementApplicationId=" + @Model.HumanSettlementApplication.Id,
                        type: "POST",
                        dataType: "json",
                        success: function (data) {
                            debugger;
                            if (data.status == "Success") {
                                debugger;
                                document.getElementById("btnApproval").click();
                            } else {
                                debugger;
                                $('#Doc_Not_Uploaded').modal({
                                    backdrop: 'static',
                                    keyboard: false,
                                    show: true
                                });
                                return false;
                            }
                        }
                    });
                } else if (statusKey == '@StatusKeys.AwaitingApplicantssignature' && approvalaction!="") {
                    var onetimepin = document.getElementById("OneTimePinId").value;
                    $.ajax({
                        url: "@Url.Action("OneTimePinValidation", "HumanSettlementApplication")?ApplicationId=" + @Model.HumanSettlementApplication.Id + "&OneTimePin=" + onetimepin,
                        type: "POST",
                        dataType: "json",
                        success: function (data) {
                            debugger;
                            if (data.status == "Success") {
                                debugger;
                                document.getElementById("btnApproval").click();
                            } else {
                                $('#otp_failure').modal({
                                    backdrop: 'static',
                                    keyboard: false,
                                    show: true
                                });
                            }
                        }
                    });

                } else {
                    document.getElementById("btnApproval").click();
                }
            }
        });
        ////$(".swal-overlay").css('background-color', 'rgba(50, 170, 145 , 0.45');
        //swal({
        //    icon: "info",
        //    title: "Are you sure you want to submit the following document approval?",
        //    buttons: [
        //        'No!',
        //        'Yes, I am sure!'
        //    ]

        //}).then(function (isConfirm) {
        //    if (isConfirm) {

        //        document.getElementById("btnApproval").click();
        //    }
        //});
    }

</script>
