@section Scripts{

    <script src="@Url.Content( "~/scripts/Datatables/jquery.dataTables.min.js" )"></script>
    <script src="@Url.Content( "~/scripts/Datatables/dataTables.bootstrap.js" )"></script>

    <script type="text/javascript">


        function loadAccounts() {
            //debugger;
            $('#FailureTable').DataTable({
                "ajax": {
                    "url": "@Url.Action( "LoadDetails", "DepartmentsApprovals" )",
                    "type": "GET",
                    "datatype": "json",
                    "timeout": 60000
                },
                "columns": [

                    {
                        "data": "CreatedDateTime", "autoWidth": true,
                        "render": function (data) {
                            return convertDate(data);
                        }
                    },
                    {
                        "render": function (data) {
                            return "System";
                        }
                    },
                    { "data": "FailureReason", "autoWidth": true },
                    {
                        "data": "CapturedDate", "autoWidth": true,
                        "render": function (data) {
                            return convertDate(data);
                        }
                    },

                     { "data": "AssignedTo", "autoWidth": true }],
                "language": {
                    "emptyTable": "No Data.",
                },
                "Initcomplete": "",
                "destroy": true
            });
        }

        function convertDate(data) {
            try {
                var dtStart = new Date(parseInt(data.substr(6)));
                var dtStartWrapper = moment(dtStart);
                return dtStartWrapper.format("YYYY-MM-DD");
            }
            catch (ex) {
            }
        }

        $(function () {
            $('#RCSTable').DataTable();

        });

    </script>

}

<script>

    function isNumber(evt) {
        evt = (evt) ? evt : window.event;
        var charCode = (evt.which) ? evt.which : evt.keyCode;
        if (charCode > 31 && (charCode < 48 || charCode > 57)) {
            return false;
        }
        return true;

        var grosincome = document.getElementById("ElectricityMeterInformation_ElectricityMeterType").value;
        var netIncome = document.getElementById("ElectricityMeterInformation_ElectricityMeterType").value;
    }

    function clickSubmit() {
        swal({
            icon: "info",
            title: "Are you sure you want to submit the following document approval?",
            buttons: [
                'No!',
                'Yes, I am sure!'
            ]

        }).then(function (isConfirm) {
            if (isConfirm) {
                var statuskey = document.getElementById('ApprovalStatus').value;
                var comment = document.getElementById('Comments').value;
                if (statuskey == "Rcs_Rejected") {
                    if (comment == null || comment == "") {
                        swal("error", "Please enter reason for rejecting termination", "warning")
                    }
                } else {
                    document.getElementById("btnApproval").click();
                }
            }
        });
    }

</script>
