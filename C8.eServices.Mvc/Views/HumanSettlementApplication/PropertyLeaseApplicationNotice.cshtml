                @*@Html.HiddenFor(model => model.LeaseDetails.Id, htmlAttributes: new { @class = "form-control", @Style = "display:none;" })
                    @Html.HiddenFor(model => model.LeaseDetails.LeaseReferenceNo, htmlAttributes: new { @class = "form-control", @Style = "display:none;" })*@

                <div class="form-horizontal">
                    <div class="form-group">
                        @Html.LabelFor(model => model.LeaseTermination.TerminationDate, "Notice Date", htmlAttributes: new { @class = "control-label col-md-2" })

                        <div class="col-md-2">
                            @Html.EditorFor(model => model.LeaseTermination.TerminationDate, "Date", new { htmlAttributes = new { @class = " form-control", onchange = "ChangeDate()", @required = "required", @Name = "ServeNoticeDate", @Id = "ServeNoticeDate" } })
                            @Html.ValidationMessageFor(model => model.LeaseTermination.TerminationDate, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
                <br />

                <div id="divbtn" style="display:block" class="col-md-offset-2">
                    <input type="button" value="Submit" name="btnApproval" onclick="clickSubmit()" class="button1" />
                    <input type="submit" value="Submit" style="display:none;" hidden name="btnApprovalStatus" class="button1" id="btnApproval" />
                    <br />
                    <br />
                    <br />
                </div>
            }
        }
    </div>
</div>


