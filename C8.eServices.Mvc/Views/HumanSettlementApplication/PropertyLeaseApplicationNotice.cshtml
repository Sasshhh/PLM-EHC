    <script src="@Url.Content( "~/scripts/Datatables/dataTables.bootstrap.js" )"></script>



    <script>
    $(function () {
        $('#RCSTable').DataTable();
        $('#RCSTable2').DataTable();
        var display = "@ViewBag.DisplaySwal";
        var message = "@ViewBag.MessageBodySwal";
        if (display != null && display != "") {
