                            {
                                <td>@Model.HumanSettlementLeaseMaster.CreatedDateTime.Value</td>
                                <td>@Model.HumanSettlementLeaseMaster.Status.Name</td>
                            }
                            else
                            {
                                <td>@Model.HumanSettlementLeaseDetails.CreatedDateTime.Value</td>
                                <td>@Model.HumanSettlementLeaseDetails.Status.Name</td>
                            }
