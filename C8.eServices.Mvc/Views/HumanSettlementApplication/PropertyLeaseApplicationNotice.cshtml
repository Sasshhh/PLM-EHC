                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-primary" data-dismiss="modal" @*onclick="location.href='@Url.Action("HumanAgreementRenewwals", "HumanSettlementApplication", new { q = Model._Data })'"*@>OK</button>
            </div>
        </div>
    </div>
</div>
