        }

        .main-container .nav-wrap .nav-head {
            background: #1e8449;
        }

        .btn {
            color: #1e8449;
            border-color: #1e8449;
            background-color: white;
        }

            .btn:hover {
                color: white;
                border-color: white;
                background-color: #1e8449;
            }

        .btn12 {
            color: #af7b0b;
            border-color: #af7b0b;
            background-color: white;
        }

