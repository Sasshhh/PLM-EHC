        var PurchaserInformation_Passport = document.getElementById("PurchaserInformation_Passport").value;
        var PurchaserInformation_PurDateExpiry = document.getElementById("PurchaserInformation_PurDateExpiry").value;
        var PurchaserInformation_Nationality = document.getElementById("PurchaserInformation_Nationality").value;
        var PurchaserInformation_CellNo = document.getElementById("PurchaserInformation_CellNo").value;
        var PurchaserInformation_HomeNo = document.getElementById("PurchaserInformation_HomeNo").value;
        var PurchaserInformation_WorkNo = document.getElementById("PurchaserInformation_WorkNo").value;
        var PurchaserInformation_PurEmail = document.getElementById("PurchaserInformation_PurEmail").value;
        var PurchaserInformation_PostAddress = document.getElementById("PurchaserInformation_PostAddress").value;
        var PurchaserInformation_PostSuburb = document.getElementById("PurchaserInformation_PostSuburb").value;
        var PurchaserInformation_PostalCity = document.getElementById("PurchaserInformation_PostalCity").value;
        var PurchaserInformation_PostPostalCode = document.getElementById("PurchaserInformation_PostPostalCode").value;
        var PurchaserInformation_PurchaseType = document.getElementById("PurchaserInformation_PurchaseType").value;
        var PurchaserInformation_NominatedAddress = document.getElementById("PurchaserInformation_NominatedAddress").value;

        if (PurchaserInformation_IDNo != "") {
            var PurchaserInformation_DOB = document.getElementById("DOBAuto").value;
            var PurchaserInformation_Age = document.getElementById("AgeAuto").value;
        }
        else {
            var PurchaserInformation_DOB = document.getElementById("PurchaserInformation_DOB").value;
            var PurchaserInformation_Age = document.getElementById("PurchaserInformation_Age").value;
        }

        if (Gender == "" || TitleType == "" || MaritialStatus == "") {

            swal("Error!", "Please enter all required fields!.", "warning");
        }

        else {

            $.getJSON("../Capture/AddNaturalPerson?Gender="
                + Gender + '&TitleType=' + TitleType
                + '&MaritialStatus=' + MaritialStatus
                + '&PurchaserInformation_Initial=' + PurchaserInformation_Initial
                + '&PurchaserInformation_FirstName=' + PurchaserInformation_FirstName
                + '&PurchaserInformation_LastName=' + PurchaserInformation_LastName
                + '&PurchaserInformation_IDNo=' + PurchaserInformation_IDNo
                + '&PurchaserInformation_DOB=' + PurchaserInformation_DOB
                + '&PurchaserInformation_Age=' + PurchaserInformation_Age
                + '&PurchaserInformation_Passport=' + PurchaserInformation_Passport
                + '&PurchaserInformation_PurDateExpiry=' + PurchaserInformation_PurDateExpiry
                + '&PurchaserInformation_Nationality=' + PurchaserInformation_Nationality
                + '&PurchaserInformation_CellNo=' + PurchaserInformation_CellNo
                + '&PurchaserInformation_HomeNo=' + PurchaserInformation_HomeNo
                + '&PurchaserInformation_WorkNo=' + PurchaserInformation_WorkNo
                + '&PurchaserInformation_PurEmail=' + PurchaserInformation_PurEmail
                + '&PurchaserInformation_PostAddress=' + PurchaserInformation_PostAddress
                + '&PurchaserInformation_PostSuburb=' + PurchaserInformation_PostSuburb
                + '&PurchaserInformation_PostalCity=' + PurchaserInformation_PostalCity
                + '&PurchaserInformation_PostPostalCode=' + PurchaserInformation_PostPostalCode
                + '&PurchaserInformation_PurchaseType=' + PurchaserInformation_PurchaseType
                + '&PurchaserInformation_NominatedAddress=' + PurchaserInformation_NominatedAddress,

                function (result) {
                    if (result != "Error") {
                        try {

                            swal("Success!", "Added successfully.", "success");
                            jQuery('#divNaturalPersontbl').css("display", "block")
                            var row = $("<tr/>")
                            $("#NaturalPersontbl").append(row);
                            row.append($("<td>" + PurchaserInformation_FirstName + " " + PurchaserInformation_LastName + "</td>"));
                            if (PurchaserInformation_IDNo == "") {
                                row.append($("<td>" + PurchaserInformation_Passport + "</td>"));
                            }
                            else {
                                row.append($("<td>" + PurchaserInformation_IDNo + "</td>"));
                            }
                            row.append($("<td>" + PurchaserInformation_PurEmail + "</td>"));
                            row.append($("<td>" + PurchaserInformation_PostAddress + "</td>"));
                            row.append($("<td>" + PurchaserInformation_NominatedAddress + "</td>"));
                            clearNaturalPerson();
                            $('#NaturalPersontbl').DataTable();
                        }
                        catch (cat) { }
                    }
                    else {

                        swal("Error!", "Unsuccessfully captured!", "error");
                    }
                });
        }
    }

