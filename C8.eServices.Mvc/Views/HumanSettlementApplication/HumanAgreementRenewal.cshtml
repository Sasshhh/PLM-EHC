@section Scripts{

    <script src="@Url.Content( " ~ /scripts/Datatables/jquery.dataTables.min.js" )"></script>
    <script src="@Url.Content( " ~ /scripts/Datatables/dataTables.bootstrap.js" )"></script>

    <script type="text/javascript">
        $(function () {
            $('#FailureTable2').dataTable;
            /* $('#Compla').dataTable;*/
        });

        function convertDate(data) {
            try {
                var dtStart = new Date(parseInt(data.substr(6)));
                var dtStartWrapper = moment(dtStart);
                return dtStartWrapper.format("YYYY-MM-DD");
            }
            catch (ex) {
            }
        }

        $(function () {
            $('#RCSTable').DataTable();

        });

    </script>

}

<script>
    function ChangeAction(val) {
        if (val != "") {
            var OTP = document.getElementById('OTPId').value;
            VerificatioCodeValidation(OTP);
        }
    }

    function VerificatioCodeValidation(val) {
        debugger;
        var Id_leng = val.length;
        var statuskey = document.getElementById('ApprovalStatusRR').value;
        if (statuskey == "" && Id_leng == 4) {
            document.getElementById("btnApproval").click();
        }
        else if (Id_leng == 4) {
            $.ajax({
                url: "@Url.Action("VerificatioCodeValidation", "HumanSettlementApplication")?"+
                    "&ApplicationId=" + @Model.HumanSettlementApplication.Id +
                    "&OTP=" + val +
                    "&ApprovalStatusddl=" + statuskey,
                type: "POST",
                dataType: "json",
                success: function (data) {
                    if (data.status == "Success") {
                        $('#_successId').text(data.message)
                        $('#otp_success').modal({
                            backdrop: 'static',
                            keyboard: false,
                            show: true
                        });
                    }
                    if (data.status == "Failure") {
                        $('#_failureId').text(data.message)
                        $('#otp_failure').modal({
                            backdrop: 'static',
                            keyboard: false,
                            show: true
                        });
                    }
                }

            });
        }
    }

    function ValidateDocumentsUploaded() {
        debugger;
        var arr = [@documentCheckListId];
        var _arr = [@documentCheckListId];
        var count = 0;
        var len = arr.length;

        $.ajax({
            url: "@Url.Action("ValidateDocumentsUploaded", "HumanSettlementApplication")?"/*documentCheckListId=" + arr[index]*/ +
                "&referenceTypeId=" + @referenceTypeId +
                "&referenceId=" + @ReferenceId +
                "&customerId=" + @CustomerId +
                "&applicationId=" + @ApplicationId +
                "&rcsappId=" + @HumanSettlementApplicationId,
            type: "POST",
            dataType: "json",
            success: function (data) {
                if (data.status == "Failure") {
                    debugger;
                    $('#failureId').text(data.message)
                    $('#DocsEmpty').modal({
                        backdrop: 'static',
                        keyboard: false,
                        show: true
                    });
                } else {
                    document.getElementById("btnApproval").click();
                }
            }

        });
    }

    function isNumber(evt) {
        evt = (evt) ? evt : window.event;
        var charCode = (evt.which) ? evt.which : evt.keyCode;
        if (charCode > 31 && (charCode < 48 || charCode > 57)) {
            return false;
        }
        return true;
    }



    function clickSubmit() {
        swal({
            icon: "info",
            title: "Are you sure you want to submit this recommendation?",
            buttons: [
                'No!',
                'Yes, I am sure!'
            ]

        }).then(function (isConfirm) {
            if (isConfirm) {
                var statuskey = document.getElementById('ApprovalStatus').value;
                var comment = document.getElementById('Comments').value;
                if (statuskey == "Rcs_Rejected") {
                    if (comment == null || comment == "") {
                        document.getElementById("btnApproval").click();
                    } else {
                        swal({
                            icon: "info",
                            title: "Are you sure you want to oppose this recommendation?",
                            buttons: [
                                'No!',
                                'Yes, I am sure!'
                            ]

                        }).then(function (isConfirm) {
                            if (isConfirm) {
                                document.getElementById("btnApproval").click();
                            }
                        });
                    }
                }
                else {
                    document.getElementById("btnApproval").click();
                }
            }
        });
        ////$(".swal-overlay").css('background-color', 'rgba(50, 170, 145 , 0.45');
        //swal({
        //    icon: "info",
        //    title: "Are you sure you want to submit the following document approval?",
        //    buttons: [
        //        'No!',
        //        'Yes, I am sure!'
        //    ]

        //}).then(function (isConfirm) {
        //    if (isConfirm) {

        //        document.getElementById("btnApproval").click();
        //    }
        //});
    }
    function SubmitVerificationCode() {
          swal({
            icon: "info",
              title: "Are you sure you want to submit this action?",
            buttons: [
                'No!',
                'Yes, I am sure!'
            ]

        }).then(function (isConfirm) {
            if (isConfirm) {
                var otp = document.getElementById("OTPId").value;
                VerificatioCodeValidation(otp);
            }
        });
    }
    function SubmitVerificationCode2() {
        swal({
            icon: "info",
            title: "Are you sure you want to submit these documents?",
            buttons: [
                'No!',
                'Yes, I am sure!'
            ]

        }).then(function (isConfirm) {
            if (isConfirm) {
                debugger;
                document.getElementById("btnApproval").click();
            }
        });
    }
</script>
