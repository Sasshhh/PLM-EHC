                    <table id="Compla" class="table table-bordered table-hover table-striped panel panel-default display ">
                        <thead>
                            <tr>
                                <th>Housing Liason Officer</th>
                                <th>Action Comment</th>
                                <th>Action Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.HSRenewalActions)
