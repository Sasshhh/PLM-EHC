@model C8.eServices.Mvc.ViewModels.DepartmentsApprovalViewModel
@using System.Text;
@using C8.eServices.Mvc.DataAccessLayer;
@using C8.eServices.Mvc.Keys
@{
    Layout = "~/Views/Shared/RCS_Layout.cshtml";
    var statusKey = Model.HumanSettlementLeaseMaster.Status.Key ?? Model.HumanSettlementLeaseDetails.Status.Key;
    var documentCheckListId = string.Empty;
    var referenceTypeId = Model.DocumentsViewModel.ReferenceTypeId;
    var ReferenceId = Model.DocumentsViewModel.ReferenceId;
    var CustomerId = Model.DocumentsViewModel.CustomerId;
    var ApplicationId = Model.DocumentsViewModel.ApplicationId;
    var HumanSettlementApplicationId = Model.DocumentsViewModel.HumanSettlementApplicationId;
    if (statusKey == StatusKeys.AgreementRenewal)
    {
        var rrq = Model.DocumentsViewModel.DocumentCheckLists.Select(r => r.Id).ToList();
        foreach (var I in rrq)
        {
            if (string.IsNullOrEmpty(documentCheckListId))
            {
                documentCheckListId = I.ToString();
            }
            else
            {
                documentCheckListId += "," + I.ToString();
            }
        }
    }


}
<head>
    <style>
        .swal-modal .swal-text {
            text-align: center;
        }
    </style>
</head>
<script src="@Url.Content( "~/Scripts/moment.js" )"></script>

<div id="bankAccountPanel">
    <div class="panel panel-default">
        <div class="panel-heading">Evaluating Application</div>
        <div style="width: 90%;margin: 0 auto;">
            <br />
