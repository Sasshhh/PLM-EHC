                            @Html.ActionLink("View", "Details", "HumanSettlementApplication", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("ApplicationId=" + Model.HumanSettlementApplication.Id.ToString()), target = "_blank" }, new { @class = "btn btn-primary", @target = "_blank" })
                        </td>
                    </tr>
                </tbody>
            </table>
            <br />
        </div>

        @if (statusKey == StatusKeys.AgreementOfLeaseReview || statusKey == StatusKeys.AwaitingRecommendationReview)
        {


