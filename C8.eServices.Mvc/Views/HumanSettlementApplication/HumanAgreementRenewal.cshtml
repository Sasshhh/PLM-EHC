                    <div class="form-group">
                        <span> @Html.Label("ACTION", htmlAttributes: new { @class = "control-label col-md-1", @style = "width: 11%;+" })<b style="color:red; font-size:x-large;">*</b></span>
                        <div class="col-md-2">
                            @Html.DropDownList("ApprovalStatus", null, "-- Select Option --", htmlAttributes: new { @class = "form-control", @Id = "ApprovalStatusRR", @Name = "ApprovalStatusddl", @*@onchange = "ChangeAction(this.value)",*@ @required = "required" })
                            @Html.ValidationMessage("ApprovalStatus", "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        <div id="divComment" style="display:block">
                            <div class="form-group">
                                <span> @Html.Label("ONE TIME PIN", htmlAttributes: new { @class = "control-label col-md-1", @style = "width: 11%;+" })<b style="color:red; font-size:x-large;">*</b></span>
                                <div class="col-md-2">
                                    @Html.EditorFor(model => model.OTP, new { htmlAttributes = new { @class = "form-control", @required = "required", @onkeypress = "return isNumber(event)", @*@onkeyup = "VerificatioCodeValidation(this.value)",*@ @Name = "OTP", @Id = "OTPId", @maxlength = "4", @minlength = "4" } })
                                    @Html.ValidationMessageFor(model => model.OTP, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <br />
                        </div>
                    </div>
                    <div id="divbtn" style="display:block" class="col-md-offset-1">
                        <input type="button" value="Verifiy" name="btnApproval" onclick="SubmitVerificationCode()" class="button1" />
                        <input type="submit" value="Submit" style="display:none;" hidden name="btnApprovalStatus" class="button1" id="btnApproval" />
                        <br />
                        <br />
                        <br />
                    </div>
                }
            }
        </div>
    </div>
</div>

