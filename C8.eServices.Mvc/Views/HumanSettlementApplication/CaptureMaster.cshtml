    function searchmeters(rateNo) {
        //alert("in search meters");
        Session = [];
        SessionDelete = [];
        SessionCount = 0;
        DeleteCount = 0;

        ElectricitySession = [];
        ElectricitySessionDelete = [];
        ElectricitySessionCount = 0;
