    function validateEmail(email) {
        var emailID = document.getElementById(email).value;
        var re = /^(([^<>()[\]\\.,;:\s@@\"]+(\.[^<>()[\]\\.,;:\s@@\"]+)*)|(\".+\"))@@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\])|(([a-zA-Z\-0-9]+\.)+[a-zA-Z]{2,}))$/;
        var isEmail = re.test(emailID);
        if (isEmail != true && (emailID != null || emailID != '')) {
            //alert("Please enter a valid email");
            swal("Error!", "Please enter a valid email.", "warning");
            document.getElementById(email).value = "";
            // 
        } else {
            if (emailID != null || emailID != '') {
                debugger;
                const SpouseEmail = document.getElementById("ApplicantJoint_JointEmail").value;
                const TenantEmail = document.getElementById("TenantEmailId").value;
                if()
                    if (SpouseEmail != null || SpouseEmail != '' && email != 'ApplicantJoint_JointEmail' ) {
                    if (emailID == SpouseEmail) {
                        swal("Error!", "The email you entered has been captured for spouse!", "warning");
                        $('#' + email).val('');
                    }
                }
                if (TenantEmail != null || TenantEmail != '' && email != 'TenantEmailId') {
                    if (emailID == TenantEmail) {
                        swal("Error!", "The email you entered has been captured for the tenant!", "warning");
                        $('#' + email).val('');
                    }
                }
            }
        }
    }
    function ValidateMobileContactNumber(MobileNumber, Id) {
        debugger;
        if (MobileNumber != null || MobileNumber != '') {
            const SpouseMobileNumber = document.getElementById("ApplicantJoint_JointCellNo").value;
            const TenantMobileNumber = document.getElementById("MobileNumberrId").value;
            if (SpouseMobileNumber != null || SpouseMobileNumber != '') {
                if (MobileNumber == SpouseMobileNumber) {
                    swal("Error!", "The number you entered has been captured for spouse!", "warning");
                    $('#' + Id).val('');
                }
            }
            if (TenantMobileNumber != null || TenantMobileNumber != '') {
                if (MobileNumber == TenantMobileNumber) {
                    swal("Error!", "The number you entered has been captured for the tenant!", "warning");
                    $('#' + Id).val('');
                }
            }
        }
    }
