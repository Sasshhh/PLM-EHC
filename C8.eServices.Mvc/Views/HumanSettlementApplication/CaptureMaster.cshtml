<script>
    function validateString(event) {
        const input = event.target.value;
        const regex = /^[a-zA-Z]+$/; // regular expression that matches only letters
        if (!regex.test(input)) {
            event.target.value = input.replace(/[^a-zA-Z]/g, ''); // remove non-letter characters from input
        }
    }
    function validateStringSpace(event) {
        const input = event.target.value;
        const regex = /^[a-zA-Z\s]+$/; // regular expression that matches letters and spaces
        if (!regex.test(input)) {
            event.target.value = input.replace(/[^a-zA-Z\s]/g, ''); // remove non-letter and non-space characters from input
        }
    }

    function isValidPhoneNumber(phoneNumber, propertyId) {
        debugger;
        // Regular expression pattern for a valid phone number (excluding 10 zeros)
       /* const pattern = /^(?!0{10})(?!0*(\d)\1{9})0\d{9}$/;*/
        const pattern = /^(?!0{10})(?!00)\d{10}$/;
        // Check if the input matches the pattern
        if (!pattern.test(phoneNumber)) {
            $('#' + propertyId).val('');
            swal("Error!", "Please enter a valid mobile number!", "warning")
        }
    }



