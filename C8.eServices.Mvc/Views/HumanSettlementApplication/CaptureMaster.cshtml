        var month = thisDate.getMonth();
        var year = thisDate.getFullYear();
        var dateSelected = thisDate.getUTCDate();
        var firstDay = 1;
        var LastDate = new Date(year, month + 1, 0);
        var LastDay = LastDate.getDate();
