                    </div>
                </div>

                <div class="col-md-3 col-xl-3" onclick="window.location='@Url.Action("HumanSettlementAgreements", "HumanSettlementApplication", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("Generate=" + false + "&Review=" + false + "&Approve=" + true + "&Signature=" + false + "&Finalized=" + false + "&Update=" + false) })'">
                    <div class="card bg-c-green order-card">
                        <div class="card-block">
                            <div><h4 class="alignleft">@Model.AgreementApproval.Count()</h4><h4 class="alignright">@Model.AgreementApproval.Where(c => c.Status.Key == StatusKeys.Archived).Count()</h4><br style="clear:both;" /></div>
                            <div><h4 class="alignleft">Recieved</h4><h4 class="alignright">Completed</h4><br style="clear:both;" /></div>
                            <hr style="width: 80%;" />
                            <div><h4 class="alignleft">Agreement Review</h4><h4 class="alignright"><span>@Model.AgreementApproval.Where(c => c.Status.Key == StatusKeys.Submitted).Count()</span></h4><br style="clear:both;" /></div>
                        </div>
                    </div>
                </div>

            </div>
        }
    </section>
</div>

<script>
    $(document).ready(function () {
        window.scrollTo({ top: 0, behavior: 'smooth' });
        var bun = document.getElementById('burgerbutton');
        bun.click();
    });
    function time() {
        var span = document.getElementById('span');
        var options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }
        var d = new Date();
        var s = d.getSeconds();
        var m = d.getMinutes();
        var h = d.getHours();
        span.textContent =
            d.toLocaleDateString("en-US", options) + " - " + ("0" + h).substr(-2) + ":" + ("0" + m).substr(-2) + ":" + ("0" + s).substr(-2);
    }
    setInterval(time, 1000);
</script>