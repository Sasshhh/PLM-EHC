<div class="grey-bg container-fluid">
    <section id="stats-subtitle">
        <div class="row">
            <div class="col-12 mt-3 mb-1">
                <h4 class="text-uppercase" style="color:dimgrey;">Human Settlement Dashboard - @_base.SystemUser.UserFullName</h4>
                <p>&nbsp; <span id="span"></span></p>
            </div>
        </div>

        <div class="row">
            <div class="col-md-3 col-xl-3" onclick="window.location='@Url.Action("HumanSettlementApplications", "HumanSettlementApplication", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("Master=" + false + "&All=" + true + "&New=" + false) })'">
