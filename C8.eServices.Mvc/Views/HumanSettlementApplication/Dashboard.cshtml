                    <div class="card-block">
                        <div><h4 class="text-center" style="font-size:50px;">@Model.AllApplications</h4></div>
                        <hr style="width: 80%;" />
                        <div><h4 class="text-center">All Applications</h4></div>
                    </div>
                </div>
            </div>

            <div class="col-md-3 col-xl-3" onclick="window.location='@Url.Action("HumanSettlementApplications", "HumanSettlementApplication", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("Master=" + true + "&All=" + false + "&New=" + false) })'">
