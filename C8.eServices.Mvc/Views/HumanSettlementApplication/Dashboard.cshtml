<style>
    .grey-bg {
        background-color: #F5F7FA;
    }

    body {
        margin-top: 20px;
        background: #FAFAFA;
    }

    .order-card {
        color: #fff;
    }

    .bg-c-blue {
        background: linear-gradient(45deg,#1d3c77,#1d3c77);
    }

    .bg-c-green {
        background: linear-gradient(45deg,#006338,#006338);
    }

    .bg-c-yellow {
        background: linear-gradient(45deg,#f7b512,#f7b512);
    }

    .bg-c-pink {
        background: linear-gradient(45deg,#da291c,#da291c);
    }


    .card {
        border-radius: 5px;
        -webkit-box-shadow: 0 1px 2.94px 0.06px rgba(4,26,55,0.16);
        box-shadow: 0 1px 2.94px 0.06px rgba(4,26,55,0.16);
        border: none;
        margin-bottom: 30px;
        -webkit-transition: all 0.3s ease-in-out;
        transition: all 0.3s ease-in-out;
    }

        .card .card-block {
            padding: 25px;
        }

    .order-card i {
        font-size: 26px;
    }

    .f-left {
        float: left;
    }

    .f-right {
        float: right;
    }


    h4 {
        color: #FFF;
        letter-spacing: 1px;
        padding: 5px;
        margin: 0;
    }

    h4 {
        color: #FFF;
        letter-spacing: 1px;
        padding: 5px;
        margin: 0;
    }

    hr {
        color: whitesmoke;
    }

    .alignleft {
        float: left;
    }

    .alignright {
        float: right;
    }

    .m-b-20 {
        text-align: center;
        padding-bottom: 0px;
    }


    .card-block:hover {
        cursor: pointer;
    }

    .grey-bg {
        padding: 25px;
    }

    .site-head.fixedHeader {
        top: 0%;
        position: fixed;
        left: 0;
        right: 0;
    }
</style>
