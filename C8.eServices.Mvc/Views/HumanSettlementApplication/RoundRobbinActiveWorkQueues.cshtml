@model IEnumerable<C8.eServices.Mvc.Models.Customer>
@using C8.eServices.Mvc.Keys;
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/RCS_Layout.cshtml";
}

@*<h4>Pending Documents Evaluations</h4>*@
<div class="panel-group">
    <div class="panel panel-default">




        <div class="panel-group" style="margin-bottom: -1px;">
            <div class="panel panel-default">
                <div class="panel-heading" align="center">
                    Ekurhuleni Housing Company Round Robbin
                </div>

            </div>
        </div>

        <div id="accountInfoCollapse" class="panel-collapse collapse in tablecss">
            <br />

            <table id="RCSTable" class="table table-bordered table-hover table-striped panel panel-default display">
                <thead>
                    <tr>
                        <th>
                            Worker Full Name
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.CellPhoneNumber)
                        </th>
                        <th>
                            Applications Assigned
                        </th>
                        <th>
                            Working
                        </th>
                        <th>
                            E-mail
                        </th>
                        <th>
                            Worker Role(s)
                        </th>


                        <th></th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {

                    <tr>
                        <td>
                            @Html.DisplayFor(modelItem => item.FullName)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.CellPhoneNumber)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Data)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.IsActive)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.EmailAddress)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.ColorCode)
                        </td>
                        <td>
                            @if (Request.IsAuthenticated && User.IsInRole("Acknowledge RCS Application"))

                            {
                                if (item.Status.Key == StatusKeys.PendingDocumentsApproval)
                                {
                                    @Html.ActionLink("View", "DocumentVerification", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("id=" + item.Id.ToString()) }, new { @class = "btn btn-primary" })
                                }
                                else if (item.Status.Key == StatusKeys.PendingApplicationFeePaymentValidation)
                                {
                                    @Html.ActionLink("View", "ApplicationFeeValidation", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("id=" + item.Id.ToString()) }, new { @class = "btn btn-primary" })

                                }
                            }

                            @if (Request.IsAuthenticated && (User.IsInRole("Rates Clearance Sectional Head") || User.IsInRole("Support Admin") || User.IsInRole("Back Office System Administrator")))
                            {
                                @Html.ActionLink("Bulk Re-Allocate", "ManualReAllocate", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("id=" + item.Id.ToString() + "&rrqID=" + item.RoundRobinQueueId + "&ResponsibilityType=" + ResponsibilityTypeKeys.AcknowledgeRCSApplication + "&ViewName=EHCRoundRobbinDashboard" + "&TitleName=EHCRoundRobbinDashboardTitle&BodyName=EHCRoundRobbinDashboard") }, new { @class = "btn btn-primary" });
                            }

                            @*@if (Request.IsAuthenticated && User.IsInRole("Acknowledge RCS Application"))

                            {
                                @Html.ActionLink("Message", "CreateMessage", "RCSApplication", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("id=" + item.Id.ToString() + "&" + "CommunicationType=" + CommunicationTypeKeys.AttorneyToBo) }, new { @class = "btn btn-primary" })

                            }*@

                            @*@Html.ActionLink("Application Details", "Details", "PropertyLeaseApplication", new
                            {
                                q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("refNo=" + item.Id.ToString()+ "&" + "id=" + item.Id.ToString())
}, new { @class = "btn btn-primary", @target = "_blank" })*@


                            @*@Html.ActionLink("Message", "CreateMessage", new { id = item.Id, CommunicationType = CommunicationTypeKeys.AttorneyToBo }, new { @class = "btn btn-primary" })*@
                        </td>
                    </tr>
                    }
                </tbody>
            </table>

        </div>
    </div>
</div>



<script>
    $(function () {
        $('#RCSTable').DataTable();
        //"rowCallback": function(row, data) {
        //    if (data.grade == "A") {
        //        $('td:eq(4)', row).html('<b>A</b>');
        //    }
        //}
                var display = "@ViewBag.Message";

        if (display != null && display != "") {
            $('#MessageModal4').modal('show');
        }
    });


</script>