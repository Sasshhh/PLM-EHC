@model C8.eServices.Mvc.ViewModels.DepartmentsApprovalViewModel
@using System.Text;
@using C8.eServices.Mvc.DataAccessLayer;
@using C8.eServices.Mvc.Keys
@{
    Layout = "~/Views/Shared/RCS_Layout.cshtml";
}
<head>
    <style>
        .swal-modal .swal-text {
            text-align: center;
        }
    </style>
</head>
<script src="@Url.Content( "~/Scripts/moment.js" )"></script>

<div id="bankAccountPanel">
    <div class="panel panel-default">
        <div class="panel-heading">Evaluating Application</div>
        <div style="width: 90%;margin: 0 auto;">
            <br />
            <table id="FailureTable" class="table table-bordered table-hover table-striped panel panel-default display ">
                <thead>
                    <tr>
                        <th>Applicant Name</th>
                        <th>Application Type</th>
                        <th>@Html.DisplayNameFor(model => model.HumanSettlementApplication.ApplicationReferenceNumber)</th>
                        <th>Application Created Date</th>
                        <th>Status</th>
                        <th> Action</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>@Model.HumanSettlementApplication.ApplicantFullName</td>
                        <td>@Model.HumanSettlementApplication.PurchaserType.Name</td>
                        <td>@Model.HumanSettlementApplication.ApplicationReferenceNumber</td>
                        <td>@Model.HumanSettlementApplication.CreatedDateTime.Value</td>
                        <td>@Model.HumanSettlementApplication.Status.Name</td>
                        <td>
                            @Html.ActionLink("View", "Details", "PropertyLeaseApplication", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("refNo=" + Model.HumanSettlementApplication.Id.ToString()), target = "_blank" }, new { @class = "btn btn-primary", @target = "_blank" })
                        </td>
                    </tr>
                </tbody>
            </table>
            <br />
        </div>

        <div class="form-horizontal">
            <div class="form-group">
                @Html.Label("Recommend Change To:", new { @class = "control-label col-md-2" })
                <div class="col-md-3">
                </div>
            </div>
            <div class="form-group">
                <span>@Html.Label("Typology :", new { @class = "control-label col-md-2" })<b style="color:red; font-size:x-large;">*</b></span>
                <div class="col-md-3">
                    @Html.TextBoxFor(m => m.WaitingQueueChangeRequest.UnitTypology.Name, null, new { @class = "form-control", @readonly = true })
                </div>
            </div>
            <div class="form-group">
                <span>@Html.Label("Category :", new { @class = "control-label col-md-2" })<b style="color:red; font-size:x-large;">*</b></span>
                <div class="col-md-3">
                    @Html.TextBoxFor(m => m.WaitingQueueChangeRequest.UnitCategory.Name, null, new { @class = "form-control", @readonly = true })
                </div>
            </div>
            <div class="form-group">
                @Html.Label("Preferred Complex/Area:", new { @class = "control-label col-md-2" })
                <div class="col-md-3">
                </div>
            </div>
            <div class="form-group">
                <span>@Html.Label("Option One:", new { @class = "control-label col-md-2" })<b style="color:red; font-size:x-large;">*</b></span>
                <div class="col-md-3">
                    @Html.TextBoxFor(m => m.WaitingQueueChangeRequest.PreferredComplexAreaOne.Name, null, new { @class = "form-control", @readonly = true })
                </div>
            </div>
            <div class="form-group">
                <span> @Html.Label("Option Two:", new { @class = "control-label col-md-2" })<b style="color:red; font-size:x-large;">*</b></span>
                <div class="col-md-3">
                    @Html.TextBoxFor(m => m.WaitingQueueChangeRequest.PreferredComplexAreaTwo.Name, null, new { @class = "form-control", @readonly = true })
                </div>
            </div>
        </div>

        <div style="width: 100%;margin: 0 auto;">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                @Html.Hidden("ApplicationId", null, new { htmlAttributes = new { @class = "form-control", @style = "display:none;", @Id = "ApplicationId", @Name = "ApplicationId" } })
                @Html.Hidden("Data", null, new { htmlAttributes = new { @class = "form-control", @style = "display:none;", @Id = "Data", @Name = "Data" } })


            <div class="form-horizontal">
                <div class="form-group">
                    <span> @Html.Label("Approval Action ", htmlAttributes: new { @class = "control-label col-md-2" })<b style="color:red; font-size:x-large;">*</b></span>
                    <div class="col-md-3">
                        @Html.DropDownList("ApprovalStatus", null, "-- Select Option --", htmlAttributes: new { @class = "form-control", @Id = "ApprovalStatus", @Name = "ApprovalStatusddl", @required = "required" })
                        @Html.ValidationMessage("ApprovalStatus", "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="col-md-offset-2">
                    <br />
                    <input type="button" value="Submit" name="btnApproval" onclick="clickSubmit()" class="button1" />
                    <input type="submit" value="Submit" style="display:none;" hidden name="btnApprovalStatus" class="button1" id="btnApproval" />
                    <br />
                    <br />
                    <br />
                </div>
            </div>
            }
        </div>
    </div>
</div>

<div >
    <br />
    <input type="button" value="Back To Inbox" class="button1" />
</div>


<div id="HalfDocs" class="modal fade" role="dialog">
    <div class="modal-dialog">
        <div class="modal-content" style="width:550px;">
            <div class="modal-header">
                <h4 class="modal-title" id="modalTitleText"></h4>
            </div>
            <div class="modal-body">
                <div class="container">
                    <div class="alert alert-success col-md-5" id="AMYAlert" style="display:block;">
                        <p id="successId"><strong>text</strong></p>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-primary" data-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>
<div id="DocsEmpty" class="modal fade" role="dialog">
    <div class="modal-dialog">
        <div class="modal-content" style="width:550px;">
            <div class="modal-header">
                <h4 class="modal-title" id="modalTitleText"></h4>
            </div>
            <div class="modal-body">
                <div class="container">
                    <div class="alert alert-danger col-md-5" id="AMYAlert" style="display:block;">
                        <p id="failureId"><strong>test</strong></p>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-primary" data-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>
<div id="otp_success" class="modal fade" role="dialog">
    <div class="modal-dialog">
        <div class="modal-content" style="width:550px;">
            <div class="modal-header">
                <h4 class="modal-title" id="modalTitleText"></h4>
            </div>
            <div class="modal-body">
                <div class="container">
                    <div class="alert alert-success col-md-5" id="AMYAlert" style="display:block;">
                        <p id="_successId"><strong>text</strong></p>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-primary" data-dismiss="modal" onclick="location.href='@Url.Action("CustomerAgreementRenewalAcceptance", "HumanSettlementApplication",  new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("IsUploadView=true") })'">OK</button>
            </div>
        </div>
    </div>
</div>
<div id="otp_failure" class="modal fade" role="dialog">
    <div class="modal-dialog">
        <div class="modal-content" style="width:550px;">
            <div class="modal-header">
                <h4 class="modal-title" id="modalTitleText"></h4>
            </div>
            <div class="modal-body">
                <div class="container">
                    <div class="alert alert-danger col-md-5" id="AMYAlert" style="display:block;">
                        <p id="_failureId"><strong>test</strong></p>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-primary" data-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>

@section Scripts{

    <script src="@Url.Content( " ~ /scripts/Datatables/jquery.dataTables.min.js" )"></script>
    <script src="@Url.Content( " ~ /scripts/Datatables/dataTables.bootstrap.js" )"></script>

    <script type="text/javascript">
        $(function () {
            $('#FailureTable2').dataTable;
            /* $('#Compla').dataTable;*/
        });

        function convertDate(data) {
            try {
                var dtStart = new Date(parseInt(data.substr(6)));
                var dtStartWrapper = moment(dtStart);
                return dtStartWrapper.format("YYYY-MM-DD");
            }
            catch (ex) {
            }
        }

        $(function () {
            $('#RCSTable').DataTable();

        });

    </script>

}

<script>
    function ChangeAction(val) {
        if (val != "") {
            var OTP = document.getElementById('OTPId').value;
            VerificatioCodeValidation(OTP);
        }
    }



    function VerificatioCodeValidation(val) {
        debugger;
        var Id_leng = val.length;
        var statuskey = document.getElementById('ApprovalStatusRR').value;
        if (statuskey == "" && Id_leng == 4) {
            document.getElementById("btnApproval").click();
        }
        else if (Id_leng == 4) {
            $.ajax({
                url: "@Url.Action("VerificatioCodeValidation2", "HumanSettlementApplication")?"+
                    "&ApplicationId=" + @Model.HumanSettlementApplication.Id +
                    "&OTP=" + val +
                    "&ApprovalStatusddl=" + statuskey,
                type: "POST",
                dataType: "json",
                success: function (data) {
                    if (data.status == "Success") {
                        $('#_successId').text(data.message)
                        $('#otp_success').modal({
                            backdrop: 'static',
                            keyboard: false,
                            show: true
                        });
                    }
                    if (data.status == "Failure") {
                        $('#_failureId').text(data.message)
                        $('#otp_failure').modal({
                            backdrop: 'static',
                            keyboard: false,
                            show: true
                        });
                    }
                }

            });
        }
    }


    function isNumber(evt) {
        evt = (evt) ? evt : window.event;
        var charCode = (evt.which) ? evt.which : evt.keyCode;
        if (charCode > 31 && (charCode < 48 || charCode > 57)) {
            return false;
        }
        return true;
    }



