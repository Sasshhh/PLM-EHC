        function loadAccounts() {
            //debugger;

            $('#FailureTable').DataTable({
                "ajax": {
                    "url": "@Url.Action( "LoadDetails", "DepartmentsApprovals" )",
                    "type": "GET",
                    "datatype": "json",
                    "timeout": 60000
                },
                "columns": [

                    {
                        "data": "CreatedDateTime", "autoWidth": true,
                        "render": function (data) {
                            return convertDate(data);
                        }
                    },
                    {
                        "render": function (data) {
                            return "System";
                        }
                    },
                    { "data": "FailureReason", "autoWidth": true },
                    {
                        "data": "CapturedDate", "autoWidth": true,
                        "render": function (data) {
                            return convertDate(data);
                        }
                    },

                    { "data": "AssignedTo", "autoWidth": true }],
                "language": {
                    "emptyTable": "No Data.",
                },
                "Initcomplete": "",
                "destroy": true
            });
            $('#Compla').DataTable({
                "ajax": {
                    "url": "@Url.Action( "LoadDetails", "DepartmentsApprovals" )",
                    "type": "GET",
                    "datatype": "json",
                    "timeout": 60000
                },
                "columns": [

                    {
                        "data": "CreatedDateTime", "autoWidth": true,
                        "render": function (data) {
                            return convertDate(data);
                        }
                    },
                    {
                        "render": function (data) {
                            return "System";
                        }
                    },
                    { "data": "FailureReason", "autoWidth": true },
                    {
                        "data": "CapturedDate", "autoWidth": true,
                        "render": function (data) {
                            return convertDate(data);
                        }
                    },

                    { "data": "AssignedTo", "autoWidth": true }],
                "language": {
                    "emptyTable": "No Data.",
                },
                "Initcomplete": "",
                "destroy": true
            });

            $('#FailureTable2').DataTable({
                "ajax": {
                    "url": "@Url.Action( "LoadDetails", "DepartmentsApprovals" )",
                    "type": "GET",
                    "datatype": "json",
                    "timeout": 60000
                },
                "columns": [

                    {
                        "data": "CreatedDateTime", "autoWidth": true,
                        "render": function (data) {
                            return convertDate(data);
                        }
                    },
                    {
                        "render": function (data) {
                            return "System";
                        }
                    },
                    { "data": "FailureReason", "autoWidth": true },
                    {
                        "data": "CapturedDate", "autoWidth": true,
                        "render": function (data) {
                            return convertDate(data);
                        }
                    },

                    { "data": "AssignedTo", "autoWidth": true }],
                "language": {
                    "emptyTable": "No Data.",
                },
                "Initcomplete": "",
                "destroy": true
            });
        }

        function convertDate(data) {
            try {
                var dtStart = new Date(parseInt(data.substr(6)));
                var dtStartWrapper = moment(dtStart);
                return dtStartWrapper.format("YYYY-MM-DD");
            }
            catch (ex) {
            }
        }

        $(function () {
            $('#RCSTable').DataTable();

        });

    </script>

}

