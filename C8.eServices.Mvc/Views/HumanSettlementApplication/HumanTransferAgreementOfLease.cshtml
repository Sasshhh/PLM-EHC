@model C8.eServices.Mvc.ViewModels.DepartmentsApprovalViewModel
@using System.Text;
@using C8.eServices.Mvc.DataAccessLayer;
@using C8.eServices.Mvc.Keys
@{
    ViewBag.Title = "Details";
    Layout = "~/Views/Shared/RCS_Layout.cshtml";
}
<head>
    <style>
        .swal-modal .swal-text {
            text-align: center;
        }
    </style>
</head>
<script src="@Url.Content( "~/Scripts/moment.js" )"></script>

<div id="bankAccountPanel">
    <div class="panel panel-default">
        <div class="panel-heading">aPPLICATION LEASE INFORMATION</div>
        <div style="width: 90%;margin: 0 auto;">
            <br />
            <table id="FailureTable2" class="table table-bordered table-hover table-striped panel panel-default display ">
                <thead>
                    <tr>
                        <th>Lease Reference No</th>
                        <th>Tenant Type</th>
                        <th>Status</th>
                        <th>Captured Date</th>
                        <th>Tenant Name</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>@Model.HumanSettlementApplication.ApplicationReferenceNumber</td>
                        <td>@Model.HumanSettlementApplication.PurchaserType.Name</td>
                        @if (Model.HumanSettlementApplication.IsMaster)
                        {
                            <td>@Model.HumanSettlementLeaseMaster.Status.Name</td>
                            <td>@Model.HumanSettlementLeaseMaster.CreatedDateTime</td>
                        }
                        else
                        {
                            <td>@Model.HumanSettlementLeaseDetails.Status.Name</td>
                            <td>@Model.HumanSettlementLeaseDetails.CreatedDateTime</td>
                        }
                        <td>@Model.HumanSettlementApplication.ApplicantFullName</td>
                        <td>@Html.ActionLink("View", "Details", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("ApplicationId=" + Model.HumanSettlementApplication.Id.ToString()), target = "_blank" }, new { @class = "btn btn-primary", @target = "_blank" })</td>
                    </tr>
                </tbody>
            </table>
        </div>
        <br />
        <div style="width: 90%;margin: 0 auto;">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                <br />
                @Html.Hidden("Id", null, new { htmlAttributes = new { @class = "form-control", @style = "display:none;", @Id = "Id", @Name = "Id" } })
                <div class="form-group">
                    <span> @Html.Label("Reason For Transfer", htmlAttributes: new { @class = "control-label col-md-1" })<b style="color:red; font-size:x-large;">*</b></span>
                    <div class="col-md-2">
                        @Html.DropDownList("TransferReason", null, "-- Select Option --", htmlAttributes: new { @class = "form-control", @onchange = "ChaneTransfer(this.value)", @Name = "ReasonKey", @required = "required", @Id = "ReasonKeyId" })
                        @Html.ValidationMessage("ReplacementId", "", new { @class = "text-danger" })
                    </div>
                </div>
                <br />
                <div class="form-group">
                    <span> @Html.Label("Preference", htmlAttributes: new { @class = "control-label col-md-1" })<b style="color:red; font-size:x-large;">*</b></span>
                    <div class="col-md-2">
                        @Html.DropDownList("ReplacementId", null, "-- Select Option --", htmlAttributes: new { @class = "form-control", @onchange = "ValidateRepesentInfo()", @Name = "ReplacementId", @required = "required", @Id = "ReplacementId" })
                        @Html.ValidationMessage("ReplacementId", "", new { @class = "text-danger" })
                    </div>
                    <br />
                </div>
                <div id="_make_tenant" style="display:none;">
                    <div class="form-group">
                        @Html.Label("Communication", "Make main tenant an occupant?", htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-1">
                            @Html.CheckBoxFor(model => model._Make_tenant, new { htmlAttributes = new { @class = "form-control", @Name = "_Make_tenant" } })
                        </div>
                        <br />
                        <br />
                    </div>
                </div>
                <div id="_email" style="display:none;">
                    <div class="form-group">
                        <span>@Html.Label("Email", htmlAttributes: new { @class = "control-label col-md-1" })<b style="color:red; font-size:x-large;">*</b></span>
                        <div class="col-md-3">
                            @Html.Editor("Email", null, new { htmlAttributes = new { @class = "form-control", @name = "Email", @Id = "_email_address", @required = "required" } })
                            @Html.ValidationMessage("Email", "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
                <div id="_cell_no" style="display:none;">
                    <div class="form-group">
                        <span>@Html.Label("CellPhone", "Cell No.", htmlAttributes: new { @class = "control-label col-md-1" })<b style="color:red; font-size:x-large;">*</b></span>
                        <div class="col-md-3">
                            @Html.Editor("CellPhone", null, new { htmlAttributes = new { @class = "form-control", @name = "CellNo", @Id = "_cell_", @required = "required" } })
                            @Html.ValidationMessage("CellPhone", "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
                <br />
                <br />

                <div id="divbtn" style="display:block">
                    <input type="button" value="Submit" onclick="clickSubmit()" class="button1" />
                    <input type="submit" value="Submit" style="display:none;" hidden name="btnApprovalStatus" class="button1" id="btnApproval" />
                    <br />
                    <br />
                    <br />
                </div>
            }
        </div>
    </div>
</div>


@section Scripts{

    <script src="@Url.Content( " ~ /scripts/Datatables/jquery.dataTables.min.js" )"></script>
    <script src="@Url.Content( " ~ /scripts/Datatables/dataTables.bootstrap.js" )"></script>

    <script type="text/javascript">
        $(function () {
