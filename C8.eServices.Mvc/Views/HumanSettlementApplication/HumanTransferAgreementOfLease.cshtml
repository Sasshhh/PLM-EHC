    function ChaneTransfer(val) {
        debugger;
        var Key = val;
        switch (Key) {
            case "plm_tenant_deceased":
                jQuery('#_make_tenant').css("display", "none")
                break;
            case "plm_other":
                jQuery('#_make_tenant').css("display", "block")
                break;
            default:
                jQuery('#_make_tenant').css("display", "none")
                break;
        }
    }

    function ValidateRepesentInfo() {
        debugger;
        var UserId = document.getElementById("ReplacementId").value;
        var ReasonKey = document.getElementById("ReasonKeyId").value;
        if (UserId == -1) {
            jQuery('#_email').css("display", "none")
            jQuery('#_cell_no').css("display", "none")
            document.querySelector('#_email_address').required = false;
            document.querySelector('#_cell_').required = false;

        } else if (UserId != "") {
            $.getJSON("../HumanSettlementApplication/CheckContactInfoForReplacement?Id=" + UserId,
                function (result) {
                    debugger;
                    switch (result) {
                        case "email":
                            jQuery('#_email').css("display", "block")
                            document.querySelector('#_email_address').required = true;
                            document.querySelector('#_cell_').required = false;
                            break;
                        case "cell":
                            jQuery('#_cell_no').css("display", "block")
                            document.querySelector('#_cell_').required = true;
                            document.querySelector('#_email_address').required = false;
                            break;
                        case "both":
                            jQuery('#_email').css("display", "block")
                            jQuery('#_cell_no').css("display", "block")
                            document.querySelector('#_email_address').required = true;
                            document.querySelector('#_cell_').required = true;
                            break;
                        default:
                            jQuery('#_email').css("display", "none")
                            jQuery('#_cell_no').css("display", "none")
                            document.querySelector('#_email_address').required = false;
                            document.querySelector('#_cell_').required = false;
                            break;
                    }
                })
        } else {
            jQuery('#_email').css("display", "none")
            jQuery('#_cell_no').css("display", "none")
            document.querySelector('#_email_address').required = false;
            document.querySelector('#_cell_').required = false;
        }
    }

