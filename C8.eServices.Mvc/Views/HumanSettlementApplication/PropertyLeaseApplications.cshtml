@model IEnumerable<C8.eServices.Mvc.Models.PropertyLeaseApplication>
@using C8.eServices.Mvc.Keys;
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/RCS_Layout.cshtml";
}
<style>
    @@media only screen and (max-width: 1000px) {


        .cards tbody tr {
            float: left;
            /*width: 20rem;*/
            width: 90%;
            margin: 0.5rem;
            border: 0.0625rem solid rgba(0,0,0,.125);
            border-radius: .25rem;
            box-shadow: 0.25rem 0.25rem 0.5rem rgba(0,0,0,0.25);
        }

        .cards thead tr {
            float: left;
            /*width: 25rem;*/
            width: 90%;
            margin: 0.5rem;
            border: 0.0625rem solid rgba(0,0,0,.125);
            border-radius: .25rem;
            box-shadow: 0.25rem 0.25rem 0.5rem rgba(0,0,0,0.25);
        }


        .cards tbody td {
            display: block;
            word-wrap: break-word;
        }

        .cards thead th {
            display: none;
        }

        .table tbody label {
            display: block;
        }

        .cards tbody label {
            display: inline;
            position: relative;
            font-size: 85%;
            top: -0.5rem;
            color: #808080;
            min-width: 4rem;
            margin-left: 0;
            margin-right: 1rem;
            text-align: left;
        }

        tr.selected label {
            color: #404040;
        }

        .table .fa {
            font-size: 2.5rem;
            text-align: center;
        }

        .cards .fa {
            font-size: 7.5rem;
        }
    }
</style>
<div class="panel-group">
    <div class="panel panel-default">
        <div class="panel-group" style="margin-bottom: -1px;">
            <div class="panel panel-default">
                <div class="panel-heading" align="center">
                    All Property Lease Applications
                </div>
            </div>
        </div>
        <div id="accountInfoCollapse" class="panel-collapse collapse in tablecss">
            <br />
            <table id="RCSTable" class="table table-bordered table-hover table-striped panel panel-default cards">
                <thead>
                    <tr>
                        <th>
                            First Name
                        </th>
                        <th>
                            Application Type
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.ApplicationReferenceNumber)
                        </th>
                        <th>
                            Application Created Date
                        </th>
                        <th>
                            Status
                        </th>
                        <th> Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.FirstName)  @Html.DisplayFor(modelItem => item.LastName)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.PurchaserType.Name)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.ApplicationReferenceNumber)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.CreatedDateTime.Value)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Status.Name)
                            </td>
                            <td>
                                @if (item.Status.Key != null)
                                {
                                    @Html.ActionLink("View", "Details", "PropertyLeaseApplication", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("refNo=" + item.Id.ToString()), target = "_blank" }, new { @class = "btn btn-primary", @target = "_blank" })
                                }
                                @*@if (item.Status.Key == StatusKeys.RatesRebateAdditionalPropertyOwnersPending)
                                    {
                                        @Html.ActionLink("Conduct Unit Inspection", "ConductUnitInspection", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("id=" + item.Id.ToString()) }, new { @class = "btn btn-primary" })
                                    }

                                    @if (item.Status.Key == StatusKeys.CustomerQueryPending || item.Status.Key == StatusKeys.UnitInhabitable)
                                    {
                                        @Html.ActionLink("Maintenance Job Sheet", "MaintenanceJobSheet", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("id=" + item.Id.ToString()) }, new { @class = "btn btn-primary" })
                                    }

                                    @if (item.Status.Key == StatusKeys.AwaitingRiskAssessment)
                                    {
                                        @Html.ActionLink("Risk Assessment Outcome", "ConductAssessment", "RiskAssessmentOutcomes", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("rcsAppId=" + item.Id.ToString()) }, new { @class = "btn btn-primary" })
                                    }

                                    @if (item.Status.Key == StatusKeys.PendingAssessmentFeePaymentValidation)
                                    {
                                        @Html.ActionLink("View", "AssessmentFeeValidation", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("id=" + item.Id.ToString()) }, new { @class = "btn btn-primary" })
                                    }

                                    @if (item.Status.Key == StatusKeys.AssessmentFeePaymentApproved)
                                    {
                                        @Html.ActionLink("Invite To Client Training", "ClientTraining", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("id=" + item.Id.ToString()) }, new { @class = "btn btn-primary" })
                                    }

                                    @if (item.Status.Key == StatusKeys.LeaseAgreementGenerated)
                                    {
                                        @Html.ActionLink("Agreement Validation", "LeaseAgreementValidation", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("id=" + item.Id.ToString()) }, new { @class = "btn btn-primary" })
                                    }

                                    @if (item.Status.Key == StatusKeys.IncentivePolicyApplicationProcessing)
                                    {
                                        @Html.ActionLink("Debit Order Validation", "DebitOrderValidation", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("id=" + item.Id.ToString()) }, new { @class = "btn btn-primary" })
                                    }

                                    @if (item.Status.Key == StatusKeys.AwaitingLeaseAgreement)
                                    {
                                        @Html.ActionLink("Generate Lease Agreement", "GenerateLeaseAgreement", new { q = item.Data }, new { @class = "btn btn-primary" })
                                    }

                                    @if (item.Status.Key == StatusKeys.AwaitingInspectionScheduleSlots)
                                    {
                                        @Html.ActionLink("Inspection Schedule Slots", "ScheduleInspectionSlots", "PropertyLeaseApplication", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("id=" + item.Id.ToString()) }, new { @class = "btn btn-primary" })

                                    }*@
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <br />
        </div>
    </div>
</div>
