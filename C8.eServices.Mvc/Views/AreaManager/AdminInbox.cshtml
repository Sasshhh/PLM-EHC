@model IEnumerable<C8.eServices.Mvc.Models.ClerkRegistration>
@using C8.eServices.Mvc.Keys;
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/RCS_Layout.cshtml";
}

<h3>Internal User Registrations</h3>

<br />

<table id="RCSTable" class="table table-bordered table-hover table-striped panel panel-default display">
    <thead>
        <tr>
            <th>
                Name
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EmployeeNumber)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CreatedDateTime)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EmailAddress)
            </th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.FullName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.EmployeeNumber)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.CreatedDateTime)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.EmailAddress)
                </td>
                <td>
                    @Html.ActionLink("View", "Edit", new { id = item.Id }, new { @class = "btn btn-primary" })

                    @*@Html.ActionLink("Message", "CreateMessage", new { id = item.Id}, new { @class = "btn btn-primary" })*@


                </td>

            </tr>
        }
    </tbody>
</table>
<script>
    $(document).ready(function () {
        $('#RCSTable').DataTable();
              var display = "@ViewBag.Message";

        if (display != null && display != "") {
            $('#MessageModal4').modal('show');
        }
        else {
            $('#MessageModal4').modal('hide');
            var result = "@ViewBag.MessageBody";
        }
        });
</script>
