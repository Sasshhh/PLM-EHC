    function isNumber(evt) {
        evt = (evt) ? evt : window.event;
        var charCode = (evt.which) ? evt.which : evt.keyCode;
        if (charCode > 31 && (charCode < 48 || charCode > 57)) {
            return false;
        }
        return true;
    }
    function ValidateQueueLen(val) {
        debugger;
        var entered = parseFloat(document.getElementById("MoveToPosition").value);
        var Queue = parseFloat(document.getElementById("Queue").value);
        var ItemPosition = parseFloat(document.getElementById("ItemPosition").value);
        if (Queue != 0 && entered > Queue) {
            //jQuery.noConflict();
