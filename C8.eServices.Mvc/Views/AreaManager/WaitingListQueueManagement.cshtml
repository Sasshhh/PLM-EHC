@model IEnumerable<C8.eServices.Mvc.Models.TemporaryDisplayModel>
@using C8.eServices.Mvc.Keys;
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/RCS_Layout.cshtml";
}
    <div class="panel-group">
        <div class="panel panel-default">
            <div class="panel-group" style="margin-bottom: -1px;">
                <div class="panel panel-default">
                    <div class="panel-heading" align="center">
                        Waiting List Queue Management
                    </div>
                </div>
            </div>

            <div id="accountInfoCollapse" class="panel-collapse collapse in tablecss">
                <br />
                <table id="RCSTable" class="table table-bordered table-hover table-striped panel panel-default display">
                    <thead>
                        <tr>
                            <th>
                                Applicant Name
                            </th>
                            <th>
                                Queue Date
                            </th>
                            <th>
                                Reference Number
                            </th>
                            <th>
                                Re-Listed
                            </th>
                            <th>
                                Queue Position
                            </th>
                            <th>
                                Complex Area(s)
                            </th>
                            <th>
                                Bedroom Type
                            </th>
                            <th></th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    @Html.DisplayFor(modelItem => item.ApplicantFullName)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.WaitingListQueueDate)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.ApplicationReferenceNo)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.IsRelisted)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Position)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.ComplexAreas)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.BedRooms)
                                </td>
                                <td>
                                    @Html.ActionLink("Cancel", "RemoveWaitingListQueueItem", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("WaitingListQueueId=" + item.WaitingListQueueId.ToString() + "&Queue=" + ViewBag.QueueSum.ToString() + "&ApplicationReferenceNo=" + item.ApplicationReferenceNo + "&PropertyLeaseApplicationId=" + item.PropertyLeaseApplicationId.ToString() + "&MoveToPosition=" + 0.ToString() + "&ApplicantFullName=" + item.ApplicantFullName + "&Position=" + item.Position) }, new { @class = "btn btn-primary" })
                                    @Html.ActionLink("Change", "ModifyApplicationUnitRequiremets", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("WaitingListQueueId=" + item.WaitingListQueueId.ToString() + "&Queue=" + ViewBag.QueueSum.ToString() + "&ApplicationReferenceNo=" + item.ApplicationReferenceNo + "&PropertyLeaseApplicationId=" + item.PropertyLeaseApplicationId.ToString() + "&MoveToPosition=" + 0.ToString() + "&ApplicantFullName=" + item.ApplicantFullName + "&Position=" + item.Position) }, new { @class = "btn btn-primary" })
                                    @Html.ActionLink("Move", "MoveWaitingListQueueItemPosition", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("WaitingListQueueId=" + item.WaitingListQueueId.ToString() + "&Queue=" + ViewBag.QueueSum.ToString() + "&ApplicationReferenceNo=" + item.ApplicationReferenceNo + "&PropertyLeaseApplicationId=" + item.PropertyLeaseApplicationId.ToString() + "&MoveToPosition=" + 0.ToString() + "&ApplicantFullName=" + item.ApplicantFullName + "&Position=" + item.Position) }, new { @class = "btn btn-primary" })
                                    @Html.ActionLink("View", "Details", "PropertyLeaseApplication", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("refNo=" + item.PropertyLeaseApplicationId.ToString()), target = "_blank" }, new { @class = "btn btn-primary", @target = "_blank" })
                                </td>
                            </tr>
    }
                    </tbody>
                </table>
                <br />
            </div>
        </div>
    </div>
<br />
<script>
    $(document).ready(function () {
        $('#RCSTable').DataTable({ searching: true, paging: true, info: true });
              @*var display = "/**************/";

        if (display != null && display != "") {
            $('#MessageModal4').modal('show');
        }
        else {
            $('#MessageModal4').modal('hide');
            var result = "/******************/"@ViewBag.Message@ViewBag.MessageBody;*@
    });
</script>
