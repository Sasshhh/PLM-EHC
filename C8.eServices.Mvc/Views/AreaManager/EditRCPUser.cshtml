@model IEnumerable<C8.eServices.Mvc.Models.SystemUser>

@{
    ViewBag.Title = "Edit";
    Layout = "~/Views/Shared/RCS_Layout.cshtml";
}

<h4>Edit RCP User</h4>
<hr />

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.Hidden("Role", (string)ViewBag.RoleId)
    @Html.Hidden("RemoveId", (int)ViewBag.RemoveId)

    <div class="form-horizontal">
        @Html.ValidationSummary(true)

        <div class="panel-group">
            <div class="panel panel-default">
                <div class="panel-heading">
                    <h4 class="panel-title">
                        <a data-toggle="collapse" data-parent="#accordion" href="#userRoleCollapse">
                            User Information
                        </a>
                    </h4>
                </div>

                <div id="userRoleCollapse" class="panel-collapse collapse in">
                    <div class="panel-body">
                        <div class="form-group">
                            @Html.Label("User Name:", new { @class = "control-label col-md-2" })
                            <div class="col-md-3">
                                @Html.TextBox("UserName", null, new { @class = "form-control", @readonly = true })
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.Label("Role Name:", new { @class = "control-label col-md-2" })
                            <div class="col-md-3">
                                @Html.TextBox("Role", null, new { @class = "form-control", @readonly = true })
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.Label("Change To:", new { @class = "control-label col-md-2" })
                            <div class="col-md-3">
                                @Html.DropDownList("UserId", (SelectList)ViewBag.BOUsers, "-- Select RCP User --", htmlAttributes: new { @class = "form-control", @Name = "UserId" })
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="col-md-offset-2 col-md-10">
                                <input type="button" value="Change" onclick="clickSubmit()" class="button1" />
                                <input type="submit" value="Re-Allocate" id="btnApproval" style="display:none;" class="button1" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
<div>
    @Html.ActionLink("Back to List", "RCPUserManagement", null, new { @class = "button1" })
</div>
<script>
    function divAssignTo() {
        if (document.getElementById("checkbox").checked == true) {
            debugger;
            jQuery('#divAssignTo').css("display", "block")
        } else {
            jQuery('#divAssignTo').css("display", "none")

        }
    }
    function clickSubmit() {

        swal({
            icon: "info",
            title: "Are you sure you want to change RCP User?",
            buttons: [
                'No!',
                'Yes, I am sure!'
            ]
        }).then(function (isConfirm) {
            if (isConfirm) {
                document.getElementById("btnApproval").click();
            }
        });
    }
</script>

<script type="text/javascript">
    $(function () {
        var Name = '@ViewBag.Name';
        var Isactive = '@ViewBag.Isactive';

        $("#Name").val(Name);
        debugger;
        if (Isactive == "True") {
            $("#rrIsActive").prop("checked", true);
        }
        else {
            Isactive.value = false;
        }
             var display = "@ViewBag.Message";

        if (display != null && display != "") {
            $('#MessageModal4').modal('show');
        }
    });
</script>

