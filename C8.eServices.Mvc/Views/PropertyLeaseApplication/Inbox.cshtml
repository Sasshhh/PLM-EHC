                                    }*@
                                @*@if (item.Status.Key == StatusKeys.CustomerQueryPending || item.Status.Key == StatusKeys.UnitInhabitable)
                                    {
                                        @Html.ActionLink("Maintenance Job Sheet", "MaintenanceJobSheet", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("id=" + item.Id.ToString()) }, new { @class = "btn btn-primary" })
                                    }*@
                                @if (item.Status.Key == StatusKeys.ReuploadApplicationDocs)
                                {
                                    @Html.ActionLink("Re-Upload", "ReUploadDocuments", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("rcsAppId=" + item.Id.ToString()) }, new { @class = "btn btn-primary" })

                                }
                                @if (item.Status.Key == StatusKeys.AwaitingTenantDocuments)
                                {
                                    @Html.ActionLink("Upload Documents", "UpdateTenanntDocuments", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("rcsAppId=" + item.Id.ToString()) }, new { @class = "btn btn-primary" })

                                }
                                @if (item.Status.Key == StatusKeys.InAwaitingWaitingListReEntry)
                                {
                                    @Html.ActionLink("Unit Still Required", "WaitingListValidation", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("PropertyId=" + item.Id.ToString()) }, new { @class = "btn btn-primary" })
                                    @*@Html.ActionLink("Waiting List Re-Entry", "WaitingListValidation", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("PropertyId=" + item.Id.ToString()) }, new { @class = "btn btn-primary" })*@

                                }
                                @if (item.Status.Key == StatusKeys.AwitingInspectionSchedule)
                                {
                                    @Html.ActionLink("Unit Inspection Schedule", "ScheduleUnitInspectionSlot", "PropertyLeaseApplication", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("id=" + item.Id.ToString()) }, new { @class = "btn btn-primary" })

                                }

                                @if (item.Status.Key == StatusKeys.AwaitingLeaseAgreement)
                                {
                                    @Html.ActionLink("Generate Lease Agreement", "GenerateLeaseAgreement", new { q = item.Data }, new { @class = "btn btn-primary" })
                                }

                                @if (item.Status.Key == StatusKeys.LeaseAgreementGenerated)
                                {
                                    @Html.ActionLink("Agreement Validation", "LeaseAgreementValidation", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("id=" + item.Id.ToString()) }, new { @class = "btn btn-primary" })
                                }



                                @*@Html.ActionLink("Waiting List Re-Entry", "WaitingListValidation", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("PropertyId=" + item.Id.ToString()) }, new { @class = "btn btn-primary" })*@


                            </td>

                        </tr>
                    }
                </tbody>
            </table>
            <br />
        </div>
    </div>
</div>
<script>
    $(function () {
        $('#RCSTable').DataTable();

        // JSON-encode server-side values so strings (and \n) are preserved correctly in JS
        var applicationFeeMsg = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.ApplicationFeeBody ?? ""));
        var applicationFeeTitle = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.ApplicationFeeTitle ?? ""));
        var depositMsg = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.DepositPaidDocumentSession ?? ""));
        var displayFlag = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.Display ?? ""));
        var messageBody3 = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.MessageBody3 ?? ""));
        var messageBody = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.MessageBody ?? ""));
        var messageBody5 = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.MessageBody5 ?? ""));

        // 1) Application-fee flow (highest priority) — show and stop
        if (applicationFeeMsg && applicationFeeMsg !== "") {
            applicationFeeMsg = applicationFeeMsg.replace(/\r\n/g, '\n');
            $('#ApplicationFeeBody').css('white-space', 'pre-line').text(applicationFeeMsg);
            // Optionally set title if not already present in markup
            if (applicationFeeTitle && applicationFeeTitle !== "") {
                $('#DepositPaidDocumentModal2 .modal-title').text(applicationFeeTitle);
            }
            $('#DepositPaidDocumentModal2').modal({ backdrop: 'static', keyboard: false, show: true });
            return;
        }

        // 2) Legacy deposit modal (second priority)
        if (depositMsg && depositMsg !== "") {
            $('#DepositPaidDocumentModal').modal({ backdrop: 'static', keyboard: false, show: true });
            return;
        }

        // 3) Legacy MessageModal3 flow — show only when there's actual content
        if (displayFlag !== "" && messageBody3 !== "") {
            $('#MessageModal3').modal('show');
        } else {
            $('#MessageModal3').modal('hide');

            if (messageBody !== "") {
                $('#MessageModal').modal('show');
            } else {
                $('#MessageModal').modal('hide');

                if (messageBody5 !== "") {
                    $('#MessageModal5').modal('show');
                } else {
                    $('#MessageModal5').modal('hide');
                }
            }
        }
    });

    function OpenChatModal() {
        $('#MessageModal').modal('show');
    }
</script>