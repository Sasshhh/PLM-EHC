
@model IEnumerable<C8.eServices.Mvc.Models.PropertyLeaseApplication>
@using C8.eServices.Mvc.Keys;
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/RCS_Layout.cshtml";


}

<style>
    @@media only screen and (max-width: 1000px) {


        .cards tbody tr {
            float: left;
            /*width: 20rem;*/
            width: 90%;
            margin: 0.5rem;
            border: 0.0625rem solid rgba(0,0,0,.125);
            border-radius: .25rem;
            box-shadow: 0.25rem 0.25rem 0.5rem rgba(0,0,0,0.25);
        }

        .cards thead tr {
            float: left;
            /*width: 25rem;*/
            width: 90%;
            margin: 0.5rem;
            border: 0.0625rem solid rgba(0,0,0,.125);
            border-radius: .25rem;
            box-shadow: 0.25rem 0.25rem 0.5rem rgba(0,0,0,0.25);
        }


        .cards tbody td {
            display: block;
            word-wrap: break-word;
        }

        .cards thead th {
            display: none;
        }

        .table tbody label {
            display: block;
        }

        .cards tbody label {
            display: inline;
            position: relative;
            font-size: 85%;
            top: -0.5rem;
            color: #808080;
            min-width: 4rem;
            margin-left: 0;
            margin-right: 1rem;
            text-align: left;
        }

        tr.selected label {
            color: #404040;
        }

        .table .fa {
            font-size: 2.5rem;
            text-align: center;
        }

        .cards .fa {
            font-size: 7.5rem;
        }
    }
</style>

<div id="DepositPaidDocumentModal" class="modal fade" role="dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>

                <h4 class="modal-title">Actioned Successfully</h4>
            </div>
            <div class="modal-body">
                <div class="container">
                    <strong>@Html.Raw(ViewBag.DepositPaidDocumentSession)</strong>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>


<!-- Application fee modal (uses ApplicationFeeBody/ApplicationFeeTitle) -->
<div id="DepositPaidDocumentModal2" class="modal fade" role="dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">@Html.Encode(ViewBag.ApplicationFeeTitle ?? "")</h4>
            </div>
            <div class="modal-body">
                <div class="container">
                    <!-- block element to display pre-line text -->
                    <div id="ApplicationFeeBody"></div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>

<div class="panel-group">
    <div class="panel panel-default">




        <div class="panel-group" style="margin-bottom: -1px;">
            <div class="panel panel-default">
                <div class="panel-heading" align="center">
                    Inbox Applications
                    @*<h4 class="panel-title" align="center">
                            <a data-toggle="collapse" data-parent="#accordion" href="#usersCollapse">

                            </a>
                        </h4>*@
                </div>

            </div>
        </div>

        <div id="accountInfoCollapse" class="panel-collapse collapse in tablecss">
            <br />

            <table id="RCSTable" class="table table-bordered table-hover table-striped panel panel-default cards">
                <thead>
                    <tr>
                        <th>
                            Applicant Name
                        </th>
                        <th>
                            Application Type
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.ApplicationReferenceNumber)
                        </th>
                        <th>
                            Application Created Date
                        </th>
                        <th>
                            Status
                        </th>
                        <th> Action</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.FirstName) @Html.DisplayFor(modelItem => item.LastName)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.PurchaserType.Name)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.ApplicationReferenceNumber)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.CreatedDateTime.Value)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Status.Name)
                            </td>
                            <td>
                                @if (item.Status.Key == StatusKeys.AwaitingAssessmentPayment)
                                {
                                    @Html.ActionLink("External Payment", "Index2", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("RcsApplicationId=" + item.Id.ToString()) }, new { @class = "btn btn-primary" })
                                }
                                @if (item.Status.Key == StatusKeys.awaited)
                                {
                                    @Html.ActionLink("View", "UnitDetails", "MatchedUnits", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("RcsApplicationId=" + item.Id.ToString()) }, new { @class = "btn btn-primary" })
                                }
                                @if (item.Status.Key == StatusKeys.ReuploadApplicationDocs)
                                {
                                    @*@Html.ActionLink("Upload", "UploadDocs", new { q = item.Data }, new { @class = "btn btn-primary" })*@
                                }
                                @if (item.Status.Key == StatusKeys.Approved)
                                {
                                    @Html.ActionLink("Acceptance Letter", "AcceptanceLetter", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("rcsAppId=" + item.Id.ToString()) }, new { @class = "btn btn-primary" })
                                }
                                @if (item.Status.Key == StatusKeys.AwaitingAssessmentPayment)
                                {
                                    @Html.ActionLink("Upload Proof Of Payment", "UploadAssessmentFee", new { q = item.Data }, new { @class = "btn btn-primary" })
                                }
                                @if (item.Status.Key == StatusKeys.AwaitingDepositPaid)
                                {
                                    @Html.ActionLink("Upload Proof Of Payment", "UploadAssessmentFee", new { q = item.Data }, new { @class = "btn btn-primary" })
                                }
                                @if (item.Status.Key == StatusKeys.AwaitingApplicationFeeUpload)
                                {
                                    @Html.ActionLink("Upload Proof Of Payment", "UploadApplicationFee", new { q = item.Data }, new { @class = "btn btn-primary" })
                                }
                                @*@if (item.Status.Key == StatusKeys.AwaitingDepartmentComments)
                                    {
                                        @Html.ActionLink("Departmental Review", "Index", "DepartmentalComments", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("id=" + item.Id.ToString()) }, new { @class = "btn btn-primary" })
                                    }*@
                                @*@if (item.Status.Key == StatusKeys.AwaitingHoDResponse)
                                    {
                                        @Html.ActionLink("Send For HOD Assessment", "Index", "Hods", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("id=" + item.Id.ToString()) }, new { @class = "btn btn-primary" })
                                    }*@
                                @if (item.Status.Key == StatusKeys.ViewRCCCertificate)
                                {
                                    @Html.ActionLink("View RCC Certificate", "ViewRCCCertificate", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("id=" + item.Id.ToString()) }, new { @class = "btn btn-primary" })
                                }
                                @*@if (item.Status.Key == StatusKeys.AwaitingDepartmentInputs)
                                    {
                                        @Html.ActionLink("Affected Departments", "AffectedDepart", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("id=" + item.Id.ToString()) }, new { @class = "btn btn-primary" })
                                    }*@
                                @if (item.Status.Key == StatusKeys.IncentivePolicyApplicationPending)
                                {
                                    @Html.ActionLink("Generate Debit Order", "DebitOrderRegistration", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("rcsAppId=" + item.Id.ToString() + "&Data=" + item.Data.ToString()) }, new { @class = "btn btn-primary" })
                                    @*@Html.ActionLink("Generate Debit Order Authority", "GenerateDebitOrder", new { q = item.Data }, new { @class = "btn btn-primary" })*@
                                }
                                @if (item.Status.Key == StatusKeys.AwaitingTenantUpdateDetails)
                                {
                                    @Html.ActionLink("Update Tenant Record", "UpdateTenantRecord", new { q = item.Data }, new { @class = "btn btn-primary" })
                                }
                                @*@if (item.Status.Key == StatusKeys.RatesRebatePropertyAccountConflict)
                                    {
