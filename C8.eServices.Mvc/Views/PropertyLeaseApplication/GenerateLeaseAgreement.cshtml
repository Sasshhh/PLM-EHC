@model C8.eServices.Mvc.ViewModels.DepartmentsApprovalViewModel
@using System.Text;
@using C8.eServices.Mvc.DataAccessLayer;
@using C8.eServices.Mvc.Keys
@{
    ViewBag.Title = "Details";
    Layout = "~/Views/Shared/RCS_Layout.cshtml";
}
<head>
    <style>
        .swal-modal .swal-text {
            text-align: center;
        }
    </style>
</head>
<script src="@Url.Content( "~/Scripts/moment.js" )"></script>

<div id="GenerateLeaseagreementModal" class="modal fade" role="dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>

                <h4 class="modal-title">Generate Lease Agreement</h4>
            </div>
            <div class="modal-body">
                <div class="container">
                    <strong>Lease agreement has been generated successfully</strong>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>
<div id="bankAccountPanel">
    <div class="panel panel-default">
        <div class="panel-heading">Evaluating Application</div>
        <div style="width: 90%;margin: 0 auto;">
            <br />
            <table id="FailureTable" class="table table-bordered table-hover table-striped panel panel-default display ">
                <thead>
                    <tr>
                        <th>
                            Reference Number
                        </th>
                        <th>
                            Applicant Type
                        </th>
                        <th>
                            Status
                        </th>
                        <th>
                            Captured Date
                        </th>
                        <th>
                            Customer Name
                        </th>
                        <th>
                            Action
                        </th>
                    </tr>
                </thead>
                <tbody>

                    <tr>
                        <td>
                            @Model.PropertyLeaseApplications.ApplicationReferenceNumber
                        </td>
                        <td>
                            @Model.PropertyLeaseApplications.PurchaserType.Name
                        </td>
                        <td>
                            @Model.PropertyLeaseApplications.Status.Name
                        </td>
                        <td>
                            @Model.PropertyLeaseApplications.CreatedDateTime
                        </td>
                        <td>
                            @Model.PropertyLeaseApplications.Customer.FullName
                        </td>
                        <td>
                            @Html.ActionLink("View", "Details", "PropertyLeaseApplication", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("refNo=" + Model.PropertyLeaseApplications.Id.ToString()), target = "_blank" }, new { @class = "btn btn-primary", @target = "_blank" })
                        </td>
                    </tr>

                </tbody>
            </table>



        </div>

        <br />

        <div class="panel-heading">Generated Lease Agreement</div>
        <div style="width: 90%;margin: 0 auto;">
            <br />
            <table id="FailureTable" class="table table-bordered table-hover table-striped panel panel-default display ">
                <thead>
                    <tr>
                        <th>
                            Document Type
                        </th>
                        <th>
                            Document
                        </th>

                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>
                            @Model.DocName
                        </td>
                        <td>
                            <input type="button" id="btnExternal" class="button1" value="View" onclick="location.href='@Url.Action("pdfDeneratePropertyLeaseAgreement", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("ApplicationId=" + ViewBag.PropertyLeaseAppliactionId.ToString()) })'" />
                            @*<input type="button" id="btnExternal" class="button1" value="View" onclick="location.href='@item.FilePath'" />*@
                        </td>
                        @*<td>
                            <div class="form-group">
                                @Html.Label("Signature", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-6">
                                    @Html.DropDownList("DebitApproval", null, "-- Select Option --", htmlAttributes: new { @class = "form-control", onchange = "ApproveDebitOder()", @Name = "DebitApproval", @required = "required", @Id = "DebitApproval" })
                                    @Html.ValidationMessage("DebitApproval", "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </td>*@
                    </tr>

                </tbody>
            </table>
        </div>

        <br />

        <div style="width: 90%;margin: 0 auto;">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

            <div class="form-horizontal">


                <div class="step-app">
                    <ul class="step-steps">

                        <li style="text-align:center;"><a href="#step3">Lease Agreement Review Response<span class=""></span></a></li>
                    </ul>

                </div>
                <div class="panel-group" id="instructions">
                    <div class="panel panel-default">
                        <div class="form-group">
                            <br />
                            @Html.Label("Outcome", htmlAttributes: new { @class = "control-label col-md-2 require" })
                            <div class="col-md-3">
                                @Html.DropDownList("ApprovalStatus", null, "-- select option --", htmlAttributes: new { @class = "form-control", @Name = "ApprovalStatusddl", @onchange = "changestatus()", @Id = "ApprovalStatus", @required = "required" })
                                @Html.ValidationMessage("ApprovalStatus", "", new { @class = "text-danger" })
                            </div>

                        </div>
                        <div class="form-group">
                            <div id="reject" style="display:none">
                                @Html.LabelFor(model => model.RiskAssessmentOutcome.Reason, "Reason", htmlAttributes: new { @class = "control-label col-md-2 require" })
                                <div class="col-md-8">
                                    @Html.TextArea("Reason", new { @class = "form-control", @Id = "RejectComment" })
                                    @Html.ValidationMessageFor(model => model.RiskAssessmentOutcome.Reason, "", new { @class = "text-danger" })
                                </div>
                            </div>

                        </div>
                        <br />
                        <div id="divbtn" style="display:block" class="col-md-offset-1">
                            <input type="button" value="Submit" name="btnApproval" onclick="clickSubmit()" class="button1" />
                            <input type="submit" value="Submit" style="display:none;" hidden name="btnApprovalStatus" class="button1" id="btnApproval" />
                          @*  <input type="button" value="Finish" name="btnApproval" onclick="location.href='@Url.Action("PropertyLeaseAgreements", "PropertyLeaseApplication")'" class="button1" />*@
                            <br />
                            <br />
                            <br />
                        </div>

                    </div>
                    </div>

                     
                    </div>
                    }
                </div>
            </div>
</div>
@section Scripts{

    <script src="@Url.Content( "~/scripts/Datatables/jquery.dataTables.min.js" )"></script>
    <script src="@Url.Content( "~/scripts/Datatables/dataTables.bootstrap.js" )"></script>
    <script type="text/javascript">
    $(document).ready(function () {
        debugger;
            $('#GenerateLeaseagreementModal').modal({
                backdrop: 'static',
                keyboard: false,
                show: true
            });
    });
    </script>
    <script type="text/javascript">
        function changestatus() {
            var statusval = document.getElementById("ApprovalStatus").value;
            if (statusval == "Rcs_Rejected") {
                jQuery('#reject').css("display", "block")
        
            } else if (statusval == "Rcs_Approval") {
                jQuery('#reject').css("display", "none")
        
            }

        }
        function clickSubmit() {
            debugger;
            swal({
                icon: "info",
                title: "Are you sure you want to submit this lease agreement review?",
                buttons: [
                    'No!',
                    'Yes, I am sure!'
                ]

            }).then(function (isConfirm) {
                if (isConfirm) {
                    debugger;
                    var statusval = document.getElementById("ApprovalStatus").value;
                    //var reject = document.getElementById("reject");
                    //var accept = document.getElementById("Approve");
                    //document.getElementById("btnApproval").click();



                    if (statusval == "Rcs_Rejected" ) {
                        //alert('rej');
                        var RejectComment = document.getElementById("RejectComment").value;

                        if ((RejectComment == null || RejectComment == "")) {
                            swal("error", "Please enter the reject reason for lease agreement!", "warning");
                        } else {
                            document.getElementById("btnApproval").click();
                            /* WaitingListBusy();*/
                        }
                        //    document.getElementById("btnApproval").click();
                    } else {
                        /*   alert('approval');*/
                        document.getElementById("btnApproval").click();
                        /*  WaitingListBusy();*/
                    }


                }
            });
        }
        function loadAccounts() {
            //debugger;
            $('#FailureTable').DataTable({
                "ajax": {
                    "url": "@Url.Action( "LoadDetails", "DepartmentsApprovals" )",
                    "type": "GET",
                    "datatype": "json",
                    "timeout": 60000
                },
                "columns": [

                    {
                        "data": "CreatedDateTime", "autoWidth": true,
                        "render": function (data) {
                            return convertDate(data);
                        }
                    },
                    {
                        "render": function (data) {
                            return "System";
                        }
                    },
                    { "data": "FailureReason", "autoWidth": true },
                    {
                        "data": "CapturedDate", "autoWidth": true,
                        "render": function (data) {
                            return convertDate(data);
                        }
                    },

                     { "data": "AssignedTo", "autoWidth": true }],
                "language": {
                    "emptyTable": "No Data.",
                },
                "Initcomplete": "",
                "destroy": true
            });
        }

        function convertDate(data) {
            try {
                var dtStart = new Date(parseInt(data.substr(6)));
                var dtStartWrapper = moment(dtStart);
                return dtStartWrapper.format("YYYY-MM-DD");
            }
            catch (ex) {
            }
        }

        $(function () {
            $('#RCSTable').DataTable();

        });

    </script>

}

