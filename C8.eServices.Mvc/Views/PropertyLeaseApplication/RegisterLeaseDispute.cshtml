@model C8.eServices.Mvc.ViewModels.DepartmentsApprovalViewModel
@using C8.eServices.Mvc.Keys
@{
    Layout = "~/Views/Shared/RCS_Layout.cshtml";
    ViewBag.Title = "Register Lease Dispute — UC26A";
    var app = ViewBag.Application as C8.eServices.Mvc.Models.PropertyLeaseApplication;
    var lease = ViewBag.Lease as C8.eServices.Mvc.Models.LeaseDetails;
}
<head>
    <style>
        .swal-modal .swal-text { text-align: center; }
    </style>
</head>

<div id="bankAccountPanel">
    <div class="panel panel-default">
        @* ═════ SECTION 1: Application Info ═════ *@
        <div class="panel-heading">Application Information</div>
        <div style="width:90%;margin:0 auto;">
            <br />
            <table class="table table-bordered table-hover table-striped panel panel-default display">
                <thead><tr><th>Reference Number</th><th>Status</th><th>Application Date</th><th>Applicant Name</th><th>Action</th></tr></thead>
                <tbody>
                    <tr>
                        <td>@(app != null ? app.ApplicationReferenceNumber : "")</td>
                        <td>@(app != null && app.Status != null ? app.Status.Name : "N/A")</td>
                        <td>@(app != null && app.CreatedDateTime.HasValue ? app.CreatedDateTime.Value.ToString("yyyy/MM/dd") : "")</td>
                        <td>@(app != null && app.Customer != null ? app.Customer.FullName : "")</td>
                        <td>@Html.ActionLink("View", "Details", "PropertyLeaseApplication", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("refNo=" + (app != null ? app.Id : 0)) }, new { @class = "btn btn-primary btn-sm", @target = "_blank" })</td>
                    </tr>
                </tbody>
            </table>
        </div>
        <br />

        @* ═════ SECTION 2: Lease Details ═════ *@
        <div class="panel-heading">Tenant Lease Details</div>
        <div style="width:90%;margin:0 auto;">
            <br />
            <table class="table table-bordered table-hover table-striped panel panel-default display">
                <thead><tr><th>Lease Ref No.</th><th>Status</th><th>Captured Date</th><th>Tenant Name</th><th>Action</th></tr></thead>
                <tbody>
                    <tr>
                        <td>@(lease != null ? lease.LeaseReferenceNo : "")</td>
                        <td>@(lease != null && lease.Status != null ? lease.Status.Name : "N/A")</td>
                        <td>@(lease != null && lease.CreatedDateTime.HasValue ? lease.CreatedDateTime.Value.ToString("yyyy/MM/dd") : "")</td>
                        <td>@(lease != null ? lease.FirstNames : "") @(lease != null ? lease.LastName : "")</td>
                        <td>@Html.ActionLink("View", "ApplincantDetails", "LeaseDetails", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("refNo=" + (lease != null ? lease.Id : 0)) }, new { @class = "btn btn-primary btn-sm", @target = "_blank" })</td>
                    </tr>
                </tbody>
            </table>
        </div>
        <br />

        @* ═════ SECTION 3: Dispute Capture Form ═════ *@
        <div class="panel-heading">Register Dispute Details</div>
        <div style="width:90%;margin:0 auto;">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                <br />
                @Html.Hidden("id", lease != null ? lease.Id : 0)

                <div class="form-horizontal">
                    <div class="form-group">
                        @Html.Label("Reported By", htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-4"><input type="text" name="ReportedByName" class="form-control" required placeholder="Full name of reporter" /></div>
                    </div>
                    <div class="form-group">
                        @Html.Label("Contact Number", htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-4"><input type="tel" name="ContactNumber" class="form-control" placeholder="e.g. 011 123 4567" /></div>
                    </div>
                    <div class="form-group">
                        @Html.Label("Email Address", htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-4"><input type="email" name="EmailAddress" class="form-control" placeholder="reporter@email.com" /></div>
                    </div>
                    <div class="form-group">
                        @Html.Label("Category", htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-4">
                            <select name="Category" class="form-control" required id="Category">
                                <option value="">-- Select Category --</option>
                                <option value="Financial and Billing">Financial & Billing</option>
                                <option value="Compliance">Compliance</option>
                                <option value="Maintenance">Maintenance</option>
                                <option value="Tenure">Tenure</option>
                                <option value="Notices">Notices</option>
                                <option value="Administrative">Administrative</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-group">
                        @Html.Label("Sub-Category", htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-4"><input type="text" name="SubCategory" class="form-control" placeholder="e.g. Incorrect billing amount" /></div>
                    </div>
                    <div class="form-group">
                        @Html.Label("Description", htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-6"><textarea name="Description" class="form-control" rows="4" required placeholder="Describe the dispute in detail..."></textarea></div>
                    </div>
                </div>

                <br />
                <div id="divbtn" class="col-md-offset-2">
                    <input type="button" value="Register Dispute" name="btnApproval" onclick="clickSubmit()" class="button1" />
                    <input type="submit" value="Submit" style="display:none;" hidden name="btnApprovalStatus" class="btn btn-primary" id="btnApproval" />
                    <br /><br /><br />
                </div>
            }
        </div>
    </div>
</div>

@section Scripts{
    <script src="@Url.Content("~/scripts/Datatables/jquery.dataTables.min.js")"></script>
    <script src="@Url.Content("~/scripts/Datatables/dataTables.bootstrap.js")"></script>
}

<script>
    function clickSubmit() {
        var cat = document.getElementById('Category').value;
        if (!cat) { swal("Error", "Please select a dispute category", "warning"); return; }
        swal({
            icon: "info",
            title: "Register Dispute?",
            text: "Category: " + cat + "\nThis will create a new dispute record.",
            buttons: ['No!', 'Yes, register!']
        }).then(function (isConfirm) {
            if (isConfirm) { document.getElementById("btnApproval").click(); }
        });
    }
</script>
