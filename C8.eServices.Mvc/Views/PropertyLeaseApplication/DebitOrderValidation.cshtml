@model C8.eServices.Mvc.ViewModels.DepartmentsApprovalViewModel
@using System.Text;
@using C8.eServices.Mvc.DataAccessLayer;
@using C8.eServices.Mvc.Keys
@{
    ViewBag.Title = "Details";
    Layout = "~/Views/Shared/RCS_Layout.cshtml";
}
<head>
    <style>
        .swal-modal .swal-text {
            text-align: center;
        }
    </style>
</head>
<script src="@Url.Content( "~/Scripts/moment.js" )"></script>
<div id="bankAccountPanel">
    <div class="panel-group" id="instructions">
        <div class="panel panel-default">
            <div class="panel-heading">
                <h4 class="panel-title">
                    <a data-toggle="collapse" data-parent="#accordion" href="#collapseInstructions">
                        <span>Instructions</span>
                    </a>
                </h4>
            </div>
            <div id="collapseInstructions" class="panel-collapse collapse in">
                <div class="panel-body">
                    <p>
                        <u><b>Steps For Correct Debit Order Authority Document</b></u><br />
                        1) Click view on the generated debit order authority document<br />
                        2) If debit order authority document is in order, Click under the signature action and choose the dropdown option "approve"<br />
                        3) Then click browse and select the signed debit order authority document that was downloaded,then click upload<br />
                        4) Then select the "approve"" Status from the approval status dropdown<br />
                        5) Then click submit<br />
                        <br />


                        <u><b>Steps For Incorrect Debit Authority Order Document</b></u><br />
                        1) View the generated debit order authority document<br />
                        2) If debit order authority document has issues, IGNORE the signature action and move on to step 3<br />
                        3) Select the "reject"" Status from the approval status dropdown, and add a comment in the "rejection comment" box that will pop up<br />
                        4) Then click submit<br />

                    </p>


                </div>
            </div>
        </div>
    </div>


    <div class="panel panel-default">
        <div class="panel-heading">Evaluating Application</div>
        <div style="width: 90%;margin: 0 auto;">
            <br />
            <table id="FailureTable" class="table table-bordered table-hover table-striped panel panel-default display ">
                <thead>
                    <tr>
                        <th>
                            Reference Number
                        </th>
                        <th>
                            Applicant Type
                        </th>
                        <th>
                            Status
                        </th>
                        <th>
                            Captured Date
                        </th>
                        <th>
                            Customer Name
                        </th>
                        <th>
                            Action
                        </th>
                    </tr>
                </thead>
                <tbody>

                    <tr>
                        <td>
                            @Model.PropertyLeaseApplications.ApplicationReferenceNumber
                        </td>
                        <td>
                            @Model.PropertyLeaseApplications.PurchaserType.Name
                        </td>
                        <td>
                            @Model.PropertyLeaseApplications.Status.Name
                        </td>
                        <td>
                            @Model.PropertyLeaseApplications.CreatedDateTime
                        </td>
                        <td>
                            @Model.PropertyLeaseApplications.Customer.FullName
                        </td>
                        <td>
                            @Html.ActionLink("View", "Details", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("refNo=" + Model.PropertyLeaseApplications.Id.ToString()), target = "_blank" }, new { @class = "btn btn-primary", @target = "_blank" })

                        </td>
                    </tr>

                </tbody>
            </table>



        </div>

        <br />

        <div class="panel-heading">Generated Debit Order Authority</div>
        <div style="width: 90%;margin: 0 auto;">
            <br />
            <table id="FailureTable" class="table table-bordered table-hover table-striped panel panel-default display ">
                <thead>
                    <tr>
                        <th>
                            Document Type
                        </th>
                        <th>
                            Document
                        </th>
                        <th>
                            Action
                        </th>

                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>
                            Debit Order
                        </td>
                        <td>
                            <input type="button" id="btnExternal" class="button1" value="View" onclick="location.href='@Url.Action("pdfDenerateDebitOrderAuthority", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("ApplicationId=" + ViewBag.PropertyLeaseAppliactionId.ToString()) })'" />
                            @*<input type="button" id="btnExternal" class="button1" value="View" onclick="location.href='@item.FilePath'" />*@
                        </td>
                        <td>
                            <div class="form-group">
                                @Html.Label("Signature", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-6">
                                    @Html.DropDownList("DebitApproval", null, "-- Select Option --", htmlAttributes: new { @class = "form-control", onchange = "ApproveDebitOder()", @Name = "DebitApproval", @required = "required", @Id = "DebitApproval" })
                                    @Html.ValidationMessage("DebitApproval", "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </td>
                    </tr>

                    @*@foreach (var item in Model.Attachments)
                        {
                            <tr>
                                <td>
                                    @Model.DocName
                                </td>
                                <td>
                                    <input type="button" id="btnExternal" class="button1" value="View" onclick="location.href='@item.FilePath'" />
                                </td>

                            </tr>
                        }*@


                </tbody>
            </table>

        </div>
        <br />

        <div class="panel-heading">Upload Signed Debit Order</div>
        @Html.Partial("_DocumentsPartialConductUnitInspection", Model.DocumentsViewModel)

        <br />

        <div style="width: 90%;margin: 0 auto;">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <br />

                if (ViewBag.ApprovalStatus != null)
                {
                    <div class="form-group">
                        @Html.Label("Approval Status", htmlAttributes: new { @class = "control-label col-md-1" })
                        <div class="col-md-2">
                            @Html.DropDownList("ApprovalStatus", null, "-- Select Option --", htmlAttributes: new { @class = "form-control", onchange = "ChangeStatus()", @Name = "ApprovalStatusddl", @required = "required", @Id = "ApprovalStatus" })
                            @Html.ValidationMessage("ApprovalStatus", "", new { @class = "text-danger" })
                        </div>
                    </div>
                }

                <br />
                <br />

                <div id="divComment" style="display:none">
                    <div class="form-group">

                        <span> @Html.Label("Rejection Comment", htmlAttributes: new { @class = "control-label col-md-1" })<b style="color:red; font-size:x-large;">*</b></span>
                        <div class="col-md-8">
                            @Html.TextArea("RejectComment", new { @class = "form-control", @Id = "RejectComment", @required = true })
                            @Html.ValidationMessage("RejectComment", "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <br />
                    <br />
                    <br />
                </div>
                <br />
                <br />

                <div id="divbtn" style="display:block">
                    <input type="button" value="Submit" name="btnApproval" onclick="clickSubmit()" class="button1" />
                    <input type="submit" value="Submit" style="display:none;" hidden name="btnApprovalStatus" class="button1" id="btnApproval" />
                    <br />
                    <br />
                    <br />
                </div>
            }
        </div>
    </div>
</div>
@section Scripts{

    <script src="@Url.Content( "~/scripts/Datatables/jquery.dataTables.min.js" )"></script>
    <script src="@Url.Content( "~/scripts/Datatables/dataTables.bootstrap.js" )"></script>
    <script>
        function ApproveDebitOder() {
             $.getJSON("../PropertyLeaseApplication/RevenueSignDebitOrder?id="+@ViewBag.PropertyLeaseAppliactionId ,
            function (result) {
                window.location.href = "@Url.Action("pdfDenerateDebitOrderAuthority", "PropertyLeaseApplication", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("ApplicationId=" + ViewBag.PropertyLeaseAppliactionId.ToString()) })";
            });
    }

    </script>
    <script type="text/javascript">

        function loadAccounts() {
            //debugger;
            $('#FailureTable').DataTable({
                "ajax": {
                    "url": "@Url.Action( "LoadDetails", "DepartmentsApprovals" )",
                    "type": "GET",
                    "datatype": "json",
                    "timeout": 60000
                },
                "columns": [

                    {
                        "data": "CreatedDateTime", "autoWidth": true,
                        "render": function (data) {
                            return convertDate(data);
                        }
                    },
                    {
                        "render": function (data) {
                            return "System";
                        }
                    },
                    { "data": "FailureReason", "autoWidth": true },
                    {
                        "data": "CapturedDate", "autoWidth": true,
                        "render": function (data) {
                            return convertDate(data);
                        }
                    },

                     { "data": "AssignedTo", "autoWidth": true }],
                "language": {
                    "emptyTable": "No Data.",
                },
                "Initcomplete": "",
                "destroy": true
            });
        }

        function convertDate(data) {
            try {
                var dtStart = new Date(parseInt(data.substr(6)));
                var dtStartWrapper = moment(dtStart);
                return dtStartWrapper.format("YYYY-MM-DD");
            }
            catch (ex) {
            }
        }

        $(function () {
            $('#RCSTable').DataTable();

        });

    </script>

}

<script>
    $.validator.setDefaults({
        ignore: ':Hidden, [readonly=readonly]'
    });
    $.validator.setDefaults({
        ignore: "#RejectComment"
    });
    function ChangeStatus() {
        var status = document.getElementById("ApprovalStatus").value;
        if (status == "Rcs_Rejected") {
            jQuery('#divComment').css("display", "block")
            $('#RejectComment').prop('required', true);
        } else {
            jQuery('#divComment').css("display", "none")
            $('#RejectComment').prop('required', false);
           
        }
       

    }


    function clickSubmit() {
       
        swal({
            icon: "info",
            title: "Are you sure you want to submit this debit order?",
            buttons: [
                'No!',
                'Yes, I am sure!'
            ]

        }).then(function (isConfirm) {
            if (isConfirm) {
                debugger;
                var statusval = document.getElementById("ApprovalStatus").value;
                if (statusval =="Rcs_Rejected") {
                    var RejectComment = document.getElementById("RejectComment").value;
                    if ((RejectComment == null || RejectComment == "")) {
                        swal("error", "Please enter rejection comment!", "warning");
                    } else {

                        document.getElementById("btnApproval").click();
                    }
                } else {
                    document.getElementById("btnApproval").click();
                }
                
            }
        });
    }

</script>
<script>
        $(function () {
            $('#FailureTable').DataTable();

                var display = "@ViewBag.Message";

        if (display != null && display != "") {
            $('#MessageModal4').modal('show');
        }
        });
</script>


