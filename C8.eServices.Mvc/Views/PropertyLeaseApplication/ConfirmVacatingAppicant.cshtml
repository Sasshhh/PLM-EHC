@model C8.eServices.Mvc.ViewModels.DepartmentsApprovalViewModel
@using System.Text;
@using C8.eServices.Mvc.DataAccessLayer;
@using C8.eServices.Mvc.Keys
@{
    //ViewBag.Title = "Details";
    Layout = "~/Views/Shared/RCS_Layout.cshtml";
}
<head>
    <style>
        .swal-modal .swal-text {
            text-align: center;
        }

        input[type='date'] {
            position: relative;
        }

        ::-webkit-datetime-edit, ::-webkit-clear-button, ::-webkit-calendar-picker-indicator {
            position: absolute;
        }

        ::-webkit-clear-button {
            right: 2.5em;
        }

        ::-webkit-inner-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }

        ::-webkit-calendar-picker-indicator {
            right: 0;
            padding: .539em .34em;
        }

        input[type="date"]::-webkit-calendar-picker-indicator {
            color: rgba(0, 0, 0, 0);
            opacity: 1;
            display: block;
            background: url('../Content/RcsStyles/calenderIcon.png') no-repeat;
            background-size: 20px 20px;
            width: 20px;
            height: 20px;
            border-width: thin;
            margin-left: 50px;
        }
    </style>
</head>
<script src="@Url.Content( "~/Scripts/moment.js" )"></script>
<div id="bankAccountPanel">
    <div class="panel panel-default">
        <div class="panel-heading">Evaluating Application</div>
        <div style="width: 90%;margin: 0 auto;">
            <br />
            <table id="FailureTable" class="table table-bordered table-hover table-striped panel panel-default display ">
                <thead>
                    <tr>
                        <th>
                            Reference Number
                        </th>
                        <th>
                            Applicant Type
                        </th>
                        <th>
                            Status
                        </th>
                        @if (Model.PropertyLeaseApplications.CommitteeDate != null)
                        {
                    <th>
                        Commitee Date
                    </th>
                        }
                        else
                        {
                    <th>
                        Captured Date
                    </th>
                        }
                    <th>
                        Applicant Name
                    </th>
                        <th>
                            Action
                        </th>
                    </tr>
                </thead>
                <tbody>

                    <tr>
                        <td>
                            @Model.PropertyLeaseApplications.ApplicationReferenceNumber
                        </td>
                        <td>
                            @if (Model.PropertyLeaseApplications.PurchaserType != null)
                            {
                                @Model.PropertyLeaseApplications.PurchaserType.Name
                            }
                        </td>
                        <td>
                            @Model.PropertyLeaseApplications.Status.Name
                        </td>
                        <td>
                            @if (Model.PropertyLeaseApplications.CommitteeDate != null)
                            {
                                @Model.PropertyLeaseApplications.CommitteeDate
                            }
                            else
                            {
                               @Model.PropertyLeaseApplications.CreatedDateTime
                            }
                        </td>
                        <td>
                            @Model.PropertyLeaseApplications.Customer.FirstName @Model.PropertyLeaseApplications.Customer.LastName
                        </td>
                        <td>
                            @Html.ActionLink("View", "Details", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("refNo=" + Model.PropertyLeaseApplications.Id.ToString()), target = "_blank" }, new { @class = "btn btn-primary", @target = "_blank" })
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
        <br />

        <div class="panel-heading">Tenant Lease Details</div>
        <div style="width: 90%;margin: 0 auto;">
            <br />
            <table id="FailureTable" class="table table-bordered table-hover table-striped panel panel-default display ">
                <thead>
                    <tr>
                        <th>
                            Lease Ref No.
                        </th>
                        <th>
                            Applicant Type
                        </th>
                        <th>
                            Status
                        </th>
                        <th>
                            Captured Date
                        </th>
                        <th>
                            Applicant Name
                        </th>
                        <th>
                            Action
                        </th>
                    </tr>
                </thead>
                <tbody>

                    <tr>

                        <td>
                            @Model.LeaseDetails.LeaseReferenceNo
                        </td>
                        <td>
                            @if (Model.LeaseDetails.PurchaserType != null)
                            {
                                @Model.LeaseDetails.PurchaserType.Name
                            }
                        </td>
                        <td>
                            @if (Model.LeaseDetails.Status != null)
                            {
                                @Model.LeaseDetails.Status.Name
                            }
                        </td>
                        <td>
                            @Model.LeaseDetails.CreatedDateTime
                        </td>
                        <td>
                            @Model.LeaseDetails.FirstNames @Model.LeaseDetails.LastName
                        </td>
                        <td>

                            @Html.ActionLink("View", "ApplincantDetails", "LeaseDetails", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("refNo=" + Model.LeaseDetails.Id.ToString()), target = "_blank" }, new { @class = "btn btn-primary", @target = "_blank" })

                        </td>
                    </tr>

                </tbody>
            </table>



        </div>

        <br />

        @if (Model.LeaseTermination != null)
        {
            <br />
            <div class="panel-heading">Termination To Confirm</div>
            <div style="width: 90%;margin: 0 auto;">
                <br />
                <table id="FailureTable" class="table table-bordered table-hover table-striped panel panel-default display ">
                    <thead>
                        <tr>
                            <th>
                                Termination Date
                            </th>
                            <th>
                                Reason For Termination
                            </th>

                            <th>
                                Captured Date
                            </th>
                            <th>
                                Terminateion By
                            </th>
                        </tr>
                    </thead>

                    <tbody>
                        <tr>
                            <td>
                                @Model.LeaseTermination.TerminationDate
                            </td>
                            <td>
                                @Model.LeaseTermination.ReasonForTermination
                            </td>

                            <td>
                                @Model.LeaseTermination.CreatedDateTime
                            </td>
                            <td>
                                Test User
                            </td>
                        </tr>

                    </tbody>
                </table>
            </div>
        }

        <br />

        <div class="panel-heading">Vacating Applicant Action</div>
        @using (Html.BeginForm())
        {

            @Html.AntiForgeryToken()
            <div style="width: 90%;margin: 0 auto;">
                <br />
                @Html.HiddenFor(model => model.PropertyLeaseApplication.Id, htmlAttributes: new { @class = "form-control", @Style = "display:none;" })
                @Html.HiddenFor(model => model.LeaseDetails.Id, htmlAttributes: new { @class = "form-control", @Style = "display:none;" })
                @Html.HiddenFor(model => model.LeaseDetails.LeaseReferenceNo, htmlAttributes: new { @class = "form-control", @Style = "display:none;" })
            <div class="form-horizontal">
                @if (ViewBag.ApprovalStatus != null)
                {
                    <div class="form-group">
                        @Html.Label("Tenant Vacated", htmlAttributes: new { @class = "control-label col-md-1" })
                        <div class="col-md-2">
                            @Html.DropDownList("ApprovalStatus", null, "-- Select Option --", htmlAttributes: new { @class = "form-control", @Id = "ApprovalStatus", @Name = "ApprovalStatusddl", @required = "required" })
                            @Html.ValidationMessage("ApprovalStatus", "", new { @class = "text-danger" })
                        </div>
                    </div>
                }
            </div>
                <div id="divComment" style="display:none">
                    <div class="form-group">
                        @Html.Label("Comment", htmlAttributes: new { @class = "control-label col-md-1" })
                        <div class="col-md-4">
                            @Html.TextArea("RejectComment", new { @class = "form-control", @Id = "Comments" })
                            @Html.ValidationMessage("RejectComment", "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <br />
                    <br />
                    <br />
                </div>
                <br />
                <br />

                <div id="divbtn" style="display:block; margin-left:100px;">

                    <input type="button" value="Submit" name="btnApproval" onclick="clickSubmit()" class="button1" />
                    <input type="submit" value="Submit" style="display:none;" hidden name="btnApprovalStatus" class="button1" id="btnApproval" />
                    <br />
                    <br />
                    <br />
                </div>
            </div>
        }

    </div>
</div>
@section Scripts{

    <script src="@Url.Content( "~/scripts/Datatables/jquery.dataTables.min.js" )"></script>
    <script src="@Url.Content( "~/scripts/Datatables/dataTables.bootstrap.js" )"></script>

    <script type="text/javascript">


        function loadAccounts() {
            //debugger;
            $('#FailureTable').DataTable({
                "ajax": {
                    "url": "@Url.Action( "LoadDetails", "DepartmentsApprovals" )",
                    "type": "GET",
                    "datatype": "json",
                    "timeout": 60000
                },
                "columns": [

                    {
                        "data": "CreatedDateTime", "autoWidth": true,
                        "render": function (data) {
                            return convertDate(data);
                        }
                    },
                    {
                        "render": function (data) {
                            return "System";
                        }
                    },
                    { "data": "FailureReason", "autoWidth": true },
                    {
                        "data": "CapturedDate", "autoWidth": true,
                        "render": function (data) {
                            return convertDate(data);
                        }
                    },

                     { "data": "AssignedTo", "autoWidth": true }],
                "language": {
                    "emptyTable": "No Data.",
                },
                "Initcomplete": "",
                "destroy": true
            });
        }

        function convertDate(data) {
            try {
                var dtStart = new Date(parseInt(data.substr(6)));
                var dtStartWrapper = moment(dtStart);
                return dtStartWrapper.format("YYYY-MM-DD");
            }
            catch (ex) {
            }
        }

        $(function () {
            $('#RCSTable').DataTable();

        });

    </script>

}

