@model IEnumerable<C8.eServices.Mvc.Models.LeaseDetails>
@using C8.eServices.Mvc.Helpers

@{
    ViewBag.Title = "Refund Authorisations";
    Layout = "~/Views/Shared/RCS_Layout.cshtml";
}

<head>
    <style>
        .header-centered {
            text-align: center;
            font-weight: 700;
            margin-top: 20px;
            margin-bottom: 30px;
            color: #2c3e50;
        }
        .table-container {
            width: 95%;
            margin: 0 auto;
            background: #ffffff;
            padding: 20px;
            border-radius: 8px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        }
    </style>
</head>

<div class="container-fluid" style="margin-top: 20px;">
    <h2 class="header-centered">CEO - Deposit Refund Authorisations</h2>

    <div class="table-container">
        @if (ViewBag.RefundAuthorisationSession != null)
        {
            <div class="alert alert-success alert-dismissible" role="alert">
                <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <strong>Success!</strong> @ViewBag.RefundAuthorisationSession
            </div>
        }

        <table id="RefundAuthorisationTable" class="table table-striped table-bordered table-hover">
            <thead>
                <tr>
                    <th>Application Ref No.</th>
                    <th>Lease Ref No.</th>
                    <th>Tenant Name</th>
                    <th>Space/Unit Number</th>
                    <th>Deposit Held</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@(item.PropertyLeaseApplication != null ? item.PropertyLeaseApplication.ApplicationReferenceNumber : "N/A")</td>
                        <td>@item.LeaseReferenceNo</td>
                        <td>@(item.FirstNames + " " + item.LastName)</td>
                        <td>@item.SpaceUnitNo</td>
                        <td><strong>R @item.DepositeAmount.ToString("F2")</strong></td>
                        <td>
                            <span class="label label-warning" style="font-size: 0.9em; padding: 5px 10px;">
                                @(item.Status != null ? item.Status.Name : "Awaiting Refund Authorisation")
                            </span>
                        </td>
                        <td style="text-align: center;">
                            @Html.ActionLink("Authorize Refund", "AuthorizeRefund", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("id=" + item.Id.ToString()) }, new { @class = "button1", @style = "padding: 8px 16px; font-size: 14px; margin: 0; min-width: auto; height: auto;" })
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script>
    $(document).ready(function () {
        $('#RefundAuthorisationTable').DataTable({
            "responsive": true,
            "order": [[0, "desc"]]
        });
    });
</script>
