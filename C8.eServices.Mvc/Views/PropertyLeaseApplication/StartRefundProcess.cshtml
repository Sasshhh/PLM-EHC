@model C8.eServices.Mvc.ViewModels.DepartmentsApprovalViewModel
@using System.Text;
@using C8.eServices.Mvc.DataAccessLayer;
@using C8.eServices.Mvc.Keys
@{
    ViewBag.Title = "";
    Layout = "~/Views/Shared/RCS_Layout.cshtml";
}
<head>
    <style>
        .swal-modal .swal-text {
            text-align: center;
        }
    </style>
</head>
<script src="@Url.Content( "~/Scripts/moment.js" )"></script>

<div id="bankAccountPanel">
    <div class="panel panel-default">
        <br />
        <div class="panel-heading">Documents</div>
        <div style="width: 90%;margin: 0 auto;">
            <div style="display:block">
                @Html.Partial("_DocumentsPartialTerminationLetter", Model.DocumentsViewModelRefundDeposits)
                <br />
            </div>
        </div>
        <br />
        <div class="panel-heading">Upload Proff of Banking Details</div>
        <div style="width: 90%;margin: 0 auto;">
            <div style="display:block">
                @Html.Partial("_DocumentsPartialProofOfBankingDetails", Model.DocumentsViewModel)
                <br />
            </div>
        </div>


        <div style="width: 90%;margin: 0 auto;">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <div class="panel-heading">Refund and Deductions Processing</div>
                <br />
                <div class="form-horizontal">
                    @Html.HiddenFor(model => model.LeaseDetails.Id)
                    @Html.HiddenFor(model => model.PropertyLeaseApplications.Id)

                    <div class="form-group">
                        @Html.LabelFor(model => model.LeaseTermination.FinancialOfficerOfficialNumber, "Financial Officer Official Number", htmlAttributes: new { @class = "control-label col-md-3" })
                        <div class="col-md-4">
                            @Html.TextBoxFor(model => model.LeaseTermination.FinancialOfficerOfficialNumber, new { @class = "form-control", @required = "required", @id = "FinancialOfficerOfficialNumber", @placeholder = "Enter your Official ID/Number" })
                            @Html.ValidationMessageFor(model => model.LeaseTermination.FinancialOfficerOfficialNumber, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="control-label col-md-3">Original Deposit Amount (R)</label>
                        <div class="col-md-4">
                            <input type="text" id="OriginalDeposit" class="form-control" readonly value="@Model.LeaseDetails.DepositeAmount" />
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.LeaseTermination.MaintenanceCost, "Maintenance Deductions (R)", htmlAttributes: new { @class = "control-label col-md-3" })
                        <div class="col-md-4">
                            @Html.TextBoxFor(model => model.LeaseTermination.MaintenanceCost, new { @class = "form-control", @id = "MaintenanceCost", @type = "number", @step = "0.01", @value = "0.00", @oninput = "calculateRefund()" })
                            @Html.ValidationMessageFor(model => model.LeaseTermination.MaintenanceCost, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.LeaseTermination.ApprovedDeductions, "Approved Other Deductions (R)", htmlAttributes: new { @class = "control-label col-md-3" })
                        <div class="col-md-4">
                            @Html.TextBoxFor(model => model.LeaseTermination.ApprovedDeductions, new { @class = "form-control", @id = "ApprovedDeductions", @type = "number", @step = "0.01", @value = "0.00", @oninput = "calculateRefund()" })
                            @Html.ValidationMessageFor(model => model.LeaseTermination.ApprovedDeductions, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.LeaseTermination.NettRefundAmount, "Nett Refund Amount (R)", htmlAttributes: new { @class = "control-label col-md-3" })
                        <div class="col-md-4">
                            @Html.TextBoxFor(model => model.LeaseTermination.NettRefundAmount, new { @class = "form-control", @id = "NettRefundAmount", @readonly = "readonly" })
                            @Html.ValidationMessageFor(model => model.LeaseTermination.NettRefundAmount, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.LeaseTermination.DepositRefundRecommended, "Refund Recommendation", htmlAttributes: new { @class = "control-label col-md-3" })
                        <div class="col-md-4">
                            @Html.DropDownListFor(model => model.LeaseTermination.DepositRefundRecommended, new List<SelectListItem>
                            {
                                new SelectListItem { Text = "Refund Full Deposit", Value = "Refund Full Deposit" },
                                new SelectListItem { Text = "Refund Partial Deposit", Value = "Refund Partial Deposit" },
                                new SelectListItem { Text = "No Refund", Value = "No Refund" }
                            }, "-- Select Option --", new { @class = "form-control", @required = "required", @id = "DepositRefundRecommended" })
                            @Html.ValidationMessageFor(model => model.LeaseTermination.DepositRefundRecommended, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.LeaseTermination.FinancialOfficerReason, "Reason for Recommendation", htmlAttributes: new { @class = "control-label col-md-3" })
                        <div class="col-md-6">
                            @Html.TextAreaFor(model => model.LeaseTermination.FinancialOfficerReason, new { @class = "form-control", @id = "FinancialOfficerReason", @rows = "3", @required = "required", @placeholder = "Provide details justifying the recommendation/deductions" })
                            @Html.ValidationMessageFor(model => model.LeaseTermination.FinancialOfficerReason, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
                <br />
                <br />

                <div id="divbtn" style="display:block">
                    <input type="button" value="Submit Refund Recommendation" name="btnApproval" onclick="clickSubmit()" class="button1" style="background-color:#2b772b; color:white; border-radius:4px; padding:8px 16px;" />
                    <input type="submit" value="Submit" style="display:none;" hidden name="btnApprovalStatus" class="button1" id="btnApproval" />
                    <br />
                    <br />
                    <br />
                </div>
            }
        </div>
    </div>
</div>

<script>
    function clickSubmit() {
        swal({
            icon: "info",
            title: "Are you sure you want to send email to finance?",
            buttons: [
                'No!',
                'Yes, I am sure!'
            ]

        }).then(function (isConfirm) {
            if (isConfirm) {
                var comment = "ss";
                if (comment == null || comment == "") {
                    document.getElementById("btnApproval").click();
                }
                else {
                    document.getElementById("btnApproval").click();
                }
            }
        });
    }

    function calculateRefund() {
        var deposit = parseFloat(document.getElementById("OriginalDeposit").value) || 0;
        var maint = parseFloat(document.getElementById("MaintenanceCost").value) || 0;
        var ded = parseFloat(document.getElementById("ApprovedDeductions").value) || 0;
        
        var net = deposit - (maint + ded);
        if (net < 0) net = 0;
        
        document.getElementById("NettRefundAmount").value = net.toFixed(2);
    }

    $(document).ready(function() {
        calculateRefund();
    });

    function opendocumentUploadDiv() {
        $("#documentuploadModal").modal('show');
    }

</script>
<script>
        $(function () {
            $('#FailureTable').DataTable();

            var display = "@ViewBag.Message";

            if (display != null && display != "") {
                $('#MessageModal4').modal('show');
            }

            @*var IncompleteDepartmentUsers = "@ViewBag.Message2";
            var IncompleteDepartmentUsersTitle = "@ViewBag.MessageTitle2";
            if (IncompleteDepartmentUsers != null && IncompleteDepartmentUsers != "") {
                swal(IncompleteDepartmentUsersTitle, IncompleteDepartmentUsers, "warning");
            }*@

            });
</script>


