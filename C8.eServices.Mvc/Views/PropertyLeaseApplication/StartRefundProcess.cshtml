<script>
    function clickSubmit() {
        swal({
            icon: "info",
            title: "Are you sure you want to send email to finance?",
            buttons: [
                'No!',
                'Yes, I am sure!'
            ]

        }).then(function (isConfirm) {
            if (isConfirm) {
                var comment = "ss";
                if (comment == null || comment == "") {
                    document.getElementById("btnApproval").click();
                }
                else {
                    document.getElementById("btnApproval").click();
                }
            }
        });
    }

    function opendocumentUploadDiv() {
        $("#documentuploadModal").modal('show');
    }

</script>
