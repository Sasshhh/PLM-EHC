@model C8.eServices.Mvc.ViewModels.DepartmentsApprovalViewModel
@using System.Text;
@using C8.eServices.Mvc.DataAccessLayer;
@using C8.eServices.Mvc.Keys
@{
    ViewBag.Title = "";
    Layout = "~/Views/Shared/RCS_Layout.cshtml";
}
<head>
    <style>
        .swal-modal .swal-text {
            text-align: center;
        }
    </style>
</head>
<script src="@Url.Content( "~/Scripts/moment.js" )"></script>

@* UC031 Process Deposit Refund or Deductions (Client Services Supervisor / Bookkeeper):
   Official Number > Deductions (maintenance, approved deductions, nett) > Authorise > recommendation
   (reason when not recommended, Proof of Banking Details when recommended) > Submit > "Yes, I am sure". *@
<div id="bankAccountPanel">
    <div class="panel panel-default">
        <br />
        <div class="panel-heading">Process Deposit Refund or Deductions</div>
        <div style="width: 90%;margin: 0 auto;">
            <table class="table table-bordered" style="margin-top:10px;">
                <tbody>
                    <tr><td style="width:35%;"><strong>Lease Reference No.</strong></td><td>@Model.LeaseDetails.LeaseReferenceNo</td></tr>
                    <tr><td><strong>Tenant Name</strong></td><td>@Model.LeaseDetails.FirstNames @Model.LeaseDetails.LastName</td></tr>
                    <tr><td><strong>Deposit Amount (R)</strong></td><td>@Model.LeaseDetails.DepositeAmount.ToString("F2")</td></tr>
                </tbody>
            </table>
        </div>
        <div class="panel-heading">Documents</div>
        <div style="width: 90%;margin: 0 auto;">
            <div style="display:block">
                @Html.Partial("_DocumentsPartialTerminationLetter", Model.DocumentsViewModelRefundDeposits)
                <br />
            </div>
        </div>

        <div style="width: 90%;margin: 0 auto;">
            @using (Html.BeginForm(null, null, new { q = Request.QueryString["q"] }, FormMethod.Post, new { id = "refundForm" }))
            {
                @Html.AntiForgeryToken()
                <br />
                <div class="form-horizontal">
                    @Html.HiddenFor(model => model.LeaseDetails.Id)
                    @Html.HiddenFor(model => model.PropertyLeaseApplications.Id)
                    <input type="hidden" id="OriginalDeposit" value="@Model.LeaseDetails.DepositeAmount.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" />

                    <div class="form-group">
                        <label class="control-label col-md-3">Official Number <span class="text-danger">*</span></label>
                        <div class="col-md-4">
                            @Html.TextBoxFor(model => model.LeaseTermination.FinancialOfficerOfficialNumber, new { @class = "form-control", @id = "FinancialOfficerOfficialNumber", @placeholder = "Enter your Official Number" })
                        </div>
                        <div class="col-md-3">
                            <input type="button" value="Deductions" class="button1" onclick="showDeductions()" />
                        </div>
                    </div>

                    <div id="divDeductions" style="display:none;">
                        <div class="form-group">
                            <label class="control-label col-md-3">Maintenance Cost (R)</label>
                            <div class="col-md-4">
                                @Html.TextBoxFor(model => model.LeaseTermination.MaintenanceCost, new { @class = "form-control", @id = "MaintenanceCost", @type = "number", @step = "0.01", @min = "0", @oninput = "calculateRefund()" })
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="control-label col-md-3">Approved Deductions (R)</label>
                            <div class="col-md-4">
                                @Html.TextBoxFor(model => model.LeaseTermination.ApprovedDeductions, new { @class = "form-control", @id = "ApprovedDeductions", @type = "number", @step = "0.01", @min = "0", @oninput = "calculateRefund()" })
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="control-label col-md-3">Nett Refund Amount (R)</label>
                            <div class="col-md-4">
                                <input type="text" id="NettRefundAmount" class="form-control" readonly />
                                <small class="text-muted">Deposit &minus; (Maintenance Cost + Approved Deductions)</small>
                            </div>
                            <div class="col-md-3">
                                <input type="button" value="Authorise" class="button1" onclick="showAuthorise()" />
                            </div>
                        </div>
                    </div>

                    <div id="divAuthorise" style="display:none;">
                        <div class="form-group">
                            <label class="control-label col-md-3">Recommendation <span class="text-danger">*</span></label>
                            <div class="col-md-4">
                                @Html.DropDownListFor(model => model.LeaseTermination.DepositRefundRecommended, new List<SelectListItem>
                                {
                                    new SelectListItem { Text = "Recommend Deposit Refund", Value = "Recommend Deposit Refund" },
                                    new SelectListItem { Text = "Deposit Refund Not Recommended", Value = "Deposit Refund Not Recommended" }
                                }, "-- Select Option --", new { @class = "form-control", @id = "DepositRefundRecommended", @onchange = "recommendationChanged()" })
                            </div>
                        </div>
                        <div class="form-group" id="divReason" style="display:none;">
                            <label class="control-label col-md-3">Reason <span class="text-danger">*</span></label>
                            <div class="col-md-6">
                                @Html.TextAreaFor(model => model.LeaseTermination.FinancialOfficerReason, new { @class = "form-control", @id = "FinancialOfficerReason", @rows = "3", @placeholder = "Reason the deposit refund is not recommended" })
                            </div>
                        </div>
                    </div>
                    <input type="submit" value="Submit" style="display:none;" id="btnApproval" />
                </div>
            }
        </div>

        <div id="divProof" style="display:none;">
            <div class="panel-heading">Upload Proof of Banking Details</div>
            <div style="width: 90%;margin: 0 auto;">
                @Html.Partial("_DocumentsPartialProofOfBankingDetails", Model.DocumentsViewModel)
                <br />
            </div>
        </div>

        <div id="divbtn" style="display:none; width: 90%; margin: 0 auto;">
            <br />
            <input type="button" value="Submit" onclick="clickSubmit()" class="button1" />
            <br /><br /><br />
        </div>
    </div>
</div>

<script>
    function showDeductions() {
        if (!$.trim($("#FinancialOfficerOfficialNumber").val())) { swal("Validation Error", "Please enter your Official Number.", "warning"); return; }
        $("#divDeductions").show();
        calculateRefund();
    }

    function showAuthorise() {
        $("#divAuthorise").show();
        recommendationChanged();
    }

    function recommendationChanged() {
        var rec = $("#DepositRefundRecommended").val();
        $("#divReason").toggle(rec === "Deposit Refund Not Recommended");
        $("#divProof").toggle(rec === "Recommend Deposit Refund");
        $("#divbtn").toggle(!!rec);
    }

    function clickSubmit() {
        var rec = $("#DepositRefundRecommended").val();
        if (!$.trim($("#FinancialOfficerOfficialNumber").val())) { swal("Validation Error", "Please enter your Official Number.", "warning"); return; }
        if (!rec) { swal("Validation Error", "Please select a recommendation.", "warning"); return; }
        if (rec === "Deposit Refund Not Recommended" && !$.trim($("#FinancialOfficerReason").val())) { swal("Validation Error", "Please capture the reason the deposit refund is not recommended.", "warning"); return; }
        swal({
            icon: "info",
            title: "Are you sure you want to confirm the outcome?",
            buttons: ["No", "Yes, I am sure"]
        }).then(function (isConfirm) {
            if (isConfirm) {
                document.getElementById("btnApproval").click();
            }
        });
    }

    function calculateRefund() {
        var deposit = parseFloat(document.getElementById("OriginalDeposit").value) || 0;
        var maint = parseFloat(document.getElementById("MaintenanceCost").value) || 0;
        var ded = parseFloat(document.getElementById("ApprovedDeductions").value) || 0;
        var net = deposit - (maint + ded);
        if (net < 0) net = 0;
        document.getElementById("NettRefundAmount").value = net.toFixed(2);
    }

    function opendocumentUploadDiv() {
        $("#documentuploadModal").modal('show');
    }

</script>
<script>
        $(function () {
            $('#FailureTable').DataTable();

            var display = "@ViewBag.Message";

            if (display != null && display != "") {
                $('#MessageModal4').modal('show');
            }

            @*var IncompleteDepartmentUsers = "@ViewBag.Message2";
            var IncompleteDepartmentUsersTitle = "@ViewBag.MessageTitle2";
            if (IncompleteDepartmentUsers != null && IncompleteDepartmentUsers != "") {
                swal(IncompleteDepartmentUsersTitle, IncompleteDepartmentUsers, "warning");
            }*@

            });
</script>


