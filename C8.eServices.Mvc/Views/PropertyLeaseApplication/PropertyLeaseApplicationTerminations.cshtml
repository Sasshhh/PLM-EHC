
@model IEnumerable<C8.eServices.Mvc.Models.LeaseDetails>
@using C8.eServices.Mvc.Keys;
@{
    Layout = "~/Views/Shared/RCS_Layout.cshtml";
}

<style>
    @@media only screen and (max-width: 1000px) {


        .cards tbody tr {
            float: left;
            /*width: 20rem;*/
            width: 90%;
            margin: 0.5rem;
            border: 0.0625rem solid rgba(0,0,0,.125);
            border-radius: .25rem;
            box-shadow: 0.25rem 0.25rem 0.5rem rgba(0,0,0,0.25);
        }

        .cards thead tr {
            float: left;
            /*width: 25rem;*/
            width: 90%;
            margin: 0.5rem;
            border: 0.0625rem solid rgba(0,0,0,.125);
            border-radius: .25rem;
            box-shadow: 0.25rem 0.25rem 0.5rem rgba(0,0,0,0.25);
        }


        .cards tbody td {
            display: block;
            word-wrap: break-word;
        }

        .cards thead th {
            display: none;
        }

        .table tbody label {
            display: block;
        }

        .cards tbody label {
            display: inline;
            position: relative;
            font-size: 85%;
            top: -0.5rem;
            color: #808080;
            min-width: 4rem;
            margin-left: 0;
            margin-right: 1rem;
            text-align: left;
        }

        tr.selected label {
            color: #404040;
        }

        .table .fa {
            font-size: 2.5rem;
            text-align: center;
        }

        .cards .fa {
            font-size: 7.5rem;
        }
    }
</style>
<div id="BOAccountValidationSessionModal" class="modal fade" role="dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>

                <h4 class="modal-title">Lease Termination and Account Validation</h4>
            </div>
            <div class="modal-body">
                <div class="container">
                    <strong>@Html.Raw(ViewBag.BOAccountValidationTSession)</strong>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>
<div class="panel-group">
    <div class="panel panel-default">




        <div class="panel-group" style="margin-bottom: -1px;">
            <div class="panel panel-default">
                <div class="panel-heading" align="center">
                    Tenants Application Termination
                </div>

            </div>
        </div>

        <div id="accountInfoCollapse" class="panel-collapse collapse in tablecss">
            <br />

            <table id="RCSTable" class="table table-bordered table-hover table-striped panel panel-default cards">
                <thead>
                    <tr>
                        <th>
                            Lease Referrence No.
                        </th>
                        <th>
                            Tenant Name
                        </th>
                        <th>
                            Application Type
                        </th>
                        <th>
                            Lease Date
                        </th>
                        <th>
                            Status
                        </th>
                        <th> Action</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.LeaseReferenceNo)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.LastName) @Html.DisplayFor(modelItem => item.FirstNames)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.PurchaserType.Name)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.CreatedDateTime.Value)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Status.Name)
                            </td>

                            <td>
                                @if (item.Status != null)
                                {
                                    @* UC023: CSO initial termination notice review *@
                                    if (item.Status.Key == StatusKeys.AwaitingCSOTerminationReview)
                                    {
                                        @Html.ActionLink("Review Notice", "TerminationCSOReviewDetails", "PropertyLeaseApplication", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("id=" + item.Id.ToString()) }, new { @class = "btn btn-warning" })
                                    }

                                    if (item.Status.Key == StatusKeys.TerminationLeaseByTenant)
                                    {
                                        @Html.ActionLink("Exit Inspection", "ConductExitInspection", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("id=" + item.PropertyLeaseApplicationId.ToString() + "&LeseId=" + item.Id.ToString()) }, new { @class = "btn btn-primary" })
                                    }

                                    if (item.Status.Key == StatusKeys.ApplicationUpForRenewalAtThreeMonths)
                                    {
                                        @Html.ActionLink("Review", "LeaseRenewalValidation", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("id=" + item.Id.ToString()) }, new { @class = "btn btn-primary" })
                                    }

                                    if (item.Status.Key == StatusKeys.AwaitingREACApproval)
                                    {
                                        @Html.ActionLink("REAC Review", "REACTermination", "committeeoutcomes", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("id=" + item.Id.ToString()) }, new { @class = "btn btn-primary" })
                                    }

                                    if (item.Status.Key == StatusKeys.AwaitingPropertyEviction)
                                    {
                                        @Html.ActionLink("Property Eviction", "PropertyEvictionValidation", "PropertyLeaseApplication", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("id=" + item.Id.ToString()) }, new { @class = "btn btn-primary" })
                                    }

                                    if (item.Status.Key == StatusKeys.AwaitingCommitteEviction)
                                    {
                                        @Html.ActionLink("Eviction Committee", "EvictionCommitteeOutcome", "PropertyLeaseApplication", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("id=" + item.Id.ToString()) }, new { @class = "btn btn-primary" })
                                    }

                                    if (item.Status.Key == StatusKeys.AwaitingTenantAccountBalanceReview || item.Status.Key == StatusKeys.TenantNotice || item.Status.Key == StatusKeys.LeaseNotRenewed || item.Status.Key == StatusKeys.EndOfLeaseTerm)
                                    {
                                        @Html.ActionLink("Account Validation", "TenantAccountValidation", "PropertyLeaseApplication", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("id=" + item.Id.ToString()) }, new { @class = "btn btn-primary" })
                                    }

                                    if (item.Status.Key == StatusKeys.AwaitingExitInspection)
                                    {
                                        @Html.ActionLink("Schedule Exit Inspection", "ScheduleInspectionSlots", "PropertyLeaseApplication", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("id=" + item.PropertyLeaseApplicationId.ToString()) }, new { @class = "btn btn-primary" })
                                        @Html.ActionLink("Conduct Exit Inspection", "ConductExitInspection", "leaseDetails", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("LeseId=" + item.Id.ToString()) }, new { @class = "btn btn-warning" })
                                        @Html.ActionLink("Cancellation PDF", "GenerateCancellationOfLease", "PropertyLeaseApplication", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("id=" + item.Id.ToString()) }, new { @class = "btn btn-info", @target = "_blank" })
                                    }

                                    if (item.Status.Key == StatusKeys.AwaitingTerminationAppraisal)
                                    {
                                        @Html.ActionLink("Authorize Termination", "PropertyEvictionValidation", "PropertyLeaseApplication", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("id=" + item.Id.ToString()) }, new { @class = "btn btn-success" })
                                    }

                                    if (item.Status.Key == StatusKeys.LegalReferralPending || item.Status.Key == StatusKeys.AwaitingEvictionCEOAuth)
                                    {
                                        @Html.ActionLink("CEO Authorization", "EvictionCEOAuthorization", "PropertyLeaseApplication", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("id=" + item.Id.ToString()) }, new { @class = "btn btn-danger" })
                                    }

                                    if (item.Status.Key == StatusKeys.AwaitingEvictionService)
                                    {
                                        @Html.ActionLink("Serve Eviction Notice", "ServeEvictionNotice", "PropertyLeaseApplication", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("id=" + item.Id.ToString()) }, new { @class = "btn btn-warning" })
                                        @Html.ActionLink("Eviction Notice PDF", "GenerateNoticeToVacate", "PropertyLeaseApplication", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("id=" + item.Id.ToString()) }, new { @class = "btn btn-info", @target = "_blank" })
                                    }

                                    if (item.Status.Key == StatusKeys.EvictionNoticeServed)
                                    {
                                        @Html.ActionLink("Capture Proof of Service", "CaptureProofOfService", "PropertyLeaseApplication", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("id=" + item.Id.ToString()) }, new { @class = "btn btn-info" })
                                        @Html.ActionLink("Eviction Notice PDF", "GenerateNoticeToVacate", "PropertyLeaseApplication", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("id=" + item.Id.ToString()) }, new { @class = "btn btn-default", @target = "_blank" })
                                    }

                                }
                            </td>

                        </tr>
                    }
                </tbody>
            </table>
            <br />
        </div>


    </div>
</div>

<script type="text/javascript">
    $(document).ready(function () {
        var boSessionMsg = "@Html.Raw(ViewBag.BOAccountValidationTSession)";
        if (boSessionMsg !== null && boSessionMsg !== '') {
            var alertType = "success";
            var alertTitle = "Success";
            if (boSessionMsg.indexOf("APPROVED") !== -1 || boSessionMsg.indexOf("approved") !== -1 || boSessionMsg.indexOf("referred") !== -1) {
                alertTitle = boSessionMsg.indexOf("referred") !== -1 ? "Legal Referral" : "Action Authorized";
                alertType = "success";
            } else if (boSessionMsg.indexOf("REJECTED") !== -1 || boSessionMsg.indexOf("rejected") !== -1) {
                alertTitle = "Action Rejected";
                alertType = "warning";
            }
            swal({
                title: alertTitle,
                text: boSessionMsg,
                icon: alertType,
                button: "OK",
            });
        }
    });
</script>
<script>
    $(function () {
        $('#RCSTable').DataTable();
        var display = "@ViewBag.Display";

        if (display != null && display != "") {
            $('#MessageModal3').modal('show');
        }
        else {
            $('#MessageModal3').modal('hide');
               var result = "@ViewBag.MessageBody";
        if (result != null && result != "") {
            $('#MessageModal').modal('show');
        }
        else {
            $('#MessageModal').modal('hide');
              var result5 = "@ViewBag.MessageBody5";
            if (result5 != null && result5 != "") {
                $('#MessageModal5').modal('show');
            }
            else {
                $('#MessageModal5').modal('hide');
            }}
        }
    });
    function OpenChatModal() {

        $('#MessageModal').modal('show');
    };
</script>