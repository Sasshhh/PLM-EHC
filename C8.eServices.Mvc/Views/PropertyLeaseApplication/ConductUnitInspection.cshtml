@model C8.eServices.Mvc.ViewModels.DepartmentsApprovalViewModel
@using System.Text;
@using C8.eServices.Mvc.DataAccessLayer;
@using C8.eServices.Mvc.Keys
@{
    ViewBag.Title = "Details";
    Layout = "~/Views/Shared/RCS_Layout.cshtml";
}
<head>
    <style>

        .require::after {
            content: "*";
            font-weight: bold;
            color: red;
        }
        .swal-modal .swal-text {
            text-align: center;
        }
    </style>
</head>
<script src="@Url.Content( "~/Scripts/moment.js" )"></script>

<div class="panel-group" id="instructions">
    <div class="panel panel-default">
        <div class="panel-heading" data-toggle="collapse" data-parent="#accordion" href="#collapseInstructions">

            @*<span class="glyphicon glyphicon-triangle-bottom" aria-hidden="true"></span>*@
            Instructions

        </div>
        <div id="collapseInstructions" class="panel-collapse collapse">
            <div class="panel-body">


                <p>
                    <b><u>  Instructions</u></b>

                    <br />
                    1)Download Inspection Template and fill it out
                    <br />
                    2)Browse and attach completed inspection template as well as any supporting documents, then click upload button
                    <br />
                    3)Select inspection outcome from outcome dropdown (if inpsection is failed inspection comment is required)
                    <br />
                    4)Click submit
                    <br />
                </p>

            </div>
        </div>
    </div>
</div>
<div id="bankAccountPanel">
    <div class="panel panel-default">
        <div class="panel-heading">Evaluating Application</div>
        <div style="width: 90%;margin: 0 auto;">
            <br />
            <table id="FailureTable" class="table table-bordered table-hover table-striped panel panel-default display ">
                <thead>
                    <tr>
                        <th>
                            Reference Number
                        </th>
                        <th>
                            Applicant Type
                        </th>
                        <th>
                            Status
                        </th>
                        <th>
                            Captured Date
                        </th>
                        <th>
                            Customer Name
                        </th>
                        <th>
                            Action
                        </th>
                    </tr>
                </thead>
                <tbody>

                    <tr>
                        <td>
                            @Model.PropertyLeaseApplications.ApplicationReferenceNumber
                        </td>
                        <td>
                            @Model.PropertyLeaseApplications.PurchaserType.Name
                        </td>
                        <td>
                            @Model.PropertyLeaseApplications.Status.Name
                        </td>
                        <td>
                            @Model.PropertyLeaseApplications.CreatedDateTime
                        </td>
                        <td>
                            @Model.PropertyLeaseApplications.Customer.FullName
                        </td>
                        <td>
                            @Html.ActionLink("View", "Details", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("refNo=" + Model.PropertyLeaseApplications.Id.ToString()), target = "_blank" }, new { @class = "btn btn-primary", @target = "_blank" })

                        </td>
                    </tr>

                </tbody>
            </table>



        </div>

        <br />

        <div class="panel-heading">Conduct Unit Inspection Template</div>
        <div style="width: 90%;margin: 0 auto;">
            <div class="form-group">
                <div class="col-md-12">
                    <br />
                    <p><strong>Download the pre-inspection form template to fill out during the unit inspection:</strong></p>
                    <a href="@Url.Action("DownloadPreInspectionTemplate", "PropertyLeaseApplication")" 
                       class="btn btn-primary" 
                       target="_blank">
                        <i class="glyphicon glyphicon-download-alt"></i> Download Pre-Inspection Form Template
                    </a>
                    <br /><br />
                    <p class="text-muted"><small>This template will open in a new tab. Fill it out during your unit inspection.</small></p>
                </div>
            </div>
        </div>
        <br />

        <div class="panel-heading">Upload Completed Unit Inspection</div>
        @Html.Partial("_DocumentsPartialConductUnitInspection", Model.DocumentsViewModel)


        <br />
       
        <div style="width: 90%;margin: 0 auto;">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <br />

                if (ViewBag.ApprovalStatus != null)
                {
                    <div class="form-group">
                        @Html.Label("Outcome", htmlAttributes: new { @class = "control-label col-md-2 require" })
                        <div class="col-md-3">
                            @Html.DropDownList("ApprovalStatus", null, "-- Select Option --", htmlAttributes: new { @class = "form-control",onchange="ChangeStatus()", @Name = "ApprovalStatusddl", @required = "required" })
                            @Html.ValidationMessage("ApprovalStatus", "", new { @class = "text-danger" })
                        </div>
                    </div>
                }

                <br />

                <div id="divCommentRequired" style="display:none">
                    <div class="form-group">
                        @Html.Label("Inspection Comment", htmlAttributes: new { @class = "control-label col-md-1" })
                        <div class="col-md-8">
                            @Html.TextArea("UnitInspectionComment", null, new { @class = "form-control"})
                            @Html.ValidationMessage("UnitInspectionComment", "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <br />
                    <br />
                    <br />
                </div>

                <br />
                <br />

                <div id="divbtn" style="display:block">
                    <input type="button" value="Submit" name="btnApproval" onclick="clickSubmit()" class="button1" />
                    <input type="submit" value="Submit" style="display:none;" hidden name="btnApprovalStatus" class="button1" id="btnApproval" />
                    <br />
                    <br />
                    <br />
                </div>
            }
        </div>
    </div>
</div>
@section Scripts{

    <script src="@Url.Content( "~/scripts/Datatables/jquery.dataTables.min.js" )"></script>
    <script src="@Url.Content( "~/scripts/Datatables/dataTables.bootstrap.js" )"></script>

    <script type="text/javascript">

        function loadAccounts() {
            //debugger;
            $('#FailureTable').DataTable({
                "ajax": {
                    "url": "@Url.Action( "LoadDetails", "DepartmentsApprovals" )",
                    "type": "GET",
                    "datatype": "json",
                    "timeout": 60000
                },
                "columns": [

                    {
                        "data": "CreatedDateTime", "autoWidth": true,
                        "render": function (data) {
                            return convertDate(data);
                        }
                    },
                    {
                        "render": function (data) {
                            return "System";
                        }
                    },
                    { "data": "FailureReason", "autoWidth": true },
                    {
                        "data": "CapturedDate", "autoWidth": true,
                        "render": function (data) {
                            return convertDate(data);
                        }
                    },

                     { "data": "AssignedTo", "autoWidth": true }],
                "language": {
                    "emptyTable": "No Data.",
                },
                "Initcomplete": "",
                "destroy": true
            });
        }

        function convertDate(data) {
            try {
                var dtStart = new Date(parseInt(data.substr(6)));
                var dtStartWrapper = moment(dtStart);
                return dtStartWrapper.format("YYYY-MM-DD");
            }
            catch (ex) {
            }
        }

        $(function () {
            $('#RCSTable').DataTable();

        });

    </script>

}

