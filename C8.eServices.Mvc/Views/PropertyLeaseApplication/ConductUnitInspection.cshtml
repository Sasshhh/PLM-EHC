<script>
    function ChangeStatus() {
        var statuskey = document.getElementById("ApprovalStatus").value;
        if (statuskey == "plm_habitable") {
            $('#divComment').css("display", "block");
            $('#divCommentRequired').css("display", "none");
            $("UnitInspectionComment").prop("required", false);
        } else if (statuskey == "plm_habitable_minor_defects" || statuskey == "plm_not_habitable") {
            $('#divCommentRequired').css("display", "block");
            $('#divComment').css("display", "none");
            $("UnitInspectionComment").prop("required", true);
        }
    }
