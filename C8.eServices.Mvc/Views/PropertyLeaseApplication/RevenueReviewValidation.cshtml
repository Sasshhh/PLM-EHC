@model C8.eServices.Mvc.ViewModels.DepartmentsApprovalViewModel
@using System.Text;
@using C8.eServices.Mvc.DataAccessLayer;
@using C8.eServices.Mvc.Keys
@{
    ViewBag.Title = "Details";
    Layout = "~/Views/Shared/RCS_Layout.cshtml";
}
<head>
    <style>
        .swal-modal .swal-text {
            text-align: center;
        }
    </style>
</head>
<script src="@Url.Content( "~/Scripts/moment.js" )"></script>

<div id="bankAccountPanel">
    <div class="panel panel-default">
        <div class="panel-heading">Evaluating Application</div>
        <div style="width: 90%;margin: 0 auto;">
            <br />
            <table id="FailureTable" class="table table-bordered table-hover table-striped panel panel-default display ">
                <thead>
                    <tr>
                        <th>
                            Reference Number
                        </th>
                        <th>
                            Applicant Type
                        </th>
                        <th>
                            Status
                        </th>
                        <th>
                            Captured Date
                        </th>
                        <th>
                            Customer Name
                        </th>
                        <th>
                            Action
                        </th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>
                            @Model.PropertyLeaseApplications.ApplicationReferenceNumber
                        </td>
                        <td>
                            @if (Model.PropertyLeaseApplications.PurchaserType != null)
                            {
                                @Model.PropertyLeaseApplications.PurchaserType.Name
                            }
                        </td>
                        <td>
                            @Model.PropertyLeaseApplications.Status.Name
                        </td>
                        <td>
                            @Model.PropertyLeaseApplications.CreatedDateTime
                        </td>
                        <td>
                            @Model.PropertyLeaseApplications.Customer.FullName
                        </td>
                        <td>
                            @Html.ActionLink("View", "Details", "PropertyLeaseApplication", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("refNo=" + Model.PropertyLeaseApplications.Id.ToString()), target = "_blank" }, new { @class = "btn btn-primary", @target = "_blank" })
                        </td>
                    </tr>
                </tbody>
            </table>
            <br />
        </div>
        <div class="panel-heading">Tenant Lease Details</div>
        <div style="width: 90%;margin: 0 auto;">
            <br />
            <table id="FailureTable2" class="table table-bordered table-hover table-striped panel panel-default display ">
                <thead>
                    <tr>
                        <th>
                            Lease Reference No
                        </th>
                        <th>
                            Tenant Type
                        </th>
                        <th>
                            Status
                        </th>
                        <th>
                            Captured Date
                        </th>
                        <th>
                            Customer Name
                        </th>
                        <th>
                            Action
                        </th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>
                            @Model.LeaseDetails.LeaseReferenceNo
                        </td>
                        <td>
                            @if (Model.LeaseDetails.PurchaserType != null)
                            {
                                @Model.LeaseDetails.PurchaserType.Name
                            }
                        </td>
                        <td>
                            @Model.LeaseDetails.Status.Name
                        </td>
                        <td>
                            @Model.LeaseDetails.CreatedDateTime
                        </td>
                        <td>
                            @Model.LeaseDetails.FirstNames
                        </td>
                        <td>
                            @Html.ActionLink("View", "ApplincantDetails", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("refNo=" + Model.LeaseDetails.Id.ToString()), target = "_blank" }, new { @class = "btn btn-primary", @target = "_blank" })
                        </td>
                    </tr>

                </tbody>
            </table>
        </div>
        <br />
        <div class="panel-heading">Tenant Account Balance</div>
        <div style="width: 90%;margin: 0 auto;">
            <br />
            <table id="FailureTable" class="table table-bordered table-hover table-striped panel panel-default display ">
                <thead>
                    <tr>
                        <th>
                            Deposit Amount Paid
                        </th>
                        <th>
                            Amount Due
                        </th>

                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>
                            @Model.LeaseDetails.DepositeAmount.ToString("C")
                        </td>
                        <td>
                            @Model.LeaseDetails.TotalIncludingVAT.ToString("C")
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
        <br />
        <div class="panel-heading">Letting Offcer's Recommendation</div>
        <div style="width: 90%;margin: 0 auto;">
            <br />
            <table id="Compla" class="table table-bordered table-hover table-striped panel panel-default display ">
                <thead>
                    <tr>
                        <th>
                            Letting Officer
                        </th>
                        <th>
                            Action Comment
                        </th>
                        <th>
                            Action Date
                        </th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>
                            @ViewBag.OfficerName
                        </td>
                        <td>
                            @ViewBag.ActionComment
                        </td>
                        <td>
                            @ViewBag.DateCaptured
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
        <br />
        <div class="panel-heading">Property Managers Action</div>
        <div style="width: 90%;margin: 0 auto;">
            <br />
            <table id="Compla" class="table table-bordered table-hover table-striped panel panel-default display ">
                <thead>
                    <tr>
                        <th>
                            Managers Comment
                        </th>
                        <th>
                            Action Comment
                        </th>
                        <th>
                            Action Date
                        </th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>
                            @Model.PropertyManager.PropertyComments
                        </td>
                        <td>
                            @ViewBag.Approved
                        </td>
                        <td>
                            @Model.PropertyManager.CreatedDateTime
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
        <br />
        <br />
        <br />

        <div class="panel-heading">Uploaded Renewal Letter Document</div>
        <div style="width: 90%;margin: 0 auto;">
            @Html.Partial("_DocumentsPartialRenewalLetter", Model.DocumentsViewModel)
        </div>
        <br />

        <div style="width: 90%;margin: 0 auto;">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <br />

                if (ViewBag.ApprovalStatus != null)
                {
                    <div class="form-group">
                        @Html.Label("Outcome", htmlAttributes: new { @class = "control-label col-md-1" })
                        <div class="col-md-2">
                            @Html.DropDownList("ApprovalStatus", null, "-- Select Option --", htmlAttributes: new
                            {
                                @class = "form-control",@*onclick = "ChangeStatus()",*@ @Name = "ApprovalStatus",
                                @required = "required",
                                @Id = "ApprovalStatus"
                            })
                            @Html.ValidationMessage("ApprovalStatus", "", new { @class = "text-danger" })
                        </div>
                    </div>
                }

                <br />
                <br />
                <div class="form-group">
                    <div id="divComment" style="display:block">
                        <div class="form-group">
                            <span>@Html.Label("Managers Comment", htmlAttributes: new { @class = "control-label col-md-1" })<b style="color:red; font-size:x-large;">*</b></span>
                            <div class="col-md-4">
                                @Html.TextArea("RejectComment", new { @class = "form-control", @Id = "Comments", @required = "required" })
                                @Html.ValidationMessage("RejectComment", "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <br />
                        <br />
                        <br />
                    </div>

                </div>
                <br />
                <br />

                <div id="divbtn" style="display:block">
                    <input type="button" value="Submit" name="btnApproval" onclick="clickSubmit()" class="button1" />
                    <input type="submit" value="Submit" style="display:none;" hidden name="btnApprovalStatus" class="button1" id="btnApproval" />
                    <br />
                    <br />
                    <br />
                </div>
            }
        </div>
    </div>
</div>


@section Scripts{

    <script src="@Url.Content( " ~ /scripts/Datatables/jquery.dataTables.min.js" )"></script>
    <script src="@Url.Content( " ~ /scripts/Datatables/dataTables.bootstrap.js" )"></script>

    <script type="text/javascript">
        $(function () {
            $('#FailureTable2').dataTable;
           /* $('#Compla').dataTable;*/
        });
        function loadAccounts() {
            //debugger;

            $('#FailureTable').DataTable({
                "ajax": {
                    "url": "@Url.Action( "LoadDetails", "DepartmentsApprovals" )",
                    "type": "GET",
                    "datatype": "json",
                    "timeout": 60000
                },
                "columns": [

                    {
                        "data": "CreatedDateTime", "autoWidth": true,
                        "render": function (data) {
                            return convertDate(data);
                        }
                    },
                    {
                        "render": function (data) {
                            return "System";
                        }
                    },
                    { "data": "FailureReason", "autoWidth": true },
                    {
                        "data": "CapturedDate", "autoWidth": true,
                        "render": function (data) {
                            return convertDate(data);
                        }
                    },

                    { "data": "AssignedTo", "autoWidth": true }],
                "language": {
                    "emptyTable": "No Data.",
                },
                "Initcomplete": "",
                "destroy": true
            });
            $('#Compla').DataTable({
                "ajax": {
                    "url": "@Url.Action( "LoadDetails", "DepartmentsApprovals" )",
                    "type": "GET",
                    "datatype": "json",
                    "timeout": 60000
                },
                "columns": [

                    {
                        "data": "CreatedDateTime", "autoWidth": true,
                        "render": function (data) {
                            return convertDate(data);
                        }
                    },
                    {
                        "render": function (data) {
                            return "System";
                        }
                    },
                    { "data": "FailureReason", "autoWidth": true },
                    {
                        "data": "CapturedDate", "autoWidth": true,
                        "render": function (data) {
                            return convertDate(data);
                        }
                    },

                    { "data": "AssignedTo", "autoWidth": true }],
                "language": {
                    "emptyTable": "No Data.",
                },
                "Initcomplete": "",
                "destroy": true
            });

            $('#FailureTable2').DataTable({
                "ajax": {
                    "url": "@Url.Action( "LoadDetails", "DepartmentsApprovals" )",
                    "type": "GET",
                    "datatype": "json",
                    "timeout": 60000
                },
                "columns": [

                    {
                        "data": "CreatedDateTime", "autoWidth": true,
                        "render": function (data) {
                            return convertDate(data);
                        }
                    },
                    {
                        "render": function (data) {
                            return "System";
                        }
                    },
                    { "data": "FailureReason", "autoWidth": true },
                    {
                        "data": "CapturedDate", "autoWidth": true,
                        "render": function (data) {
                            return convertDate(data);
                        }
                    },

                    { "data": "AssignedTo", "autoWidth": true }],
                "language": {
                    "emptyTable": "No Data.",
                },
                "Initcomplete": "",
                "destroy": true
            });
        }

        function convertDate(data) {
            try {
                var dtStart = new Date(parseInt(data.substr(6)));
                var dtStartWrapper = moment(dtStart);
                return dtStartWrapper.format("YYYY-MM-DD");
            }
            catch (ex) {
            }
        }

        $(function () {
            $('#RCSTable').DataTable();

        });

    </script>

}

