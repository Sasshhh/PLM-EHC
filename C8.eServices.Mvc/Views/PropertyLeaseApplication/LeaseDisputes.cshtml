@using C8.eServices.Mvc.Keys
@{
    Layout = "~/Views/Shared/RCS_Layout.cshtml";
    ViewBag.Title = "Lease Disputes — UC026";
    var disputes = ViewBag.Disputes as List<C8.eServices.Mvc.Models.LeaseDispute> ?? new List<C8.eServices.Mvc.Models.LeaseDispute>();
}
<head>
    <style>
        .swal-modal .swal-text { text-align: center; }
        .plm-section-heading { background-color: #2c3e50; color: #fff; padding: 10px 15px; font-weight: bold; border-radius: 3px 3px 0 0; }
        .badge-open { background-color: #f39c12; color: #fff; padding: 3px 8px; border-radius: 3px; }
        .badge-referred { background-color: #3498db; color: #fff; padding: 3px 8px; border-radius: 3px; }
        .badge-resolved { background-color: #27ae60; color: #fff; padding: 3px 8px; border-radius: 3px; }
        .badge-closed { background-color: #95a5a6; color: #fff; padding: 3px 8px; border-radius: 3px; }
    </style>
</head>

<div id="bankAccountPanel">
    <div class="panel panel-default">
        <div class="panel-heading">
            <strong><i class="fa fa-gavel"></i> Lease Dispute Management</strong>
        </div>
        <div style="width:95%;margin:0 auto;">
            <br />
            @if (ViewBag.SessionMessage != null)
            {
                <div class="alert alert-success alert-dismissible" role="alert">
                    <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
                    <strong>Success!</strong> @ViewBag.SessionMessage
                </div>
            }

            <table id="tblDisputes" class="table table-bordered table-hover table-striped panel panel-default display">
                <thead>
                    <tr>
                        <th>Dispute Ref</th>
                        <th>Category</th>
                        <th>Reported By</th>
                        <th>Risk</th>
                        <th>Status</th>
                        <th>Created</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in disputes)
                    {
                        var statusKey = (d.Status != null) ? d.Status.Key : "";
                        var badgeClass = statusKey == StatusKeys.DisputeOpenAwaitingReview ? "badge-open"
                            : statusKey == StatusKeys.DisputeReferred ? "badge-referred"
                            : statusKey == StatusKeys.DisputeResolved ? "badge-resolved"
                            : "badge-closed";
                        <tr>
                            <td>@d.DisputeReferenceNumber</td>
                            <td>@d.Category</td>
                            <td>@d.ReportedByName</td>
                            <td>@(d.RiskClassification ?? "—")</td>
                            <td><span class="@badgeClass">@(d.Status != null ? d.Status.Name : "N/A")</span></td>
                            <td>@(d.CreatedDateTime.HasValue ? d.CreatedDateTime.Value.ToString("yyyy/MM/dd") : "")</td>
                            <td>
                                @if (statusKey == StatusKeys.DisputeOpenAwaitingReview)
                                {
                                    @Html.ActionLink("Review", "ReviewLeaseDispute", "PropertyLeaseApplication", new { q = d.Data }, new { @class = "btn btn-warning btn-sm" })
                                }
                                else if (statusKey == StatusKeys.DisputeReferred)
                                {
                                    @Html.ActionLink("Resolve", "ResolveLeaseDispute", "PropertyLeaseApplication", new { q = d.Data }, new { @class = "btn btn-success btn-sm" })
                                }
                                else if (statusKey == StatusKeys.DisputeResolved)
                                {
                                    @Html.ActionLink("Close", "CloseLeaseDispute", "PropertyLeaseApplication", new { q = d.Data }, new { @class = "btn btn-primary btn-sm" })
                                }
                                else
                                {
                                    <span class="text-muted">Closed</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts{
    <script src="@Url.Content("~/scripts/Datatables/jquery.dataTables.min.js")"></script>
    <script src="@Url.Content("~/scripts/Datatables/dataTables.bootstrap.js")"></script>
}
<script>
    $(document).ready(function () {
        $('#tblDisputes').DataTable({ responsive: true, order: [[5, "desc"]] });
    });
</script>
