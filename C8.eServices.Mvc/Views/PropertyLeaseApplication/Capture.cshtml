<script>
    (function ($) {
        $(function () {
            // --- Helper to ensure legacy id-only hidden fields exist and are synced ---
            function ensureLegacyNameFields() {
                if (!$('#Name').length) $('<input>').attr({ type: 'hidden', id: 'Name', name: 'Name' }).appendTo('#clientInfo-form');
                if (!$('#LastName').length) $('<input>').attr({ type: 'hidden', id: 'LastName', name: 'LastName' }).appendTo('#clientInfo-form');
                // initial copy
                $('#Name').val($('#PurchaserInformation_FirstName').val() || '');
                $('#LastName').val($('#PurchaserInformation_LastName').val() || '');
                // keep in sync if values change
                $('#PurchaserInformation_FirstName, #PurchaserInformation_LastName').on('input change', function () {
                    $('#Name').val($('#PurchaserInformation_FirstName').val() || '');
                    $('#LastName').val($('#PurchaserInformation_LastName').val() || '');
                });
            }

            // --- Sync selects to their HiddenFor fields ---
            function syncSelectToHidden(selectSelectors, hiddenSelector) {
                var $sel = $(selectSelectors).first();
                var $hid = $(hiddenSelector);
                if (!$hid.length) return;
                if ($sel.length) {
                    $hid.val($sel.val());
                    $sel.on('change input', function () { $hid.val($sel.val()); });
                }
            }

            // initial setup
            ensureLegacyNameFields();

            // selectors used in the view
            syncSelectToHidden('select[name="PropertyLeaseApplication.Gender"], #Genderr, #Gender', '#GenderHidden');
            syncSelectToHidden('select[name="PropertyLeaseApplication.TitleTypeId"], #TitleTyperr, #TitleType', '#TitleTypeHidden');
            syncSelectToHidden('select[name="PropertyLeaseApplication.IdentificationTypeId"], #IdentificationType, #PurchaserInformation_Nationality', '#IdentificationTypeHidden');

            // final sync before submit
            $('#clientInfo-form').on('submit', function () {
                var idVal = $('#IdentityNumber').val();
                if (typeof idVal !== 'undefined') $('#PropertyLeaseApplication_IDNo').val(idVal);


                var g = $('select[name="PropertyLeaseApplication.Gender"], #Genderr, #Gender').val();
                if (typeof g !== 'undefined') $('#GenderHidden').val(g);

                var t = $('select[name="PropertyLeaseApplication.TitleTypeId"], #TitleTyperr, #TitleType').val();
                if (typeof t !== 'undefined') $('#TitleTypeHidden').val(t);

                var idt = $('select[name="PropertyLeaseApplication.IdentificationTypeId"], #IdentificationType, #PurchaserInformation_Nationality').val();
                if (typeof idt !== 'undefined') $('#IdentificationTypeHidden').val(idt);

                // legacy name fields
                $('#Name').val($('#PurchaserInformation_FirstName').val() || '');
                $('#LastName').val($('#PurchaserInformation_LastName').val() || '');
            });
        });
    })(jQuery);
</script>

<script>
        (function () {
            // ensure any programmatic .val(...) updates are reflected immediately in legacy hidden fields
            var first = document.getElementById('PurchaserInformation_FirstName');
            var last = document.getElementById('PurchaserInformation_LastName');
            function updateHidden() {
                var $f = $('#PurchaserInformation_FirstName'), $l = $('#PurchaserInformation_LastName');
                $('#Name').val($f.val() || '');
                $('#LastName').val($l.val() || '');
            }
            // observe attribute/value changes (fires when code uses setAttribute or mutations)
            if (window.MutationObserver && first && last) {
                var obs = new MutationObserver(updateHidden);
                obs.observe(first, { attributes: true, attributeFilter: ['value'] });
                obs.observe(last, { attributes: true, attributeFilter: ['value'] });
            }
            // fallback: poll lightly (1000ms) — harmless and cheap
            setInterval(updateHidden, 1000);
            // expose for manual calls where you set values programmatically:
            window.updateLegacyNameFields = updateHidden;
        })();


 
$(document).ready(function () {

        // Helper: Parse user input like "2 Years", "6 Months" into TOTAL MONTHS
        function parsePeriodToMonths(periodString) {
            if (!periodString) return 0;

            var totalMonths = 0;
            var cleanString = periodString.toLowerCase();

            // Check for Years
            if (cleanString.includes("year") || cleanString.includes("yr")) {
                var years = parseFloat(cleanString.match(/[\d\.]+/));
                if (!isNaN(years)) totalMonths += (years * 12);
            }

            // Check for Months
            if (cleanString.includes("month")) {
                var months = parseFloat(cleanString.match(/[\d\.]+/));
                if (!isNaN(months) && !cleanString.includes("year")) {
                     totalMonths += months;
                }
            }

            // Fallback: If just a number is entered, assume YEARS
            if (totalMonths === 0) {
                 var val = parseFloat(cleanString);
                 if (!isNaN(val)) totalMonths = val * 12;
            }

            return totalMonths;
        }

        // Function to calculate months difference between now and a past date
        function getMonthsSince(dateString) {
            var today = new Date();
            var pastDate = new Date(dateString);

            if (isNaN(pastDate.getTime())) return 0;

            var months;
            months = (today.getFullYear() - pastDate.getFullYear()) * 12;
            months -= pastDate.getMonth();
            months += today.getMonth();
            return months <= 0 ? 0 : months;
        }

        // The Validator Function
        function validatePeriodWorking() {
            // Selector uses name attribute to avoid issues with dots in IDs
            var dateOccInput = $("[name='PropertyLeaseApplication.DateOfOccupation']");
            var periodInput = $("[name='PropertyLeaseApplication.PresentEmployerPeriodWorking']");

            var dateVal = dateOccInput.val();
            var periodVal = periodInput.val();

            if (!dateVal || !periodVal) return;

            // Calculate Limits
            var maxPossibleMonths = getMonthsSince(dateVal);
            var userMonths = parsePeriodToMonths(periodVal);

            // Compare (Strict check)
            if (userMonths > maxPossibleMonths) {

                swal({
                    title: "Invalid Period",
                    text: "Period Working cannot be greater than the time since Date Of Occupation (" + (maxPossibleMonths/12).toFixed(1) + " Years).",
                    icon: "error",
                    button: "OK",
                });

                periodInput.val(''); // Clear the field
            }
        }

        // Attach Event Listeners
        $("[name='PropertyLeaseApplication.PresentEmployerPeriodWorking']").on('change blur', validatePeriodWorking);
        $("[name='PropertyLeaseApplication.DateOfOccupation']").on('change blur', validatePeriodWorking);

});

</script>