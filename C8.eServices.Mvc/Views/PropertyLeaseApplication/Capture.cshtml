                // Optional: Remove read-only
                // $('#SecAppAddress, #SecAppSuburb, #SecAppPostal').removeAttr('readonly');
            }
        });
        // --- END: Same Address Logic ---

        // --- START: Preferred Area Dynamic Logic ---

        // 1. Store the original full list of options from the second dropdown
        var $optionsOption2 = $('#ddlPrefArea2').find('option').clone();

        // 2. Listen for changes on Option 1
        $('#ddlPrefArea1').change(function () {
            var selectedValue1 = $(this).val();
            var currentSelection2 = $('#ddlPrefArea2').val();

            // 3. Reset Option 2 to contain ALL original options
            $('#ddlPrefArea2').empty().append($optionsOption2.clone());

            // 4. If a value is selected in Option 1, remove it from Option 2
            if (selectedValue1) {
                $('#ddlPrefArea2').find('option[value="' + selectedValue1 + '"]').remove();
            }

            // 5. If Option 2 had a value selected, try to keep it. 
            // If that value was the one just removed, reset Option 2 to blank.
            if (currentSelection2 && currentSelection2 !== selectedValue1) {
                $('#ddlPrefArea2').val(currentSelection2);
            } else {
                $('#ddlPrefArea2').val(''); // Reset to "--Select Option--"
            }
        });

        // --- END: Preferred Area Dynamic Logic ---
