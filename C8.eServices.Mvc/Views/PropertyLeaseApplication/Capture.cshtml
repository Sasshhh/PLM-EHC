    function isNumber(evt) {
        evt = (evt) ? evt : window.event;
        var charCode = (evt.which) ? evt.which : evt.keyCode;
        if (charCode > 31 && (charCode < 48 || charCode > 57)) {
            return false;
        }
        return true;

        var grosincome = document.getElementById("ElectricityMeterInformation_ElectricityMeterType").value;
        var netIncome = document.getElementById("ElectricityMeterInformation_ElectricityMeterType").value;
    }

    function isMaxNumber(evt) {
        evt = evt || window.event;
        var charCode = evt.which || evt.keyCode;
        var input = evt.target.value + String.fromCharCode(charCode);

        // Check if the input is a valid number
        if (/^\d+$/.test(input)) {
            // Check if the number is greater than 6 digits
            if (input.length > 8) {
                // Send alert and return false
                //alert("Number is greater than 6 digits!");
                swal("Error!", "Expense amount cannot be greater than 8 digits!!", "error");
                return false;
            } else {
                // Number is valid and less than or equal to 6 digits
                return true;
            }
        } else {
            // Input is not a valid number
            return false;
        }
    }


