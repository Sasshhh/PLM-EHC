@model C8.eServices.Mvc.ViewModels.DepartmentsApprovalViewModel
@using C8.eServices.Mvc.Keys
@{
    Layout = "~/Views/Shared/RCS_Layout.cshtml";
}
<head>
    <style>
        .swal-modal .swal-text { text-align: center; }
    </style>
</head>
<script src="@Url.Content("~/Scripts/moment.js")"></script>

<div id="bankAccountPanel">
    <div class="panel panel-default">

        @* ── Section 1: Application Info ── *@
        <div class="panel-heading">Evaluating Application</div>
        <div style="width: 90%;margin: 0 auto;">
            <br />
            <table class="table table-bordered table-hover table-striped panel panel-default display">
                <thead>
                    <tr>
                        <th>Reference Number</th>
                        <th>Applicant Type</th>
                        <th>Status</th>
                        <th>Application Date</th>
                        <th>Applicant Name</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>@(Model.PropertyLeaseApplications != null ? Model.PropertyLeaseApplications.ApplicationReferenceNumber : "")</td>
                        <td>@(Model.PropertyLeaseApplications != null && Model.PropertyLeaseApplications.PurchaserType != null ? Model.PropertyLeaseApplications.PurchaserType.Name : "N/A")</td>
                        <td>@(Model.PropertyLeaseApplications != null && Model.PropertyLeaseApplications.Status != null ? Model.PropertyLeaseApplications.Status.Name : "N/A")</td>
                        <td>@(Model.PropertyLeaseApplications != null ? Model.PropertyLeaseApplications.CreatedDateTime.ToString() : "")</td>
                        <td>@(Model.PropertyLeaseApplications != null && Model.PropertyLeaseApplications.Customer != null ? Model.PropertyLeaseApplications.Customer.FullName : "")</td>
                        <td>
                            @if (Model.PropertyLeaseApplications != null)
                            {
                                @Html.ActionLink("View", "Details", "PropertyLeaseApplication", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("refNo=" + Model.PropertyLeaseApplications.Id.ToString()), target = "_blank" }, new { @class = "btn btn-primary", @target = "_blank" })
                            }
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <br />

        @* ── Section 2: Lease Details ── *@
        <div class="panel-heading">Tenant Lease Details</div>
        <div style="width: 90%;margin: 0 auto;">
            <br />
            <table class="table table-bordered table-hover table-striped panel panel-default display">
                <thead>
                    <tr>
                        <th>Lease Ref No.</th>
                        <th>Applicant Type</th>
                        <th>Status</th>
                        <th>Captured Date</th>
                        <th>Tenant Name</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>@(Model.LeaseDetails != null ? Model.LeaseDetails.LeaseReferenceNo : "")</td>
                        <td>@(Model.LeaseDetails != null && Model.LeaseDetails.PurchaserType != null ? Model.LeaseDetails.PurchaserType.Name : "N/A")</td>
                        <td>@(Model.LeaseDetails != null && Model.LeaseDetails.Status != null ? Model.LeaseDetails.Status.Name : "N/A")</td>
                        <td>@(Model.LeaseDetails != null ? Model.LeaseDetails.CreatedDateTime.ToString() : "")</td>
                        <td>@(Model.LeaseDetails != null ? Model.LeaseDetails.FirstNames + " " + Model.LeaseDetails.LastName : "")</td>
                        <td>
                            @if (Model.LeaseDetails != null)
                            {
                                @Html.ActionLink("View", "ApplincantDetails", "LeaseDetails", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("refNo=" + Model.LeaseDetails.Id.ToString()), target = "_blank" }, new { @class = "btn btn-primary", @target = "_blank" })
                            }
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <br />

        @* ── Section 3: Termination Details ── *@
        <div class="panel-heading">Termination Details</div>
        <div style="width: 90%;margin: 0 auto;">
            <br />
            <table class="table table-bordered table-hover table-striped panel panel-default display">
                <thead>
                    <tr>
                        <th>Termination Date</th>
                        <th>Reason For Termination</th>
                        <th>Captured Date</th>
                        <th>Terminated By</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>@ViewBag.TerminationDate</td>
                        <td>@ViewBag.TerminationReason</td>
                        <td>@(Model.LeaseTermination != null ? Model.LeaseTermination.CreatedDateTime.ToString() : "")</td>
                        <td>@(Model.Customer != null ? Model.Customer.FullName : "")</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <br />

        @* ── Section 4: CSO Review Decision ── *@
        <div class="panel-heading">CSO Review Decision</div>
        <div style="width: 90%;margin: 0 auto;">
            @using (Html.BeginForm("TerminationCSOReviewDetails", "PropertyLeaseApplication", FormMethod.Post, new { id = "csoReviewForm", enctype = "multipart/form-data" }))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@(Model.LeaseDetails != null ? Model.LeaseDetails.Id : 0)" />
                <br />

                <div class="form-horizontal">
                    <div class="form-group">
                        @Html.Label("Official Number", htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-3">
                            <input type="text" name="OfficialNumber" id="OfficialNumber" class="form-control" placeholder="Enter official number" />
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.Label("Action", htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-3">
                            @Html.DropDownList("ApprovalStatusddl", (SelectList)ViewBag.ApprovalStatus, "-- Select Action --", new { @class = "form-control", @id = "ApprovalStatusddl", @required = "required" })
                        </div>
                    </div>

                    <div id="rejectReasonDiv" style="display:none;">
                        <div class="form-group">
                            @Html.Label("Comments / Reason", htmlAttributes: new { @class = "control-label col-md-2" })
                            <div class="col-md-6">
                                <textarea name="RejectComment" id="RejectComment" class="form-control" rows="3" placeholder="Enter your comments here..."></textarea>
                            </div>
                        </div>
                    </div>
                </div>

                <br />
                <div class="col-md-offset-2">
                    <button type="button" id="btnSubmitReview" class="btn btn-success" onclick="clickSubmit()">Submit Review</button>
                    &nbsp;
                    @Html.ActionLink("Cancel", "PropertyLeaseApplicationTerminations", "PropertyLeaseApplication", null, new { @class = "btn btn-default" })
                    <br /><br /><br />
                </div>
            }
        </div>
    </div>
</div>

@section Scripts{
    <script src="@Url.Content("~/scripts/Datatables/jquery.dataTables.min.js")"></script>
    <script src="@Url.Content("~/scripts/Datatables/dataTables.bootstrap.js")"></script>
}

<script type="text/javascript">
    function clickSubmit() {
        swal({
            icon: "info",
            title: "Are you sure you want to submit this termination review?",
            buttons: ['No!', 'Yes, I am sure!']
        }).then(function (isConfirm) {
            if (isConfirm) {
                var statuskey = document.getElementById('ApprovalStatusddl').value;
                var comment = document.getElementById('RejectComment').value;
                if (statuskey === '') {
                    swal("Error", "Please select an action", "warning");
                } else if (statuskey === '@RCSActionTypeKeys.Rejected' && (comment == null || comment === '')) {
                    swal("Error", "Please enter reason for not supporting termination", "warning");
                } else {
                    document.getElementById('csoReviewForm').submit();
                }
            }
        });
    }

    $(document).ready(function () {
        $('#ApprovalStatusddl').change(function () {
            var selectedValue = $(this).val();
            if (selectedValue === '@RCSActionTypeKeys.Rejected') {
                $('#rejectReasonDiv').show();
            } else {
                $('#rejectReasonDiv').hide();
            }
        });
    });
</script>
