@model C8.eServices.Mvc.ViewModels.DepartmentsApprovalViewModel
@using C8.eServices.Mvc.Keys
@{
    Layout = "~/Views/Shared/RCS_Layout.cshtml";
    ViewBag.Title = "Resolve Lease Dispute — UC26C-S1";
    var app = ViewBag.Application as C8.eServices.Mvc.Models.PropertyLeaseApplication;
    var lease = ViewBag.Lease as C8.eServices.Mvc.Models.LeaseDetails;
    var dispute = ViewBag.Dispute as C8.eServices.Mvc.Models.LeaseDispute;
}
<head><style>.swal-modal .swal-text { text-align: center; }</style></head>

<div id="bankAccountPanel">
    <div class="panel panel-default">
        <div class="panel-heading">Application Information</div>
        <div style="width:90%;margin:0 auto;">
            <br />
            <table class="table table-bordered table-hover table-striped panel panel-default display">
                <thead><tr><th>Reference Number</th><th>Status</th><th>Application Date</th><th>Applicant Name</th><th>Action</th></tr></thead>
                <tbody><tr>
                    <td>@(app != null ? app.ApplicationReferenceNumber : "")</td>
                    <td>@(app != null && app.Status != null ? app.Status.Name : "N/A")</td>
                    <td>@(app != null && app.CreatedDateTime.HasValue ? app.CreatedDateTime.Value.ToString("yyyy/MM/dd") : "")</td>
                    <td>@(app != null && app.Customer != null ? app.Customer.FullName : "")</td>
                    <td>@Html.ActionLink("View", "Details", "PropertyLeaseApplication", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("refNo=" + (app != null ? app.Id : 0)) }, new { @class = "btn btn-primary btn-sm", @target = "_blank" })</td>
                </tr></tbody>
            </table>
        </div><br />

        <div class="panel-heading">Tenant Lease Details</div>
        <div style="width:90%;margin:0 auto;">
            <br />
            <table class="table table-bordered table-hover table-striped panel panel-default display">
                <thead><tr><th>Lease Ref No.</th><th>Status</th><th>Captured Date</th><th>Tenant Name</th><th>Action</th></tr></thead>
                <tbody>
                    <tr>
                        <td>@(lease != null ? lease.LeaseReferenceNo : "")</td>
                        <td>@(lease != null && lease.Status != null ? lease.Status.Name : "N/A")</td>
                        <td>@(lease != null && lease.CreatedDateTime.HasValue ? lease.CreatedDateTime.Value.ToString("yyyy/MM/dd") : "")</td>
                        <td>@(lease != null ? lease.FirstNames : "") @(lease != null ? lease.LastName : "")</td>
                        <td>@Html.ActionLink("View", "ApplincantDetails", "LeaseDetails", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("refNo=" + (lease != null ? lease.Id : 0)) }, new { @class = "btn btn-primary btn-sm", @target = "_blank" })</td>
                    </tr>
                </tbody>
            </table>
        </div><br />

        <div class="panel-heading">Dispute Details</div>
        <div style="width:90%;margin:0 auto;">
            <br />
            <table class="table table-bordered table-hover table-striped panel panel-default display">
                <thead><tr><th>Dispute Ref</th><th>Category</th><th>Risk</th><th>Review Comment</th></tr></thead>
                <tbody><tr>
                    <td>@(dispute != null ? dispute.DisputeReferenceNumber : "")</td><td>@(dispute != null ? dispute.Category : "")</td><td>@(dispute != null ? dispute.RiskClassification : "")</td><td>@(dispute != null ? dispute.ReviewComment : "")</td>
                </tr></tbody>
            </table>
            <div class="well"><strong>Description:</strong><br />@(dispute != null ? dispute.Description : "")</div>
        </div><br />

        <div class="panel-heading">Revenue Manager Resolution</div>
        <div style="width:90%;margin:0 auto;">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                <br />
                @Html.Hidden("id", dispute != null ? dispute.Id : 0)
                <div class="form-horizontal">
                    <div class="form-group">
                        @Html.Label("Decision", htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-3">
                            <select name="ApprovalStatusddl" class="form-control" required id="ApprovalStatusddl">
                                <option value="">-- Select --</option>
                                <option value="@RCSActionTypeKeys.Approved">Resolved</option>
                                <option value="@RCSActionTypeKeys.Rejected">Not Resolved</option>
                            </select>
                        </div>
                    </div>
                    <div id="divResolved" style="display:none">
                        <div class="form-group">
                            @Html.Label("Resolution Type", htmlAttributes: new { @class = "control-label col-md-2" })
                            <div class="col-md-4">
                                <select name="ResolutionOutcomeType" class="form-control">
                                    <option value="">-- Select --</option>
                                    <option value="Mutual settlement">Mutual settlement</option>
                                    <option value="Lease amendment">Lease amendment</option>
                                    <option value="Billing correction">Billing correction</option>
                                    <option value="Compliance directive">Compliance directive</option>
                                    <option value="Maintenance resolution">Maintenance resolution</option>
                                    <option value="Formal mediation">Formal mediation</option>
                                    <option value="Withdrawal by complainant">Withdrawal by complainant</option>
                                </select>
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.Label("Resolution Summary", htmlAttributes: new { @class = "control-label col-md-2" })
                            <div class="col-md-6"><textarea name="ResolutionSummary" class="form-control" rows="3" placeholder="Describe the resolution..."></textarea></div>
                        </div>
                    </div>
                    <div id="divNotResolved" style="display:none">
                        <div class="form-group">
                            @Html.Label("Reason", htmlAttributes: new { @class = "control-label col-md-2" })
                            <div class="col-md-6"><textarea name="NotResolvedReason" class="form-control" rows="3" placeholder="Why was the dispute not resolved?"></textarea></div>
                        </div>
                    </div>
                </div>
                <br />
                <div class="col-md-offset-2">
                    <input type="button" value="Submit" onclick="clickSubmit()" class="button1" />
                    <input type="submit" value="Submit" style="display:none;" hidden id="btnApproval" />
                    <br /><br /><br />
                </div>
            }
        </div>
    </div>
</div>

@section Scripts{
    <script src="@Url.Content("~/scripts/Datatables/jquery.dataTables.min.js")"></script>
    <script src="@Url.Content("~/scripts/Datatables/dataTables.bootstrap.js")"></script>
}
<script>
    $(document).ready(function () {
        $('#ApprovalStatusddl').change(function () {
            var v = $(this).val();
            $('#divResolved').toggle(v === '@RCSActionTypeKeys.Approved');
            $('#divNotResolved').toggle(v === '@RCSActionTypeKeys.Rejected');
        });
    });
    function clickSubmit() {
        var dec = document.getElementById('ApprovalStatusddl').value;
        if (!dec) { swal("Error", "Please select a decision", "warning"); return; }
        swal({ icon: "info", title: "Confirm Resolution Decision?", buttons: ['No!', 'Yes, submit!'] })
            .then(function (c) { if (c) document.getElementById("btnApproval").click(); });
    }
</script>
