@model C8.eServices.Mvc.ViewModels.DepartmentsApprovalViewModel
@using C8.eServices.Mvc.Keys
@{
    Layout = "~/Views/Shared/RCS_Layout.cshtml";
    ViewBag.Title = "Review Lease Dispute — UC26B";
    var app = ViewBag.Application as C8.eServices.Mvc.Models.PropertyLeaseApplication;
    var lease = ViewBag.Lease as C8.eServices.Mvc.Models.LeaseDetails;
    var dispute = ViewBag.Dispute as C8.eServices.Mvc.Models.LeaseDispute;
}
<head><style>.swal-modal .swal-text { text-align: center; }</style></head>

<div id="bankAccountPanel">
    <div class="panel panel-default">
        <div class="panel-heading">Application Information</div>
        <div style="width:90%;margin:0 auto;">
            <br />
            <table class="table table-bordered table-hover table-striped panel panel-default display">
                <thead><tr><th>Reference Number</th><th>Status</th><th>Application Date</th><th>Applicant Name</th><th>Action</th></tr></thead>
                <tbody><tr>
                    <td>@(app != null ? app.ApplicationReferenceNumber : "")</td>
                    <td>@(app != null && app.Status != null ? app.Status.Name : "N/A")</td>
                    <td>@(app != null && app.CreatedDateTime.HasValue ? app.CreatedDateTime.Value.ToString("yyyy/MM/dd") : "")</td>
                    <td>@(app != null && app.Customer != null ? app.Customer.FullName : "")</td>
                    <td>@Html.ActionLink("View", "Details", "PropertyLeaseApplication", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("refNo=" + (app != null ? app.Id : 0)) }, new { @class = "btn btn-primary btn-sm", @target = "_blank" })</td>
                </tr></tbody>
            </table>
        </div><br />

        <div class="panel-heading">Tenant Lease Details</div>
        <div style="width:90%;margin:0 auto;">
            <br />
            <table class="table table-bordered table-hover table-striped panel panel-default display">
                <thead><tr><th>Lease Ref No.</th><th>Status</th><th>Captured Date</th><th>Tenant Name</th><th>Action</th></tr></thead>
                <tbody>
                    <tr>
                        <td>@(lease != null ? lease.LeaseReferenceNo : "")</td>
                        <td>@(lease != null && lease.Status != null ? lease.Status.Name : "N/A")</td>
                        <td>@(lease != null && lease.CreatedDateTime.HasValue ? lease.CreatedDateTime.Value.ToString("yyyy/MM/dd") : "")</td>
                        <td>@(lease != null ? lease.FirstNames : "") @(lease != null ? lease.LastName : "")</td>
                        <td>@Html.ActionLink("View", "ApplincantDetails", "LeaseDetails", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("refNo=" + (lease != null ? lease.Id : 0)) }, new { @class = "btn btn-primary btn-sm", @target = "_blank" })</td>
                    </tr>
                </tbody>
            </table>
        </div><br />

        <div class="panel-heading">Dispute Details</div>
        <div style="width:90%;margin:0 auto;">
            <br />
            <table class="table table-bordered table-hover table-striped panel panel-default display">
                <thead><tr><th>Dispute Ref</th><th>Category</th><th>Sub-Category</th><th>Reported By</th><th>Created</th></tr></thead>
                <tbody><tr>
                    <td>@(dispute != null ? dispute.DisputeReferenceNumber : "")</td><td>@(dispute != null ? dispute.Category : "")</td><td>@(dispute != null ? dispute.SubCategory : "")</td>
                    <td>@(dispute != null ? dispute.ReportedByName : "")</td><td>@(dispute != null && dispute.CreatedDateTime.HasValue ? dispute.CreatedDateTime.Value.ToString("yyyy/MM/dd") : "")</td>
                </tr></tbody>
            </table>
            <div class="well"><strong>Description:</strong><br />@(dispute != null ? dispute.Description : "")</div>
        </div><br />

        <div class="panel-heading">CSO Review</div>
        <div style="width:90%;margin:0 auto;">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                <br />
                @Html.Hidden("id", dispute != null ? dispute.Id : 0)
                <div class="form-horizontal">
                    <div class="form-group">
                        @Html.Label("Risk Classification", htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-4">
                            <select name="RiskClassification" class="form-control" required id="RiskClassification">
                                <option value="">-- Select Risk --</option>
                                <option value="Low">Low</option>
                                <option value="Medium">Medium</option>
                                <option value="High">High</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-group">
                        @Html.Label("Official No.", htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-4"><input type="text" name="OfficialNumber" class="form-control" placeholder="CSO Reference" /></div>
                    </div>
                    <div class="form-group">
                        @Html.Label("Review Comment", htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-6"><textarea name="ReviewComment" class="form-control" rows="3" required placeholder="Assessment and next steps..."></textarea></div>
                    </div>
                </div>
                <br />
                <div class="col-md-offset-2">
                    <input type="button" value="Submit Review" onclick="clickSubmit()" class="button1" />
                    <input type="submit" value="Submit" style="display:none;" hidden id="btnApproval" />
                    <br /><br /><br />
                </div>
            }
        </div>
    </div>
</div>

@section Scripts{
    <script src="@Url.Content("~/scripts/Datatables/jquery.dataTables.min.js")"></script>
    <script src="@Url.Content("~/scripts/Datatables/dataTables.bootstrap.js")"></script>
}
<script>
    function clickSubmit() {
        var risk = document.getElementById('RiskClassification').value;
        if (!risk) { swal("Error", "Please select a risk classification", "warning"); return; }
        swal({ icon: "info", title: "Submit Review?", text: "Risk: " + risk, buttons: ['No!', 'Yes, submit!'] })
            .then(function (c) { if (c) document.getElementById("btnApproval").click(); });
    }
</script>
