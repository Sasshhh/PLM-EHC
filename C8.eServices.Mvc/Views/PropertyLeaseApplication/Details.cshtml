                                                                    tenantCtx = tenantCanvas.getContext('2d');
                                                                    tenantCtx.strokeStyle = "#000";
                                                                    tenantCtx.lineWidth = 2;
                                                                    tenantCtx.clearRect(0, 0, tenantCanvas.width, tenantCanvas.height);

                                                                    tenantCanvas.addEventListener('mousedown', function (e) {
                                                                        isDrawingTenant = true;
                                                                        tenantCtx.beginPath();
                                                                        var rect = tenantCanvas.getBoundingClientRect();
                                                                        tenantCtx.moveTo(e.clientX - rect.left, e.clientY - rect.top);
                                                                    });

                                                                    tenantCanvas.addEventListener('mousemove', function (e) {
                                                                        if (!isDrawingTenant) return;
                                                                        var rect = tenantCanvas.getBoundingClientRect();
                                                                        tenantCtx.lineTo(e.clientX - rect.left, e.clientY - rect.top);
                                                                        tenantCtx.stroke();
                                                                    });

                                                                    window.addEventListener('mouseup', function () {
                                                                        isDrawingTenant = false;
                                                                    });
                                                                }

