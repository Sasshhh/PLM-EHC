@model C8.eServices.Mvc.ViewModels.DepartmentsApprovalViewModel
@using System.Text;
@using C8.eServices.Mvc.DataAccessLayer;
@using C8.eServices.Mvc.Keys
@using C8.eServices.Mvc.ViewModels
@{
    ViewBag.Title = "CSO Initiates Termination";
    Layout = "~/Views/Shared/RCS_Layout.cshtml";
    var flaggedLeases = ViewBag.FlaggedLeases as IEnumerable<FlaggedLeaseViewModel> ?? new List<FlaggedLeaseViewModel>();
}

<style>
    .flagged-table th {
        background-color: #2c3e50;
        color: white;
        text-align: center;
        vertical-align: middle !important;
    }
    .flagged-table td {
        text-align: center;
        vertical-align: middle !important;
    }
    .flag-reason-notice {
        background-color: #fcf8e3;
        color: #8a6d3b;
        font-weight: bold;
        padding: 4px 8px;
        border-radius: 4px;
        border: 1px solid #faebcc;
    }
    .flag-reason-transgression {
        background-color: #f2dede;
        color: #a94442;
        font-weight: bold;
        padding: 4px 8px;
        border-radius: 4px;
        border: 1px solid #ebccd1;
    }
    .btn-initiate {
        background-color: #d9534f;
        color: white;
        font-weight: bold;
        border-radius: 4px;
        padding: 6px 12px;
        transition: all 0.3s;
        border: none;
    }
    .btn-initiate:hover {
        background-color: #c9302c;
        color: white;
        transform: translateY(-2px);
        box-shadow: 0 4px 8px rgba(0,0,0,0.15);
    }
</style>

<div id="LeaseTerminationLOSessionModal" class="modal fade" role="dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Lease Termination</h4>
            </div>
            <div class="modal-body">
                <div class="container">
                    <strong>@Html.Raw(ViewBag.LeaseTerminationLOSession)</strong>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>

<div class="panel-group">
    <div class="panel panel-default">
        <div class="panel-heading" align="center">
            <h4><strong>Lease Termination Dashboard — Flagged Active Leases (UC023-S2b)</strong></h4>
        </div>
        <div class="panel-body">
            <p class="text-muted" align="center">
                List of all active leases that have exceeded their notice periods or are flagged due to active payment transgressions.
            </p>
            <br />
            <table id="FlaggedLeasesTable" class="table table-bordered table-hover table-striped flagged-table">
                <thead>
                    <tr>
                        <th>Lease Reference #</th>
                        <th>Tenant Name</th>
                        <th>ID Number</th>
                        <th>Unit #</th>
                        <th>Purchaser Type</th>
                        <th>Reason Flagged</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in flaggedLeases)
                    {
                        var isNotice = item.FlaggedReason.Contains("Notice Date");
                        <tr>
                            <td><strong>@item.Lease.LeaseReferenceNo</strong></td>
                            <td>@item.Lease.FirstNames @item.Lease.LastName</td>
                            <td>@item.Lease.IDNo</td>
                            <td>@item.Lease.SpaceUnitNo</td>
                            <td>@(item.Lease.PurchaserType?.Name ?? "N/A")</td>
                            <td>
                                @if (isNotice)
                                {
                                    <span class="flag-reason-notice"><i class="glyphicon glyphicon-time"></i> @item.FlaggedReason</span>
                                }
                                else
                                {
                                    <span class="flag-reason-transgression"><i class="glyphicon glyphicon-exclamation-sign"></i> @item.FlaggedReason</span>
                                }
                            </td>
                            <td>
                                @Html.ActionLink("Initiate Termination", "LeaseTerminationValidation", "LeaseDetails", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("id=" + item.Lease.Id.ToString()) }, new { @class = "btn btn-initiate" })
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts{
    <script src="@Url.Content( "~/scripts/Datatables/jquery.dataTables.min.js" )"></script>
    <script src="@Url.Content( "~/scripts/Datatables/dataTables.bootstrap.js" )"></script>

    <script type="text/javascript">
    $(document).ready(function () {
        $('#FlaggedLeasesTable').DataTable({
            "order": [[5, "asc"]],
            "responsive": true
        });

        if ('@ViewBag.LeaseTerminationLOSession' !== null && '@ViewBag.LeaseTerminationLOSession' !== '') {
            $('#LeaseTerminationLOSessionModal').modal({
                backdrop: 'static',
                keyboard: false,
                show: true
            });
        }
    });
    </script>
}
