@model C8.eServices.Mvc.ViewModels.DepartmentsApprovalViewModel
@using System.Text;
@using C8.eServices.Mvc.DataAccessLayer;
@using C8.eServices.Mvc.Keys
@{
    ViewBag.Title = "Details";
    Layout = "~/Views/Shared/RCS_Layout.cshtml";
}
<head>
    <style>
        .swal-modal .swal-text {
            text-align: center;
        }
    </style>
</head>
<script src="@Url.Content( "~/Scripts/moment.js" )"></script>



<div id="bankAccountPanel">
    <div class="panel panel-default">

        <div class="panel-heading">Application Lease Eviction</div>

        <br />
        @{ var evictionCases = ViewBag.EvictionCases as List<System.Tuple<string, string, int, string, string>> ?? new List<System.Tuple<string, string, int, string, string>>(); }
        <div style="width: 90%;margin: 0 auto;">
            <h5><strong>Eviction cases</strong> (referred for eviction by the Revenue Manager)</h5>
            <table class="table table-bordered table-hover table-striped">
                <thead>
                    <tr><th>Eviction Reference No.</th><th>Application Reference</th><th>Tenant</th><th>Status</th><th>Action</th></tr>
                </thead>
                <tbody>
                    @if (!evictionCases.Any())
                    {
                        <tr><td colspan="5">No eviction cases waiting. You can still capture an eviction by application reference below.</td></tr>
                    }
                    @foreach (var c in evictionCases)
                    {
                        <tr>
                            <td>@c.Item1</td>
                            <td>@c.Item2</td>
                            <td>@c.Item4</td>
                            <td>@c.Item5</td>
                            <td>@Html.ActionLink("Capture Outcome", "CaptureEvictionDetails", "PropertyLeaseApplication", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("id=" + c.Item3.ToString()) }, new { @class = "btn btn-primary" })</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <br />
        <div style="width: 90%;margin: 0 auto;">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <br />
                <div class="form-group">
                    @Html.Label("Application Reference Number", htmlAttributes: new { @class = "control-label col-md-3" })
                    <div class="col-md-3">
                        @Html.TextArea("LeaseDetails.LeaseReferenceNo", null, new { @class = "form-control", @Name = "ApprovalStatusddl", @required = "required" })
                        @Html.ValidationMessage("ApprovalStatus", "", new { @class = "text-danger" })
                    </div>
                </div>
                <br />
                <div id="divComment" style="display:none">
                    <div class="form-group">
                        @Html.Label("Comment", htmlAttributes: new { @class = "control-label col-md-1" })
                        <div class="col-md-4">
                            @Html.TextArea("Comment", new { @class = "form-control" })
                            @Html.ValidationMessage("Comment", "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <br />
                    <br />
                    <br />
                </div>
                <br />
                <br />

                <div id="divbtn" style="display:block">
                    <input type="button" value="Submit" name="btnApproval" onclick="clickSubmit()" class="button1" />
                    <input type="submit" value="Submit" style="display:none;" hidden name="btnApprovalStatus" class="button1" id="btnApproval" />
                    <br />
                    <br />
                    <br />
                </div>
            }
        </div>
    </div>
</div>
@section Scripts{

    <script src="@Url.Content( "~/scripts/Datatables/jquery.dataTables.min.js" )"></script>
    <script src="@Url.Content( "~/scripts/Datatables/dataTables.bootstrap.js" )"></script>

    <script type="text/javascript">
    $(document).ready(function () {
        var evictionSessionMsg = "@Html.Raw(ViewBag.EvictionDetailsSession)";
        if (evictionSessionMsg !== null && evictionSessionMsg !== '') {
            swal({
                title: "Eviction Processed",
                text: evictionSessionMsg,
                icon: "success",
                button: "OK",
            });
        }
    });
    </script>

    <script>
    $(function () {
        $('#RCSTable').DataTable();
        $('#RCSTable2').DataTable();
        var display = "@ViewBag.DisplaySwal";
        var message = "@ViewBag.MessageBodySwal";
        if (display != null && display != "") {
            var message = "@ViewBag.MessageBodySwal";
            swal("Error!", message, "warning");
            //swal({
            //    icon: "error",
            //    title: message,
            //    type: "error",
            //    closeOnClickOutside: false,
            //    buttons: [
            //        'Cancel',
            //        'Rerty!'
            //    ]

            //});
        }
    });

    function OpenChatModal() {

        $('#MessageModal').modal('show');
    };


    </script>


    <script type="text/javascript">

        function loadAccounts() {
            $('#FailureTable').DataTable({
                "ajax": {
                    "url": "@Url.Action( "LoadDetails", "DepartmentsApprovals" )",
                    "type": "GET",
                    "datatype": "json",
                    "timeout": 60000
                },
                "columns": [

                    {
                        "data": "CreatedDateTime", "autoWidth": true,
                        "render": function (data) {
                            return convertDate(data);
                        }
                    },
                    {
                        "render": function (data) {
                            return "System";
                        }
                    },
                    { "data": "FailureReason", "autoWidth": true },
                    {
                        "data": "CapturedDate", "autoWidth": true,
                        "render": function (data) {
                            return convertDate(data);
                        }
                    },

                     { "data": "AssignedTo", "autoWidth": true }],
                "language": {
                    "emptyTable": "No Data.",
                },
                "Initcomplete": "",
                "destroy": true
            });
        }

        function convertDate(data) {
            try {
                var dtStart = new Date(parseInt(data.substr(6)));
                var dtStartWrapper = moment(dtStart);
                return dtStartWrapper.format("YYYY-MM-DD");
            }
            catch (ex) {
            }
        }

        $(function () {
            $('#RCSTable').DataTable();

        });

    </script>

}

<script>
    function clickSubmit() {
        swal({
            icon: "info",
            title: "Are you sure you want to evict this application?",
            buttons: [
                'No!',
                'Yes, I am sure!'
            ]

        }).then(function (isConfirm) {
            if (isConfirm) {

                document.getElementById("btnApproval").click();
            }
        });
    }

</script>
<script>
        $(function () {
            $('#FailureTable').DataTable();

                var display = "@ViewBag.Message";

        if (display != null && display != "") {
            $('#MessageModal4').modal('show');
        }});
</script>


