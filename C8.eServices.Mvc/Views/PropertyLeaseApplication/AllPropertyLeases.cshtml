
@model IEnumerable<C8.eServices.Mvc.ViewModels.LeaseDetailsViewModel>
@using C8.eServices.Mvc.Keys;
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/RCS_Layout.cshtml";


}

<style>
    @@media only screen and (max-width: 1000px) {


        .cards tbody tr {
            float: left;
            /*width: 20rem;*/
            width: 90%;
            margin: 0.5rem;
            border: 0.0625rem solid rgba(0,0,0,.125);
            border-radius: .25rem;
            box-shadow: 0.25rem 0.25rem 0.5rem rgba(0,0,0,0.25);
        }

        .cards thead tr {
            float: left;
            /*width: 25rem;*/
            width: 90%;
            margin: 0.5rem;
            border: 0.0625rem solid rgba(0,0,0,.125);
            border-radius: .25rem;
            box-shadow: 0.25rem 0.25rem 0.5rem rgba(0,0,0,0.25);
        }


        .cards tbody td {
            display: block;
            word-wrap: break-word;
        }

        .cards thead th {
            display: none;
        }

        .table tbody label {
            display: block;
        }

        .cards tbody label {
            display: inline;
            position: relative;
            font-size: 85%;
            top: -0.5rem;
            color: #808080;
            min-width: 4rem;
            margin-left: 0;
            margin-right: 1rem;
            text-align: left;
        }

        tr.selected label {
            color: #404040;
        }

        .table .fa {
            font-size: 2.5rem;
            text-align: center;
        }

        .cards .fa {
            font-size: 7.5rem;
        }
    }
</style>

<div id="SendWarningLetterSessionModal" class="modal fade" role="dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>

                <h4 class="modal-title">Warning Letter</h4>
            </div>
            <div class="modal-body">
                <div class="container">
                    <strong>@Html.Raw(ViewBag.SendWarningLetterSession)</strong>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>

<div class="panel-group">
    <div class="panel panel-default">
        <div class="panel-group" style="margin-bottom: -1px;">
            <div class="panel panel-default">
                <div class="panel-heading" align="center">
                    All Property Leases
                </div>
            </div>
        </div>
        <div id="accountInfoCollapse" class="panel-collapse collapse in tablecss">
            @* FR4.1 / D058: visual summary of the lease portfolio by status, built from the same rows as the table *@
            @{
                var leaseStatusSummary = (Model ?? Enumerable.Empty<C8.eServices.Mvc.ViewModels.LeaseDetailsViewModel>())
                    .GroupBy(x => string.IsNullOrWhiteSpace(x.StatusName) ? "No status" : x.StatusName)
                    .Select(g => new { Status = g.Key, Count = g.Count() })
                    .OrderByDescending(x => x.Count).ToList();
                var leaseTotal = leaseStatusSummary.Sum(x => x.Count);
                var leaseMax = leaseStatusSummary.Count > 0 ? leaseStatusSummary.Max(x => x.Count) : 1;
                var barColours = new[] { "#1b5e20", "#2e7d32", "#43a047", "#66bb6a", "#0277bd", "#0288d1", "#f9a825", "#ef6c00", "#c62828", "#6a1b9a", "#546e7a" };
            }
            <div class="lease-dashboard" style="padding:15px 20px 5px 20px;">
                <div style="display:flex; flex-wrap:wrap; gap:12px; margin-bottom:12px;">
                    <div style="border:1px solid #ddd; border-radius:6px; padding:10px 16px; min-width:140px;">
                        <div class="text-muted" style="font-size:12px;">Total leases</div>
                        <div style="font-size:24px; font-weight:bold;">@leaseTotal</div>
                    </div>
                    @foreach (var s in leaseStatusSummary.Take(3))
                    {
                        <div style="border:1px solid #ddd; border-radius:6px; padding:10px 16px; min-width:140px;">
                            <div class="text-muted" style="font-size:12px;">@s.Status</div>
                            <div style="font-size:24px; font-weight:bold;">@s.Count</div>
                        </div>
                    }
                </div>
                <div style="font-weight:bold; margin-bottom:6px;">Leases by status</div>
                @for (int i = 0; i < leaseStatusSummary.Count; i++)
                {
                    var s = leaseStatusSummary[i];
                    var pct = (int)Math.Round(100.0 * s.Count / leaseMax);
                    <div style="display:flex; align-items:center; margin-bottom:4px;" title="@s.Status: @s.Count">
                        <div style="width:260px; font-size:12px; padding-right:8px; text-align:right; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">@s.Status</div>
                        <div style="flex:1; background:#f1f1f1; border-radius:3px;">
                            <div style="width:@(Math.Max(pct, 1))%; background:@barColours[i % barColours.Length]; height:16px; border-radius:3px;"></div>
                        </div>
                        <div style="width:50px; font-size:12px; padding-left:8px;">@s.Count</div>
                    </div>
                }
            </div>
            <br />
            <table id="RCSTable" class="table table-bordered table-hover table-striped panel panel-default cards">
                <thead>
                    <tr>
                        <th>Applicant Name</th>
                        <th>Lease Type</th>
                        <th>Lease Reference No</th>
                        <th>Lease Created Date</th>
                        <th>Status</th>
                        <th>Progress</th>
                        <th>Total Warning Letter Sent</th>
                        <th>    </th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.TenantFullName)
                            </td>
                            <td>@Html.DisplayFor(modelItem => item.TenantType)</td>
                            <td>@Html.DisplayFor(modelItem => item.ReferenceNumber)</td>
                            <td>@Html.DisplayFor(modelItem => item.CreatedDateTime.Value)</td>
                            <td>@Html.DisplayFor(modelItem => item.StatusName)</td>
                            <td>@Html.DisplayFor(modelItem => item.CompletionStatus)</td>
                            <td>@Html.DisplayFor(modelItem => item.WarningLetterCount)</td>
                            <td>
                                @Html.ActionLink("View", "ApplincantDetails", "leaseDetails", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("refNo=" + item.Id.ToString()), target = "_blank" }, new { @class = "btn btn-primary", @target = "_blank" })
                                @Html.ActionLink("Unit Info", "UnitDetails", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("Id=" + item.EkurhulreniEHCUnitId.ToString()), target = "_blank" }, new { @class = "btn btn-primary", @target = "_blank" })
                                @Html.ActionLink("Application Details", "Details", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("refNo=" + item.PropertyLeaseApplicationId.ToString()), target = "_blank" }, new { @class = "btn btn-primary", @target = "_blank" })
                                @if (User.IsInRole("Letting Officer"))
                                {
                                    @Html.ActionLink("Send Warning Letter", "SendWarningLetter", "leaseDetails", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("id=" + item.Id.ToString()), target = "_blank" }, new { @class = "btn btn-primary", @target = "_blank" })
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <br />
        </div>
    </div>
</div>



<script type="text/javascript">
    $(document).ready(function () {
        debugger;
        if ('@ViewBag.SendWarningLetterSession' !== null && '@ViewBag.SendWarningLetterSession' !== '') {
            $('#SendWarningLetterSessionModal').modal({
                backdrop: 'static',
                keyboard: false,
                show: true
            });
        }
    });
</script>

<script>
    $(function () {


        debugger;
        $('#RCSTable').DataTable();
