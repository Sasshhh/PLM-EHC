@model C8.eServices.Mvc.ViewModels.DepartmentsApprovalViewModel
@using System.Text;
@using C8.eServices.Mvc.DataAccessLayer;
@using C8.eServices.Mvc.Keys
@{
    ViewBag.Title = "Property & Facilities Manager Review";
    Layout = "~/Views/Shared/RCS_Layout.cshtml";
    var maintenanceRecord = ViewBag.MaintenanceRecord as C8.eServices.Mvc.Models.AllocatedUnitMaintenanceEHC;
    var maintenanceSignature = ViewBag.MaintenanceSignature as C8.eServices.Mvc.Models.MaintenanceJobCardSignature;
    var maintenanceId = (int)(ViewBag.MaintenanceId ?? 0);
}
<head>
    <style>
        .swal-modal .swal-text {
            text-align: center;
        }
        .view-only-badge {
            background-color: #5bc0de;
            color: #fff;
            padding: 2px 8px;
            border-radius: 3px;
            font-size: 11px;
            margin-left: 8px;
            vertical-align: middle;
        }
    </style>
</head>
<script src="@Url.Content("~/Scripts/moment.js")"></script>
<div id="bankAccountPanel">
    <div class="panel panel-default">

        <!-- Application Summary -->
        <div class="panel-heading">Evaluating Application</div>
        <div style="width: 90%;margin: 0 auto;">
            <br />
            <table class="table table-bordered table-hover table-striped panel panel-default display">
                <thead>
                    <tr>
                        <th>Reference Number</th>
                        <th>Applicant Type</th>
                        <th>Status</th>
                        <th>Captured Date</th>
                        <th>Customer Name</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>@Model.PropertyLeaseApplications.ApplicationReferenceNumber</td>
                        <td>@Model.PropertyLeaseApplications.PurchaserType.Name</td>
                        <td>@Model.PropertyLeaseApplications.Status.Name</td>
                        <td>@Model.PropertyLeaseApplications.CreatedDateTime</td>
                        <td>@Model.PropertyLeaseApplications.Customer.FullName</td>
                        <td>
                            @Html.ActionLink("View", "Details", "PropertyLeaseApplication", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("refNo=" + Model.PropertyLeaseApplications.Id.ToString()), target = "_blank" }, new { @class = "btn btn-primary", @target = "_blank" })
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
        <br />

        @if (maintenanceRecord != null)
        {
            <!-- Maintenance Defect Details -->
            <div class="panel-heading">Maintenance Defect Details <span class="view-only-badge">View Only</span></div>
            <div style="width: 90%;margin: 0 auto; padding: 15px;">
                <dl class="dl-horizontal">
                    <dt>Defect Classification:</dt>
                    <dd>
                        @if (maintenanceRecord.RCSActionType != null)
                        {
                            <span class="label label-danger">@maintenanceRecord.RCSActionType.Name</span>
                        }
                    </dd>
                    <dt>Inspection Type:</dt>
                    <dd>@maintenanceRecord.InspectionType</dd>
                    <dt>Maintenance Completed:</dt>
                    <dd>@(maintenanceRecord.UnitMaintenanceCompleted ? "Yes" : "Pending")</dd>
                    <dt>Job Card Submitted:</dt>
                    <dd>@(maintenanceRecord.JobCardSubmitted.HasValue && maintenanceRecord.JobCardSubmitted.Value ? "Yes" : "No")</dd>
                    @if (maintenanceRecord.JobCardSubmittedDate.HasValue)
                    {
                        <dt>Submitted Date:</dt>
                        <dd>@maintenanceRecord.JobCardSubmittedDate.Value.ToString("dd MMMM yyyy HH:mm")</dd>
                    }
                    @if (maintenanceRecord.ModifiedBySystemUser != null)
                    {
                        <dt>Last Updated By:</dt>
                        <dd>@maintenanceRecord.ModifiedBySystemUser.FullName</dd>
                        <dt>Last Updated:</dt>
                        <dd>@(maintenanceRecord.ModifiedDateTime.HasValue ? maintenanceRecord.ModifiedDateTime.Value.ToString("dd MMMM yyyy HH:mm") : "-")</dd>
                    }
                </dl>
            </div>
            <br />

            <!-- Task List - View Only -->
            <div class="panel-heading">Captured Maintenance Tasks <span class="view-only-badge">View Only</span></div>
            <div style="width: 90%;margin: 0 auto;">
                <br />
                <table class="table table-bordered table-hover table-striped">
                    <thead>
                        <tr>
                            <th>Start Date</th>
                            <th>End Date</th>
                            <th>Activity</th>
                            <th>Material</th>
                            <th>Quantity</th>
                            <th>Labour</th>
                            <th>Total Cost</th>
                            <th>Comments</th>
                            <th>Document</th>
                        </tr>
                    </thead>
                    <tbody id="tasksTableBody">
                        <tr><td colspan="9" class="text-center">Loading tasks...</td></tr>
                    </tbody>
                </table>
                <br />
            </div>

            <!-- Before & After Images - View Only -->
            <div class="panel-heading">Job Card Documents - Before &amp; After Images <span class="view-only-badge">View Only</span></div>
            <div style="width: 90%;margin: 0 auto;">
                <br />
                <div class="row">
                    <div class="col-md-6">
                        <div class="panel panel-default">
                            <div class="panel-heading"><i class="fa fa-image"></i> Before Image</div>
                            <div class="panel-body text-center">
                                @if (maintenanceRecord.BeforeImage != null)
                                {
                                    @Html.ActionLink("View Before Image", "GetFile", "Document", new { area = "", data = maintenanceRecord.BeforeImage.Data }, new { @class = "btn btn-info", target = "_blank" })
                                }
                                else
                                {
                                    <span class="text-muted"><i class="fa fa-times-circle"></i> No before image uploaded</span>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="panel panel-default">
                            <div class="panel-heading"><i class="fa fa-image"></i> After Image</div>
                            <div class="panel-body text-center">
                                @if (maintenanceRecord.AfterImage != null)
                                {
                                    @Html.ActionLink("View After Image", "GetFile", "Document", new { area = "", data = maintenanceRecord.AfterImage.Data }, new { @class = "btn btn-info", target = "_blank" })
                                }
                                else
                                {
                                    <span class="text-muted"><i class="fa fa-times-circle"></i> No after image uploaded</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
                <br />
            </div>

            <!-- Maintenance Manager Signature - View Only -->
            <div class="panel-heading">Maintenance Manager Signature <span class="view-only-badge">View Only</span></div>
            <div style="width: 90%;margin: 0 auto;">
                <!-- Job Card Signatures -->
                <div class="panel-heading">Job Card Sign-Offs <span class="view-only-badge">View Only</span></div>
                <br />
                @{
                    var signatures = (List<C8.eServices.Mvc.Models.MaintenanceJobCardSignature>)ViewBag.MaintenanceSignatures;
                    var facSignature = signatures.FirstOrDefault(x => x.SignatureRole == "FacilitiesManager");
                }

                @if (signatures != null && signatures.Any())
                {
                    foreach (var sig in signatures.OrderBy(x => x.ApprovalDate))
                    {
                        var roleTitle = sig.SignatureRole == "FacilitiesManager" ? "Property & Facilities Manager" : "Maintenance Manager";
                        <div class="alert @(sig.SignatureRole == "FacilitiesManager" ? "alert-info" : "alert-success")" style="margin-bottom: 0;">
                            <strong><i class="fa fa-check-circle"></i> Job Card Signed by @roleTitle</strong>
                        </div>
                        <table class="table table-bordered" style="margin-bottom: 20px;">
                            <tbody>
                                <tr>
                                    <th style="width:200px;">Official Number</th>
                                    <td>@sig.OfficialNumber</td>
                                </tr>
                                <tr>
                                    <th>Approval Action</th>
                                    <td>
                                        <span class="label @(sig.ApprovalAction == "Approved" || sig.ApprovalAction == "Approve" ? "label-success" : "label-danger")">
                                            @sig.ApprovalAction
                                        </span>
                                    </td>
                                </tr>
                                <tr>
                                    <th>Reason</th>
                                    <td>@sig.Reason</td>
                                </tr>
                                <tr>
                                    <th>Signed By</th>
                                    <td>@(sig.SignedByCustomer != null ? sig.SignedByCustomer.FullName : "-")</td>
                                </tr>
                                <tr>
                                    <th>Approval Date</th>
                                    <td>@sig.ApprovalDate.ToString("dd MMMM yyyy HH:mm", System.Globalization.CultureInfo.InvariantCulture)</td>
                                </tr>
                                <tr>
                                    <th>Signature</th>
                                    <td>
                                        @if (!string.IsNullOrEmpty(sig.SignatureData))
                                        {
                                            <img src="@sig.SignatureData" alt="Signature" style="border: 1px solid #ccc; max-width: 400px;" />
                                        }
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    }
                }
                else
                {
                    <div class="alert alert-warning">
                        <i class="fa fa-exclamation-triangle"></i> No signatures captured yet.
                    </div>
                }

                @if (facSignature != null)
                {
                    <script type="text/javascript">
                        $(document).ready(function() {
                            $('#facilitiesSignatureSection').hide();
                        });
                    </script>
                }
                <br />
            </div>
        }

        <!-- Uploaded Job Sheet Document -->
        <div class="panel-heading">Maintenance Job Sheet Documentation <span class="view-only-badge">View Only</span></div>
        @Html.Partial("_DocumentsPartialConductUnitInspection", Model.DocumentsViewModel)
        <br />

        <!-- Facilities Manager Decision (Signature Section) -->
        <div id="facilitiesSignatureSection">
            <div class="panel-heading">Property &amp; Facilities Manager Review &amp; Sign-Off</div>
            <div style="width: 90%;margin: 0 auto;">
                <br />
                <div class="alert alert-info">
                    <strong>Instructions:</strong>
                    <ul>
                        <li>Enter your official number and click <strong>Authorize</strong>.</li>
                        <li>Select your <strong>Approval Action</strong> and enter a <strong>Reason</strong>.</li>
                        <li>Capture your signature and click <strong>Submit Signature</strong> to complete the review.</li>
                    </ul>
                </div>

                <div class="form-horizontal">
                    <div class="form-group">
                        <label class="control-label col-md-2">Official Number *</label>
                        <div class="col-md-4">
                            <input type="text" id="facOfficialNumber" class="form-control" maxlength="50" required />
                        </div>
                        <div class="col-md-2">
                            <button type="button" class="btn btn-warning" onclick="authorizeFacilitiesSignature()">
                                <i class="fa fa-key"></i> Authorize
                            </button>
                        </div>
                    </div>
                    <div class="clearfix"></div>
                    <br />

                    <div id="facSignatureFormSection" style="display: none;">
                        <div class="form-group">
                            <label class="control-label col-md-2">Approval Action *</label>
                            <div class="col-md-4">
                                <select id="facApprovalAction" class="form-control" required>
                                    <option value="">-- Select --</option>
                                    <option value="Rcs_Approval">Approve (Maintenance Complete)</option>
                                    <option value="Rcs_Rejected">Reject (Further Action Required)</option>
                                </select>
                            </div>
                        </div>
                        <div class="clearfix"></div>
                        <br />

                        <div class="form-group">
                            <label class="control-label col-md-2">Review Comment *</label>
                            <div class="col-md-10">
                                <textarea id="facSignatureReason" class="form-control" rows="3" maxlength="1000" placeholder="Enter your review comment or reason for decision..." required></textarea>
                            </div>
                        </div>
                        <div class="clearfix"></div>
                        <br />

                        <div class="form-group">
                            <label class="control-label col-md-2">Capture Signature *</label>
                            <div class="col-md-10">
                                <div style="border: 2px solid #000; width: 600px; height: 150px; background-color: #fff;">
                                    <canvas id="facSignaturePad" width="600" height="150"></canvas>
                                </div>
                                <button type="button" class="btn btn-default" style="margin-top: 10px;" onclick="clearFacilitiesSignature()">
                                    <i class="fa fa-eraser"></i> Clear Signature
                                </button>
                            </div>
                        </div>
                        <div class="clearfix"></div>
                        <br />

                        <div class="text-center">
                            <button type="button" class="btn btn-success btn-lg" onclick="submitFacilitiesSignature()">
                                <i class="fa fa-check"></i> Submit Review &amp; Signature
                            </button>
                            @Html.ActionLink("Back to List", "PropertyFacilitiesMaintenanceReviews", null, new { @class = "btn btn-default btn-lg", style="margin-left: 10px;" })
                        </div>
                    </div>
                </div>
                <br />
            </div>
        </div>
        <br />

    </div>
</div>

@section Scripts {
    <script type="text/javascript">
        var maintenanceId = @Html.Raw(maintenanceId);

        // === Vanilla Canvas Signature (no external library needed) ===
        var _facCanvas, _facCtx, _facDrawing = false, _facHasMark = false;

        function initializeSignaturePad() {
            _facCanvas = document.getElementById('facSignaturePad');
            if (!_facCanvas) return;
            _facCtx = _facCanvas.getContext('2d');
            _facCtx.strokeStyle = '#000';
            _facCtx.lineWidth = 2;
            _facCtx.lineCap = 'round';

            _facCanvas.onmousedown  = function (e) { _facDrawing = true; _facCtx.beginPath(); var r = _facCanvas.getBoundingClientRect(); _facCtx.moveTo(e.clientX - r.left, e.clientY - r.top); };
            _facCanvas.onmousemove  = function (e) { if (!_facDrawing) return; _facHasMark = true; var r = _facCanvas.getBoundingClientRect(); _facCtx.lineTo(e.clientX - r.left, e.clientY - r.top); _facCtx.stroke(); };
            _facCanvas.onmouseup    = function () { _facDrawing = false; };
            _facCanvas.onmouseleave = function () { _facDrawing = false; };

            _facCanvas.ontouchstart = function (e) { e.preventDefault(); _facDrawing = true; _facCtx.beginPath(); var r = _facCanvas.getBoundingClientRect(); _facCtx.moveTo(e.touches[0].clientX - r.left, e.touches[0].clientY - r.top); };
            _facCanvas.ontouchmove  = function (e) { e.preventDefault(); if (!_facDrawing) return; _facHasMark = true; var r = _facCanvas.getBoundingClientRect(); _facCtx.lineTo(e.touches[0].clientX - r.left, e.touches[0].clientY - r.top); _facCtx.stroke(); };
            _facCanvas.ontouchend   = function () { _facDrawing = false; };
        }

        function clearFacilitiesSignature() {
            if (_facCtx) { _facCtx.clearRect(0, 0, _facCanvas.width, _facCanvas.height); _facHasMark = false; }
        }
        // === End Vanilla Canvas ===

        $(document).ready(function () {
            @if (ViewBag.MessageTitle != null && ViewBag.Message != null)
            {
                <text>
            swal({
                title: "@ViewBag.MessageTitle",
                text: "@ViewBag.Message",
                icon: "info",
                button: "OK",
            });
                </text>
            }

            if (maintenanceId > 0) {
                loadTasksViewOnly();
                initializeSignaturePad();
            }
        });

        function authorizeFacilitiesSignature() {
            var officialNumber = $('#facOfficialNumber').val();
            if (!officialNumber) {
                swal("Warning", "Please enter your official number to authorize", "warning");
                return;
            }
            swal("Authorized", "You may now select your decision and capture your signature", "success");
            $('#facSignatureFormSection').show();
        }

        function submitFacilitiesSignature() {
            var officialNumber = $('#facOfficialNumber').val();
            var approvalAction = $('#facApprovalAction').val();
            var reason = $('#facSignatureReason').val();

            if (!officialNumber || !approvalAction || !reason) {
                swal("Error", "Please fill in all required fields", "error");
                return;
            }

            if (!_facHasMark) {
                swal("Error", "Please draw your signature before submitting", "error");
                return;
            }

            var signatureData = _facCanvas.toDataURL('image/png');

            swal({
                icon: "warning",
                title: "Are you sure you want to submit this review?",
                text: "Once submitted, you will not be able to change your decision.",
                buttons: ['No, cancel', 'Yes, submit signature']
            }).then(function (isConfirm) {
                if (isConfirm) {
                    $.ajax({
                        url: '@Url.Action("SaveFacilitiesManagerSignature", "PropertyLeaseApplication")',
                        type: 'POST',
                        data: {
                            maintenanceId: maintenanceId,
                            officialNumber: officialNumber,
                            approvalAction: approvalAction,
                            reason: reason,
                            signatureData: signatureData
                        },
                        success: function (response) {
                            if (response.success) {
                                swal("Success", "Review and signature submitted successfully!", "success")
                                    .then(function () {
                                        window.location.href = '@Url.Action("PropertyFacilitiesMaintenanceReviews", "PropertyLeaseApplication")';
                                    });
                            } else {
                                swal("Error", response.message, "error");
                            }
                        },
                        error: function () {
                            swal("Error", "Failed to submit signature. Please try again.", "error");
                        }
                    });
                }
            });
        }

        function loadTasksViewOnly() {
            $.ajax({
                url: '@Url.Action("GetMaintenanceTasks", "PropertyLeaseApplication")',
                type: 'GET',
                data: { maintenanceId: maintenanceId },
                success: function (response) {
                    var tbody = $('#tasksTableBody');
                    tbody.empty();
                    if (response.success) {
                        if (response.tasks.length === 0) {
                            tbody.append('<tr><td colspan="9" class="text-center">No tasks captured</td></tr>');
                        } else {
                            $.each(response.tasks, function (index, task) {
                                var row = '<tr>' +
                                    '<td>' + task.StartDate + '</td>' +
                                    '<td>' + task.EndDate + '</td>' +
                                    '<td>' + task.Activity + '</td>' +
                                    '<td>' + (task.MaterialUsed || '-') + '</td>' +
                                    '<td>' + (task.QuantityUsed || '-') + '</td>' +
                                    '<td>' + (task.LabourUsed || '-') + '</td>' +
                                    '<td>' + (task.TotalCosts || '-') + '</td>' +
                                    '<td>' + (task.TaskComments || '-') + '</td>' +
                                    '<td>' + (task.HasDocument ? '<i class="fa fa-check text-success"></i> Uploaded' : '<i class="fa fa-times text-danger"></i> None') + '</td>' +
                                    '</tr>';
                                tbody.append(row);
                            });
                        }
                    } else {
                        tbody.append('<tr><td colspan="9" class="text-center text-danger">Failed to load tasks</td></tr>');
                    }
                },
                error: function () {
                    $('#tasksTableBody').html('<tr><td colspan="9" class="text-center text-danger">Error loading tasks</td></tr>');
                }
            });
        }
    </script>
}
