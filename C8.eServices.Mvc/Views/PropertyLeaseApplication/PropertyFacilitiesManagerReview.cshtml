@model C8.eServices.Mvc.ViewModels.DepartmentsApprovalViewModel
@using System.Text;
@using C8.eServices.Mvc.DataAccessLayer;
@using C8.eServices.Mvc.Keys
@{
    ViewBag.Title = "Property & Facilities Manager Review";
    Layout = "~/Views/Shared/RCS_Layout.cshtml";
    var maintenanceRecord = ViewBag.MaintenanceRecord as C8.eServices.Mvc.Models.AllocatedUnitMaintenanceEHC;
    var maintenanceSignature = ViewBag.MaintenanceSignature as C8.eServices.Mvc.Models.MaintenanceJobCardSignature;
    var maintenanceId = (int)(ViewBag.MaintenanceId ?? 0);
}
<head>
    <style>
        .swal-modal .swal-text {
            text-align: center;
        }
        .view-only-badge {
            background-color: #5bc0de;
            color: #fff;
            padding: 2px 8px;
            border-radius: 3px;
            font-size: 11px;
            margin-left: 8px;
            vertical-align: middle;
        }
    </style>
</head>
<script src="@Url.Content("~/Scripts/moment.js")"></script>
<div id="bankAccountPanel">
    <div class="panel panel-default">

        <!-- Application Summary -->
        <div class="panel-heading">Evaluating Application</div>
        <div style="width: 90%;margin: 0 auto;">
            <br />
            <table class="table table-bordered table-hover table-striped panel panel-default display">
                <thead>
                    <tr>
                        <th>Reference Number</th>
                        <th>Applicant Type</th>
                        <th>Status</th>
                        <th>Captured Date</th>
                        <th>Customer Name</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>@Model.PropertyLeaseApplications.ApplicationReferenceNumber</td>
                        <td>@Model.PropertyLeaseApplications.PurchaserType.Name</td>
                        <td>@Model.PropertyLeaseApplications.Status.Name</td>
                        <td>@Model.PropertyLeaseApplications.CreatedDateTime</td>
                        <td>@Model.PropertyLeaseApplications.Customer.FullName</td>
                        <td>
                            @Html.ActionLink("View", "Details", "PropertyLeaseApplication", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("refNo=" + Model.PropertyLeaseApplications.Id.ToString()), target = "_blank" }, new { @class = "btn btn-primary", @target = "_blank" })
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
        <br />

        @if (maintenanceRecord != null)
        {
            <!-- Maintenance Defect Details -->
            <div class="panel-heading">Maintenance Defect Details <span class="view-only-badge">View Only</span></div>
            <div style="width: 90%;margin: 0 auto; padding: 15px;">
                <dl class="dl-horizontal">
                    <dt>Defect Classification:</dt>
                    <dd>
                        @if (maintenanceRecord.RCSActionType != null)
                        {
                            <span class="label label-danger">@maintenanceRecord.RCSActionType.Name</span>
                        }
                    </dd>
                    <dt>Inspection Type:</dt>
                    <dd>@maintenanceRecord.InspectionType</dd>
                    <dt>Maintenance Completed:</dt>
                    <dd>@(maintenanceRecord.UnitMaintenanceCompleted ? "Yes" : "Pending")</dd>
                    <dt>Job Card Submitted:</dt>
                    <dd>@(maintenanceRecord.JobCardSubmitted.HasValue && maintenanceRecord.JobCardSubmitted.Value ? "Yes" : "No")</dd>
                    @if (maintenanceRecord.JobCardSubmittedDate.HasValue)
                    {
                        <dt>Submitted Date:</dt>
                        <dd>@maintenanceRecord.JobCardSubmittedDate.Value.ToString("dd MMMM yyyy HH:mm")</dd>
                    }
                    @if (maintenanceRecord.ModifiedBySystemUser != null)
                    {
                        <dt>Last Updated By:</dt>
                        <dd>@maintenanceRecord.ModifiedBySystemUser.FullName</dd>
                        <dt>Last Updated:</dt>
                        <dd>@(maintenanceRecord.ModifiedDateTime.HasValue ? maintenanceRecord.ModifiedDateTime.Value.ToString("dd MMMM yyyy HH:mm") : "-")</dd>
                    }
                </dl>
            </div>
            <br />

            <!-- Task List - View Only -->
            <div class="panel-heading">Captured Maintenance Tasks <span class="view-only-badge">View Only</span></div>
            <div style="width: 90%;margin: 0 auto;">
                <br />
                <table class="table table-bordered table-hover table-striped">
                    <thead>
                        <tr>
                            <th>Start Date</th>
                            <th>End Date</th>
                            <th>Activity</th>
                            <th>Material</th>
                            <th>Quantity</th>
                            <th>Labour</th>
                            <th>Total Cost</th>
                            <th>Comments</th>
                            <th>Document</th>
                        </tr>
                    </thead>
                    <tbody id="tasksTableBody">
                        <tr><td colspan="9" class="text-center">Loading tasks...</td></tr>
                    </tbody>
                </table>
                <br />
            </div>

            <!-- Before & After Images - View Only -->
            <div class="panel-heading">Job Card Documents - Before &amp; After Images <span class="view-only-badge">View Only</span></div>
            <div style="width: 90%;margin: 0 auto;">
                <br />
                <div class="row">
                    <div class="col-md-6">
                        <div class="panel panel-default">
                            <div class="panel-heading"><i class="fa fa-image"></i> Before Image</div>
                            <div class="panel-body text-center">
                                @if (maintenanceRecord.BeforeImage != null)
                                {
                                    @Html.ActionLink("View Before Image", "GetFile", "Document", new { area = "", data = maintenanceRecord.BeforeImage.Data }, new { @class = "btn btn-info", target = "_blank" })
                                }
                                else
                                {
                                    <span class="text-muted"><i class="fa fa-times-circle"></i> No before image uploaded</span>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="panel panel-default">
                            <div class="panel-heading"><i class="fa fa-image"></i> After Image</div>
                            <div class="panel-body text-center">
                                @if (maintenanceRecord.AfterImage != null)
                                {
                                    @Html.ActionLink("View After Image", "GetFile", "Document", new { area = "", data = maintenanceRecord.AfterImage.Data }, new { @class = "btn btn-info", target = "_blank" })
                                }
                                else
                                {
                                    <span class="text-muted"><i class="fa fa-times-circle"></i> No after image uploaded</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
                <br />
            </div>

            <!-- Maintenance Manager Signature - View Only -->
            <div class="panel-heading">Maintenance Manager Signature <span class="view-only-badge">View Only</span></div>
            <div style="width: 90%;margin: 0 auto;">
                <br />
                @if (maintenanceSignature != null)
                {
                    <div class="alert alert-success">
                        <strong><i class="fa fa-check-circle"></i> Job Card Signed by Maintenance Manager</strong>
                    </div>
                    <table class="table table-bordered">
                        <tbody>
                            <tr>
                                <th style="width:200px;">Official Number</th>
                                <td>@maintenanceSignature.OfficialNumber</td>
                            </tr>
                            <tr>
                                <th>Approval Action</th>
                                <td>
                                    <span class="label @(maintenanceSignature.ApprovalAction == "Approve" ? "label-success" : "label-danger")">
                                        @maintenanceSignature.ApprovalAction
                                    </span>
                                </td>
                            </tr>
                            <tr>
                                <th>Reason</th>
                                <td>@maintenanceSignature.Reason</td>
                            </tr>
                            <tr>
                                <th>Signed By</th>
                                <td>@(maintenanceSignature.SignedByCustomer != null ? maintenanceSignature.SignedByCustomer.FullName : "-")</td>
                            </tr>
                            <tr>
                                <th>Approval Date</th>
                                <td>@maintenanceSignature.ApprovalDate.ToString("dd MMMM yyyy HH:mm", System.Globalization.CultureInfo.InvariantCulture)</td>
                            </tr>
                            <tr>
                                <th>Signature</th>
                                <td>
                                    @if (!string.IsNullOrEmpty(maintenanceSignature.SignatureData))
                                    {
                                        <img src="@maintenanceSignature.SignatureData" alt="Signature" style="border: 1px solid #ccc; max-width: 400px;" />
                                    }
                                </td>
                            </tr>
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="alert alert-warning">
                        <i class="fa fa-exclamation-triangle"></i> No signature captured yet.
                    </div>
                }
                <br />
            </div>
        }

        <!-- Uploaded Job Sheet Document -->
        <div class="panel-heading">Maintenance Job Sheet Documentation <span class="view-only-badge">View Only</span></div>
        @Html.Partial("_DocumentsPartialConductUnitInspection", Model.DocumentsViewModel)
        <br />

        <!-- Facilities Manager Decision -->
        <div class="panel-heading">Property &amp; Facilities Manager Decision</div>
        <div class="panel-body" style="width: 90%;margin: 0 auto;">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                <div class="form-horizontal">
                    <div class="alert alert-info">
                        <strong>Review Instructions:</strong>
                        <ul>
                            <li><strong>Approve:</strong> Maintenance work is complete. Application will proceed to next step.</li>
                            <li><strong>Reject:</strong> Additional maintenance work is required. Application will remain pending for further action.</li>
                        </ul>
                    </div>
                    <div class="form-group">
                        <label class="control-label col-md-2">Decision</label>
                        <div class="col-md-10">
                            @Html.DropDownList("ApprovalStatusddl", (SelectList)ViewBag.ApprovalStatus, "-- Select --", new { @class = "form-control", required = "required" })
                            <span class="text-danger">*</span>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="control-label col-md-2">Review Comment</label>
                        <div class="col-md-10">
                            @Html.TextArea("ReviewComment", null, new { @class = "form-control", rows = 4, placeholder = "Enter your review comment or reason for decision...", required = "required" })
                            <span class="text-danger">*</span>
                        </div>
                    </div>
                    <div class="form-group">
                        <div class="col-md-offset-2 col-md-10">
                            <input type="submit" value="Submit Decision" class="btn btn-primary" />
                            @Html.ActionLink("Back to List", "PropertyFacilitiesMaintenanceReviews", null, new { @class = "btn btn-default" })
                        </div>
                    </div>
                </div>
            }
        </div>
        <br />

    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script type="text/javascript">
        var maintenanceId = @Html.Raw(maintenanceId);

        $(document).ready(function () {
            @if (ViewBag.MessageTitle != null && ViewBag.Message != null)
            {
                <text>
            swal({
                title: "@ViewBag.MessageTitle",
                text: "@ViewBag.Message",
                icon: "info",
                button: "OK",
            });
                </text>
            }

            if (maintenanceId > 0) {
                loadTasksViewOnly();
            }
        });

        function loadTasksViewOnly() {
            $.ajax({
                url: '@Url.Action("GetMaintenanceTasks", "PropertyLeaseApplication")',
                type: 'GET',
                data: { maintenanceId: maintenanceId },
                success: function (response) {
                    var tbody = $('#tasksTableBody');
                    tbody.empty();
                    if (response.success) {
                        if (response.tasks.length === 0) {
                            tbody.append('<tr><td colspan="9" class="text-center">No tasks captured</td></tr>');
                        } else {
                            $.each(response.tasks, function (index, task) {
                                var row = '<tr>' +
                                    '<td>' + task.StartDate + '</td>' +
                                    '<td>' + task.EndDate + '</td>' +
                                    '<td>' + task.Activity + '</td>' +
                                    '<td>' + (task.MaterialUsed || '-') + '</td>' +
                                    '<td>' + (task.QuantityUsed || '-') + '</td>' +
                                    '<td>' + (task.LabourUsed || '-') + '</td>' +
                                    '<td>' + (task.TotalCosts || '-') + '</td>' +
                                    '<td>' + (task.TaskComments || '-') + '</td>' +
                                    '<td>' + (task.HasDocument ? '<i class="fa fa-check text-success"></i> Uploaded' : '<i class="fa fa-times text-danger"></i> None') + '</td>' +
                                    '</tr>';
                                tbody.append(row);
                            });
                        }
                    } else {
                        tbody.append('<tr><td colspan="9" class="text-center text-danger">Failed to load tasks</td></tr>');
                    }
                },
                error: function () {
                    $('#tasksTableBody').html('<tr><td colspan="9" class="text-center text-danger">Error loading tasks</td></tr>');
                }
            });
        }
    </script>
}
