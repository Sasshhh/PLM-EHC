
@model C8.eServices.Mvc.ViewModels.CaptureViewModel
@using C8.eServices.Mvc.Models
@{
    ViewBag.Title = "Create";
    Layout = "~/Views/Shared/RCS_Layout.cshtml";
    PropertyLeaseApplication propertyLeaseApplication = Model.PropertyLeaseApplication;
}

<style>
    /*  h4 {
        font-size: 1.2em;
    }*/
    .require::after {
        content: "*";
        font-weight: bold;
        color: red;
    }

    @@media only screen and (max-width: 1000px) {



        .buttonIcon {
            font-size: 2.5rem !important;
        }

        .chkboxmargin {
            margin-left: 30px;
        }

        .cards tbody tr {
            float: left;
            /*width: 20rem;*/
            width: 90%;
            margin: 0.5rem;
            border: 0.0625rem solid rgba(0,0,0,.125);
            border-radius: .25rem;
            box-shadow: 0.25rem 0.25rem 0.5rem rgba(0,0,0,0.25);
        }

        .cards thead tr {
            float: left;
            /*width: 25rem;*/
            width: 90%;
            margin: 0.5rem;
            border: 0.0625rem solid rgba(0,0,0,.125);
            border-radius: .25rem;
            box-shadow: 0.25rem 0.25rem 0.5rem rgba(0,0,0,0.25);
        }


        .cards tbody td {
            display: block;
            word-wrap: break-word;
        }

        .cards thead th {
            display: none;
        }

        .table tbody label {
            display: block;
        }

        .cards tbody label {
            display: inline;
            position: relative;
            font-size: 85%;
            top: -0.5rem;
            color: #808080;
            min-width: 4rem;
            margin-left: 0;
            margin-right: 1rem;
            text-align: left;
        }

        tr.selected label {
            color: #404040;
        }

        .table .fa {
            font-size: 2.5rem;
            text-align: center;
        }

        .cards .fa {
            font-size: 7.5rem;
        }
    }

    @@media only screen and (max-width: 1000px) {
        .step-app > .step-steps {
            display: inline-block;
            padding: 1px;
            color: white;
            background-color: #848484;
            text-decoration: none;
            border-right: 1px solid #fff;
            word-wrap: break-word;
            width: 100%;
        }
    }

    .button1 {
        font-size: 13px;
    }

    .required:before {
        content: '*';
        color: red;
    }

    input[type='date'] {
        position: relative;
    }

    ::-webkit-datetime-edit, ::-webkit-clear-button, ::-webkit-calendar-picker-indicator {
        position: absolute;
    }

    ::-webkit-clear-button {
        right: 2.5em;
    }

    ::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    ::-webkit-calendar-picker-indicator {
        right: 0;
        padding: .539em .34em;
    }

    input[type="date"]::-webkit-calendar-picker-indicator {
        color: rgba(0, 0, 0, 0);
        opacity: 1;
        display: block;
        background: url('../plm/Content/RcsStyles/calenderIcon.png') no-repeat;
        background-size: 20px 20px;
        width: 20px;
        height: 20px;
        border-width: thin;
        margin-left: 50px;
    }

    body {
        font-family: Arial;
    }

    .number {
        background-color: transparent !important;
        border: 1.5px solid white;
        border-radius: 50px;
        color: white !important;
    }

    .step-app > .step-steps > li > a {
        display: block;
        padding: 10px;
        color: white;
        background-color: #848484;
        text-decoration: none;
        border-right: 1px solid #fff;
    }

    legend {
        display: block;
        width: 100%;
        padding: 0;
        margin-bottom: 20px;
        font-size: 25px;
        line-height: inherit;
        color: #333;
        border: 0;
        background-color: aliceblue;
        border-bottom: 1px solid #00d0ff;
    }

    .error {
        color: tomato;
    }
</style>

<div class="panel-group">
    <div class="panel panel-default">
        <div class="panel-group" style="margin-bottom: -1px;">
            <div class="panel panel-default">
                <div class="panel-heading" align="center">
                    Application Details
                </div>
            </div>
        </div>
        <div id="accountInfoCollapse" class="panel-collapse collapse in tablecss">
            <br />

            <table id="RCSTable" class="table table-bordered table-hover table-striped panel panel-default cards">
                <thead>
                    <tr>
                        <th> Applicant Name </th>
                        <th> Application Type </th>
                        <th> Application Reference No. </th>
                        <th> Application Created Date </th>
                        <th> Status </th>
                        <th> Action </th>
                    </tr>
                </thead>

                <tbody>
                    <tr>
                        <td> @Html.DisplayFor(m => m.PropertyLeaseApplication.FullName) </td>
                        <td> @Html.DisplayFor(m => m.PropertyLeaseApplication.PurchaserType.Name) </td>
                        <td> @Html.DisplayFor(m => m.PropertyLeaseApplication.ApplicationReferenceNumber) </td>
                        <td> @Html.DisplayFor(m => m.PropertyLeaseApplication.CreatedDateTime.Value) </td>
                        <td> @Html.DisplayFor(m => m.PropertyLeaseApplication.Status.Name) </td>
                        <td>
                            @Html.ActionLink("View", "Details", "PropertyLeaseApplication",
                            new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("refNo=" + propertyLeaseApplication.Id), target = "_blank" },
                            new { @class = "btn btn-primary", @target = "_blank" })
                        </td>
                    </tr>

                </tbody>
            </table>
            <br />
            <br />
        </div>

        <div style="width: 90%;margin: 0 auto;">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                <div class="form-horizontal">
                    <div class="step-app">
                        <ul class="step-steps">

                            <li style="text-align:center;"><a href="#step3">Return Application to Waiting List<span class=""></span></a></li>
                        </ul>

                    </div>
                    <div class="panel-group" id="instructions">
                        <div class="panel panel-default">

                            <div id="collapseInstructions" class="panel-collapse collapse in">
                                <div class="panel-body">
                                    @Html.Hidden("Id")
                                    @Html.HiddenFor(model => model.PropertyLeaseApplication.Id, new { htmlAttributes = new { @class = "form-control", @Style = "display:none;", @Name = "Id" } })
                                    @Html.HiddenFor(model => model.LeaseDetails.Id, new { htmlAttributes = new { @class = "form-control", @Style = "display:none;" } })
                                    <div id="AllocateSpaceUnitDiv" style="display:none;">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.PropertyLeaseApplication.HumanEHCOptions.Name, "Unit Bed Type", htmlAttributes: new { @class = "control-label col-md-2" })
                                            <div class="col-md-3">
                                                @Html.EditorFor(model => model.PropertyLeaseApplication.HumanEHCOptions.Name, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                                                @Html.ValidationMessageFor(model => model.PropertyLeaseApplication.HumanEHCOptions.Name, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.PropertyLeaseApplication.PreferredComplexArea.ComplexName, "1st Complex/Area ", htmlAttributes: new { @class = "control-label col-md-2" })
                                            <div class="col-md-3">
                                                @Html.EditorFor(model => model.PropertyLeaseApplication.PreferredComplexArea.Name, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                                                @Html.ValidationMessageFor(model => model.PropertyLeaseApplication.PreferredComplexArea.Name, "", new { @class = "text-danger" })
                                            </div>
                                            @Html.LabelFor(model => model.PropertyLeaseApplication.PreferredComplexArea2.ComplexName, "2nd Complex/Area ", htmlAttributes: new { @class = "control-label col-md-2" })
                                            <div class="col-md-3">
                                                @Html.EditorFor(model => model.PropertyLeaseApplication.PreferredComplexArea2.Name, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                                                @Html.ValidationMessageFor(model => model.PropertyLeaseApplication.PreferredComplexArea2.Name, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                        <br />
                                        <br />
                                        <div class="panel-group" style="margin-bottom: -1px;">
                                            <div class="panel panel-default">
                                                <div class="panel-heading">

                                                    <h4 class="panel-title" align="center">
                                                        <a data-toggle="collapse" data-parent="#accordion" href="#usersCollapse">
                                                            Available Unit Details
                                                        </a>
                                                    </h4>
                                                </div>

                                            </div>
                                        </div>
                                        <br />
                                        <br />
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.ApplicationAllocatedProperties.SpaceUnitNumber, htmlAttributes: new { @class = "control-label col-md-2" })
                                            <div class="col-md-3">
                                                @Html.EditorFor(model => model.ApplicationAllocatedProperties.SpaceUnitNumber, new { htmlAttributes = new { @class = "form-control", @Id = "SpaceUnitNumber", @onfocusout = "ValidateUnit()" } })
                                                @Html.ValidationMessageFor(model => model.ApplicationAllocatedProperties.SpaceUnitNumber, "", new { @class = "text-danger" })
                                            </div>
                                            @Html.LabelFor(model => model.ApplicationAllocatedProperties.SpaceUnitSize, htmlAttributes: new { @class = "control-label col-md-2" })
                                            <div class="col-md-3">
                                                @Html.EditorFor(model => model.ApplicationAllocatedProperties.SpaceUnitSize, new { htmlAttributes = new { @class = "form-control" } })
                                                @Html.ValidationMessageFor(model => model.ApplicationAllocatedProperties.SpaceUnitSize, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.ApplicationAllocatedProperties.SolarReference, htmlAttributes: new { @class = "control-label col-md-2" })
                                            <div class="col-md-3">
                                                @Html.EditorFor(model => model.ApplicationAllocatedProperties.SolarReference, new { htmlAttributes = new { @class = "form-control", @Id = "SolarReference", @onfocusout = "ValidateUnit()" } })
                                                @Html.ValidationMessageFor(model => model.ApplicationAllocatedProperties.SolarReference, "", new { @class = "text-danger" })
                                            </div>
                                            @Html.LabelFor(model => model.ApplicationAllocatedProperties.MonthlyRentalAmount, htmlAttributes: new { @class = "control-label col-md-2" })
                                            <div class="col-md-3">
                                                @Html.EditorFor(model => model.ApplicationAllocatedProperties.MonthlyRentalAmount, new { htmlAttributes = new { @class = "form-control" } })
                                                @Html.ValidationMessageFor(model => model.ApplicationAllocatedProperties.MonthlyRentalAmount, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.ApplicationAllocatedProperties.NumOfBeds, htmlAttributes: new { @class = "control-label col-md-2" })
                                            <div class="col-md-3">
                                                @Html.EditorFor(model => model.ApplicationAllocatedProperties.NumOfBeds, new { htmlAttributes = new { @class = "form-control" } })
                                                @Html.ValidationMessageFor(model => model.ApplicationAllocatedProperties.NumOfBeds, "", new { @class = "text-danger" })
                                            </div>
                                            @Html.LabelFor(model => model.ApplicationAllocatedProperties.RequiedDepositAmount, htmlAttributes: new { @class = "control-label col-md-2" })
                                            <div class="col-md-3">
                                                @Html.EditorFor(model => model.ApplicationAllocatedProperties.RequiedDepositAmount, new { htmlAttributes = new { @class = "form-control" } })
                                                @Html.ValidationMessageFor(model => model.ApplicationAllocatedProperties.RequiedDepositAmount, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.ApplicationAllocatedProperties.StreetName, htmlAttributes: new { @class = "control-label col-md-2" })
                                            <div class="col-md-3">
                                                @Html.EditorFor(model => model.ApplicationAllocatedProperties.StreetName, new { htmlAttributes = new { @class = "form-control" } })
                                                @Html.ValidationMessageFor(model => model.ApplicationAllocatedProperties.StreetName, "", new { @class = "text-danger" })
                                            </div>
                                            @Html.LabelFor(model => model.ApplicationAllocatedProperties.Shower, htmlAttributes: new { @class = "control-label col-md-2" })
                                            <div class="col-md-3">
                                                @Html.EditorFor(model => model.ApplicationAllocatedProperties.Shower, new { htmlAttributes = new { @class = "form-control" } })
                                                @Html.ValidationMessageFor(model => model.ApplicationAllocatedProperties.Shower, "", new { @class = "text-danger" })
                                            </div>
                                        </div>

                                        <div class="form-group">
                                            @Html.LabelFor(model => model.ApplicationAllocatedProperties.Township, htmlAttributes: new { @class = "control-label col-md-2" })
                                            <div class="col-md-3">
                                                @Html.EditorFor(model => model.ApplicationAllocatedProperties.Township, new { htmlAttributes = new { @class = "form-control" } })
                                                @Html.ValidationMessageFor(model => model.ApplicationAllocatedProperties.Township, "", new { @class = "text-danger" })
                                            </div>
                                            @Html.LabelFor(model => model.ApplicationAllocatedProperties.Postal, htmlAttributes: new { @class = "control-label col-md-2" })
                                            <div class="col-md-3">
                                                @Html.EditorFor(model => model.ApplicationAllocatedProperties.Postal, new { htmlAttributes = new { @class = "form-control" } })
                                                @Html.ValidationMessageFor(model => model.ApplicationAllocatedProperties.Postal, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.ApplicationAllocatedProperties.OfferedComplexId, htmlAttributes: new { @class = "control-label col-md-2" })
                                            <div class="col-md-3">
                                                @Html.DropDownListFor(model => model.ApplicationAllocatedProperties.OfferedComplexId, (SelectList)ViewBag.HumanEHCOption, "-- select option -- ", new { @class = "form-control" })
                                                @Html.ValidationMessageFor(model => model.ApplicationAllocatedProperties.OfferedComplexId, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.ApplicationAllocatedProperties.LettingRequirements, htmlAttributes: new { @class = "control-label col-md-2" })
                                            <div class="col-md-8">
                                                @Html.TextAreaFor(model => model.ApplicationAllocatedProperties.LettingRequirements, new { @class = "form-control" })
                                                @Html.ValidationMessageFor(model => model.ApplicationAllocatedProperties.LettingRequirements, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                    </div>


                                    <div class="form-group">
                                        @Html.HiddenFor(model => model.PropertyLeaseApplication.Id)
                                    </div>
                                </div>
                                <div class="step-footer" align="left">
                                    @Html.EncodedActionLink("Cancel", "Index", "RCSApplication", new { id = 0 }, new { @class = "btn btn-outline-primary", @style = "display:none", @id = "Cancelbtn" })
                                </div>
                            </div>
                        </div>
                        <br />
                        <br />
                        <div class="step-footer" align="center">
                            <input type="button" value="Cancel" onclick="location.href='@Url.Action("ApplicantRiskAssessment", "PropertyLeaseApplication")'" name="btnApprovalStatus" class="button1" />

                            @*<button class="button1" value="Cancel" onclick="location.href='@Url.Action("ApplicantRiskAssessment", "PropertyLeaseApplication")'">Cancel</button>*@
                            <input type="button" value="Return to Waiting List" name="btnApproval" onclick="clickSubmit()" class="button1" />
                            <input type="submit" value="Return to Waiting List" style="display:none;" hidden name="btnApprovalStatus" class="button1" id="btnApproval" />
                            <br />
                            <br />
                            <br />
                        </div>

                    </div>

                </div>
            }
        </div>
    </div>

</div>
<div id="waitinglist_busy" class="modal fade" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content" style="width:550px;">
            <div class="modal-header">
                <h4 class="modal-title" id="modalTitleText"></h4>
            </div>
            <div class="modal-body">
                <div class="container">
                    <div class="alert alert-success col-md-5" id="AMYAlert" style="display:block;">
                        <p>Please wait 20 seconds, then action.</p>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-dismiss="modal">Okay</button>
            </div>
        </div>
    </div>
</div>
<script>
    function ValidateUnit() {
        debugger;
        const SolarReference = document.getElementById('SolarReference').value;
        const SpaceUnitNumber = document.getElementById('SpaceUnitNumber').value;
        if ((SolarReference != null && SolarReference != '') && (SpaceUnitNumber != null && SpaceUnitNumber != '')) {
            $.getJSON("../riskAssessmentOutcomes/ValidateUnit?SpaceUnitNumber=" + SpaceUnitNumber + "&SolarReference=" + SolarReference,
                function (result) {
                    debugger;
                    if (result.status) {
                        swal("Warning", result.data, "warning");
                        $('#SolarReference').val('');
                        $('#SpaceUnitNumber').val('');
                    }
                });
        }
    }

    function Cancel() {
        window.location.href = "@Url.Action("Verted", "PropertyLeaseApplication")";
    }
    function clickSubmit() {
        swal({
            icon: "info",
            title: "Are you sure you want to return this application to the bottom of the waiting list?",
            buttons: [
                'No!',
                'Yes, I am sure!'
            ]

        }).then(function (isConfirm) {
            if (isConfirm) {
                document.getElementById("btnApproval").click();
            }
        });
    }


    function WaitingListBusy() {
        debugger;
        $.getJSON("../riskAssessmentOutcomes/ValidateWaitingListSorting",
            function (result) {
                debugger;
                //if (result == true) {
                //    jQuery.noConflict();
                //    $("#waitinglist_busy").modal('show');
                //    $('#waitinglist_busy').modal({
                //        backdrop: 'static',
                //        keyboard: false,
                //        show: true
                //    });
                //} else {
                //    document.getElementById("btnApproval").click();
                //}
            });
    }

    function changestatus() {
        var statusval = document.getElementById("ApprovalStatus").value;
        if (statusval == "Rcs_Rejected") {
            jQuery('#reject').css("display", "block")
            jQuery('#LeetingOfficers').css("display", "none")
            jQuery('#documentsDiv').css("display", "block")
            jQuery('#Approve').css("display", "none")
            jQuery('#AllocateSpaceUnitDiv').css("display", "none")
        } else if (statusval == "Rcs_Approval") {
            jQuery('#reject').css("display", "none")
            jQuery('#LeetingOfficers').css("display", "none")
            jQuery('#Approve').css("display", "block")
            jQuery('#documentsDiv').css("display", "block")
            jQuery('#AllocateSpaceUnitDiv').css("display", "block")
        } else if (statusval == "r_re_allocate_application") {
            jQuery('#reject').css("display", "block")
            jQuery('#LeetingOfficers').css("display", "block")
            jQuery('#Approve').css("display", "none")
            jQuery('#documentsDiv').css("display", "none")
            jQuery('#AllocateSpaceUnitDiv').css("display", "none")
        }

    }


    function isNumber(evt) {
        evt = (evt) ? evt : window.event;
        var charCode = (evt.which) ? evt.which : evt.keyCode;
        if (charCode > 31 && (charCode < 48 || charCode > 57)) {
            return false;
        }
        return true;
    }


    function Submit() {
        var statusval = document.getElementById("ApprovalStatus").value;
        if (statusval == "Rcs_Rejected") {
            var RejectComment = document.getElementById("RejectComment").value;
            if ((RejectComment == null || RejectComment == "")) {
                swal("error", "Please enter rejection comment!", "warning");
            } else {
                document.getElementById("btnApproval").click();
            }

        }
    }

</script>
