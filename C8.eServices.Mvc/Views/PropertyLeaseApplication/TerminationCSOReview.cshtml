
@model IEnumerable<C8.eServices.Mvc.Models.LeaseDetails>
@using C8.eServices.Mvc.Keys;
@{
    Layout = "~/Views/Shared/RCS_Layout.cshtml";
}

<style>
    @@media only screen and (max-width: 1000px) {
        .cards tbody tr {
            float: left;
            width: 90%;
            margin: 0.5rem;
            border: 0.0625rem solid rgba(0,0,0,.125);
            border-radius: .25rem;
            box-shadow: 0.25rem 0.25rem 0.5rem rgba(0,0,0,0.25);
        }
        .cards thead tr {
            float: left;
            width: 90%;
            margin: 0.5rem;
            border: 0.0625rem solid rgba(0,0,0,.125);
            border-radius: .25rem;
            box-shadow: 0.25rem 0.25rem 0.5rem rgba(0,0,0,0.25);
        }
        .cards tbody td { display: block; word-wrap: break-word; }
        .cards thead th { display: none; }
        .table tbody label { display: block; }
        .cards tbody label { display: inline; position: relative; font-size: 85%; top: -0.5rem; color: #808080; min-width: 4rem; margin-left: 0; margin-right: 1rem; text-align: left; }
    }
</style>

<div id="CSOReviewModal" class="modal fade" role="dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Termination Review</h4>
            </div>
            <div class="modal-body">
                <div class="container">
                    <strong>@Html.Raw(ViewBag.CSOTerminationReviewSession)</strong>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>

<div class="panel-group">
    <div class="panel panel-default">
        <div class="panel-group" style="margin-bottom: -1px;">
            <div class="panel panel-default">
                <div class="panel-heading" align="center">
                    Termination Notice Reviews — CSO Review Gate (UC023-S2a)
                </div>
            </div>
        </div>

        <div id="accountInfoCollapse" class="panel-collapse collapse in tablecss">
            <br />
            <table id="RCSTable" class="table table-bordered table-hover table-striped panel panel-default cards">
                <thead>
                    <tr>
                        <th>Lease Ref No.</th>
                        <th>Tenant Name</th>
                        <th>Application Type</th>
                        <th>Date</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@Html.DisplayFor(modelItem => item.LeaseReferenceNo)</td>
                            <td>@Html.DisplayFor(modelItem => item.LastName) @Html.DisplayFor(modelItem => item.FirstNames)</td>
                            <td>@Html.DisplayFor(modelItem => item.PurchaserType.Name)</td>
                            <td>@Html.DisplayFor(modelItem => item.CreatedDateTime.Value)</td>
                            <td>@Html.DisplayFor(modelItem => item.Status.Name)</td>
                            <td>
                                @if (item.Status != null && item.Status.Key == StatusKeys.AwaitingCSOTerminationReview)
                                {
                                    @Html.ActionLink("Review", "TerminationCSOReviewDetails", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("id=" + item.Id.ToString()) }, new { @class = "btn btn-warning" })
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <br />
        </div>
    </div>
</div>

<script>
    $(function () {
        $('#RCSTable').DataTable({
            "responsive": true,
            "order": [[3, "desc"]]
        });
        var session = "@ViewBag.CSOTerminationReviewSession";
        if (session != null && session != "") {
            $('#CSOReviewModal').modal('show');
        }
    });
</script>

