@model C8.eServices.Mvc.ViewModels.DepartmentsApprovalViewModel
@using System.Text;
@using C8.eServices.Mvc.DataAccessLayer;
@using C8.eServices.Mvc.Keys
@{
    ViewBag.Title = "Details";
    Layout = "~/Views/Shared/RCS_Layout.cshtml";
}
<head>
    <style>
        .swal-modal .swal-text {
            text-align: center;
        }
    </style>
</head>
<script src="@Url.Content( "~/Scripts/moment.js" )"></script>
<div id="bankAccountPanel">
    <div class="panel-group" id="instructions">
        <div class="panel panel-default">
            <div class="panel-heading">
                <h4 class="panel-title">
                    <a data-toggle="collapse" data-parent="#accordion" href="#collapseInstructions">
                        <span>Instructions</span>
                    </a>
                </h4>
            </div>
            <div id="collapseInstructions" class="panel-collapse collapse in">
                <div class="panel-body">
                    <p>

                        1) View the generated lease agreement<br />
                        2) Click under the signature action and choose the dropdown option "approve"<br />
                        3) Then select the "approve"" Status from the approval status dropdown<br />
                        4) Then click submit<br />





                    </p>


                </div>
            </div>
        </div>
    </div>
    <div class="panel panel-default">
        <div class="panel-heading">Evaluating Application</div>
        <div style="width: 90%;margin: 0 auto;">
            <br />
            <table id="FailureTable" class="table table-bordered table-hover table-striped panel panel-default display ">
                <thead>
                    <tr>
                        <th>
                            Reference Number
                        </th>
                        <th>
                            Applicant Type
                        </th>
                        <th>
                            Status
                        </th>
                        <th>
                            Captured Date
                        </th>
                        <th>
                            Customer Name
                        </th>
                        <th>
                            Action
                        </th>
                    </tr>
                </thead>
                <tbody>

                    <tr>
                        <td>
                            @Model.PropertyLeaseApplications.ApplicationReferenceNumber
                        </td>
                        <td>
                            @Model.PropertyLeaseApplications.PurchaserType.Name
                        </td>
                        <td>
                            @Model.PropertyLeaseApplications.Status.Name
                        </td>
                        <td>
                            @Model.PropertyLeaseApplications.CreatedDateTime
                        </td>
                        <td>
                            @Model.PropertyLeaseApplications.Customer.FullName
                        </td>
                        <td>
                            @Html.ActionLink("View", "Details", "PropertyLeaseApplication", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("refNo=" + Model.PropertyLeaseApplications.Id.ToString()), target = "_blank" }, new { @class = "btn btn-primary", @target = "_blank" })
                        </td>
                    </tr>

                </tbody>
            </table>



        </div>

        <br />

        <div class="panel-heading">Generated Lease Agreement</div>
        <div style="width: 90%;margin: 0 auto;">
            <br />
            <table id="FailureTable" class="table table-bordered table-hover table-striped panel panel-default display ">
                <thead>
                    <tr>
                        <th>
                            Document Type
                        </th>
                        <th>
                            Document
                        </th>
                        <th>
                            Action
                        </th>

                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>
                            @Model.DocName
                        </td>
                        <td>
                            <input type="button" id="btnExternal" class="button1" value="View" onclick="location.href='@Url.Action("pdfDeneratePropertyLeaseAgreement", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("ApplicationId=" + ViewBag.PropertyLeaseAppliactionId.ToString()) })'" />
                        </td>
                        <td>
                            <div class="form-group">
                                @Html.Label("Revenue Manager Signature", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    <input type="hidden" id="capturedRevenueManagerSignatureData" name="capturedRevenueManagerSignatureData" value="" />
                                    <div id="revenueManagerSignatureStatus" style="margin-bottom:5px;"></div>
                                    <button type="button" class="button1" onclick="openRevenueManagerSignaturePad()">Draw Signature</button>
                                </div>
                            </div>
                        </td>
                    </tr>

                </tbody>
            </table>
        </div>
        <br />
        <div style="width: 90%;margin: 0 auto;">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <br />

                if (ViewBag.ApprovalStatus != null)
                {
                    <div class="form-group">
                        @Html.Label("Approval Status", htmlAttributes: new { @class = "control-label col-md-1" })
                        <div class="col-md-2">
                            @Html.DropDownList("ApprovalStatus", null, "-- Select Option --", htmlAttributes: new { @class = "form-control", @Name = "ApprovalStatusddl", @required = "required", onchange = "ChangeStatus()", @Id = "ApprovalStatus" })
                            @Html.ValidationMessage("ApprovalStatus", "", new { @class = "text-danger" })
                        </div>
                    </div>
                }

                <br />

                <div id="divComment" style="display:none">
                    <div class="form-group">
                        <span> @Html.Label("Comment", htmlAttributes: new { @class = "control-label col-md-1" })<b style="color:red; font-size:x-large;">*</b></span>
                        <div class="col-md-4">
                            @Html.TextArea("Comment", new { @class = "form-control", @Id = "Comment" })
                            @Html.ValidationMessage("Comment", "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <br />
                    <br />
                    <br />
                </div>
                <br />
                <br />

                <div id="divbtn" style="display:block">
                    <input type="button" value="Submit" name="btnApproval" onclick="clickSubmit()" class="button1" />
                    <input type="submit" value="Submit" style="display:none;" hidden name="btnApprovalStatus" class="button1" id="btnApproval" />
                    <br />
                    <br />
                    <br />
                </div>
            }
        </div>
    </div>
</div>

<div id="signaturePadModal" class="modal fade" role="dialog">
    <div class="modal-dialog" style="width:520px;">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Draw Your Signature</h4>
            </div>
            <div class="modal-body" style="text-align:center;">
                <canvas id="signaturePadCanvas" width="460" height="160"></canvas>
                <br /><br />
                <button type="button" class="btn btn-default" onclick="clearSignaturePad()">Clear</button>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                <button type="button" class="button1" onclick="confirmRevenueManagerSignature()">Confirm Signature</button>
            </div>
        </div>
    </div>
</div>

@section Scripts{

    <script src="@Url.Content( "~/scripts/Datatables/jquery.dataTables.min.js" )"></script>
    <script src="@Url.Content( "~/scripts/Datatables/dataTables.bootstrap.js" )"></script>
    <script>
        var _sigCanvas, _sigCtx, _sigDrawing = false, _sigHasMark = false;

        function openRevenueManagerSignaturePad() {
            $('#signaturePadModal').modal({ backdrop: 'static', keyboard: false, show: true });
            _sigCanvas = document.getElementById('signaturePadCanvas');
            _sigCtx = _sigCanvas.getContext('2d');
            _sigCtx.clearRect(0, 0, _sigCanvas.width, _sigCanvas.height);
            _sigHasMark = false;
            _sigCtx.strokeStyle = '#000';
            _sigCtx.lineWidth = 2;
            _sigCtx.lineCap = 'round';

            _sigCanvas.onmousedown = function (e) { _sigDrawing = true; _sigCtx.beginPath(); var r = _sigCanvas.getBoundingClientRect(); _sigCtx.moveTo(e.clientX - r.left, e.clientY - r.top); };
            _sigCanvas.onmousemove = function (e) { if (!_sigDrawing) return; _sigHasMark = true; var r = _sigCanvas.getBoundingClientRect(); _sigCtx.lineTo(e.clientX - r.left, e.clientY - r.top); _sigCtx.stroke(); };
            _sigCanvas.onmouseup = function () { _sigDrawing = false; };
            _sigCanvas.onmouseleave = function () { _sigDrawing = false; };

            _sigCanvas.ontouchstart = function (e) { e.preventDefault(); _sigDrawing = true; _sigCtx.beginPath(); var r = _sigCanvas.getBoundingClientRect(); _sigCtx.moveTo(e.touches[0].clientX - r.left, e.touches[0].clientY - r.top); };
            _sigCanvas.ontouchmove = function (e) { e.preventDefault(); if (!_sigDrawing) return; _sigHasMark = true; var r = _sigCanvas.getBoundingClientRect(); _sigCtx.lineTo(e.touches[0].clientX - r.left, e.touches[0].clientY - r.top); _sigCtx.stroke(); };
            _sigCanvas.ontouchend = function () { _sigDrawing = false; };
        }

        function clearSignaturePad() {
            if (_sigCtx) _sigCtx.clearRect(0, 0, _sigCanvas.width, _sigCanvas.height);
            _sigHasMark = false;
        }

        function confirmRevenueManagerSignature() {
            if (!_sigHasMark) {
                swal('Error', 'Please draw your signature before confirming.', 'warning');
                return;
            }
            var dataUrl = _sigCanvas.toDataURL('image/png');
            $.ajax({
                url: '@Url.Action("SaveRevenueManagerSignatureImage", "PropertyLeaseApplication")',
                type: 'POST',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ ApplicationId: @ViewBag.PropertyLeaseAppliactionId, SignatureImageData: dataUrl }),
                success: function (result) {
                    if (result && result.success) {
                        document.getElementById('capturedRevenueManagerSignatureData').value = dataUrl;
                        document.getElementById('revenueManagerSignatureStatus').innerHTML = '<span style="color:green;"><b>&#10003; Signature captured.</b></span><br/><img src="' + dataUrl + '" style="border:1px solid #ccc;max-width:200px;max-height:60px;" />';
                        $('#signaturePadModal').modal('hide');
                        swal({
                            title: 'Success!',
                            text: 'Signature captured. Downloading lease agreement...',
                            icon: 'success',
                            timer: 2000,
                            buttons: false
                        });
                        setTimeout(function () {
                            window.location.href = '@Url.Action("pdfDeneratePropertyLeaseAgreement", "PropertyLeaseApplication", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("ApplicationId=" + ViewBag.PropertyLeaseAppliactionId.ToString()) })';
                        }, 2000);
                    } else {
                        swal('Error', (result && result.message) ? result.message : 'Failed to save signature.', 'error');
                    }
                },
                error: function () {
                    swal('Error', 'An error occurred while saving the signature.', 'error');
                }
            });
        }

        // Check if signature already captured on page load
        $(document).ready(function () {
            // You can add code here to check if signature is already captured
        });


    function ApproveLeaseAgreement() {
        $.getJSON("../PropertyLeaseApplication/RevenueManagergnLeaseAgreement?id="+@ViewBag.PropertyLeaseAppliactionId ,
        function (result) {
            window.location.href = "@Url.Action("pdfDeneratePropertyLeaseAgreement", "PropertyLeaseApplication", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("ApplicationId=" + ViewBag.PropertyLeaseAppliactionId.ToString()) })";
        });
}

</script>
    <script type="text/javascript">

        function loadAccounts() {
            //debugger;
            $('#FailureTable').DataTable({
                "ajax": {
                    "url": "@Url.Action( "LoadDetails", "DepartmentsApprovals" )",
                    "type": "GET",
                    "datatype": "json",
                    "timeout": 60000
                },
                "columns": [

                    {
                        "data": "CreatedDateTime", "autoWidth": true,
                        "render": function (data) {
                            return convertDate(data);
                        }
                    },
                    {
                        "render": function (data) {
                            return "System";
                        }
                    },
                    { "data": "FailureReason", "autoWidth": true },
                    {
                        "data": "CapturedDate", "autoWidth": true,
                        "render": function (data) {
                            return convertDate(data);
                        }
                    },

                     { "data": "AssignedTo", "autoWidth": true }],
                "language": {
                    "emptyTable": "No Data.",
                },
                "Initcomplete": "",
                "destroy": true
            });
        }

        function convertDate(data) {
            try {
                var dtStart = new Date(parseInt(data.substr(6)));
                var dtStartWrapper = moment(dtStart);
                return dtStartWrapper.format("YYYY-MM-DD");
            }
            catch (ex) {
            }
        }

        $(function () {
            $('#RCSTable').DataTable();

        });

    </script>

}

<script>
    function ChangeStatus() {
        var status = document.getElementById("ApprovalStatus").value;
        if (status == "plm_not_supported_tenant" || status == "plm_not_supported_cso" || status == "Rcs_Rejected") {
            jQuery('#divComment').css("display", "block");
        } else {
            jQuery('#divComment').css("display", "none");
        }
    }
    function clickSubmit() {
        var status = document.getElementById("ApprovalStatus").value;
        var isRejection = (status == "plm_not_supported_tenant" || status == "plm_not_supported_cso" || status == "Rcs_Rejected");

        if (!isRejection) {
            var sigData = document.getElementById("capturedRevenueManagerSignatureData").value;
            if (!sigData || sigData === "") {
                swal("Error", "Please draw and confirm your signature before approving.", "warning");
                return;
            }
        }
        swal({
            icon: "info",
            title: "Are you sure you want to submit this lease agreement?",
            buttons: [
                'No!',
                'Yes, I am sure!'
            ]

        }).then(function (isConfirm) {
            if (isConfirm) {
                if (isRejection) {
                    var Comment = document.getElementById("Comment").value;
                    if (Comment == "" || Comment == null) {
                        swal("Error", "Comment required when rejecting", "warning");
                    } else {
                        document.getElementById("btnApproval").click();
                    }
                } else {
                    document.getElementById("btnApproval").click();
                }
            }
        });
    }

</script>
