@model C8.eServices.Mvc.ViewModels.DepartmentsApprovalViewModel
@using System.Text;
@using C8.eServices.Mvc.DataAccessLayer;
@using C8.eServices.Mvc.Keys
@{
    ViewBag.Title = "Details";
    Layout = "~/Views/Shared/RCS_Layout.cshtml";
}
<head>
    <style>
        .swal-modal .swal-text {
            text-align: center;
        }
    </style>
</head>
<script src="@Url.Content( "~/Scripts/moment.js" )"></script>
<div id="bankAccountPanel">
    <div class="panel panel-default">
        <div class="panel-heading">Evaluating Application</div>
        <div style="width: 90%;margin: 0 auto;">
            <br />
            <table id="FailureTable" class="table table-bordered table-hover table-striped panel panel-default display ">
                <thead>
                    <tr>
                        <th>
                            Reference Number
                        </th>
                        <th>
                            Applicant Type
                        </th>
                        <th>
                            Status
                        </th>
                        <th>
                            Captured Date
                        </th>
                        <th>
                            Customer Name
                        </th>
                        <th>
                            Action
                        </th>
                    </tr>
                </thead>
                <tbody>

                    <tr>
                        <td>
                            @Model.PropertyLeaseApplications.ApplicationReferenceNumber
                        </td>
                        <td>
                            @Model.PropertyLeaseApplications.PurchaserType.Name
                        </td>
                        <td>
                            @Model.PropertyLeaseApplications.Status.Name
                        </td>
                        <td>
                            @Model.PropertyLeaseApplications.CreatedDateTime
                        </td>
                        <td>
                            @Model.PropertyLeaseApplications.Customer.FullName
                        </td>
                        <td>
                            @Html.ActionLink("View", "Details", "PropertyLeaseApplication", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("refNo=" + Model.PropertyLeaseApplications.Id.ToString()), target = "_blank" }, new { @class = "btn btn-primary", @target = "_blank" })
                        </td>
                    </tr>

                </tbody>
            </table>
        </div>
        <br />
        <div class="panel-heading">Unit Inspection Details</div>
        <div style="width: 90%;margin: 0 auto;">
            <br />
            <table id="FailureTable" class="table table-bordered table-hover table-striped panel panel-default display ">
                <thead>
                    <tr>
                        <th>
                           Inspection Date
                        </th>
                        <th>
                            Inspection Comment
                        </th>
                        <th>
                            Inspecton By
                        </th>
                    </tr>
                </thead>
                <tbody>

                    <tr>
                        <td>
                            @Model.ConductUnitInspection.CreatedDateTime
                        </td>
                        <td>
                            @Model.ConductUnitInspection.InspectionComment
                        </td>
                        <td>
                            @Model.ConductUnitInspection.CreatedBySystemUser.FullName
                        </td>
                    </tr>

                </tbody>
            </table>



        </div>

        <br />

        <div class="panel-heading">
            Maintenance Job Sheet Template
            <a href="@Url.Action("DownloadMaintenanceJobCardTemplate", "PropertyLeaseApplication")" class="btn btn-sm btn-info pull-right" style="margin-top: -5px;">
                <i class="fa fa-download"></i> Download Job Card Template
            </a>
        </div>
        <div style="width: 90%;margin: 0 auto; padding: 15px; background-color: #f0f8ff; border: 1px solid #d1ecf1;">
            <p style="margin: 0; color: #004085;">
                <i class="fa fa-info-circle"></i> 
                <strong>Note:</strong> Download the Maintenance Job Sheet Template to complete offline, then upload the completed form below.
            </p>
        </div>
        <br />

        <div class="panel-heading">Upload Completed Maintenance Job Sheet </div>
        @Html.Partial("_DocumentsPartialConductUnitInspection", Model.DocumentsViewModel)

        <br />

        <!-- Task Capture Section -->
        <div class="panel-heading">Task Capture - Step 9 (Capture Maintenance Tasks)</div>
        <div style="width: 90%;margin: 0 auto;">
            <br />
            <div id="taskCaptureForm" style="border: 1px solid #ddd; padding: 15px; margin-bottom: 20px; background-color: #f9f9f9;">
                <div class="form-group">
                    <label class="control-label col-md-2">Start Date *</label>
                    <div class="col-md-4">
                        <input type="date" id="taskStartDate" class="form-control" required />
                    </div>
                    <label class="control-label col-md-2">End Date *</label>
                    <div class="col-md-4">
                        <input type="date" id="taskEndDate" class="form-control" required />
                    </div>
                </div>
                <div class="clearfix"></div>
                <br />

                <div class="form-group">
                    <label class="control-label col-md-2">Activity *</label>
                    <div class="col-md-10">
                        <input type="text" id="taskActivity" class="form-control" maxlength="500" required placeholder="Enter activity description" />
                    </div>
                </div>
                <div class="clearfix"></div>
                <br />

                <div class="form-group">
                    <label class="control-label col-md-2">Material Used</label>
                    <div class="col-md-4">
                        <input type="text" id="taskMaterialUsed" class="form-control" maxlength="200" />
                    </div>
                    <label class="control-label col-md-2">Quantity Used</label>
                    <div class="col-md-4">
                        <input type="number" id="taskQuantityUsed" class="form-control" step="0.01" />
                    </div>
                </div>
                <div class="clearfix"></div>
                <br />

                <div class="form-group">
                    <label class="control-label col-md-2">Labour Used</label>
                    <div class="col-md-4">
                        <input type="text" id="taskLabourUsed" class="form-control" maxlength="200" />
                    </div>
                    <label class="control-label col-md-2">Total Costs</label>
                    <div class="col-md-4">
                        <input type="number" id="taskTotalCosts" class="form-control" step="0.01" />
                    </div>
                </div>
                <div class="clearfix"></div>
                <br />

                <div class="form-group">
                    <label class="control-label col-md-2">Task Comments</label>
                    <div class="col-md-10">
                        <textarea id="taskComments" class="form-control" rows="3" maxlength="1000"></textarea>
                    </div>
                </div>
                <div class="clearfix"></div>
                <br />

                <div class="form-group">
                    <label class="control-label col-md-2">Supporting Document</label>
                    <div class="col-md-6">
                        <input type="file" id="taskSupportingDoc" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <button type="button" class="btn btn-primary" onclick="addTask()">
                            <i class="fa fa-plus"></i> Add Task
                        </button>
                    </div>
                </div>
                <div class="clearfix"></div>
            </div>

            <div id="tasksListContainer">
                <h4>Captured Tasks</h4>
                <table id="tasksTable" class="table table-bordered table-hover table-striped">
                    <thead>
                        <tr>
                            <th>Start Date</th>
                            <th>End Date</th>
                            <th>Activity</th>
                            <th>Material</th>
                            <th>Quantity</th>
                            <th>Labour</th>
                            <th>Total Cost</th>
                            <th>Comments</th>
                            <th>Document</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="tasksTableBody">
                        <!-- Tasks will be loaded here -->
                    </tbody>
                </table>
            </div>
        </div>
        <br />

        <!-- Job Card Documents Section -->
        <div class="panel-heading">Job Card Documents - Upload Before & After Images</div>
        <div style="width: 90%;margin: 0 auto;">
            <br />
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="control-label">Before Image</label>
                        <input type="file" id="beforeImage" class="form-control" accept="image/*" />
                        <button type="button" class="btn btn-primary" style="margin-top: 10px;" onclick="uploadBeforeImage()">
                            <i class="fa fa-upload"></i> Upload Before Image
                        </button>
                        <div id="beforeImageStatus" style="margin-top: 10px;"></div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="control-label">After Image</label>
                        <input type="file" id="afterImage" class="form-control" accept="image/*" />
                        <button type="button" class="btn btn-primary" style="margin-top: 10px;" onclick="uploadAfterImage()">
                            <i class="fa fa-upload"></i> Upload After Image
                        </button>
                        <div id="afterImageStatus" style="margin-top: 10px;"></div>
                    </div>
                </div>
            </div>
            <br />
            <div class="text-center">
                <button type="button" class="btn btn-success btn-lg" onclick="submitJobCardForSignOff()" id="btnSubmitJobCard">
                    <i class="fa fa-check"></i> Submit Job Card for Sign-Off
                </button>
            </div>
            <br />
        </div>
        <br />

        <!-- Signature Section -->
        <div id="signatureSection" style="display: none;">
            <div class="panel-heading">Signature Section - Maintenance Manager Sign-Off</div>
            <div style="width: 90%;margin: 0 auto;">
                <br />
                <div class="alert alert-info">
                    <strong>Instructions:</strong> Enter your official number and authorize, then capture your signature below.
                </div>

                <div class="form-group">
                    <label class="control-label col-md-2">Official Number *</label>
                    <div class="col-md-4">
                        <input type="text" id="officialNumber" class="form-control" maxlength="50" required />
                    </div>
                    <div class="col-md-2">
                        <button type="button" class="btn btn-warning" onclick="authorizeSignature()">
                            <i class="fa fa-key"></i> Authorize
                        </button>
                    </div>
                </div>
                <div class="clearfix"></div>
                <br />

                <div id="signatureFormSection" style="display: none;">
                    <div class="form-group">
                        <label class="control-label col-md-2">Approval Action *</label>
                        <div class="col-md-4">
                            <select id="approvalAction" class="form-control" required>
                                <option value="">-- Select --</option>
                                <option value="Approve">Approve</option>
                                <option value="Reject">Reject</option>
                            </select>
                        </div>
                    </div>
                    <div class="clearfix"></div>
                    <br />

                    <div class="form-group">
                        <label class="control-label col-md-2">Reason (Mandatory) *</label>
                        <div class="col-md-10">
                            <textarea id="signatureReason" class="form-control" rows="3" maxlength="1000" required></textarea>
                        </div>
                    </div>
                    <div class="clearfix"></div>
                    <br />

                    <div class="form-group">
                        <label class="control-label col-md-2">Capture Signature *</label>
                        <div class="col-md-10">
                            <div style="border: 2px solid #000; width: 600px; height: 150px;">
                                <canvas id="signaturePad" width="600" height="150"></canvas>
                            </div>
                            <button type="button" class="btn btn-default" style="margin-top: 10px;" onclick="clearSignature()">
                                <i class="fa fa-eraser"></i> Clear Signature
                            </button>
                        </div>
                    </div>
                    <div class="clearfix"></div>
                    <br />

                    <div class="text-center">
                        <button type="button" class="btn btn-success btn-lg" onclick="submitSignature()">
                            <i class="fa fa-check"></i> Submit Signature
                        </button>
                    </div>
                </div>
                <br />
            </div>
        </div>
        <br />


