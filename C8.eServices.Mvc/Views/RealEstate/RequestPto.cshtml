@model C8.eServices.Mvc.Models.RE_Application
@{
    ViewBag.Title = "Request Permission to Occupy";
    Layout = "~/Views/Shared/RCS_Layout.cshtml";
}

<style>
    :root {
        --re-gold: #c59b27;
        --re-gold-hover: #a37f1c;
        --re-border-color: #e7e5e4;
        --re-slate-dark: #2e2a27;
        --re-slate-black: #1c1917;
    }

    .re-container {
        padding: 30px 15px;
        font-family: 'Inter', sans-serif;
    }

    .re-header-card {
        background: linear-gradient(135deg, var(--re-slate-dark) 0%, var(--re-slate-black) 100%);
        color: #ffffff;
        border-radius: 12px;
        padding: 25px 30px;
        margin-bottom: 25px;
        border-left: 5px solid var(--re-gold);
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .info-card {
        background: #ffffff;
        border: 1px solid var(--re-border-color);
        border-radius: 12px;
        padding: 20px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    }

    .info-card h4 {
        margin-top: 0;
        margin-bottom: 15px;
        font-weight: 700;
        color: var(--re-slate-black);
        border-bottom: 2px solid var(--re-gold);
        padding-bottom: 6px;
        font-size: 15px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .info-item {
        display: flex;
        justify-content: space-between;
        padding: 8px 0;
        border-bottom: 1px dashed #f1f5f9;
        font-size: 13px;
    }

    .info-item:last-child {
        border-bottom: none;
    }

    .info-label {
        font-weight: 600;
        color: #64748b;
    }

    .info-value {
        color: #1e293b;
        font-weight: 500;
        text-align: right;
    }

    .form-card {
        background: #ffffff;
        border: 1px solid var(--re-border-color);
        border-radius: 12px;
        padding: 24px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        margin-bottom: 25px;
    }

    .btn-re-gold {
        background-color: var(--re-gold);
        color: #ffffff;
        border: 1px solid var(--re-gold);
        padding: 10px 24px;
        border-radius: 6px;
        font-weight: 600;
        cursor: pointer;
        font-size: 14px;
    }

    .btn-re-gold:hover {
        background-color: var(--re-gold-hover);
        border-color: var(--re-gold-hover);
    }

    .btn-cancel {
        background-color: transparent;
        border: 1px solid #cbd5e1;
        color: #475569;
        text-decoration: none;
        padding: 10px 24px;
        border-radius: 6px;
        font-weight: 600;
        font-size: 14px;
        display: inline-block;
    }

    .btn-cancel:hover {
        background-color: #f1f5f9;
        color: #1e293b;
    }
</style>

<div class="re-container">
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger" style="border-radius: 8px; border-left: 4px solid #dc2626;">
            <i class="fa fa-exclamation-circle"></i> @TempData["ErrorMessage"]
        </div>
    }

    <div class="re-header-card">
        <h1 style="margin:0 0 5px 0; font-size:24px; font-weight:700;">Request Permission to Occupy (PTO)</h1>
        <p style="margin:0; font-size:14px; color:#cbd5e1;">Submit early occupation details and upload compliance documents for reference @Model.ApplicationReferenceNumber.</p>
    </div>

    <div class="info-grid">
        <div class="info-card">
            <h4>Application Details</h4>
            <div class="info-item">
                <span class="info-label">Reference Number:</span>
                <span class="info-value" style="font-weight:700;">@Model.ApplicationReferenceNumber</span>
            </div>
            <div class="info-item">
                <span class="info-label">Premises Address:</span>
                <span class="info-value">@Model.PropertyAddress</span>
            </div>
            <div class="info-item">
                <span class="info-label">Unit Code:</span>
                <span class="info-value">@(Model.SelectedFacilityUnit != null ? Model.SelectedFacilityUnit.UnitType : "N/A")</span>
            </div>
        </div>

        <div class="info-card">
            <h4>Lease Specifications</h4>
            <div class="info-item">
                <span class="info-label">Calculated Rental:</span>
                <span class="info-value" style="color:var(--re-gold); font-weight:700;">R @string.Format("{0:N2}", Model.CalculatedMonthlyRental) / month</span>
            </div>
            <div class="info-item">
                <span class="info-label">Facility Name:</span>
                <span class="info-value">@(Model.SelectedFacility != null ? Model.SelectedFacility.Name : "N/A")</span>
            </div>
            <div class="info-item">
                <span class="info-label">Current Status:</span>
                <span class="info-value">@(Model.Status != null ? Model.Status.Name : "Approved")</span>
            </div>
        </div>
    </div>

    @using (Html.BeginForm("RequestPto", "RealEstate", new { id = Model.Id }, FormMethod.Post, new { enctype = "multipart/form-data", id = "ptoForm" }))
    {
        @Html.AntiForgeryToken()

        <div class="form-card">
            <h4 style="margin-top:0; margin-bottom: 20px; font-weight: 700; font-size:16px; border-bottom: 2px solid var(--re-gold); padding-bottom: 8px;">Occupation Period & Purpose</h4>

            <div class="form-group">
                <label style="font-weight:600; color:#475569;">Purpose of Occupation (Fit-out work, early storage, etc.) *</label>
                @Html.TextArea("purpose", "", new { @class = "form-control", rows = "3", required = "required", placeholder = "Describe what you will use the space for during early occupation...", id = "txtPurpose" })
            </div>

            <div class="row" style="margin-top: 15px;">
                <div class="col-md-6 form-group">
                    <label style="font-weight:600; color:#475569;">Start Date *</label>
                    <input type="date" name="startDate" class="form-control" required="required" id="txtStartDate" value="@(DateTime.Today.ToString("yyyy-MM-dd"))" />
                </div>
                <div class="col-md-6 form-group">
                    <label style="font-weight:600; color:#475569;">End Date (Max 12 months from start date) *</label>
                    <input type="date" name="endDate" class="form-control" required="required" id="txtEndDate" value="@(DateTime.Today.AddMonths(1).ToString("yyyy-MM-dd"))" />
                </div>
            </div>
        </div>

        <div class="form-card">
            <h4 style="margin-top:0; margin-bottom: 20px; font-weight: 700; font-size:16px; border-bottom: 2px solid var(--re-gold); padding-bottom: 8px;">Required Compliance Documents</h4>
            
            <div class="form-group">
                <label style="font-weight:600; color:#475569;">1. Public Liability Certificate of Insurance *</label>
                <input type="file" name="fileInsurance" class="form-control-file" required="required" id="fileInsurance" />
                <span class="text-muted" style="font-size:11px;">Proof of public liability insurance cover.</span>
            </div>

            <div class="form-group" style="margin-top:15px;">
                <label style="font-weight:600; color:#475569;">2. Detailed Fit-out & Layout Plans *</label>
                <input type="file" name="fileFitout" class="form-control-file" required="required" id="fileFitout" />
                <span class="text-muted" style="font-size:11px;">Architectural or layout designs detailing interior changes.</span>
            </div>

            <div class="form-group" style="margin-top:15px;">
                <label style="font-weight:600; color:#475569;">3. Health & Safety Plan / Clearance *</label>
                <input type="file" name="fileHealthSafety" class="form-control-file" required="required" id="fileHealthSafety" />
                <span class="text-muted" style="font-size:11px;">OHSA compliance plan for interior construction or setup.</span>
            </div>
        </div>

        <div class="form-card">
            <h4 style="margin-top:0; margin-bottom: 20px; font-weight: 700; font-size:16px; border-bottom: 2px solid var(--re-gold); padding-bottom: 8px;">Indemnity Acceptance</h4>

            <div class="form-group">
                <div class="checkbox">
                    <label style="font-weight:700; color:var(--re-slate-black); font-size:14px; cursor:pointer;">
                        <input type="checkbox" name="acceptIndemnity" value="true" required="required" id="chkIndemnity" />
                        I accept the Indemnity Terms & Conditions *
                    </label>
                </div>
                <p style="margin:5px 0 0 20px; font-size:12.5px; color:#475569; line-height:1.5;">
                    By checking this box, the applicant indemnifies the Municipality/EHC against any claims, losses, damages, or injuries sustained during the early occupation period prior to the formal lease commencement date.
                </p>
            </div>
        </div>

        <div style="margin-top: 25px; display:flex; gap:12px; margin-bottom:40px;">
            <button type="button" class="btn-re-gold" id="btn-submit-pto" onclick="validateAndSubmit()">
                <i class="fa fa-send"></i> Submit PTO Request
            </button>
            <a href="@Url.Action("MyApplications", "RealEstate")" class="btn-cancel">
                Cancel
            </a>
        </div>
    }
</div>

@section Scripts {
    <script>
        function validateAndSubmit() {
            let purpose = $('#txtPurpose').val();
            let startDateVal = $('#txtStartDate').val();
            let endDateVal = $('#txtEndDate').val();
            let chk = $('#chkIndemnity').is(':checked');

            let insurance = $('#fileInsurance').val();
            let fitout = $('#fileFitout').val();
            let safety = $('#fileHealthSafety').val();

            if (!purpose || purpose.trim() === '') {
                alert('Purpose of occupation is required.');
                return;
            }

            if (!startDateVal || !endDateVal) {
                alert('Start and End dates are required.');
                return;
            }

            let start = new Date(startDateVal);
            let end = new Date(endDateVal);
            let today = new Date();
            today.setHours(0, 0, 0, 0);

            if (start < today) {
                alert('The start date cannot fall in the past.');
                return;
            }

            if (end <= start) {
                alert('The end date must be after the start date.');
                return;
            }

            let diffTime = Math.abs(end - start);
            let diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
            if (diffDays > 366) {
                alert('The requested PTO period cannot exceed the maximum allowable period of 12 months.');
                return;
            }

            if (!insurance || !fitout || !safety) {
                alert('All supporting compliance documents are mandatory.');
                return;
            }

            if (!chk) {
                alert('You must accept the Indemnity Terms & Conditions to proceed.');
                return;
            }

            $('#ptoForm').submit();
        }
    </script>
}
