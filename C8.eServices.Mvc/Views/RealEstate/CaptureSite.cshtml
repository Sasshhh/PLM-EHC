            <div class="col-xs-12 col-sm-6 col-md-2 form-group ">
                <label for="Application_PropertyPostalCode" class="req">Postal Code</label>
                @Html.TextBoxFor(m => m.Application.PropertyPostalCode, new { @class = "form-control", maxlength = "4" })
                @Html.ValidationMessageFor(m => m.Application.PropertyPostalCode, "", new { @class = "text-danger" })
            </div>
            <div class="col-xs-12 col-sm-6 col-md-4 form-group ">
