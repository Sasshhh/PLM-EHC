@model C8.eServices.Mvc.ViewModels.RE_SiteApplicationViewModel
@using C8.eServices.Mvc.Models
@{
    ViewBag.Title = Model.FormTitle;
    Layout = "~/Views/Shared/RCS_Layout.cshtml";
    var docs = (List<C8.eServices.Mvc.Controllers.RealEstateController.RE_SiteDocument>)ViewBag.SiteDocuments;
    bool isDraft = Model.Application != null && Model.Application.Id > 0;
}
<link rel="stylesheet" href="~/Content/RealEstate/re-forms.css?v=20261127" />

<div class="re-container re-form-page">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success"><i class="fa fa-check-circle"></i> @TempData["SuccessMessage"]</div>
    }

    <div class="re-header-card">
        <div class="re-eyebrow"><i class="fa fa-file-text-o"></i> Real Estate &middot; @Model.LeaseType</div>
        <h1>@Model.FormTitle</h1>
        <p>Fill in each section below. You can save and come back to it at any time. The application fee is paid after you submit.</p>
        <span class="re-chip"><i class="fa fa-tag"></i> Reference @Model.ReferencePrefix YYYY/#### on submit</span>
        @if (isDraft)
        {
            <span class="re-chip"><i class="fa fa-floppy-o"></i> Saved draft</span>
        }
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger"><strong>Please correct the errors below:</strong> @Html.ValidationSummary(false, "")</div>
    }

    @using (Html.BeginForm("CaptureSite", "RealEstate", FormMethod.Post, new { enctype = "multipart/form-data", id = "siteForm", novalidate = "novalidate" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.Application.Id)
        @Html.HiddenFor(m => m.LeaseType)
        <input type="hidden" name="submitAction" id="submitAction" value="submit" />

        if (Model.FormCode == "OA")
        {
        <div class="re-card" data-step="Property">
            <div class="re-card-header"><i class="fa fa-map-marker"></i><h3 class="re-card-title">Section A: Property Details</h3></div>
            <div class="re-card-body"><div class="row">
            <div class="col-xs-12 col-sm-6 form-group ">
                <label for="Site_SignLocationType" class="req">Will the advertising sign be erected on</label>
                @Html.DropDownListFor(m => m.Site.SignLocationType, new SelectList(RE_LeaseLookups.SignLocationTypes, Model.Site.SignLocationType), "-- Select --", new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.Site.SignLocationType, "", new { @class = "text-danger" })
            </div>
            <div class="col-xs-12 col-sm-6 col-md-3 form-group ">
                <label for="Site_SignType" class="req">Sign Type</label>
                @Html.DropDownListFor(m => m.Site.SignType, new SelectList(RE_LeaseLookups.SignTypes, Model.Site.SignType), "-- Select --", new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.Site.SignType, "", new { @class = "text-danger" })
            </div>
            <div class="col-xs-12 col-sm-6 col-md-3 form-group " id="wrapSignTypeOther">
                <label for="Site_SignTypeOther">Other sign type, please specify</label>
                @Html.TextBoxFor(m => m.Site.SignTypeOther, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.Site.SignTypeOther, "", new { @class = "text-danger" })
            </div>
            <div class="col-xs-12 col-sm-6 col-md-3 form-group ">
                <label class="req">Will the sign be illuminated?</label>
                <div class="re-seg" role="radiogroup">
                    <label class="radio-inline">@Html.RadioButtonFor(m => m.Site.SignIlluminated, true, new { id = "Site_SignIlluminated_Yes" }) Yes</label>
                    <label class="radio-inline">@Html.RadioButtonFor(m => m.Site.SignIlluminated, false, new { id = "Site_SignIlluminated_No" }) No</label>
                </div>
                @Html.ValidationMessageFor(m => m.Site.SignIlluminated, "", new { @class = "text-danger" })
            </div>
            <div class="col-xs-12 col-sm-6 col-md-3 form-group ">
                <label for="Site_SignElevations" class="req">Number of Elevations</label>
                @Html.DropDownListFor(m => m.Site.SignElevations, new SelectList(RE_LeaseLookups.SignElevations, Model.Site.SignElevations), "-- Select --", new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.Site.SignElevations, "", new { @class = "text-danger" })
            </div>
            <div class="col-xs-12 col-sm-6 col-md-3 form-group " id="wrapSignElevationsOther">
                <label for="Site_SignElevationsOther">Other, indicate number of elevations</label>
                @Html.TextBoxFor(m => m.Site.SignElevationsOther, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.Site.SignElevationsOther, "", new { @class = "text-danger" })
            </div>
            <div class="col-xs-12 col-sm-6 col-md-4 form-group ">
                <label for="Site_AdvertisingSignReferenceNumber">Advertising Sign Reference Number</label>
                @Html.TextBoxFor(m => m.Site.AdvertisingSignReferenceNumber, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.Site.AdvertisingSignReferenceNumber, "", new { @class = "text-danger" })
            </div>
            <div class="col-xs-12 col-sm-6 col-md-4 form-group ">
                <label for="Site_RealEstateReferenceNumber">Real Estate Reference Number</label>
                @Html.TextBoxFor(m => m.Site.RealEstateReferenceNumber, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.Site.RealEstateReferenceNumber, "", new { @class = "text-danger" })
            </div>
            <div class="col-xs-12 col-sm-6 col-md-4 form-group ">
                <label for="Site_CityPlanningReferenceNumber">City Planning Reference Number</label>
                @Html.TextBoxFor(m => m.Site.CityPlanningReferenceNumber, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.Site.CityPlanningReferenceNumber, "", new { @class = "text-danger" })
            </div>
            @* DPRE-Q08 (26 Nov 2026): the old town list is replaced by the Customer Care Area below. *@
            <div class="col-xs-12 col-sm-6 col-md-4 form-group ">
                <label for="Application_CCCId" class="req">Customer Care Area</label>
                @Html.DropDownListFor(m => m.Application.CCCId, new SelectList((IEnumerable<SelectListItem>)ViewBag.CCCList, "Value", "Text", Model.Application.CCCId), "-- Select --", new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.Application.CCCId, "", new { @class = "text-danger" })
            </div>
            <div class="col-xs-12 col-sm-6 col-md-4 form-group ">
                <label for="Application_ErfFarmNumber" class="req">ERF / Farm Portion / Agricultural Holding Number</label>
                @Html.TextBoxFor(m => m.Application.ErfFarmNumber, new { @class = "form-control" })
                <small class="text-muted">For a road reserve, give the ERF number of the adjacent property</small>
                @Html.ValidationMessageFor(m => m.Application.ErfFarmNumber, "", new { @class = "text-danger" })
            </div>
            <div class="col-xs-12 col-sm-6 form-group " id="wrapFarmDescription">
                <label for="Site_FarmPortionDescription" class="req">Farm Portion/Agricultural Holding Description</label>
                @Html.TextBoxFor(m => m.Site.FarmPortionDescription, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.Site.FarmPortionDescription, "", new { @class = "text-danger" })
            </div>
            <div class="col-xs-12 col-sm-6 form-group " id="wrapPropertyAddress">
                <label for="Application_PropertyAddress" class="req">Physical Address of the property</label>
                @Html.TextBoxFor(m => m.Application.PropertyAddress, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.Application.PropertyAddress, "", new { @class = "text-danger" })
            </div>
            <div class="col-xs-12 col-sm-6 col-md-4 form-group oa-road">
                <label for="Site_RoadReserveStreetName" class="req">Street Name</label>
                @Html.TextBoxFor(m => m.Site.RoadReserveStreetName, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.Site.RoadReserveStreetName, "", new { @class = "text-danger" })
            </div>
            <div class="col-xs-12 col-sm-6 col-md-4 form-group oa-road">
                <label for="Site_RoadReserveNearestIntersection" class="req">Name of Nearest Intersecting Street</label>
                @Html.TextBoxFor(m => m.Site.RoadReserveNearestIntersection, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.Site.RoadReserveNearestIntersection, "", new { @class = "text-danger" })
            </div>
            <div class="col-xs-12 col-sm-6 col-md-4 form-group oa-road">
                <label for="Site_RoadReserveAdjacentProperty" class="req">Description of Adjacent Property</label>
                @Html.TextBoxFor(m => m.Site.RoadReserveAdjacentProperty, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.Site.RoadReserveAdjacentProperty, "", new { @class = "text-danger" })
            </div>
            <div class="col-xs-12 col-sm-6 col-md-4 form-group ">
                <label for="Application_TownshipSuburbFarmName" class="req">Township</label>
                @Html.TextBoxFor(m => m.Application.TownshipSuburbFarmName, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.Application.TownshipSuburbFarmName, "", new { @class = "text-danger" })
            </div>
            <div class="col-xs-12 col-sm-6 col-md-2 form-group ">
                <label for="Application_PropertyPostalCode" class="req">Postal Code</label>
                @Html.TextBoxFor(m => m.Application.PropertyPostalCode, new { @class = "form-control", maxlength = "4" })
                @Html.ValidationMessageFor(m => m.Application.PropertyPostalCode, "", new { @class = "text-danger" })
            </div>
            </div></div>
        </div>
        }

        if (Model.FormCode == "TEL")
        {
        <div class="re-card" data-step="Property">
            <div class="re-card-header"><i class="fa fa-signal"></i><h3 class="re-card-title">Section A: Property Details</h3></div>
            <div class="re-card-body"><div class="row">
            <div class="col-xs-12 col-sm-6 col-md-4 form-group ">
                <label for="Application_ErfFarmNumber" class="req">ERF Number / Farm Description</label>
                @Html.TextBoxFor(m => m.Application.ErfFarmNumber, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.Application.ErfFarmNumber, "", new { @class = "text-danger" })
            </div>
            <div class="col-xs-12 col-sm-6 col-md-4 form-group ">
                <label for="Application_TownshipSuburbFarmName" class="req">Township / Suburb</label>
                @Html.TextBoxFor(m => m.Application.TownshipSuburbFarmName, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.Application.TownshipSuburbFarmName, "", new { @class = "text-danger" })
            </div>
            <div class="col-xs-12 col-sm-6 col-md-4 form-group ">
                <label for="Application_CCCId" class="req">Customer Care Area</label>
                @Html.DropDownListFor(m => m.Application.CCCId, new SelectList((IEnumerable<SelectListItem>)ViewBag.CCCList, "Value", "Text", Model.Application.CCCId), "-- Select --", new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.Application.CCCId, "", new { @class = "text-danger" })
            </div>
            <div class="col-xs-12 col-sm-6 form-group ">
                <label for="Application_PropertyAddress" class="req">Property's Physical Address</label>
                @Html.TextBoxFor(m => m.Application.PropertyAddress, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.Application.PropertyAddress, "", new { @class = "text-danger" })
            </div>
            <div class="col-xs-12 col-sm-6 col-md-2 form-group ">
                <label for="Application_PropertyPostalCode" class="req">Postal Code</label>
                @Html.TextBoxFor(m => m.Application.PropertyPostalCode, new { @class = "form-control", maxlength = "4" })
                @Html.ValidationMessageFor(m => m.Application.PropertyPostalCode, "", new { @class = "text-danger" })
            </div>
            <div class="col-xs-12 col-sm-6 col-md-4 form-group ">
                <label for="Site_Zoning" class="req">Zoning</label>
                @Html.TextBoxFor(m => m.Site.Zoning, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.Site.Zoning, "", new { @class = "text-danger" })
            </div>
            <div class="col-xs-12 col-sm-6 col-md-4 form-group ">
                <label for="Site_SiteName" class="req">Site Name</label>
                @Html.TextBoxFor(m => m.Site.SiteName, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.Site.SiteName, "", new { @class = "text-danger" })
            </div>
            <div class="col-xs-12 col-sm-6 col-md-4 form-group ">
                <label for="Site_SiteNumber">Site Number</label>
                @Html.TextBoxFor(m => m.Site.SiteNumber, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.Site.SiteNumber, "", new { @class = "text-danger" })
            </div>
            <div class="col-xs-12 col-sm-6 col-md-2 form-group ">
                <label for="Site_Latitude" class="req">Latitude (decimal degrees)</label>
                @Html.TextBoxFor(m => m.Site.Latitude, new { @class = "form-control", type = "number", step = "any", placeholder = "-26.1234" })
                @Html.ValidationMessageFor(m => m.Site.Latitude, "", new { @class = "text-danger" })
            </div>
            <div class="col-xs-12 col-sm-6 col-md-2 form-group ">
                <label for="Site_Longitude" class="req">Longitude (decimal degrees)</label>
                @Html.TextBoxFor(m => m.Site.Longitude, new { @class = "form-control", type = "number", step = "any", placeholder = "28.1234" })
                @Html.ValidationMessageFor(m => m.Site.Longitude, "", new { @class = "text-danger" })
            </div>
            <div class="col-xs-12 col-md-8 form-group ">
                <label for="Site_InstallationType" class="req">Telecommunications Infrastructure Installation</label>
                @Html.DropDownListFor(m => m.Site.InstallationType, new SelectList(RE_LeaseLookups.TelecomInstallationTypes, Model.Site.InstallationType), "-- Select --", new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.Site.InstallationType, "", new { @class = "text-danger" })
            </div>
            <div class="col-xs-12 col-sm-6 col-md-4 form-group " id="wrapInstallationOther">
                <label for="Site_InstallationTypeOther">Other installation, please specify</label>
                @Html.TextBoxFor(m => m.Site.InstallationTypeOther, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.Site.InstallationTypeOther, "", new { @class = "text-danger" })
            </div>
            <div class="col-xs-12 col-sm-6 col-md-4 form-group ">
                <label for="Site_AreaOnStructureSqm">Area on top of Water Tower or attached to Mast/Tower (m²)</label>
                @Html.TextBoxFor(m => m.Site.AreaOnStructureSqm, new { @class = "form-control", type = "number", step = "any" })
                @Html.ValidationMessageFor(m => m.Site.AreaOnStructureSqm, "", new { @class = "text-danger" })
            </div>
            <div class="col-xs-12 col-sm-6 col-md-4 form-group ">
                <label for="Site_AreaGroundSqm">Area at Ground Level Base Station (m²)</label>
                @Html.TextBoxFor(m => m.Site.AreaGroundSqm, new { @class = "form-control", type = "number", step = "any" })
                @Html.ValidationMessageFor(m => m.Site.AreaGroundSqm, "", new { @class = "text-danger" })
            </div>
            <div class="col-xs-12 col-sm-6 col-md-2 form-group ">
                <label for="Site_ProposedLeaseYears" class="req">Proposed Lease Term: Years</label>
                @Html.TextBoxFor(m => m.Site.ProposedLeaseYears, new { @class = "form-control", type = "number", step = "1", min = "0" })
                @Html.ValidationMessageFor(m => m.Site.ProposedLeaseYears, "", new { @class = "text-danger" })
            </div>
            <div class="col-xs-12 col-sm-6 col-md-2 form-group ">
                <label for="Site_ProposedLeaseMonths">Months</label>
                @Html.TextBoxFor(m => m.Site.ProposedLeaseMonths, new { @class = "form-control", type = "number", step = "1", min = "0", max = "11" })
                @Html.ValidationMessageFor(m => m.Site.ProposedLeaseMonths, "", new { @class = "text-danger" })
            </div>
            <div class="col-xs-12 col-sm-6 col-md-4 form-group ">
                <label class="req">Option to Renew?</label>
                <div class="re-seg" role="radiogroup">
                    <label class="radio-inline">@Html.RadioButtonFor(m => m.Site.OptionToRenew, true, new { id = "Site_OptionToRenew_Yes" }) Yes</label>
                    <label class="radio-inline">@Html.RadioButtonFor(m => m.Site.OptionToRenew, false, new { id = "Site_OptionToRenew_No" }) No</label>
                </div>
                @Html.ValidationMessageFor(m => m.Site.OptionToRenew, "", new { @class = "text-danger" })
            </div>
            </div></div>
        </div>
        }

        if (Model.FormCode == "LH")
        {
        <div class="re-card" data-step="Property">
            <div class="re-card-header"><i class="fa fa-map"></i><h3 class="re-card-title">Section A: Property Details</h3></div>
            <div class="re-card-body"><div class="row">
            <div class="col-xs-12 col-sm-6 col-md-4 form-group ">
