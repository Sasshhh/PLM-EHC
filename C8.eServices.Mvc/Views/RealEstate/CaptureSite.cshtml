                @Html.TextBoxFor(m => m.Site.ProposedLeaseYears, new { @class = "form-control", type = "number", step = "1", min = "0" })
                @Html.ValidationMessageFor(m => m.Site.ProposedLeaseYears, "", new { @class = "text-danger" })
