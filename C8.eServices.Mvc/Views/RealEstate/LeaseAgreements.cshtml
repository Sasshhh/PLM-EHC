@model IEnumerable<C8.eServices.Mvc.Models.RE_Application>
@{
    ViewBag.Title = "My Lease Agreements";
    Layout = "~/Views/Shared/RCS_Layout.cshtml";
}

<style>
    :root {
        --re-gold: #c59b27;
        --re-gold-hover: #a37f1c;
        --re-gold-light: #fafaf9;
        --re-text-dark: #1c1917;
        --re-border-color: #e7e5e4;
    }

    .re-container {
        padding: 30px 15px;
        font-family: 'Inter', Arial, sans-serif;
        color: var(--re-text-dark);
    }

    .re-header-card {
        background: linear-gradient(135deg, #2e2a27 0%, #1c1917 100%);
        color: #ffffff;
        border-radius: 12px;
        padding: 30px;
        margin-bottom: 30px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
    }

    .re-header-title {
        font-size: 28px;
        font-weight: 700;
        margin: 0 0 10px 0;
    }

    .re-card {
        background: #ffffff;
        border: 1px solid var(--re-border-color);
        border-radius: 12px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        padding: 20px;
    }

    .re-table {
        width: 100%;
        margin-bottom: 0;
    }

    .re-table th {
        background-color: #f8fafc !important;
        color: #475569 !important;
        font-weight: 600 !important;
        padding: 16px 20px !important;
        border-bottom: 2px solid var(--re-border-color) !important;
    }

    .re-table td {
        padding: 16px 20px !important;
        border-bottom: 1px solid var(--re-border-color) !important;
        vertical-align: middle !important;
    }

    .ref-badge {
        font-family: 'Courier New', Courier, monospace;
        font-weight: 700;
        background-color: #f1f5f9;
        padding: 4px 8px;
        border-radius: 6px;
        border: 1px solid #cbd5e1;
    }

    .status-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 12px;
        border-radius: 50px;
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
    }

    .status-active {
        background-color: #dcfce7;
        color: #16a34a;
    }

    .status-pending {
        background-color: #fef3c7;
        color: #d97706;
    }

    .status-action-required {
        background-color: #fee2e2;
        color: #dc2626;
    }

    .btn-re {
        background-color: var(--re-gold);
        color: white;
        border: none;
        border-radius: 6px;
        padding: 8px 16px;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: background-color 0.2s;
    }

    .btn-re:hover {
        background-color: var(--re-gold-hover);
        color: white;
    }
</style>

<div class="re-container">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            <i class="fa fa-check-circle"></i> @TempData["SuccessMessage"]
        </div>
    }

    <div class="re-header-card">
        <h1 class="re-header-title">My Lease Agreements</h1>
        <p style="margin: 0; color: #94a3b8;">Manage and sign your commercial lease contracts and Permission to Occupy agreements.</p>
    </div>

    <div class="re-card">
        @if (Model == null || !Model.Any())
        {
            <div style="text-align: center; padding: 40px; color: #64748b;">
                <i class="fa fa-file-text-o style='font-size: 48px; color: #cbd5e1; margin-bottom: 15px;'"></i>
                <p style="font-weight: 600;">No Lease Agreements Found</p>
            </div>
        }
        else
        {
            <table class="table re-table">
                <thead>
                    <tr>
                        <th>Reference</th>
                        <th>Property Details</th>
                        <th>Category / Type</th>
                        <th>Monthly Rental</th>
                        <th>Status</th>
                        <th style="text-align: center;">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var app in Model)
                    {
                        var statusClass = "status-pending";
                        var statusName = app.Status != null ? app.Status.Name : "Awaiting Actions";

                        if (app.Status != null)
                        {
                            if (app.Status.Key == "re_active" || app.Status.Key == "re_active_occupancy")
                            {
                                statusClass = "status-active";
                            }
                            else if (app.Status.Key == "re_awaiting_agreement_conclusion")
                            {
                                statusClass = "status-action-required";
                                statusName = "Signature Required";
                            }
                        }

                        <tr>
                            <td>
                                <span class="ref-badge">@app.ApplicationReferenceNumber</span>
                                @if (!string.IsNullOrEmpty(app.UniqueTenancyLeaseNumber))
                                {
                                    <div style="font-size: 11px; margin-top: 4px; color: #64748b;">Lease: @app.UniqueTenancyLeaseNumber</div>
                                }
                            </td>
                            <td>
                                <div style="font-weight: 600;">@app.PropertyAddress</div>
                                <div style="font-size: 12px; color: #64748b;">@app.TownshipSuburbFarmName</div>
                            </td>
                            <td>
                                <div>@(app.LeaseCategory ?? "Pending Classification")</div>
                                <div style="font-size: 11px; color: #64748b;">@app.ApplicantType</div>
                            </td>
                            <td>
                                <strong>R @(app.CalculatedMonthlyRental.HasValue ? app.CalculatedMonthlyRental.Value.ToString("N2") : "0.00")</strong>
                            </td>
                            <td>
                                <span class="status-pill @statusClass">
                                    <i class="fa fa-circle" style="font-size: 8px;"></i>
                                    @statusName
                                </span>
                            </td>
                            <td style="text-align: center;">
                                @if (app.Status != null && app.Status.Key == "re_awaiting_agreement_conclusion")
                                {
                                    <a href="@Url.Action("SignLeaseAgreement", "RealEstate", new { id = app.Id })" class="btn-re" id="btn-sign-agreement-@app.Id">
                                        <i class="fa fa-pencil"></i> Sign Agreement
                                    </a>
                                }
                                else if (!string.IsNullOrEmpty(app.UniqueTenancyLeaseNumber))
                                {
                                    <span style="color: #64748b; font-size: 13px;"><i class="fa fa-check-circle text-success"></i> Fully Signed</span>
                                }
                                else
                                {
                                    <span style="color: #64748b; font-size: 13px;">Processing...</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
