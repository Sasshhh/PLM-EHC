@model C8.eServices.Mvc.Models.RE_Application
@{
    ViewBag.Title = "Upload Proof of Payment";
    Layout = "~/Views/Shared/RCS_Layout.cshtml";
}

<style>
    .pop-container { padding: 30px 15px; font-family: 'Inter', sans-serif; max-width: 760px; }
    .pop-header { background: linear-gradient(135deg, #2e2a27 0%, #1c1917 100%); color: #fff; border-radius: 12px; padding: 25px 30px; margin-bottom: 25px; border-left: 5px solid #c59b27; }
    .pop-header h1 { font-size: 24px; font-weight: 700; margin: 0 0 6px 0; }
    .pop-header p { color: #cbd5e1; margin: 0; }
    .pop-card { background: #fff; border: 1px solid #e7e5e4; border-radius: 12px; padding: 24px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); }
    .pop-row { display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px dashed #e7e5e4; font-size: 14px; }
    .pop-row span:first-child { color: #64748b; font-weight: 600; }
    .pop-btn { background-color: #c59b27; border: none; color: #fff; border-radius: 8px; padding: 10px 20px; font-weight: 600; }
    .pop-btn:hover { background-color: #a37f1c; }
</style>

<div class="pop-container">
    <div class="pop-header">
        <h1><i class="fa fa-upload"></i> Upload Proof of Payment</h1>
        <p>Pay the application fee, then upload the EFT receipt or deposit slip here so your application can be processed.</p>
    </div>

    <div class="pop-card">
        <div class="pop-row"><span>Reference Number</span><span>@Model.ApplicationReferenceNumber</span></div>
        <div class="pop-row"><span>Lease Type</span><span>@(string.IsNullOrEmpty(Model.LeaseType) ? "Business Hub" : Model.LeaseType)</span></div>
        <div class="pop-row"><span>Applicant</span><span>@Model.EntityName</span></div>
        <div class="pop-row"><span>Status</span><span>@(Model.Status != null ? Model.Status.Name : "")</span></div>

        @if (!string.IsNullOrEmpty(Model.PaymentValidationComment))
        {
            <div class="alert alert-warning" style="margin-top: 18px; border-radius: 8px;">
                <strong>Your previous proof of payment was not accepted.</strong><br />
                Reason: @Model.PaymentValidationComment
            </div>
        }

        @using (Html.BeginForm("UploadProofOfPayment", "RealEstate", new { id = Model.Id }, FormMethod.Post, new { enctype = "multipart/form-data", id = "frmUploadPop" }))
        {
            @Html.AntiForgeryToken()
            <div class="form-group" style="margin-top: 20px;">
                <label for="file_Fee" style="font-weight: 600;">Proof of Application Fee Payment <span style="color: #dc2626;">*</span></label>
                <input type="file" name="file_Fee" id="file_Fee" class="form-control" accept=".pdf,.png,.jpg,.jpeg" required />
                <small style="color: #64748b;">PDF, PNG or JPG, up to 10 MB.</small>
                @Html.ValidationMessage("file_Fee", "", new { @class = "text-danger", style = "display: block;" })
            </div>
            <div style="display: flex; gap: 10px; justify-content: flex-end;">
                <a href="@Url.Action("MyApplications", "RealEstate")" class="btn btn-default" style="border-radius: 8px;" id="btn-pop-cancel">Cancel</a>
                <button type="submit" class="pop-btn" id="btn-pop-submit"><i class="fa fa-check"></i> Submit Proof of Payment</button>
            </div>
        }
    </div>
</div>
