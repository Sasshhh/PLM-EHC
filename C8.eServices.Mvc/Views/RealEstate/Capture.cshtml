@model C8.eServices.Mvc.ViewModels.RE_CaptureViewModel
@{
    ViewBag.Title = "Capture Lease Application";
    Layout = "~/Views/Shared/RCS_Layout.cshtml";
}

<style>
    /* Premium Real Estate Gold/Amber Design Theme */
    :root {
        --re-gold: #c59b27;
        --re-gold-hover: #a37f1c;
        --re-gold-light: #fafaf9;
        --re-text-dark: #1c1917;
        --re-border-color: #e7e5e4;
    }

    .re-container {
        padding: 30px 15px;
        font-family: 'Inter', 'Outfit', 'Helvetica Neue', Arial, sans-serif;
        color: var(--re-text-dark);
    }

    .re-header-card {
        background: linear-gradient(135deg, #2e2a27 0%, #1c1917 100%);
        color: #ffffff;
        border-radius: 12px;
        padding: 30px;
        margin-bottom: 30px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
        position: relative;
        overflow: hidden;
    }

    .re-header-card::before {
        content: '';
        position: absolute;
        top: -50px;
        right: -50px;
        width: 150px;
        height: 150px;
        background: rgba(197, 155, 39, 0.15);
        border-radius: 50%;
        filter: blur(30px);
    }

    .re-header-title {
        font-size: 28px;
        font-weight: 700;
        margin: 0 0 10px 0;
        letter-spacing: -0.5px;
    }

    .re-header-subtitle {
        font-size: 15px;
        color: #94a3b8;
        margin: 0;
        line-height: 1.6;
    }

    .re-card {
        background: #ffffff;
        border: 1px solid var(--re-border-color);
        border-radius: 12px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
        margin-bottom: 30px;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .re-card:hover {
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.08), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
    }

    .re-card-header {
        background-color: var(--re-gold-light);
        border-bottom: 1px solid var(--re-border-color);
        padding: 18px 24px;
        border-top-left-radius: 11px;
        border-top-right-radius: 11px;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .re-card-title {
        font-size: 18px;
        font-weight: 600;
        color: #1e293b;
        margin: 0;
    }

    .re-card-body {
        padding: 24px;
    }

    .re-form-label {
        font-weight: 600;
        color: #334155;
        font-size: 13px;
        margin-bottom: 8px;
        display: block;
    }

    .re-form-control {
        border-radius: 8px !important;
        border: 1px solid #cbd5e1 !important;
        padding: 10px 14px !important;
        height: auto !important;
        font-size: 14px !important;
        transition: all 0.2s ease !important;
        box-shadow: none !important;
    }

    .re-form-control:focus {
        border-color: var(--re-gold) !important;
        box-shadow: 0 0 0 3px rgba(197, 155, 39, 0.15) !important;
        outline: none !important;
    }

    .re-grid-2 {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
    }

    @@media (max-width: 768px) {
        .re-grid-2 {
            grid-template-columns: 1fr;
        }
    }

    /* Document upload grid */
    .doc-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
    }

    @@media (max-width: 992px) {
        .doc-grid {
            grid-template-columns: 1fr;
        }
    }

    .doc-upload-card {
        border: 1px solid var(--re-border-color);
        border-radius: 10px;
        padding: 16px;
        background: #f8fafc;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        position: relative;
        transition: all 0.2s ease;
    }

    .doc-upload-card:hover {
        border-color: #cbd5e1;
        background: #f1f5f9;
    }

    .doc-info {
        margin-bottom: 12px;
    }

    .doc-title {
        font-size: 14px;
        font-weight: 600;
        color: #1e293b;
        margin-bottom: 4px;
    }

    .doc-desc {
        font-size: 12px;
        color: #64748b;
    }

    .doc-input-wrapper {
        position: relative;
        overflow: hidden;
        display: inline-block;
        width: 100%;
    }

    .doc-file-label {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        background-color: #ffffff;
        border: 1px dashed #cbd5e1;
        border-radius: 6px;
        padding: 10px;
        font-size: 13px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s ease;
        text-align: center;
        width: 100%;
        color: #475569;
    }

    .doc-file-label:hover {
        border-color: var(--re-gold);
        color: var(--re-gold);
        background-color: var(--re-gold-light);
    }

    .doc-file-input {
        position: absolute;
        top: 0;
        right: 0;
        margin: 0;
        padding: 0;
        font-size: 20px;
        cursor: pointer;
        opacity: 0;
        filter: alpha(opacity=0);
        height: 100%;
        width: 100%;
    }

    .selected-filename {
        margin-top: 6px;
        font-size: 12px;
        color: #16a34a;
        font-weight: 500;
        display: none;
        align-items: center;
        gap: 4px;
    }

    .required-badge {
        color: #ef4444;
        font-weight: bold;
        margin-left: 2px;
    }

    .checkbox-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
    }

    @@media (max-width: 768px) {
        .checkbox-grid {
            grid-template-columns: 1fr;
        }
    }

    .checkbox-item {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        background: #f8fafc;
        padding: 12px;
        border-radius: 8px;
        border: 1px solid var(--re-border-color);
        transition: all 0.2s ease;
    }

    .checkbox-item:hover {
        border-color: #cbd5e1;
        background: #f1f5f9;
    }

    .checkbox-item input[type="checkbox"] {
        margin-top: 3px;
        cursor: pointer;
        width: 16px;
        height: 16px;
        accent-color: var(--re-gold);
    }

    .checkbox-label {
        font-size: 13px;
        font-weight: 500;
        color: #334155;
        cursor: pointer;
    }

    .re-btn-primary {
        background-color: var(--re-gold) !important;
        border-color: var(--re-gold) !important;
        color: #ffffff !important;
        border-radius: 8px !important;
        padding: 12px 28px !important;
        font-weight: 600 !important;
        font-size: 15px !important;
        transition: all 0.2s ease !important;
        box-shadow: 0 4px 6px -1px rgba(197, 155, 39, 0.2) !important;
    }

    .re-btn-primary:hover {
        background-color: var(--re-gold-hover) !important;
        border-color: var(--re-gold-hover) !important;
        box-shadow: 0 10px 15px -3px rgba(197, 155, 39, 0.3) !important;
        transform: translateY(-1px);
    }

    .re-btn-secondary {
        background-color: #f1f5f9 !important;
        border-color: #cbd5e1 !important;
        color: #475569 !important;
        border-radius: 8px !important;
        padding: 12px 28px !important;
        font-weight: 600 !important;
        font-size: 15px !important;
        transition: all 0.2s ease !important;
    }

    .re-btn-secondary:hover {
        background-color: #e2e8f0 !important;
        color: #1e293b !important;
    }

    .text-danger {
        color: #ef4444;
        font-size: 12px;
        margin-top: 4px;
        display: block;
        font-weight: 500;
    }

    .alert-danger-custom {
        background-color: #fef2f2;
        border: 1px solid #fee2e2;
        color: #991b1b;
        border-radius: 8px;
        padding: 16px;
        margin-bottom: 25px;
    }

    /* Tabs for Document Uploads Section */
    .re-nav-tabs {
        border-bottom: 2px solid var(--re-border-color) !important;
        margin-bottom: 25px;
        display: flex;
        gap: 8px;
        padding-left: 0;
        list-style: none;
    }
    
    .re-nav-tabs > li {
        margin-bottom: -2px;
    }
    
    .re-nav-tabs > li > a {
        border: none !important;
        background: transparent !important;
        color: #64748b !important;
        font-weight: 600;
        font-size: 14px;
        padding: 12px 20px;
        border-radius: 0 !important;
        border-bottom: 2px solid transparent !important;
        transition: all 0.2s ease;
        display: flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
    }
    
    .re-nav-tabs > li > a:hover {
        color: var(--re-gold-hover) !important;
        background-color: transparent !important;
    }
    
    .re-nav-tabs > li.active > a {
        color: var(--re-gold) !important;
        border-bottom: 2px solid var(--re-gold) !important;
        background: transparent !important;
    }
</style>

<div class="re-container">
    <div class="re-header-card">
        <h1 class="re-header-title">Submit Lease Application</h1>
        <p class="re-header-subtitle">
            Real Estate Development (RED) Department. Complete the details below, specify your desired facility or letting space details, and upload the mandatory pre-qualification documents.
        </p>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger-custom">
            <h4 style="margin-top: 0; font-weight: 600;"><i class="fa fa-exclamation-triangle"></i> Please correct the errors below:</h4>
            @Html.ValidationSummary(false, "")
        </div>
    }

    @using (Html.BeginForm("Capture", "RealEstate", null, FormMethod.Post, new { enctype = "multipart/form-data", id = "realEstateForm", @class = "form-horizontal" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.Application.CustomerId)
        @Html.HiddenFor(m => m.Application.SystemUserId)

        <!-- Section 1: Applicant Profile -->
        <div class="re-card">
            <div class="re-card-header">
                <i class="fa fa-user" style="color: var(--re-gold); font-size: 18px;"></i>
                <h3 class="re-card-title">1. Applicant & Entity Details</h3>
            </div>
            <div class="re-card-body">
                <div class="re-grid-2">
                    <div class="form-group" style="margin: 0;">
                        <label class="re-form-label">Applicant Type<span class="required-badge">*</span></label>
                        @Html.DropDownListFor(m => m.Application.ApplicantType, (IEnumerable<SelectListItem>)ViewBag.ApplicantTypes, new { @class = "form-control re-form-control", id = "ddlApplicantType" })
                    </div>
                </div>

                <hr style="border-color: var(--re-border-color); margin: 20px 0;" />

                <!-- Dynamic section for Entity/Individual details -->
                <div class="re-grid-2">
                    <div class="form-group" style="margin: 0;" id="divEntityName">
                        <label class="re-form-label" id="lblEntityName">Entity/Business Name<span class="required-badge">*</span></label>
                        @Html.TextBoxFor(m => m.Application.EntityName, new { @class = "form-control re-form-control", required = "required" })
                    </div>

                    <div class="form-group" style="margin: 0;" id="divRegNo">
                        <label class="re-form-label" id="lblRegNo">Company Registration Number<span class="required-badge">*</span></label>
                        @Html.TextBoxFor(m => m.Application.CompanyRegistrationNumber, new { @class = "form-control re-form-control", required = "required", pattern = @"\d{4}/\d{6}/\d{2}", title = "Format must be YYYY/NNNNNN/NN (as per CIPC Standard)", placeholder = "e.g. 2026/123456/07", maxlength = "14" })
                    </div>

                    <div class="form-group" style="margin: 0;" id="divVatNo">
                        <label class="re-form-label">VAT Registration Number</label>
                        @Html.TextBoxFor(m => m.Application.VatRegistrationNumber, new { @class = "form-control re-form-control", pattern = @"4\d{9}", title = "VAT Registration Number must be a 10 digit number starting with 4", placeholder = "e.g. 4123456789", maxlength = "10" })
                    </div>

                    <div class="form-group" style="margin: 0;" id="divTaxNo">
                        <label class="re-form-label">SARS Tax Reference Number<span class="required-badge">*</span></label>
                        @Html.TextBoxFor(m => m.Application.TaxReferenceNumber, new { @class = "form-control re-form-control", required = "required", pattern = @"\d{10}", title = "SARS Tax Reference Number must be exactly 10 digits", placeholder = "e.g. 1234567890", maxlength = "10" })
                    </div>

                    <div class="form-group" style="margin: 0;" id="divRepName">
                        <label class="re-form-label">Authorized Representative Name<span class="required-badge">*</span></label>
                        @Html.TextBoxFor(m => m.Application.AuthorizedRepresentativeName, new { @class = "form-control re-form-control", id = "txtRepName" })
                    </div>

                    <div class="form-group" style="margin: 0;" id="divRepCapacity">
                        <label class="re-form-label">Authorized Representative Capacity<span class="required-badge">*</span></label>
                        @Html.TextBoxFor(m => m.Application.AuthorizedRepresentativeCapacity, new { @class = "form-control re-form-control", id = "txtRepCapacity" })
                    </div>
                </div>

                <hr style="border-color: var(--re-border-color); margin: 20px 0;" />

                <h4 style="font-size: 14px; font-weight: 600; margin-bottom: 15px; color: #1e293b;">Contact & Address Details</h4>
                
                <div class="re-grid-2">
                    <div class="form-group" style="margin: 0;">
                        <label class="re-form-label" id="lblAddress">Registered Address<span class="required-badge">*</span></label>
                        @Html.TextBoxFor(m => m.Application.EntityRegisteredAddress, new { @class = "form-control re-form-control", required = "required" })
                    </div>

                    <div class="form-group" style="margin: 0;">
                        <label class="re-form-label">Postal Code<span class="required-badge">*</span></label>
                        @Html.TextBoxFor(m => m.Application.EntityRegisteredPostalCode, new { @class = "form-control re-form-control", required = "required", pattern = @"\d{4}", title = "Postal Code must be exactly 4 digits", placeholder = "e.g. 1401", maxlength = "4" })
                    </div>

                    <div class="form-group" style="margin: 0;" id="divTel">
                        <label class="re-form-label">Telephone Number</label>
                        @Html.TextBoxFor(m => m.Application.EntityTelephone, new { @class = "form-control re-form-control", pattern = @"0\d{9}", title = "Telephone Number must be exactly 10 digits starting with 0", placeholder = "e.g. 0119991234", maxlength = "10" })
                    </div>

                    <div class="form-group" style="margin: 0;">
                        <label class="re-form-label" id="lblMobile">Mobile Number<span class="required-badge">*</span></label>
                        @Html.TextBoxFor(m => m.Application.EntityMobile, new { @class = "form-control re-form-control", required = "required", pattern = @"0\d{9}", title = "Mobile/Cell Number must be exactly 10 digits starting with 0", placeholder = "e.g. 0829991234", maxlength = "10" })
                    </div>

                    <div class="form-group" style="margin: 0;" id="divFax">
                        <label class="re-form-label">Fax Number</label>
                        @Html.TextBoxFor(m => m.Application.EntityFax, new { @class = "form-control re-form-control", pattern = @"0\d{9}", title = "Fax Number must be exactly 10 digits starting with 0", placeholder = "e.g. 0119991235", maxlength = "10" })
                    </div>

                    <div class="form-group" style="margin: 0;">
                        <label class="re-form-label" id="lblEmail">Email Address<span class="required-badge">*</span></label>
                        @Html.TextBoxFor(m => m.Application.EntityEmail, new { @class = "form-control re-form-control", required = "required", type = "email" })
                    </div>
                </div>
            </div>
        </div>

        <!-- Section 2: Space / Lease Details -->
        <div class="re-card">
            <div class="re-card-header">
                <i class="fa fa-building" style="color: var(--re-gold); font-size: 18px;"></i>
                <h3 class="re-card-title">2. Space / Lease Specification</h3>
            </div>
            <div class="re-card-body">
                <div class="re-grid-2">
                    <div class="form-group" style="margin: 0;">
                        <label class="re-form-label">Purpose of Lease<span class="required-badge">*</span></label>
                        @Html.DropDownListFor(m => m.Application.PurposeOfLease, (IEnumerable<SelectListItem>)ViewBag.PurposesOfLease, new { @class = "form-control re-form-control" })
                    </div>

                    <div class="form-group" style="margin: 0;">
                        <label class="re-form-label">Customer Care Centre (CCC) Area<span class="required-badge">*</span></label>
                        @Html.DropDownListFor(m => m.Application.CCCId, (IEnumerable<SelectListItem>)ViewBag.CCCList, "Select CCC Area...", new { @class = "form-control re-form-control", required = "required" })
                    </div>

                    <div class="form-group" style="margin: 0;">
                        <label class="re-form-label">Erf / Farm Number<span class="required-badge">*</span></label>
                        @Html.TextBoxFor(m => m.Application.ErfFarmNumber, new { @class = "form-control re-form-control", required = "required" })
                    </div>

                    <div class="form-group" style="margin: 0;">
                        <label class="re-form-label">Property Address<span class="required-badge">*</span></label>
                        @Html.TextBoxFor(m => m.Application.PropertyAddress, new { @class = "form-control re-form-control", required = "required" })
                    </div>

                    <div class="form-group" style="margin: 0;">
                        <label class="re-form-label">Township / Suburb / Farm Name<span class="required-badge">*</span></label>
                        @Html.TextBoxFor(m => m.Application.TownshipSuburbFarmName, new { @class = "form-control re-form-control", required = "required" })
                    </div>

                    <div class="form-group" style="margin: 0;">
                        <label class="re-form-label">Property Postal Code<span class="required-badge">*</span></label>
                        @Html.TextBoxFor(m => m.Application.PropertyPostalCode, new { @class = "form-control re-form-control", required = "required", pattern = @"\d{4}", title = "Property Postal Code must be exactly 4 digits", placeholder = "e.g. 1401", maxlength = "4" })
                    </div>
                </div>

                <hr style="border-color: var(--re-border-color); margin: 20px 0;" />

                <h4 style="font-size: 14px; font-weight: 600; margin-bottom: 15px; color: #1e293b;">Facility & Letting Space Selection</h4>
                
                @Html.HiddenFor(m => m.Application.SelectedUnitsJson, new { id = "hfSelectedUnitsJson" })

                <div class="re-grid-2" style="margin-bottom: 20px;">
                    <div class="form-group" style="margin: 0;">
                        <label class="re-form-label">Select Letting Facility / Site<span class="required-badge">*</span></label>
                        @Html.DropDownListFor(m => m.Application.SelectedFacilityId, new List<SelectListItem>(), "Select a Facility...", new { @class = "form-control re-form-control", id = "ddlSelectedFacility", disabled = "disabled" })
                    </div>

                    <div class="form-group" style="margin: 0;">
                        <label class="re-form-label">Select Unit Type & Specification<span class="required-badge">*</span></label>
                        @Html.DropDownListFor(m => m.Application.SelectedFacilityUnitId, new List<SelectListItem>(), "Select a Unit Type...", new { @class = "form-control re-form-control", id = "ddlSelectedUnit", disabled = "disabled" })
                    </div>

                    <div class="form-group" style="margin: 0; position: relative;">
                        <label class="re-form-label">Number of Units (Max limit applies)<span class="required-badge">*</span></label>
                        @Html.TextBoxFor(m => m.Application.SelectedUnitCount, new { @class = "form-control re-form-control", id = "txtUnitCount", type = "number", min = "1", max = "4", disabled = "disabled", value = "1" })
                        <small id="lblMaxUnitsWarning" class="text-muted" style="font-size: 12px; display: block; position: absolute; bottom: -20px; left: 0; margin: 0;"></small>
                    </div>

                    <div class="form-group" style="margin: 0; display: flex; flex-direction: column; justify-content: flex-end; height: 100%;">
                        <label class="re-form-label" style="visibility: hidden;">&nbsp;</label>
                        <button type="button" id="btnAddUnit" class="btn re-btn-primary" style="width: 100%; height: 42px; display: flex; align-items: center; justify-content: center; gap: 8px; margin: 0;">
                            <i class="fa fa-plus-circle"></i> Add Unit to Selection
                        </button>
                    </div>
                </div>

                <!-- Live Selection Grid -->
                <div id="selectionGridWrapper" style="display: none; margin-top: 25px;">
                    <h5 style="margin-top: 0; margin-bottom: 12px; font-weight: 700; color: #1e293b; text-transform: uppercase; font-size: 13px; letter-spacing: 0.5px; display: flex; align-items: center; gap: 8px;">
                        <i class="fa fa-th-list" style="color: var(--re-gold);"></i> Selected letting units & spaces
                    </h5>
                    <div class="table-responsive" style="border: 1px solid var(--re-border-color); border-radius: 8px; overflow: hidden; background: #ffffff; margin-bottom: 20px;">
                        <table class="table table-striped table-hover" id="tblSelectedUnits" style="margin: 0;">
                            <thead>
                                <tr style="background: #f8fafc; border-bottom: 2px solid var(--re-border-color);">
                                    <th style="font-weight: 600; padding: 12px; font-size: 13px; color: #475569;">Facility</th>
                                    <th style="font-weight: 600; padding: 12px; font-size: 13px; color: #475569;">Unit Type</th>
                                    <th style="font-weight: 600; padding: 12px; font-size: 13px; color: #475569; text-align: right;">Size</th>
                                    <th style="font-weight: 600; padding: 12px; font-size: 13px; color: #475569; text-align: right;">Tariff / m²</th>
                                    <th style="font-weight: 600; padding: 12px; font-size: 13px; color: #475569; text-align: center;">Qty</th>
                                    <th style="font-weight: 600; padding: 12px; font-size: 13px; color: #475569; text-align: right;">Monthly Rental</th>
                                    <th style="font-weight: 600; padding: 12px; font-size: 13px; color: #475569; text-align: center; width: 80px;">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Live Pricing Summary Panel -->
                <div id="pricingPanel" style="display: none; background: var(--re-gold-light); border: 1px solid rgba(197, 155, 39, 0.3); border-radius: 8px; padding: 20px; margin-top: 20px;">
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <span style="font-size: 14px; font-weight: 600; color: #475569;">Estimated Total Monthly Rental:</span>
                        <span id="lblCalcTotal" style="font-size: 24px; font-weight: 800; color: var(--re-gold);">-</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Section 3: Mandatory Document Uploads -->
        <div class="re-card">
            <div class="re-card-header">
                <i class="fa fa-cloud-upload" style="color: var(--re-gold); font-size: 18px;"></i>
                <h3 class="re-card-title">3. Pre-Qualification Documents</h3>
            </div>
            <div class="re-card-body">
                <div class="alert alert-warning" style="border-radius: 8px; font-size: 13px; margin-bottom: 20px;">
                    <i class="fa fa-info-circle"></i> <strong>Mandatory Uploads:</strong> Please upload high-quality PDF/Scanned copies of the following documents. All files are mandatory unless noted as entity-only or optional. Maximum file size per document is 5MB.
                </div>

                <!-- Tabs Header -->
                <ul class="nav nav-tabs re-nav-tabs" role="tablist">
