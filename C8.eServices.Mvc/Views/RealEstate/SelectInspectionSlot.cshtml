@model C8.eServices.Mvc.Models.RE_Application
@{
    ViewBag.Title = "Select Inspection Slot";
    Layout = "~/Views/Shared/RCS_Layout.cshtml";
}

<style>
    :root {
        --re-gold: #c59b27;
        --re-gold-hover: #a37f1c;
        --re-border-color: #e7e5e4;
        --re-slate-dark: #2e2a27;
        --re-slate-black: #1c1917;
    }

    .re-container {
        padding: 30px 15px;
        font-family: 'Inter', sans-serif;
    }

    .re-header-card {
        background: linear-gradient(135deg, var(--re-slate-dark) 0%, var(--re-slate-black) 100%);
        color: #ffffff;
        border-radius: 12px;
        padding: 25px 30px;
        margin-bottom: 25px;
        border-left: 5px solid var(--re-gold);
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .info-card {
        background: #ffffff;
        border: 1px solid var(--re-border-color);
        border-radius: 12px;
        padding: 20px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    }

    .info-card h4 {
        margin-top: 0;
        margin-bottom: 15px;
        font-weight: 700;
        color: var(--re-slate-black);
        border-bottom: 2px solid var(--re-gold);
        padding-bottom: 6px;
        font-size: 15px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .info-item {
        display: flex;
        justify-content: space-between;
        padding: 8px 0;
        border-bottom: 1px dashed #f1f5f9;
        font-size: 13px;
    }

    .info-item:last-child {
        border-bottom: none;
    }

    .info-label {
        font-weight: 600;
        color: #64748b;
    }

    .info-value {
        color: #1e293b;
        font-weight: 500;
        text-align: right;
    }

    .option-card {
        background: #ffffff;
        border: 1px solid var(--re-border-color);
        border-radius: 12px;
        padding: 24px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        margin-bottom: 20px;
    }

    .btn-re-gold {
        background-color: var(--re-gold);
        color: #ffffff;
        border: 1px solid var(--re-gold);
        padding: 10px 24px;
        border-radius: 6px;
        font-weight: 600;
        cursor: pointer;
        font-size: 14px;
    }

    .btn-re-gold:hover {
        background-color: var(--re-gold-hover);
        border-color: var(--re-gold-hover);
    }

    .btn-cancel {
        background-color: transparent;
        border: 1px solid #cbd5e1;
        color: #475569;
        text-decoration: none;
        padding: 10px 24px;
        border-radius: 6px;
        font-weight: 600;
        font-size: 14px;
        display: inline-block;
    }

    .btn-cancel:hover {
        background-color: #f1f5f9;
        color: #1e293b;
    }
</style>

<div class="re-container">
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger" style="border-radius: 8px; border-left: 4px solid #dc2626;">
            <i class="fa fa-exclamation-circle"></i> @TempData["ErrorMessage"]
        </div>
    }

    <div class="re-header-card">
        <h1 style="margin:0 0 5px 0; font-size:24px; font-weight:700;">Confirm Inspection Appointment</h1>
        <p style="margin:0; font-size:14px; color:#cbd5e1;">Verify the scheduled pre-occupation inspection slot for reference @Model.ApplicationReferenceNumber.</p>
    </div>

    <div class="info-grid">
        <div class="info-card">
            <h4>Application Details</h4>
            <div class="info-item">
                <span class="info-label">Reference Number:</span>
                <span class="info-value" style="font-weight:700;">@Model.ApplicationReferenceNumber</span>
            </div>
            <div class="info-item">
                <span class="info-label">Applicant Name:</span>
                <span class="info-value">@(Model.Customer != null ? Model.Customer.FullName : "N/A")</span>
            </div>
            <div class="info-item">
                <span class="info-label">Selected Premises:</span>
                <span class="info-value">@(Model.SelectedFacility != null ? Model.SelectedFacility.Name : "N/A")</span>
            </div>
        </div>

        <div class="info-card">
            <h4>Scheduled Slot</h4>
            <div class="info-item">
                <span class="info-label">Inspection Date:</span>
                <span class="info-value" style="font-weight:700; color:var(--re-gold);">@(Model.InspectionDate.HasValue ? Model.InspectionDate.Value.ToString("yyyy-MM-dd") : "Not Scheduled")</span>
            </div>
            <div class="info-item">
                <span class="info-label">Inspection Time:</span>
                <span class="info-value" style="font-weight:700; color:var(--re-gold);">@Model.InspectionTime</span>
            </div>
            <div class="info-item">
                <span class="info-label">Slot Status:</span>
                <span class="info-value">@Model.InspectionStatus</span>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Option 1: Confirm Scheduled Slot -->
        <div class="col-md-6">
            <div class="option-card" style="border-top: 4px solid #16a34a;">
                <h4 style="font-weight:700; color:#16a34a; margin-top:0;"><i class="fa fa-check-circle"></i> Option 1: Confirm Appointment</h4>
                <p style="font-size:13.5px; color:#475569; min-height:60px;">Accept the scheduled slot as proposed by the Property Management office. A property officer will meet you on site at the scheduled time.</p>
                
                @using (Html.BeginForm("SelectInspectionSlot", "RealEstate", new { id = Model.Id }, FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="actionType" value="Confirm" />
                    <button type="submit" class="btn-re-gold" style="background-color:#16a34a; border-color:#16a34a;" id="btn-confirm-slot">
                        Accept & Confirm Slot
                    </button>
                }
            </div>
        </div>

        <!-- Option 2: Propose New Slot -->
        <div class="col-md-6">
            <div class="option-card" style="border-top: 4px solid var(--re-gold);">
                <h4 style="font-weight:700; color:var(--re-gold); margin-top:0;"><i class="fa fa-calendar-plus-o"></i> Option 2: Propose Alternative</h4>
                <p style="font-size:13.5px; color:#475569; min-height:60px;">If the scheduled slot does not work for you, propose an alternative date and time for review by the property officer.</p>
                
                @using (Html.BeginForm("SelectInspectionSlot", "RealEstate", new { id = Model.Id }, FormMethod.Post, new { id = "proposeForm" }))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="actionType" value="Propose" />
                    
                    <div class="row" style="margin-bottom:15px;">
                        <div class="col-xs-6">
                            <label style="font-size:12px; font-weight:600; color:#475569;">Proposed Date *</label>
                            <input type="date" name="proposedDate" class="form-control input-sm" id="txtProposedDate" />
                        </div>
                        <div class="col-xs-6">
                            <label style="font-size:12px; font-weight:600; color:#475569;">Proposed Time *</label>
                            <input type="text" name="proposedTime" class="form-control input-sm" placeholder="e.g. 14:00" id="txtProposedTime" />
                        </div>
                    </div>
                    
                    <button type="button" class="btn-re-gold" onclick="validateAndPropose()" id="btn-propose-slot">
                        Submit Proposed Slot
                    </button>
                }
            </div>
        </div>
    </div>

    <div style="margin-top: 15px;">
        <a href="@Url.Action("MyApplications", "RealEstate")" class="btn-cancel">
            Back to My Applications
        </a>
    </div>
</div>

@section Scripts {
    <script>
        function validateAndPropose() {
            let pDate = $('#txtProposedDate').val();
            let pTime = $('#txtProposedTime').val();

            if (!pDate || pDate === '') {
                alert('Please specify a proposed date.');
                return;
            }

            if (!pTime || pTime.trim() === '') {
                alert('Please specify a proposed time slot.');
                return;
            }

            $('#proposeForm').submit();
        }
    </script>
}
