@model IEnumerable<C8.eServices.Mvc.Models.RE_LeaseLookups.LeaseApplicationType>
@{
    ViewBag.Title = "Lease Applications";
    Layout = "~/Views/Shared/RCS_Layout.cshtml";
}
<style>
    .re-container { padding: 30px 15px; font-family: 'Inter', 'Helvetica Neue', Arial, sans-serif; color: #1c1917; }
    .re-header-card { background: linear-gradient(135deg, #2e2a27 0%, #1c1917 100%); color: #fff; border-radius: 12px; padding: 28px 30px; margin-bottom: 25px; border-left: 5px solid #c59b27; }
    .re-header-card h1 { margin: 0 0 6px 0; font-size: 26px; font-weight: 700; }
    .re-header-card p { margin: 0; color: #cbd5e1; font-size: 14px; }
    .lt-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 16px; }
    .lt-card { display: block; background: #fff; border: 1px solid #e7e5e4; border-radius: 12px; padding: 22px; color: inherit; text-decoration: none; transition: border-color .15s, box-shadow .15s; min-height: 150px; }
    a.lt-card:hover, a.lt-card:focus { border-color: #c59b27; box-shadow: 0 6px 18px rgba(0,0,0,.08); text-decoration: none; color: inherit; }
    .lt-card h3 { margin: 0 0 8px 0; font-size: 18px; font-weight: 700; }
    .lt-card p { margin: 0 0 14px 0; font-size: 14px; color: #57534e; }
    .lt-card .go { font-weight: 600; color: #a37f1c; font-size: 14px; }
    .lt-card.off { background: #fafaf9; cursor: default; }
    .lt-card.off h3 { color: #78716c; }
    .lt-card .soon { display: inline-block; font-size: 12px; font-weight: 600; color: #57534e; background: #e7e5e4; border-radius: 999px; padding: 2px 10px; }
</style>

<div class="re-container">
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-warning"><i class="fa fa-info-circle"></i> @TempData["ErrorMessage"]</div>
    }

    <div class="re-header-card">
        <h1>Lease Applications</h1>
        <p>Select the type of lease you would like to apply for.</p>
    </div>

    <div class="lt-grid">
        @foreach (var t in Model)
        {
            if (t.OnlineFormAvailable)
            {
                <a class="lt-card" href="@Url.Action("Capture", "RealEstate", new { leaseType = t.Name })" id="lease-type-@t.Name.Replace(" ", "-").ToLowerInvariant()">
                    <h3>@t.Name</h3>
                    <p>@t.Description</p>
                    <span class="go">Apply now <i class="fa fa-arrow-right"></i></span>
                </a>
            }
            else
            {
                <div class="lt-card off" id="lease-type-@t.Name.Replace(" ", "-").ToLowerInvariant()">
                    <h3>@t.Name</h3>
                    <p>@t.Description</p>
                    <span class="soon">Not yet available online. Please contact the DPRE office.</span>
                </div>
            }
        }
    </div>
</div>
