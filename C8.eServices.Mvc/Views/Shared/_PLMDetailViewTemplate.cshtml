@*
    ============================================================
    PLM DETAIL VIEW TEMPLATE — Reference Pattern
    ============================================================
    Use this file as a COPY-PASTE reference when building any
    new Termination, Eviction, or Authorization detail view.

    Standard Model: C8.eServices.Mvc.ViewModels.DepartmentsApprovalViewModel
    Standard Layout: ~/Views/Shared/RCS_Layout.cshtml

    Section Order:
        1. Application Info Table (with "View" link to Details)
        2. Lease Details Table (with "View" link to ApplincantDetails)
        3. Context-specific Data (Termination / Eviction / Docs)
        4. Document Upload Partials (if applicable)
        5. Action Form (dropdowns, textareas, date pickers)
        6. Submit Section (SweetAlert confirmation)

    CSS: Use existing Bootstrap 3 classes:
        - panel / panel-default / panel-heading / panel-body
        - table table-bordered table-hover table-striped
        - btn btn-primary / btn-warning / btn-danger / btn-success
        - form-control / form-group / form-horizontal
    ============================================================
*@

@model C8.eServices.Mvc.ViewModels.DepartmentsApprovalViewModel
@using C8.eServices.Mvc.Keys
@{
    Layout = "~/Views/Shared/RCS_Layout.cshtml";
}
<head>
    <style>
        .swal-modal .swal-text { text-align: center; }
        .plm-section-heading {
            background-color: #2c3e50;
            color: #ffffff;
            padding: 10px 15px;
            font-weight: bold;
            border-radius: 3px 3px 0 0;
        }
        .plm-detail-label {
            font-weight: 600;
            color: #555;
            margin-bottom: 2px;
        }
        .plm-detail-value {
            font-size: 14px;
            margin-bottom: 10px;
        }
    </style>
</head>

@* ═══════════════════════════════════════════════════════════════
   SECTION 1: Application Info Table
   ═══════════════════════════════════════════════════════════════ *@
<div id="bankAccountPanel">
    <div class="panel panel-default">
        <div class="panel-heading">Application Information</div>
        <div style="width: 90%;margin: 0 auto;">
            <br />
            <table class="table table-bordered table-hover table-striped panel panel-default display">
                <thead>
                    <tr>
                        <th>Reference Number</th>
                        <th>Applicant Type</th>
                        <th>Status</th>
                        <th>Application Date</th>
                        <th>Applicant Name</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>@Model.PropertyLeaseApplications?.ApplicationReferenceNumber</td>
                        <td>@(Model.PropertyLeaseApplications?.PurchaserType?.Name ?? "N/A")</td>
                        <td>@(Model.PropertyLeaseApplications?.Status?.Name ?? "N/A")</td>
                        <td>@Model.PropertyLeaseApplications?.CreatedDateTime</td>
                        <td>@Model.PropertyLeaseApplications?.Customer?.FullName</td>
                        <td>
                            @Html.ActionLink("View", "Details", "PropertyLeaseApplication", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("refNo=" + Model.PropertyLeaseApplications?.Id.ToString()), target = "_blank" }, new { @class = "btn btn-primary btn-sm", @target = "_blank" })
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <br />

        @* ═══════════════════════════════════════════════════════════════
           SECTION 2: Lease Details Table
           ═══════════════════════════════════════════════════════════════ *@
        <div class="panel-heading">Tenant Lease Details</div>
        <div style="width: 90%;margin: 0 auto;">
            <br />
            <table class="table table-bordered table-hover table-striped panel panel-default display">
                <thead>
                    <tr>
                        <th>Lease Ref No.</th>
                        <th>Applicant Type</th>
                        <th>Status</th>
                        <th>Captured Date</th>
                        <th>Tenant Name</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>@Model.LeaseDetails?.LeaseReferenceNo</td>
                        <td>@(Model.LeaseDetails?.PurchaserType?.Name ?? "N/A")</td>
                        <td>@(Model.LeaseDetails?.Status?.Name ?? "N/A")</td>
                        <td>@Model.LeaseDetails?.CreatedDateTime</td>
                        <td>@Model.LeaseDetails?.FirstNames @Model.LeaseDetails?.LastName</td>
                        <td>
                            @if (Model.LeaseDetails != null)
                            {
                                @Html.ActionLink("View", "ApplincantDetails", "LeaseDetails", new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("refNo=" + Model.LeaseDetails?.Id.ToString()), target = "_blank" }, new { @class = "btn btn-primary btn-sm", @target = "_blank" })
                            }
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <br />

        @* ═══════════════════════════════════════════════════════════════
           SECTION 3: Context-Specific Details (Termination / Eviction)
           Replace or extend this section per use case.
           ═══════════════════════════════════════════════════════════════ *@
        <div class="panel-heading">Termination Details</div>
        <div style="width: 90%;margin: 0 auto;">
            <br />
            <table class="table table-bordered table-hover table-striped panel panel-default display">
                <thead>
                    <tr>
                        <th>Termination Date</th>
                        <th>Reason for Termination</th>
                        <th>Captured Date</th>
                        <th>Terminated By</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>@Model.LeaseTermination?.TerminationDate</td>
                        <td>@Model.LeaseTermination?.ReasonForTermination</td>
                        <td>@Model.LeaseTermination?.CreatedDateTime</td>
                        <td>@Model.Customer?.FullName</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <br />

        @* ═══════════════════════════════════════════════════════════════
           SECTION 4: Document Uploads (if applicable)
           ═══════════════════════════════════════════════════════════════ *@
        @if (Model.DocumentsViewModel != null)
        {
            <div class="panel-heading">Upload Document/s</div>
            @Html.Partial("_DocumentsPartialConductUnitInspection", Model.DocumentsViewModel)
            <br />
        }

        @* ═══════════════════════════════════════════════════════════════
           SECTION 5: Action Form
           ═══════════════════════════════════════════════════════════════ *@
        <div class="panel-heading">Decision</div>
        <div style="width: 90%;margin: 0 auto;">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                <br />
                @* Hidden fields for IDs *@
                @Html.HiddenFor(model => model.PropertyLeaseApplication.Id)
                @Html.HiddenFor(model => model.LeaseDetails.Id)

                <div class="form-horizontal">
                    @if (ViewBag.ApprovalStatus != null)
                    {
                        <div class="form-group">
                            @Html.Label("Approval Status", htmlAttributes: new { @class = "control-label col-md-2" })
                            <div class="col-md-3">
                                @Html.DropDownList("ApprovalStatus", null, "-- Select Option --", htmlAttributes: new { @class = "form-control", @Name = "ApprovalStatusddl", @required = "required", @id = "ApprovalStatusddl" })
                            </div>
                        </div>
                    }
                </div>

                <div id="divComment" style="display:none">
                    <div class="form-group">
                        @Html.Label("Comment", htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-6">
                            @Html.TextArea("RejectComment", new { @class = "form-control", @Id = "Comments", @rows = "3", @placeholder = "Enter your comments here..." })
                        </div>
                    </div>
                </div>

                <br />
                <div id="divbtn" style="display:block" class="col-md-offset-2">
                    <input type="button" value="Submit" name="btnApproval" onclick="clickSubmit()" class="btn btn-primary" />
                    <input type="submit" value="Submit" style="display:none;" hidden name="btnApprovalStatus" class="btn btn-primary" id="btnApproval" />
                    <br /><br /><br />
                </div>
            }
        </div>
    </div>
</div>

@* ═══════════════════════════════════════════════════════════════
   SECTION 6: Scripts (DataTable + SweetAlert)
   ═══════════════════════════════════════════════════════════════ *@
@section Scripts{
    <script src="@Url.Content("~/scripts/Datatables/jquery.dataTables.min.js")"></script>
    <script src="@Url.Content("~/scripts/Datatables/dataTables.bootstrap.js")"></script>
}

<script>
    function clickSubmit() {
        swal({
            icon: "info",
            title: "Are you sure you want to submit?",
            buttons: ['No!', 'Yes, I am sure!']
        }).then(function (isConfirm) {
            if (isConfirm) {
                var statuskey = document.getElementById('ApprovalStatusddl').value;
                var comment = document.getElementById('Comments').value;
                if (statuskey === '@RCSActionTypeKeys.Rejected' && (comment == null || comment === '')) {
                    swal("Error", "Please enter a reason for rejection", "warning");
                } else {
                    document.getElementById("btnApproval").click();
                }
            }
        });
    }

    $(document).ready(function () {
        // Toggle comment section on reject
        $('#ApprovalStatusddl').change(function () {
            var val = $(this).val();
            if (val === '@RCSActionTypeKeys.Rejected') {
                $('#divComment').show();
            } else {
                $('#divComment').hide();
            }
        });
    });
</script>
