    <div class="modal fade" id="myModal10" role="dialog">
        <div class="modal-dialog">
            <!-- Modal content-->
            <div class="modal-content">
                <div class="modal-header">
                    <h4 id="modalHeading" runat="server" class="modal-title">Session time out</h4>
                </div>
                <div class="modal-body">
                    <label runat="server">Your session is about to expire.</label>
                    <span id="spanTimeLeft" style="color: red; font-size:large; display:none"> </span>
                    <label runat="server"> Click cancel to reset the session.</label>

                </div>
                <div class="modal-footer" style="align-content: flex-end">
                    <button id="btn" class="form-control" runat="server" data-dismiss="modal" onclick="ResetThisSession()">Cancel</button>
                </div>
            </div>
        </div>
    </div>
    @RenderSection("Scripts", required: false)
</body>

