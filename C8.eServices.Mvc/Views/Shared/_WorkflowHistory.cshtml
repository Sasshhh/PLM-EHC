@model C8.eServices.Mvc.ViewModels.DepartmentsApprovalViewModel

<style>
    .workflow-timeline {
        position: relative;
        padding-left: 30px;
        margin: 20px 0;
        font-family: inherit;
    }
    .workflow-timeline::before {
        content: '';
        position: absolute;
        top: 0;
        bottom: 0;
        left: 11px;
        width: 2px;
        background: #cbd5e1;
        border-radius: 2px;
    }
    .timeline-node {
        position: relative;
        margin-bottom: 24px;
    }
    .timeline-node:last-child {
        margin-bottom: 0;
    }
    .timeline-icon {
        position: absolute;
        left: -30px;
        top: 4px;
        width: 24px;
        height: 24px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        color: #fff;
        z-index: 1;
        box-shadow: 0 0 0 4px #fff;
    }
    .icon-done { background: #10b981; }
    .icon-pending { background: #94a3b8; }
    
    .timeline-content {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 6px;
        padding: 12px 16px;
        position: relative;
    }
    .timeline-content::before {
        content: '';
        position: absolute;
        left: -6px;
        top: 10px;
        width: 10px;
        height: 10px;
        background: #f8fafc;
        border-left: 1px solid #e2e8f0;
        border-bottom: 1px solid #e2e8f0;
        transform: rotate(45deg);
    }
    .tl-role {
        font-size: 11px;
        text-transform: uppercase;
        font-weight: 700;
        color: #64748b;
        margin-bottom: 4px;
    }
    .tl-user {
        font-size: 14px;
        font-weight: 600;
        color: #0f172a;
    }
    .tl-action {
        font-size: 13px;
        color: #334155;
        margin-top: 6px;
        background: #fff;
        padding: 8px 12px;
        border-radius: 4px;
        border-left: 3px solid #3b82f6;
    }
    .tl-date {
        position: absolute;
        right: 16px;
        top: 12px;
        font-size: 11px;
        color: #94a3b8;
        font-weight: 600;
    }
</style>

<div class="eval-section">
    <div class="eval-section-hdr"><i class="ion ion-network"></i> Workflow Approval Tracker</div>
    <div class="eval-section-body">
        <div class="workflow-timeline">
            
            @* 1. Letting Officer (CSO) *@
            <div class="timeline-node">
                @if (ViewBag.OfficerName != null)
                {
                    <div class="timeline-icon icon-done"><i class="ion ion-checkmark"></i></div>
                    <div class="timeline-content">
                        <div class="tl-role">Letting Officer (CSO)</div>
                        <div class="tl-user">@ViewBag.OfficerName</div>
                        <div class="tl-date">@(ViewBag.DateCaptured != null ? ((DateTime)ViewBag.DateCaptured).ToString("yyyy-MM-dd HH:mm") : "-")</div>
                        <div class="tl-action"><strong>Decision:</strong> @ViewBag.ActionComment</div>
                    </div>
                }
                else
                {
                    <div class="timeline-icon icon-pending"><i class="ion ion-more"></i></div>
                    <div class="timeline-content" style="opacity: 0.6;">
                        <div class="tl-role">Letting Officer (CSO)</div>
                        <div class="tl-action" style="border-left-color: #94a3b8;">Pending recommendation...</div>
                    </div>
                }
            </div>

            @* 2. Revenue Manager *@
            <div class="timeline-node">
                @if (Model != null && Model.PropertyManager != null && !string.IsNullOrEmpty(Model.PropertyManager.PropertyComments))
                {
                    <div class="timeline-icon icon-done"><i class="ion ion-checkmark"></i></div>
                    <div class="timeline-content">
                        <div class="tl-role">Revenue Manager</div>
                        <div class="tl-user">Revenue Manager</div>
                        <div class="tl-date">@(Model.PropertyManager.CreatedDateTime != null ? ((DateTime)Model.PropertyManager.CreatedDateTime).ToString("yyyy-MM-dd HH:mm") : "Done")</div>
                        <div class="tl-action"><strong>Decision:</strong> @ViewBag.Approved - @Model.PropertyManager.PropertyComments</div>
                    </div>
                }
                else
                {
                    <div class="timeline-icon icon-pending"><i class="ion ion-more"></i></div>
                    <div class="timeline-content" style="opacity: 0.6;">
                        <div class="tl-role">Revenue Manager</div>
                        <div class="tl-action" style="border-left-color: #94a3b8;">Awaiting review...</div>
                    </div>
                }
            </div>

        </div>
    </div>
</div>
