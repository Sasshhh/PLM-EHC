            color: white;
        }
        .site-head {
            background-color: #1e8449;
        }

        .main-container .nav-wrap .nav-head {
            background: #1e8449;
        }

        .btn {
            color: #1e8449;
            border-color: #1e8449;
            background-color: white;
        }

            .btn:hover {
                color: white;
                border-color: white;
                background-color: #1e8449;
            }

        .btn12 {
            color: #af7b0b;
            border-color: #af7b0b;
            background-color: white;
        }

            .btn12:hover {
                color: white;
                border-color: white;
                background-color: #1e8449;
            }

        .pagination > .active > a, .pagination > .active > span, .pagination > .active > a:hover, .pagination > .active > span:hover, .pagination > .active > a:focus, .pagination > .active > span:focus {
            color: #ffffff;
            background-color: grey;
            border-color: #ffffff;
        }

        .BoToDoHide {
            display: none;
        }

        .button1 {
            background-color: #1e8449 !important;
            border: none;
            color: white;
            padding: 15px 32px;
            text-align: center;
            text-decoration: none;
            display: inline-block;
            font-size: 16px;
            margin: 4px 2px;
            cursor: pointer;
        }

        .step-app > .step-steps > li.active a {
            background-color: darkgrey !important;
            color: #fff;
        }


        .sk-cube-grid {
            width: 60px;
            height: 60px;
            text-align: center;
            font-size: 10px;
            background-color: grey;
        }

            .sk-cube-grid .sk-cube-child {
                width: 33%;
                height: 33%;
                background-color: white;
                float: left;
                -webkit-animation: sk-cubeGridScaleDelay 1.3s infinite ease-in-out;
                animation: sk-cubeGridScaleDelay 1.3s infinite ease-in-out
            }

            .sk-cube-grid .sk-cube-grid9 {
                -webkit-animation-delay: .2s;
                animation-delay: .2s
            }


        .modal-dialog {
            position: relative;
            display: table; /* This is important */
            overflow-y: auto;
            overflow-x: auto;
            width: auto;
            min-width: 300px;
        }
    </style>
