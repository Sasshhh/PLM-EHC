<script>
    function StatusChange() {
        var Status = $("#ApprovalStatus option:selected").text();
        if (Status == "Re-Assign") {
            jQuery('#divReAssign').css("display", "block")
            jQuery('#divReAllocate').css("display", "none")
            jQuery('#divComment').css("display", "none")
        }
        else if (Status == "Re-Allocate") {
            jQuery('#divReAssign').css("display", "none")
            jQuery('#divReAllocate').css("display", "block")
            jQuery('#divComment').css("display", "none")
        }
        else if (Status == "Disprove" || Status == "Rejected") {
            jQuery('#divComment').css("display", "block")
        }
        else {
            jQuery('#divReAssign').css("display", "none")
            jQuery('#divReAllocate').css("display", "none")
            jQuery('#divComment').css("display", "none")
        }
    }
</script>



<script>
