@model C8.eServices.Mvc.ViewModels.DepartmentsApprovalViewModel
@using System.Text;
@using C8.eServices.Mvc.DataAccessLayer;
@using C8.eServices.Mvc.Keys
@{
    ViewBag.Title = "Details";
    Layout = "~/Views/Shared/RCS_Layout.cshtml";
}

<script src="@Url.Content( "~/Scripts/moment.js" )"></script>
<div id="bankAccountPanel">
    <div class="panel panel-default">
        <div class="panel-heading">Evaluating Application</div>
        <div style="width: 90%;margin: 0 auto;">
            <br />
            <table id="FailureTable" class="table table-bordered table-hover table-striped panel panel-default display ">
                <thead>
                    <tr>
                        <th>
                            Reference Number
                        </th>
                        <th>
                            Attorney Code
                        </th>
                        <th>
                            Status
                        </th>
                        <th>
                            Captured Date
                        </th>
                        <th>
                            Customer Name
                        </th>
                    </tr>
                </thead>
                <tbody>

                    <tr>
                        <td>
                            @Model.RCSApplicationStatus.ApplicationReferenceNumber
                        </td>
                        <td>
                            @Model.RCSApplicationStatus.Customer.AttorneyCode
                        </td>
                        <td>
                            @Model.RCSApplicationStatus.Status.Name
                        </td>
                        <td>
                            @Model.RCSApplicationStatus.CreatedDateTime
                        </td>
                        <td>
                            @Model.RCSApplicationStatus.Customer.FullName
                        </td>
                    </tr>

                </tbody>
            </table>



        </div>

        <br />

        <div class="panel-heading">Attached Documents</div>
        <div id="documentsCollapse" class="panel-collapse collapse in">
            <div class="panel-body">
                <div id="currentDocumentsGrp">
                    <div class="form-group">
                        @Html.Partial("~/Views/Shared/_DocumentsPartialRcsBo.cshtml", Model.Document)
                        <div class="form-group">

                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="panel-heading">CoE Financial System - Payment History</div>
        <div style="width: 90%;margin: 0 auto;">
            <br />
            <table id="RCSTable" class="table table-bordered table-hover table-striped panel panel-default display">
                <thead>
                    <tr>
                        <th>
                            Customer Name
                        </th>
                        <th>
                            Reference
                        </th>
                        <th>
                            Processed Date
                        </th>
                        <th>
                            Amount
                        </th>


                    </tr>
                </thead>
                @if (Model.paymentDetails.PaymentDetailsList !=null && Model.paymentDetails.Status == "Success")
                {
                    <tbody>
                        @foreach (var item in Model.paymentDetails.PaymentDetailsList)
                        {
                            <tr>
                                <td>
                                    @item.CustomerFirstName @item.CustomerLastName
                                </td>

                                <td>
                                    @item.Ref
                                </td>
                                <td>
                                    @if (item.ConvertedDate != null)
                                    {
                                        @item.ConvertedDate
                                    }
                                    else
                                    {
                                        @item.Date
                                    }

                                </td>
                                <td>
                                    @item.Amt
                                </td>

                            </tr>
                        }


                    </tbody>
                }
                else
                {
                    <tbody>

                        <tr>
                            <td>
                                @Model.paymentDetails.Status
                            </td>

                            <td>
                                -
                            </td>
                            <td>
                                -

                            </td>
                            <td>
                                -
                            </td>

                        </tr>



                    </tbody>
                }

            </table>



        </div>

        <br />
        @if (Model.RCSApplicationStatus.ApplicationFeePaymentOnline == true)
        {
            <div class="panel-heading">Siyakhokha Payment History</div>
            <div style="width: 90%;margin: 0 auto;">
                <br />
                <table id="RCSTable" class="table table-bordered table-hover table-striped panel panel-default display">
                    <thead>
                        <tr>
                            <th>
                                Account Number
                            </th>
                            <th>
                                Payment Method
                            </th>
                            <th>
                                Date
                            </th>
                            <th>
                                Amount
                            </th>
                            <th>
                                Status
                            </th>


                        </tr>
                    </thead>

                    <tbody>

                        <tr>

                            <td>
                                @Model.RCSApplicationStatus.TransferInformation.RatesNumber
                            </td>
                            <td>
                                @Model.RCSApplicationStatus.ApplicationFeePayMethod
                            </td>
                            <td>

                                @Model.RCSApplicationStatus.ApplicationFeePaymentDate


                            </td>
                            <td>
                                @Model.RCSApplicationStatus.ApplicationFeeAmount
                            </td>

                            <td>
                                @Model.RCSApplicationStatus.ApplicationFeeStatus
                            </td>

                        </tr>



                    </tbody>


                </table>

                <br />
                <br />



            </div>

        }
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            <br />
            <div style="width: 90%;margin:auto;">
                @if (ViewBag.ApprovalStatus != null)
                {
                    <div class="form-group">
                        @Html.Label("Approval Status", htmlAttributes: new { @class = "control-label col-md-1" })
                        <div class="col-md-2">
                            @Html.DropDownList("ApprovalStatus", null, "-- Select Option --", htmlAttributes: new { @class = "form-control", @Name = "ApprovalStatusddl", @required = "required" })
                            @Html.ValidationMessage("ApprovalStatus", "", new { @class = "text-danger" })
                        </div>
                    </div>
                }

                <br />

                <div id="divComment" style="display:none">
                    <div class="form-group">
                        @Html.Label("Comment", htmlAttributes: new { @class = "control-label col-md-1" })
                        <div class="col-md-4">
                            @Html.TextArea("Comment", new { @class = "form-control" })
                            @Html.ValidationMessage("Comment", "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <br />
                    <br />
                    <br />
                </div>
                <br />
                <br />

                <div id="divbtn" style="display:block" @*align="left"*@>
                    <input type="button" value="Submit" name="btnApproval" onclick="clickSubmit()" class="button1" />
                    <input type="submit" value="Submit" style="display:none;" hidden name="btnApprovalStatus" class="button1" id="btnApproval" />
                    <br />
                    <br />
                    <br />
                </div>
               
            </div>
                }
            </div>

        </div>
@section Scripts{

    <script src="@Url.Content( "~/scripts/Datatables/jquery.dataTables.min.js" )"></script>
    <script src="@Url.Content( "~/scripts/Datatables/dataTables.bootstrap.js" )"></script>

    <script type="text/javascript">
        $(function () {
            $('#RCSTable').DataTable();

        });

        function loadAccounts() {
            //debugger;
            $('#FailureTable').DataTable({
                "ajax": {
                    "url": "@Url.Action( "LoadDetails", "DepartmentsApprovals" )",
                    "type": "GET",
                    "datatype": "json",
                    "timeout": 60000
                },
                "columns": [

                    {
                        "data": "CreatedDateTime", "autoWidth": true,
                        "render": function (data) {
                            return convertDate(data);
                        }
                    },
                    {
                        "render": function (data) {
                            return "System";
                        }
                    },
                    { "data": "FailureReason", "autoWidth": true },
                    {
                        "data": "CapturedDate", "autoWidth": true,
                        "render": function (data) {
                            return convertDate(data);
                        }
                    },

                     { "data": "AssignedTo", "autoWidth": true }],
                "language": {
                    "emptyTable": "No Data.",
                },
                "Initcomplete": "",
                "destroy": true
            });
        }

        function convertDate(data) {
            try {
                var dtStart = new Date(parseInt(data.substr(6)));
                var dtStartWrapper = moment(dtStart);
                return dtStartWrapper.format("YYYY-MM-DD");
            }
            catch (ex) {
            }
        }

    

    </script>

}

