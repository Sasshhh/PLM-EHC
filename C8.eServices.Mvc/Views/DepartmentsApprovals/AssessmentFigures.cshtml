<script>
    //Masking amount fields
    $(document).ready(function ($) {
        $('#amount').mask('#,##0.00', { reverse: true });
        CheckAccountBalance();
    });

     $(function () {

                var IncompleteDepartmentUsers = "@ViewBag.Message2";
             var IncompleteDepartmentUsersTitle = "@ViewBag.MessageTitle2";
            if (IncompleteDepartmentUsers != null && IncompleteDepartmentUsers != "") {
                swal(IncompleteDepartmentUsersTitle, IncompleteDepartmentUsers, "warning");
            }
             $('#RCSTable').DataTable();


                var display = "@ViewBag.Error";

        if (display != null && display != "") {
            jQuery('#divNoDiscrepancies').css("display", "block")
        }
    });

    function switchDivsDiscrepancies() {
        var Billing = document.getElementById("Billing").value;
        var CreditControl = document.getElementById("CreditControl").value;
        var Rates = document.getElementById("Rates").value;
        var Sundries = document.getElementById("Sundries").value;


        if (Billing == "No" && CreditControl == "No" && Rates == "No" && Sundries=="No") {
            jQuery('#divNoDiscrepancies').css("display", "block")

        }


        else {
            jQuery('#divNoDiscrepancies').css("display", "none")

        }
    }

    function GenAssessmentFigure() {
        debugger;

        var rcsid = document.getElementById('returnUrl').value;

        $.getJSON("../DepartmentsApprovals/GenerareAssessmentFigures?RCSId="
            + rcsid,

            function (result) {
                if (result.Status == "Success") {
                    try {

                          $('#amount').val(result.FormattedOutstandingAmount);
                            $('#VerifyAccountBillingCycle').val(result.VerifyAccountBillingCycle);
                            $('#BillingCycleNumber').val(result.BillingCycleNumber);
                            $('#BillingCycleChange').val(result.BillingCycleChange);
                            $('#BalanceDueDate').val(result.BalanceDueDate);
                            //alert("al1" + result.AssessmentFigureExpiryDate);
                            //alert(result.date);
                            //alert(result.FormattedOutstandingAmount);
                            //alert("al" + result.FormattedAssessmentFigureExpiryDate);
                            $('#AssessmentFigureExpiryDate').val(result.AssessmentFigureExpiryDate);
                            $('#CalculationMonths').val(result.CalculationMonths);



                    }
                    catch (cat) { }
                }
                else {
                    //alert("Unsuccessfully captured!");
                    //alert(result.AccountNumber);
                    //alert(result.Status);
                    swal("" + result.Status, "", "info");
                }
            });
    }

    function CheckAccountBalance() {
        debugger;

        var rcsid = document.getElementById('returnUrl').value;

        $.getJSON("../DepartmentsApprovals/CheckAccountBalancce?RCSId="
            + rcsid,

            function (result) {
                if (result != "Error") {
                    try {
                        debugger
                        if (result.length == 0) {

                            swal("Error!", "No Results found!", "error");
                            $('#rate').val('');
                        }

                        else {


                            $('#AccountBalance').val(result.AccountBalance);
                            $('#DtCrFlag').val(result.DtCrFlag);
                            $('#PaymentBy').val(result.PaymentBy);



                        }
                    }
                    catch (cat) { }
                }
                else {
                    //alert("Unsuccessfully captured!");
                    swal("Error!", "Unsuccessfully captured.", "error");
                }
            });
    }

</script>
