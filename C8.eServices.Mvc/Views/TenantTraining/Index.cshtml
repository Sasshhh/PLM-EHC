@model IEnumerable<C8.eServices.Mvc.Models.PropertyLeaseApplication>
@using C8.eServices.Mvc.Keys;
@{
    ViewBag.Title = "Tenant Training - Send Invitations";
    Layout = "~/Views/Shared/RCS_Layout.cshtml";
}

<style>
    @@media only screen and (max-width: 1000px) {
        .cards tbody tr {
            float: left;
            width: 90%;
            margin: 0.5rem;
            border: 0.0625rem solid rgba(0,0,0,.125);
            border-radius: .25rem;
            box-shadow: 0.25rem 0.25rem 0.5rem rgba(0,0,0,0.25);
        }

        .cards thead tr {
            float: left;
            width: 90%;
            margin: 0.5rem;
            border: 0.0625rem solid rgba(0,0,0,.125);
            border-radius: .25rem;
            box-shadow: 0.25rem 0.25rem 0.5rem rgba(0,0,0,0.25);
        }

        .cards tbody td {
            display: block;
            word-wrap: break-word;
        }

        .cards thead th {
            display: none;
        }

        .table tbody label {
            display: block;
        }

        .cards tbody label {
            display: inline;
            position: relative;
            font-size: 85%;
            top: -0.5rem;
            color: #808080;
            min-width: 4rem;
            margin-left: 0;
            margin-right: 1rem;
            text-align: left;
        }

        tr.selected label {
            color: #404040;
        }

        .table .fa {
            font-size: 2.5rem;
            text-align: center;
        }

        .cards .fa {
            font-size: 7.5rem;
        }
    }
</style>

<div class="panel-group">
    <div class="panel panel-default">
        <div class="panel-group" style="margin-bottom: -1px;">
            <div class="panel panel-default">
                <div class="panel-heading" align="center">
                    <i class="fa fa-graduation-cap"></i> Pre-Tenancy Training Invitations
                </div>
            </div>
        </div>

        <div id="accountInfoCollapse" class="panel-collapse collapse in tablecss">
            <br />
            <div class="alert alert-info" style="margin: 15px;">
                <i class="fa fa-info-circle"></i> 
                <strong>Instructions:</strong> Click "Invite to Training" to send an email invitation to the tenant. 
                The tenant will receive a link to complete their mandatory pre-tenancy training and examination online.
            </div>

            <table id="TrainingTable" class="table table-bordered table-hover table-striped panel panel-default cards">
                <thead>
                    <tr>
                        <th>Applicant Name</th>
                        <th>Application Type</th>
                        <th>Application Ref No.</th>
                        <th>Email Address</th>
                        <th>Created Date</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.FirstName) @Html.DisplayFor(modelItem => item.LastName)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.PurchaserType.Name)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.ApplicationReferenceNumber)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.PurEmail)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.CreatedDateTime.Value)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Status.Name)
                            </td>
                            <td>
                                <button class="btn btn-success btn-invite" data-application-id="@item.Id" 
                                        data-applicant-name="@item.FirstName @item.LastName">
                                    <i class="fa fa-envelope"></i> Invite to Training
                                </button>
                                @Html.ActionLink("View Details", "Details", "PropertyLeaseApplication", 
                                    new { q = new C8.eServices.Mvc.Helpers.AesCrypto().Encrypt("refNo=" + item.Id.ToString()), target = "_blank" }, 
                                    new { @class = "btn btn-primary", @target = "_blank" })
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <br />
        </div>
    </div>
</div>

<!-- Success Modal -->
<div id="successModal" class="modal fade" role="dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title"><i class="fa fa-check-circle text-success"></i> Success!</h4>
            </div>
            <div class="modal-body">
                <p id="successMessage"></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>

<!-- Error Modal -->
<div id="errorModal" class="modal fade" role="dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title"><i class="fa fa-exclamation-triangle text-danger"></i> Error</h4>
            </div>
            <div class="modal-body">
                <p id="errorMessage"></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            $('#TrainingTable').DataTable({
                "order": [[4, "desc"]]
            });

            $('.btn-invite').click(function () {
                var btn = $(this);
                var applicationId = btn.data('application-id');
                var applicantName = btn.data('applicant-name');

                swal({
                    title: "Send Training Invitation?",
                    text: "This will send an email invitation to " + applicantName + " to complete their pre-tenancy training.",
                    icon: "info",
                    buttons: ["Cancel", "Send Invitation"],
                    dangerMode: false,
                }).then((willSend) => {
                    if (willSend) {
                        btn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Sending...');

                        $.ajax({
                            type: 'POST',
                            url: '@Url.Action("InviteToTraining", "TenantTraining")',
                            data: { applicationId: applicationId },
                            success: function (response) {
                                btn.prop('disabled', false).html('<i class="fa fa-envelope"></i> Invite to Training');

                                if (response.success) {
                                    swal("Success!", response.message, "success").then(() => {
                                        location.reload();
                                    });
                                } else {
                                    swal("Error!", response.message, "error");
                                }
                            },
                            error: function () {
                                btn.prop('disabled', false).html('<i class="fa fa-envelope"></i> Invite to Training');
                                swal("Error!", "An unexpected error occurred. Please try again.", "error");
                            }
                        });
                    }
                });
            });
        });
    </script>
}
