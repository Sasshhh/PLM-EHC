  <!--
    For a description of web.config changes for .NET 4.5 see http://go.microsoft.com/fwlink/?LinkId=235367.

    The following attributes can be set on the <httpRuntime> tag.
      <system.Web>
        <httpRuntime targetFramework="4.5" />
      </system.Web>
  -->
  <system.web>
    <globalization requestEncoding="utf-8" responseEncoding="utf-8" />
    <!-- httpOnlyCookies - Ensure that external script cannot access the cookie. -->
    <!-- requireSSL - Ensure that the cookie can only be transported over SSL. -->
    <!--<httpCookies httpOnlyCookies="true" requireSSL="true"/>-->
    <sessionState cookieName="es" timeout="1" />
    <customErrors mode="Off" />
    <!--<customErrors mode="RemoteOnly" defaultRedirect="~/Error">-->
    <!--<error redirect="~/Error/NotFound" statusCode="404"/>-->
    <!--</customErrors>-->
    <compilation debug="true" targetFramework="4.6.1" />
    <!-- This will handle requests up to 1024MB (1GB) -->
    <httpRuntime maxRequestLength="1048576" targetFramework="4.5" enableVersionHeader="false" />
    <!--<httpRuntime maxRequestLength="10240" targetFramework="4.5" enableVersionHeader="false" />-->
    <httpModules>
      <add name="ErrorLog" type="Elmah.ErrorLogModule, Elmah" />
      <add name="ErrorMail" type="Elmah.ErrorMailModule, Elmah" />
      <add name="ErrorFilter" type="Elmah.ErrorFilterModule, Elmah" />
    </httpModules>
  </system.web>
  <entityFramework>
    <contexts>
      <context type="C8.eServices.Mvc.DataAccessLayer.eServicesDbContext, C8.eServices.Mvc" disableDatabaseInitialization="true">
        <databaseInitializer type="C8.eServices.Mvc.DataAccessLayer.eServicesDbInitialiser, C8.eServices.Mvc" />
      </context>
    </contexts>
    <defaultConnectionFactory type="System.Data.Entity.Infrastructure.SqlConnectionFactory, EntityFramework" />
    <providers>
      <provider invariantName="System.Data.SqlClient" type="System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer" />
    </providers>
  </entityFramework>
